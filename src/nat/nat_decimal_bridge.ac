/// `Nat.ab` is literally `a.read(b)`, and `read(x, y)` is `10 * x + y`.
/// Adding a single digit `c` to `a.read(b)` appends the sum to the higher part.
theorem read_add_single(a: Nat, b: Nat, c: Nat) {
    a.read(b) + c = a.read(b + c)
} by {
    a.read(b) = 10 * a + b
    add_assoc(10 * a, b, c)
    (10 * a + b) + c = 10 * a + (b + c)
    10 * a + (b + c) = a.read(b + c)
}

/// Adding two decimal numbers appends the sums of the digits.
theorem read_add_read(a: Nat, b: Nat, c: Nat, d: Nat) {
    a.read(b) + c.read(d) = (a + c).read(b + d)
} by {
    a.read(b) = 10 * a + b
    c.read(d) = 10 * c + d
    add_comm_4(10 * a, b, 10 * c, d)
    (10 * a + b) + (10 * c + d) = (10 * a + 10 * c) + (b + d)
    distrib_left(10, a, c)
    10 * (a + c) = 10 * a + 10 * c
    10 * (a + c) + (b + d) = (a + c).read(b + d)
}

/// Multiplying `a.read(b)` by `d` appends the digit products.
theorem read_mul_single(a: Nat, b: Nat, d: Nat) {
    a.read(b) * d = (a * d).read(b * d)
} by {
    a.read(b) = 10 * a + b
    distrib_right(10 * a, b, d)
    (10 * a + b) * d = (10 * a) * d + b * d
    mul_assoc(10, a, d)
    (10 * a) * d = 10 * (a * d)
    10 * (a * d) + b * d = (a * d).read(b * d)
}

/// Carrying within a read: `a.read(10 * q + e)` is `(a + q).read(e)`.
theorem read_read_carry(a: Nat, q: Nat, e: Nat) {
    a.read(10 * q + e) = (a + q).read(e)
} by {
    a.read(10 * q + e) = 10 * a + (10 * q + e)
    add_assoc(10 * a, 10 * q, e)
    10 * a + (10 * q + e) = (10 * a + 10 * q) + e
    distrib_left(10, a, q)
    10 * (a + q) = 10 * a + 10 * q
    10 * (a + q) + e = (a + q).read(e)
}

