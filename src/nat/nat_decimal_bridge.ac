/// `18 + 12 = 30`.
theorem nat_add_18_12 {
    18 + 12 = 30
} by {
    18 = 1.read(8)
    12 = 1.read(2)
    read_add_read(1, 8, 1, 2)
    1.read(8) + 1.read(2) = (1 + 1).read(8 + 2)
    1 + 1 = 2
    8 + 2 = 10
    2.read(10) = 2.read(10 * 1 + 0)
    read_read_carry(2, 1, 0)
    2.read(10 * 1 + 0) = (2 + 1).read(0)
    two_plus_one
    2 + 1 = 3
    3.read(0) = 30
}

