/// The two right arguments of an iterated infimum may be exchanged.
theorem inf_right_comm[S: MeetSemilattice](a: S, b: S, c: S) {
    a.meet(b).meet(c) = a.meet(c).meet(b)
} by {
    meet_right_comm(a, b, c)
