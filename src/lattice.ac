/// The outer left argument of a nested infimum may be exchanged.
theorem inf_left_comm[S: MeetSemilattice](a: S, b: S, c: S) {
    a.meet(b.meet(c)) = b.meet(a.meet(c))
} by {
    meet_left_comm(a, b, c)
