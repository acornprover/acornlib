/// The outer left argument of a nested supremum may be exchanged.
theorem sup_left_comm[S: JoinSemilattice](a: S, b: S, c: S) {
    a.join(b.join(c)) = b.join(a.join(c))
} by {
    join_left_comm(a, b, c)
