from nat import Nat, from_nat
from real import Real, pi, converges_to
from list import partial

numerals Nat

// The Basel problem: the sum of the reciprocals of the squares converges,
// and its value is pi^2 / 6:
//     sum_{n=1}^{infinity} 1 / n^2 = pi^2 / 6.
// The problem is named after Basel, the hometown of the Bernoulli family,
// who worked on it in the late seventeenth century; it resisted many
// attempts until Leonhard Euler solved it in 1734 (aged 28).  The value
// pi^2 / 6 also equals zeta(2), the value of the Riemann zeta function at 2,
// and it is the reciprocal of the probability that two random integers are
// coprime.
//
// The statement is recorded with the library's sequence notation: a real
// sequence `q: Nat -> Real` converges to `a` when `converges_to(q, a)`
// holds, and `partial(f, k)` is the sum `f(0) + ... + f(k - 1)`.  The
// partial sums of the squared reciprocals are indexed from `n = 0` with the
// term `1 / (n + 1)^2`, so the sum from `n = 1` to `k` is
// `partial(..., k)`, and the classical statement is
//     converges_to(partial sums of 1/(n+1)^2, pi^2/6).
//
// Proof sketch (Euler, 1734, made rigorous later): the sine function has
// the Weierstrass product expansion
//     sin(x) / x = product_{n=1}^{infinity} (1 - x^2 / (n^2 pi^2)),
// and comparing the coefficient of x^2 in the product with the Taylor
// expansion sin(x)/x = 1 - x^2/6 + ... gives -1/6 = -sum 1/(n^2 pi^2),
// hence sum 1/n^2 = pi^2/6.  The modern proofs use the Fourier series of
// the function x -> x^2 on [-pi, pi] (Parseval's identity) or the cotangent
// partial fractions sum 1/(x - n pi).  A rigorous proof needs the theory of
// power series, infinite products and their termwise manipulation, which is
// only partially present in the library (the Wallis product
// `real/wallis_product.ac` develops a similar infinite product but the main
// limit is not yet closed).
//
// theorem theorems1000_basel {
//     converges_to(
//         function(k: Nat) {
//             partial(function(n: Nat) {
//                 Real.1 / ((from_nat[Real](n) + Real.1) * (from_nat[Real](n) + Real.1))
//             }, k)
//         },
//         pi * pi / from_nat[Real](Nat.6))
// }
