from complex.complex import Complex
from real import Real, sin, cos
from nat import Nat

// De Moivre's theorem: (cos x + i sin x)^n = cos(n x) + i sin(n x).
//
// The statement is faithful to the classical theorem, with the complex
// number `cos x + i sin x` built from the real sine and cosine power series
// and `Complex.i` the imaginary unit.  The proof by induction on `n` needs
// the trigonometric addition formulas
//     sin(x + y) = sin x cos y + cos x sin y,
//     cos(x + y) = cos x cos y - sin x sin y,
// and the boundary values sin 0 = 0, cos 0 = 1.  Those theorems live in the
// private `real.trig_identities` module of the `real` package and are not
// re-exported through the public `real` interface, so they cannot be cited
// from outside the package; the statement is therefore left commented out
// until the `real` interface exports them.
//
// theorem theorems1000_de_moivre(n: Nat, x: Real) {
//     Complex.new(cos(x), sin(x)).pow(n) =
//         Complex.new(cos(Real.from_nat(n) * x), sin(Real.from_nat(n) * x))
// }
