            r2_norm_sq(r2_smul((Real.1 + Real.1) * (Real.1 + Real.1 + Real.1), r2_sub(n2, n3)))
        r2_norm_sq_double(r2_smul((Real.1 + Real.1) * (Real.1 + Real.1 + Real.1), r2_sub(n1, n2)))
        r2_norm_sq(r2_add(
