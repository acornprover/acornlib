            r2_add(
                r2_add(
                    r2_smul((Real.1 + Real.1 + Real.1), r2_add(r2_sub(a, b), r2_sub(b, c))),
                    r2_smul(s, r2_rot90(r2_sub(r2_sub(a, b), r2_sub(b, c))))),
                r2_add(
                    r2_smul((Real.1 + Real.1 + Real.1), r2_add(r2_sub(a, b), r2_sub(b, c))),
                    r2_smul(s, r2_rot90(r2_sub(r2_sub(a, b), r2_sub(b, c))))))
        r2_add(
            r2_smul((Real.1 + Real.1) * (Real.1 + Real.1 + Real.1), r2_sub(n1, n2)),
            r2_smul((Real.1 + Real.1) * (Real.1 + Real.1 + Real.1), r2_sub(n1, n2))) =
