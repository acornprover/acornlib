        (Real.1 + Real.1) * r2_norm_sq(r2_smul((Real.1 + Real.1) * (Real.1 + Real.1 + Real.1), r2_sub(n2, n3))) +
            (Real.1 + Real.1) * r2_norm_sq(r2_smul((Real.1 + Real.1) * (Real.1 + Real.1 + Real.1), r2_sub(n2, n3))) =
