            napoleon_c(s, r2_sub(b, c), r2_neg(r2_add(r2_sub(a, b), r2_sub(b, c))))
        napoleon_pair2(a, b, c)
        r2_neg(r2_add(
            r2_sub(b, c),
            r2_neg(r2_add(r2_sub(a, b), r2_sub(b, c))))) = r2_sub(a, b)
        r2_add(
            r2_neg(r2_add(r2_sub(b, c), r2_neg(r2_add(r2_sub(a, b), r2_sub(b, c))))),
