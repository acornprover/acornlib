        r2_sub(
            r2_neg(r2_add(r2_sub(b, c), r2_neg(r2_add(r2_sub(a, b), r2_sub(b, c))))),
            r2_sub(b, c)) =
            r2_sub(r2_sub(a, b), r2_sub(b, c))
        r2_add(
