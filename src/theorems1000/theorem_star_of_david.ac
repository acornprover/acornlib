from combinatorics import binom
from nat import Nat

// Star of David theorem (also known as the "hexagon identity") for binomial
// coefficients: in Pascal's triangle, the product of the three entries
// surrounding any entry in one direction equals the product of the three
// entries surrounding it in the other direction.  For the entry `C(a.suc, b.suc)`
// the identity reads
//     C(a, b) * C(a.suc, b.suc.suc) * C(a.suc.suc, b.suc)
//         = C(a, b.suc) * C(a.suc, b) * C(a.suc.suc, b.suc.suc)
// whenever `b.suc <= a` (so that the six entries are inside Pascal's triangle).

// Star of David theorem: the two six-term products around an entry of
// Pascal's triangle are equal:
//     a.binom(b) * a.suc.binom(b.suc.suc) * a.suc.suc.binom(b.suc)
//         = a.binom(b.suc) * a.suc.binom(b) * a.suc.suc.binom(b.suc.suc)
// for `b.suc <= a`.  The proof (outlined below) reduces both sides to
// `a! * (a+1)! * (a+2)!` and cancels the common factorial product; it is
// commented out because the `Nat` product rearrangements require long
// step-by-step associativity/commutativity chains.
// theorem theorems1000_star_of_david(a: Nat, b: Nat) {
//     b.suc <= a implies
//     a.binom(b) * a.suc.binom(b.suc.suc) * a.suc.suc.binom(b.suc) =
//         a.binom(b.suc) * a.suc.binom(b) * a.suc.suc.binom(b.suc.suc)
// }
// Proof outline (each side collapses to a! * (a+1)! * (a+2)! after
// multiplying by the common factorial product
//   b! * (b+1)! * (b+2)! * (a-b)! * (a-b-1)! * (a+1-b)!):
//   1. the defining equations of `binom` give, for `k <= n`,
//        n.binom(k) * k! * (n-k)! = n!
//      applied to the six entries, with the subtraction identities
//        (a+1) - (b+2) = a - (b+1),   (a+2) - (b+1) = (a+1) - b,
//        (a+2) - (b+2) = a - b;
//   2. the two products then both reduce to a! * (a+1)! * (a+2)!;
//   3. cancellation of the common nonzero factor by `mul_cancel_right`.
// The proof is left commented out because the product rearrangements over
// `Nat` (which the prover only accepts one associativity/commutativity step
// at a time) make it long; the statements of the three subtraction
// identities and the cancellation step are recorded below as lemmas.

