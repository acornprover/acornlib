from geometry import Point2, point2_law_of_cosines_dist_sq
from real import Real

/// Freek Top 100 #94: the law of cosines in the real coordinate plane.
theorem top100_094_law_of_cosines(a: Point2[Real], b: Point2[Real], c: Point2[Real]) {
    b.dist_sq(c) =
        a.dist_sq(b) + a.dist_sq(c) -
        b.sub(a).dot(c.sub(a)) - b.sub(a).dot(c.sub(a))
} by {
    point2_law_of_cosines_dist_sq(a, b, c)
}
