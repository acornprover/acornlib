    Nat.1 < Nat.2
    p(Nat.1) < p(Nat.2)
}

/// p(3) > p(2): the partition function grows from two to three.
theorem p_grows_two_three {
    p(Nat.2) < p(Nat.3)
} by {
    p_two
    p(Nat.2) = Nat.2
    p_three
    p(Nat.3) = Nat.3
    lt_suc(Nat.2)
