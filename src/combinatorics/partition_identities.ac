/// p(2) > p(1): the partition function grows from one to two.
theorem p_grows_one_two {
    p(Nat.1) < p(Nat.2)
} by {
    p_one
    p(Nat.1) = Nat.1
    p_two
    p(Nat.2) = Nat.2
