                                a + Nat.2 <= a + (b + (c + sum(t3)))
                                a + (b + (c + sum(t3))) = Nat.2
                                a + Nat.2 <= Nat.2
                                add_comm(Nat.2, a)
                                Nat.2 + a = a + Nat.2
                                lte_add_left(Nat.2, Nat.0, a)
                                Nat.0 <= a implies Nat.2 + Nat.0 <= Nat.2 + a
                                zero_lte(a)
                                Nat.0 <= a
