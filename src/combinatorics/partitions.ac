            is_partition_intro(List.cons(Nat.1, List.cons(Nat.1, List.nil[Nat])), Nat.2)
            is_partition(List.cons(Nat.1, List.cons(Nat.1, List.nil[Nat])), Nat.2)
            is_partition(l, Nat.2)
