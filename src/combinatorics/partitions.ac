            List.cons(a, t) {
                match t {
                    List.nil {
                        sum(List.cons(a, List.nil[Nat])) = a + sum(List.nil[Nat])
                        sum(List.nil[Nat]) = Nat.0
                        a + Nat.0 = a
                        sum(List.cons(a, List.nil[Nat])) = a
