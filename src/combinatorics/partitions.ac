                        Nat.1 + c = Nat.3
                        add_cancels_left(Nat.1, c, Nat.2)
                        c = Nat.2
                        c <= b
                        Nat.2 <= Nat.1
                        false
                    }
                    if b = Nat.0 {
                        Nat.1 <= b
                        Nat.1 <= Nat.0
                        false
                    }
                    false
                }
                if not b < Nat.2 {
                    lte_imp_not_lt(b, Nat.2)
                    b <= Nat.2 implies not Nat.2 < b
                    lte_add_left(b, Nat.1, c)
                    Nat.1 <= c implies b + Nat.1 <= b + c
                    b + Nat.1 <= b + c
                    add_one_right(b)
                    b + Nat.1 = b.suc
                    b.suc <= b + c
                    b.suc <= Nat.3
                    lte_cancel_suc(b, Nat.2)
                    b.suc <= Nat.2.suc implies b <= Nat.2
                    b <= Nat.2
                    lte_antisymm(b, Nat.2)
                    b = Nat.2
                    Nat.2 + c = Nat.3
                    add_cancels_left(Nat.2, c, Nat.1)
                    c = Nat.1
                    c <= b
                    Nat.1 <= Nat.2
                    b <= a
                    Nat.2 <= Nat.1
                    false
                }
                false
            }
            if a = Nat.0 {
                Nat.1 <= a
                Nat.1 <= Nat.0
                false
            }
            false
        }
        if not a < Nat.2 {
            lte_imp_not_lt(a, Nat.2)
            a <= Nat.2 implies not Nat.2 < a
            a + (b + c) = Nat.4
