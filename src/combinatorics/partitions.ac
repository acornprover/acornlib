                                lte_cancel_suc(a, Nat.1)
                                a.suc <= Nat.1.suc implies a <= Nat.1
                                a <= Nat.1
                                lte_antisymm(a, Nat.1)
                                Nat.1 <= a and a <= Nat.1
                                a = Nat.1
