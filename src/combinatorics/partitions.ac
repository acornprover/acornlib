                        List.cons(p4_b, List.cons(p4_c, List.cons(p4_d, List.cons(p4_e, List.nil[List[Nat]])))).contains(p4_d)
                        List.cons(p4_a, List.cons(p4_b, List.cons(p4_c, List.cons(p4_d, List.cons(p4_e, List.nil[List[Nat]]))))).contains(p4_d)
