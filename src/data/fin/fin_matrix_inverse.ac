    matrix_entry[F](Nat.0.suc.suc, Nat.0.suc.suc, square_matrix_mul[F](Nat.0.suc.suc, matrix2_adjugate[F](Nat.0, a), a), fin_zero(Nat.0.suc), fin_succ(Nat.0.suc, fin_zero(Nat.0))) =
