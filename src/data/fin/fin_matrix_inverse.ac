theorem matrix2_mul_entry[F: Ring](a: Matrix[F, Nat.0.suc.suc, Nat.0.suc.suc], b: Matrix[F, Nat.0.suc.suc, Nat.0.suc.suc], i: Fin[Nat.0.suc.suc], j: Fin[Nat.0.suc.suc]) {
