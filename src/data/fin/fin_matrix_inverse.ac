/// The upper-right entry of the product of two two-by-two matrices.
theorem matrix2_mul_entry_01[F: Ring](a: Matrix[F, Nat.0.suc.suc, Nat.0.suc.suc], b: Matrix[F, Nat.0.suc.suc, Nat.0.suc.suc]) {
