    matrix2_entry_11[F](Nat.0, a) * (-matrix2_entry_10[F](Nat.0, a)) =
        -(matrix2_entry_11[F](Nat.0, a) * matrix2_entry_10[F](Nat.0, a))
    matrix2_entry_11[F](Nat.0, a) * matrix2_entry_10[F](Nat.0, a) =
