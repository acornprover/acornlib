theorem remove_cardinality_is_of_not_contains[K](s: Set[K], item: K, n: Nat) {
    s.cardinality_is(n) and not s.contains(item) implies s.remove(item).cardinality_is(n)
}

theorem remove_cardinality_is_pred_of_contains[K](s: Set[K], item: K, n: Nat) {
    s.cardinality_is(n + Nat.1) and s.contains(item) implies s.remove(item).cardinality_is(n)
}

theorem remove_contains_eq[K](s: Set[K], item: K, x: K) {
    s.remove(item).contains(x) = (s.contains(x) and x != item)
}

theorem remove_does_not_contain[K](s: Set[K], item: K) {
    not s.remove(item).contains(item)
}

theorem remove_insert_cardinality_is_suc_of_contains[K](s: Set[K], item: K, n: Nat) {
    s.remove(item).cardinality_is(n) and s.contains(item) implies s.cardinality_is(n + Nat.1)
}

theorem remove_is_finite_of_finite[T](s: Set[T], item: T) {
    s.is_finite implies s.remove(item).is_finite
}

theorem remove_other_contains_eq[K](s: Set[K], item: K, other: K) {
    item != other implies s.contains(item) = s.remove(other).contains(item)
}

theorem remove_then_insert[K](s: Set[K], item: K) {
    s.contains(item) implies s.remove(item).insert(item) = s
}

theorem residue_class_density(m: Nat, a: Nat) {
    a < m implies from_nat[Real](m) * lower_density(in_residue_class(m, a)) = Real.1
        and from_nat[Real](m) * upper_density(in_residue_class(m, a)) = Real.1
}

numerals Nat
theorem residue_class_in_block(m: Nat, a: Nat, q: Nat, i: Nat) {
    a < m and i < m implies (in_residue_class(m, a)(q * m + i) = (i = a))
}

theorem residue_density_seq_lower(m: Nat, a: Nat, eps: Real, n: Nat) {
    a < m and eps > Real.0 and from_nat[Real](m) <= eps * range_size(n)
        implies Real.1 - eps
            <= from_nat[Real](m) * density_seq(in_residue_class(m, a), n)
}

theorem residue_density_seq_upper(m: Nat, a: Nat, eps: Real, n: Nat) {
    a < m and eps > Real.0 and from_nat[Real](m) <= eps * range_size(n)
        implies from_nat[Real](m) * density_seq(in_residue_class(m, a), n)
            <= Real.1 + eps
}

theorem residue_lower_density_ge_one(m: Nat, a: Nat) {
    a < m implies Real.1 <= from_nat[Real](m) * lower_density(in_residue_class(m, a))
}

theorem residue_range_long_enough(m: Nat, eps: Real, big_m: Nat, n: Nat) {
    eps > Real.0 and from_nat[Real](m) < eps * from_nat[Real](big_m) and big_m <= n
        implies from_nat[Real](m) <= eps * range_size(n)
}

numerals Nat
define residue_summand[A: AddCommMonoid](m: Nat, a: Nat, f: Nat -> A, i: Nat) -> A {
    if i.mod(m) = a {
        f(i)
    } else {
        A.0
    }
}

theorem residue_upper_density_le_one(m: Nat, a: Nat) {
    a < m implies from_nat[Real](m) * upper_density(in_residue_class(m, a)) <= Real.1
}

theorem respects_add_eq_respects_binary_op[T: Add](r: (T, T) -> Bool) {
    respects_add(r) = respects_binary_op(r, T.add)
}

theorem respects_binary_op_eq[T](r: (T, T) -> Bool, q: (T, T) -> Bool, op: (T, T) -> T, op2: (T, T) -> T) {
    r = q and op = op2 and respects_binary_op(r, op) implies respects_binary_op(q, op2)
}

theorem respects_binary_op_eq_op[T](r: (T, T) -> Bool, op: (T, T) -> T, op2: (T, T) -> T) {
    op = op2 and respects_binary_op(r, op) implies respects_binary_op(r, op2)
}

theorem respects_binary_op_eq_relation[T](r: (T, T) -> Bool, q: (T, T) -> Bool, op: (T, T) -> T) {
    r = q and respects_binary_op(r, op) implies respects_binary_op(q, op)
}

theorem respects_binary_op_step[T](r: (T, T) -> Bool, op: (T, T) -> T, x1: T, y1: T, x2: T, y2: T) {
    respects_binary_op(r, op) and r(x1, y1) and r(x2, y2) implies r(op(x1, x2), op(y1, y2))
}

theorem respects_equivalence_eq[T, U](
    f: T -> U,
    g: T -> U,
    r: (T, T) -> Bool,
    q: (T, T) -> Bool,
    s: (U, U) -> Bool,
    t: (U, U) -> Bool
) {
    f = g and r = q and s = t and respects_equivalence(f, r, s) implies respects_equivalence(g, q, t)
}

theorem respects_equivalence_eq_function[T, U](
    f: T -> U,
    g: T -> U,
    r: (T, T) -> Bool,
    s: (U, U) -> Bool
) {
    f = g and respects_equivalence(f, r, s) implies respects_equivalence(g, r, s)
}

theorem respects_equivalence_eq_source[T, U](
    f: T -> U,
    r: (T, T) -> Bool,
    q: (T, T) -> Bool,
    s: (U, U) -> Bool
) {
    r = q and respects_equivalence(f, r, s) implies respects_equivalence(f, q, s)
}

theorem respects_equivalence_eq_target[T, U](
    f: T -> U,
    r: (T, T) -> Bool,
    s: (U, U) -> Bool,
    q: (U, U) -> Bool
) {
    s = q and respects_equivalence(f, r, s) implies respects_equivalence(f, r, q)
}

define respects_function[T, U](r: (T, T) -> Bool, f: T -> U) -> Bool {
    forall(x: T, y: T) {
        r(x, y) implies f(x) = f(y)
    }
}

theorem respects_function_eq_function[T, U](r: (T, T) -> Bool, f: T -> U, g: T -> U) {
    f = g and respects_function(r, f) implies respects_function(r, g)
}

theorem respects_function_eq_relation[T, U](r: (T, T) -> Bool, q: (T, T) -> Bool, f: T -> U) {
    r = q and respects_function(r, f) implies respects_function(q, f)
}

theorem respects_mul_eq_respects_binary_op[T: Mul](r: (T, T) -> Bool) {
