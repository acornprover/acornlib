theorem fs_card_mono[T](s: FiniteSet[T], t: FiniteSet[T]) {
    s.subset_eq(t) implies fs_card(s) <= fs_card(t)
}

theorem fs_card_pos_of_contains[T](s: FiniteSet[T], x: T) {
    s.contains(x) implies Nat.1 <= fs_card(s)
