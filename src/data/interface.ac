theorem fs_card_positive_of_contains[T](s: FiniteSet[T], item: T) {
    s.contains(item) implies Nat.0 < fs_card(s)
}

theorem fs_card_product[T, U](a: FiniteSet[T], b: FiniteSet[U]) {
