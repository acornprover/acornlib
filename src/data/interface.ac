theorem fs_card_insert_of_not_contains[T](s: FiniteSet[T], item: T) {
    not s.contains(item) implies fs_card(fs_insert(s, item)) = fs_card(s) + Nat.1
}

theorem fs_card_le_of_at_most[T](s: FiniteSet[T], n: Nat) {
    s.cardinality_at_most(n) implies fs_card(s) <= n
}

theorem fs_card_le_of_covered_by_image[T, U](s: FiniteSet[U], t: FiniteSet[T], f: T -> U) {
    is_covered_by_image(s, t, f) implies fs_card(s) <= fs_card(t)
