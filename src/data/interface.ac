define finite_fiber_set_list[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) -> List[Set[T]] {
    map[U, Set[T]](values, function(value: U) { finite_fiber_set(source, f, value) })
}

define finite_fiber_partition[T, U](source: FiniteSet[T], f: T -> U) -> List[Set[T]] {
    finite_fiber_set_list(source, f, finite_fiber_partition_values(source, f))
}

define set_list_all_cardinality_is[K](items: List[Set[K]], n: Nat) -> Bool {
    forall(s: Set[K]) {
        items.contains(s) implies s.cardinality_is(n)
    }
}

numerals Nat
theorem finite_fiber_partition_cardinality_is[T, U](source: FiniteSet[T], f: T -> U, n: Nat) {
    set_list_all_cardinality_is[T](finite_fiber_partition(source, f), n)
    implies source.underlying_set.cardinality_is(n * finite_fiber_partition(source, f).length)
}

theorem finite_fiber_partition_cardinality_is_values[T, U](source: FiniteSet[T], f: T -> U,
    n: Nat) {
    (forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(n)
    }) implies source.underlying_set.cardinality_is(n * finite_fiber_partition_values(source, f).length)
}

theorem finite_fiber_partition_constant_fiber_cardinality_by_image[T, U](source: FiniteSet[T],
    f: T -> U, n: Nat, m: Nat) {
    (forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(n)
    }) and fs_image(source, f).cardinality_is(m)
    implies source.underlying_set.cardinality_is(n * m)
}

define set_list_union[K](items: List[Set[K]]) -> Set[K] {
    match items {
        List.nil {
            Set[K].empty_set
        }
        List.cons(head, tail) {
            head.union(set_list_union[K](tail))
        }
    }
}

define set_list_exactly_covers[K](items: List[Set[K]], whole: Set[K]) -> Bool {
    set_list_union[K](items) = whole
}

numerals Nat
theorem finite_fiber_partition_exactly_covers_source[T, U](source: FiniteSet[T], f: T -> U) {
    set_list_exactly_covers[T](finite_fiber_partition(source, f), source.underlying_set)
}

theorem finite_fiber_partition_image_cardinality_is_values_length[T, U](source: FiniteSet[T],
    f: T -> U) {
    fs_image(source, f).cardinality_is(finite_fiber_partition_values(source, f).length)
}

theorem finite_fiber_partition_injective_fibers_cardinality_one[T, U](source: FiniteSet[T],
    f: T -> U) {
    (forall(x: T, y: T) {
        source.contains(x) and source.contains(y) and f(x) = f(y) implies x = y
    }) implies forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(Nat.1)
    }
}

define set_list_pairwise_disjoint[K](items: List[Set[K]]) -> Bool {
    forall(a: Set[K], b: Set[K]) {
        items.contains(a) and items.contains(b) and a != b implies a.is_disjoint(b)
    }
}

define set_list_partition_of[K](items: List[Set[K]], whole: Set[K]) -> Bool {
    set_list_exactly_covers[K](items, whole) and items.is_unique and set_list_pairwise_disjoint[K](items)
}

numerals Nat
theorem finite_fiber_partition_is_partition[T, U](source: FiniteSet[T], f: T -> U) {
    set_list_partition_of[T](finite_fiber_partition(source, f), source.underlying_set)
}

theorem finite_fiber_partition_is_unique[T, U](source: FiniteSet[T], f: T -> U) {
    finite_fiber_partition(source, f).is_unique
}

theorem finite_fiber_partition_pairwise_disjoint[T, U](source: FiniteSet[T], f: T -> U) {
    set_list_pairwise_disjoint[T](finite_fiber_partition(source, f))
}

theorem finite_fiber_partition_singleton_fibers_cardinality_eq_image[T, U](source: FiniteSet[T],
    f: T -> U, m: Nat) {
    (forall(value: U) {
        finite_fiber_partition_values(source, f).contains(value) implies
        finite_fiber_set(source, f, value).cardinality_is(Nat.1)
    }) and fs_image(source, f).cardinality_is(m) implies source.cardinality_is(m)
}

theorem finite_fiber_partition_values_contains_image[T, U](source: FiniteSet[T], f: T -> U, x: T) {
    source.contains(x) implies finite_fiber_partition_values(source, f).contains(f(x))
}

theorem finite_fiber_partition_values_has_preimage[T, U](source: FiniteSet[T], f: T -> U, value: U) {
    finite_fiber_partition_values(source, f).contains(value) implies exists(x: T) {
        source.contains(x) and value = f(x)
    }
}

theorem finite_fiber_partition_values_spec[T, U](source: FiniteSet[T], f: T -> U) {
    fs_from_list(finite_fiber_partition_values(source, f)) = fs_image(source, f) and
    finite_fiber_partition_values(source, f).is_unique
}

theorem finite_fiber_set_contains_eq[T, U](source: FiniteSet[T], f: T -> U, value: U, x: T) {
    finite_fiber_set(source, f, value).contains(x) = (source.contains(x) and f(x) = value)
}

theorem finite_fiber_set_contains_of_source[T, U](source: FiniteSet[T], f: T -> U, x: T) {
    source.contains(x) implies finite_fiber_set(source, f, f(x)).contains(x)
}

theorem finite_fiber_set_list_exactly_covers_source[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) {
    (forall(x: T) { source.contains(x) implies values.contains(f(x)) }) implies
    set_list_exactly_covers[T](finite_fiber_set_list(source, f, values), source.underlying_set)
}

theorem finite_fiber_set_list_pairwise_disjoint[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) {
    set_list_pairwise_disjoint[T](finite_fiber_set_list(source, f, values))
}

theorem finite_fiber_set_list_source_subset_union[T, U](source: FiniteSet[T], f: T -> U, values: List[U]) {
    (forall(x: T) { source.contains(x) implies values.contains(f(x)) }) implies
    source.underlying_set.subset(set_list_union[T](finite_fiber_set_list(source, f, values)))
}

theorem finite_list_pigeonhole_into_shorter_list[T, U](items: List[T], targets: List[U], f: T -> U) {
    items.is_unique and items.length > targets.length and
    forall(x: T) {
        items.contains(x) implies targets.contains(f(x))
    } implies exists(x: T, y: T) {
        items.contains(x) and items.contains(y) and x != y and f(x) = f(y)
    }
}

theorem finite_set_cardinality_is_le_of_at_most[T](s: FiniteSet[T], m: Nat, n: Nat) {
    s.cardinality_at_most(n) and s.cardinality_is(m) implies m <= n
}

define is_empty_or_inhabited[T](s: FiniteSet[T]) -> Bool {
    s = FiniteSet.empty[T] or exists(x: T) { s.contains(x) }
}

theorem finite_set_empty_or_inhabited[T](s: FiniteSet[T]) {
    is_empty_or_inhabited(s)
}

theorem finite_set_eq_of_contains_eq[T](a: FiniteSet[T], b: FiniteSet[T]) {
    (forall(x: T) { a.contains(x) = b.contains(x) }) implies a = b
}

let finite_set_filter[T](s: FiniteSet[T], p: T -> Bool) -> result: FiniteSet[T] satisfy {
    FiniteSet.new(s.underlying_set.intersection(Set[T].new(p))) = Option.some(result)
}

theorem finite_set_filter_contains_eq[T](s: FiniteSet[T], p: T -> Bool, x: T) {
    finite_set_filter(s, p).contains(x) = (s.contains(x) and p(x))
}

theorem finite_set_filter_mono_pred[T](s: FiniteSet[T], p: T -> Bool, q: T -> Bool) {
    (forall(x: T) { p(x) implies q(x) }) implies
    finite_set_filter(s, p).subset_eq(finite_set_filter(s, q))
}

theorem finite_set_filter_subset[T](s: FiniteSet[T], p: T -> Bool) {
    finite_set_filter(s, p).subset_eq(s)
}

theorem finite_set_filter_underlying_set[T](s: FiniteSet[T], p: T -> Bool) {
    finite_set_filter(s, p).underlying_set = s.underlying_set.intersection(Set[T].new(p))
}

numerals Nat
theorem finite_set_has_member_of_ne_empty[T](s: FiniteSet[T]) {
    s != FiniteSet.empty[T] implies exists(x: T) { s.contains(x) }
}

let fs_card[T](s: FiniteSet[T]) -> result: Nat satisfy {
    s.cardinality_is(result)
}

theorem finite_set_has_member_of_positive_card[T](s: FiniteSet[T]) {
    Nat.0 < fs_card(s) implies exists(x: T) { s.contains(x) }
}

theorem finite_set_has_unique_list[T](s: FiniteSet[T]) {
    exists(items: List[T]) {
        fs_from_list(items) = s and items.is_unique
    }
}

theorem finite_set_induction[T](p: FiniteSet[T] -> Bool) {
    p(FiniteSet.empty[T]) and (forall(s: FiniteSet[T], item: T) {
        p(s) implies p(fs_insert(s, item))
    }) implies forall(s: FiniteSet[T]) { p(s) }
}

theorem finite_set_induction_apply[T](p: FiniteSet[T] -> Bool, s: FiniteSet[T]) {
    p(FiniteSet.empty[T]) and (forall(t: FiniteSet[T], item: T) {
        p(t) implies p(fs_insert(t, item))
    }) implies p(s)
}

theorem finite_set_list_rep_property[T](p: FiniteSet[T] -> Bool, items: List[T]) {
    p(FiniteSet.empty[T]) and (forall(s: FiniteSet[T], item: T) {
        p(s) implies p(fs_insert(s, item))
    }) implies p(fs_from_list(items))
}

define pair_set_contains[T, U](left: Set[T], right: Set[U], p: Pair[T, U]) -> Bool {
    left.contains(p.first) and right.contains(p.second)
}

define pair_set[T, U](left: Set[T], right: Set[U]) -> Set[Pair[T, U]] {
    Set[Pair[T, U]].new(pair_set_contains(left, right))
}

let finite_set_product[T, U](a: FiniteSet[T], b: FiniteSet[U]) -> result: FiniteSet[Pair[T, U]] satisfy {
    FiniteSet.new(pair_set(a.underlying_set, b.underlying_set)) = Option.some(result)
}

theorem finite_set_product_cardinality_is[T, U](a: FiniteSet[T], b: FiniteSet[U],
    n_left: Nat, n_right: Nat) {
    a.cardinality_is(n_left) and b.cardinality_is(n_right) implies
    finite_set_product(a, b).cardinality_is(n_right * n_left)
}

theorem finite_set_product_contains_eq[T, U](a: FiniteSet[T], b: FiniteSet[U], p: Pair[T, U]) {
    finite_set_product(a, b).contains(p) = (a.contains(p.first) and b.contains(p.second))
}

theorem finite_set_product_contains_pair[T, U](a: FiniteSet[T], b: FiniteSet[U], x: T, y: U) {
    a.contains(x) and b.contains(y) implies finite_set_product(a, b).contains(Pair.new(x, y))
}

theorem finite_set_product_empty_left[T, U](b: FiniteSet[U]) {
    finite_set_product(fs_empty[T](Set[T].empty_set), b) =
    fs_empty[Pair[T, U]](Set[Pair[T, U]].empty_set)
}

numerals Nat
define pair_with_left[T, U](x: T, y: U) -> Pair[T, U] {
    Pair.new(x, y)
}

define pair_with_left_fn[T, U](x: T) -> U -> Pair[T, U] {
    function(y: U) { pair_with_left(x, y) }
}

define list_pair_with_left[T, U](x: T, right: List[U]) -> List[Pair[T, U]] {
    map[U, Pair[T, U]](right, pair_with_left_fn(x))
}

define list_pair_product[T, U](left: List[T], right: List[U]) -> List[Pair[T, U]] {
    match left {
        List.nil {
            List.nil[Pair[T, U]]
        }
        List.cons(head, tail) {
            list_pair_with_left(head, right) + list_pair_product(tail, right)
        }
    }
}

theorem finite_set_product_from_list_contains_imp_list_pair_product_contains[T, U](left: List[T],
    right: List[U], p: Pair[T, U]) {
    finite_set_product(fs_from_list(left), fs_from_list(right)).contains(p) implies
    list_pair_product(left, right).contains(p)
}

theorem finite_set_product_from_list_eq[T, U](left: List[T], right: List[U]) {
    finite_set_product(fs_from_list(left), fs_from_list(right)) =
    fs_from_list(list_pair_product(left, right))
}

theorem finite_set_product_fs_from_list_contains_eq[T](items: List[T], x: T) {
    fs_from_list(items).contains(x) = items.contains(x)
}

define finite_set_product_row_fn[T, U, A](f: Pair[T, U] -> A, x: T) -> (U -> A) {
    function(y: U) { f(Pair.new(x, y)) }
}

theorem finite_set_product_underlying_set[T, U](a: FiniteSet[T], b: FiniteSet[U]) {
    finite_set_product(a, b).underlying_set = pair_set(a.underlying_set, b.underlying_set)
}

numerals Nat
theorem finite_set_strong_induction[T](p: FiniteSet[T] -> Bool, s: FiniteSet[T]) {
    p(FiniteSet.empty[T]) and (forall(t: FiniteSet[T], item: T) {
        p(t) and not t.contains(item) implies p(fs_insert(t, item))
    }) implies p(s)
}

theorem finite_set_subset_cardinality_at_most[T](s: FiniteSet[T], t: FiniteSet[T], n: Nat) {
    s.subset_eq(t) and t.cardinality_is(n) implies s.cardinality_at_most(n)
}

theorem finite_set_subset_eq_of_same_cardinality[T](s: FiniteSet[T], t: FiniteSet[T], n: Nat) {
    s.subset_eq(t) and s.cardinality_is(n) and t.cardinality_is(n) implies s = t
}

theorem finite_set_sum_eq_of_finite_set_eq[T, A: AddCommMonoid](s: FiniteSet[T], t: FiniteSet[T],
    f: T -> A) {
    s = t implies finite_set_sum(s, f) = finite_set_sum(t, f)
}

theorem finite_set_sum_eq_of_function_eq[T, A: AddCommMonoid](s: FiniteSet[T],
    f: T -> A, g: T -> A) {
    f = g implies finite_set_sum(s, f) = finite_set_sum(s, g)
}

theorem finite_set_sum_eq_of_pointwise_on_set[T, A: AddCommMonoid](
    s: FiniteSet[T], f: T -> A, g: T -> A
) {
    (forall(x: T) { s.contains(x) implies f(x) = g(x) }) implies
        finite_set_sum(s, f) = finite_set_sum(s, g)
}

numerals Nat
define pointwise_le[T](f: T -> Real, g: T -> Real) -> Bool {
    forall(t: T) { f(t) <= g(t) }
}

theorem finite_set_sum_le[T](s: FiniteSet[T], f: T -> Real, g: T -> Real) {
    pointwise_le(f, g) implies finite_set_sum(s, f) <= finite_set_sum(s, g)
}

theorem finite_set_sum_nonneg[T](s: FiniteSet[T], f: T -> Real) {
    (forall(item: T) { Real.0 <= f(item) }) implies Real.0 <= finite_set_sum(s, f)
}

theorem finite_set_sum_product_from_lists_eq_list_pair_product_sum[T, U, A: AddCommMonoid](
    left: List[T], right: List[U], f: Pair[T, U] -> A
) {
    left.is_unique and right.is_unique implies
    finite_set_sum(finite_set_product(fs_from_list(left), fs_from_list(right)), f) =
    sum[A](map(list_pair_product(left, right), f))
}

theorem finite_set_sum_product_fubini_rows[T, U, A: AddCommMonoid](
    a: FiniteSet[T], b: FiniteSet[U], f: Pair[T, U] -> A
) {
    finite_set_sum(finite_set_product(a, b), f) =
        finite_set_sum(a, function(x: T) { finite_set_sum(b, function(y: U) { f(Pair.new(x, y)) }) })
}

numerals Nat
theorem finite_set_unique_list_property[T](p: FiniteSet[T] -> Bool, items: List[T]) {
    p(FiniteSet.empty[T]) and (forall(s: FiniteSet[T], item: T) {
        p(s) and not s.contains(item) implies p(fs_insert(s, item))
    }) and items.is_unique implies p(fs_from_list(items))
