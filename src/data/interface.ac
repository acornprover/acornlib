    Nat.1 <= n and square_divisor_pred(n)(d) implies d <= n
}

theorem square_divisor_pred_one(n: Nat) {
    square_divisor_pred(n)(Nat.1)
}

theorem square_divisor_pred_upper_bound(n: Nat) {
    Nat.1 <= n implies is_upper_bound_of(square_divisor_pred(n), n)
}

theorem square_matrix_mul_add_left[S: Semiring](n: Nat, a: Matrix[S, n, n], b: Matrix[S, n, n], c: Matrix[S, n, n]) {
    square_matrix_mul[S](n, a + b, c) = square_matrix_mul[S](n, a, c) + square_matrix_mul[S](n, b, c)
}

theorem square_matrix_mul_add_right[S: Semiring](n: Nat, a: Matrix[S, n, n], b: Matrix[S, n, n], c: Matrix[S, n, n]) {
    square_matrix_mul[S](n, a, b + c) = square_matrix_mul[S](n, a, b) + square_matrix_mul[S](n, a, c)
}

theorem square_matrix_mul_one_left[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    square_matrix_mul[S](n, matrix_one[S](n), a) = a
}

theorem square_matrix_mul_one_right[S: Semiring](n: Nat, a: Matrix[S, n, n]) {
    square_matrix_mul[S](n, a, matrix_one[S](n)) = a
}

numerals Nat
let square_part(n: Nat) -> result: Nat satisfy {
    Nat.1 <= n implies is_max(square_divisor_pred(n), result)
}

theorem squarefree_of_divides(n: Nat, m: Nat) {
    is_squarefree(n) and m.divides(n) implies is_squarefree(m)
}

theorem squarefree_of_no_prime_square_divides(n: Nat) {
    no_prime_square_divides(n) implies is_squarefree(n)
}

define squarefree_part(n: Nat) -> Nat {
    n.div(square_part(n) * square_part(n))
}

theorem sub_self_zero[R: CommRing](x: R) {
    x - x = R.0
}

theorem sub_sub_cancel(a: Nat, b: Nat, c: Nat) {
    b <= c and c <= a implies (a - b) - (c - b) = a - c
}

theorem subset_antisymm[K](a: Set[K], b: Set[K]) {
    a.subset(b) and b.subset(a) implies a = b
}

theorem subset_cardinality_at_most[K](a: Set[K], b: Set[K], n: Nat) {
    a.subset(b) and b.cardinality_at_most(n) implies a.cardinality_at_most(n)
}

theorem subset_contains[K](a: Set[K], b: Set[K], x: K) {
    a.subset(b) and a.contains(x) implies b.contains(x)
}

theorem subset_contains_eq[K](a: Set[K], b: Set[K]) {
    a.subset(b) = forall(x: K) {
        a.contains(x) implies b.contains(x)
    }
}

theorem subset_is_finite_of_finite[K](a: Set[K], b: Set[K]) {
    a.subset(b) and b.is_finite implies a.is_finite
}

theorem subset_of_countable_is_countable[T](s: Set[T], t: Set[T]) {
    s.subset(t) and is_countable[T](t) implies is_countable[T](s)
}

theorem subset_of_empty_is_countable[T](s: Set[T]) {
    s.subset(Set[T].empty_set) implies is_countable[T](s)
}

theorem subset_of_nonempty_countable_is_countable[T](s: Set[T], t: Set[T]) {
    s.subset(t) and is_countable[T](t) and t != Set[T].empty_set implies is_countable[T](s)
}

theorem subset_of_sequence_covered_is_countable[T](s: Set[T], t: Set[T], f: Nat -> T) {
    s.subset(t) and forall(x: T) {
        t.contains(x) implies exists(n: Nat) { f(n) = x }
    } implies is_countable[T](s)
}

theorem subset_refl[K](s: Set[K]) {
    s.subset(s)
}

theorem subset_set_preimage_image[T, U](s: Set[T], f: T -> U) {
    s.subset(set_preimage(f, set_image(s, f)))
}

theorem subset_trans[K](a: Set[K], b: Set[K], c: Set[K]) {
    a.subset(b) and b.subset(c) implies a.subset(c)
}

numerals Nat
theorem suc_mod_cases(v: Nat, n: Nat, w: Nat) {
    v < n and v.suc.mod(n) = w implies
        (w = v.suc or (v.suc = n and w = Nat.0))
}

theorem sum_filter_indicator_value[T](items: List[T], c: Nat, pred: T -> Bool) {
    sum(map(items, filter_indicator_value(c, pred))) = c * items.filter(pred).length
}

theorem sum_map_add_split[T, A: AddCommMonoid](left: List[T], right: List[T], f: T -> A) {
    sum(map(left + right, f)) = sum(map(left, f)) + sum(map(right, f))
}

theorem sum_map_drop_length[T, A: AddCommMonoid](items: List[T], f: T -> A) {
    sum(map(items.drop(items.length), f)) = A.0
}

theorem sum_map_drop_range_length[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    sum(map(n.range.drop(n), f)) = A.0
}

theorem sum_map_take_drop[T, A: AddCommMonoid](items: List[T], n: Nat, f: T -> A) {
    sum(map(items, f)) = sum(map(list_take(items, n), f)) + sum(map(items.drop(n), f))
}

theorem sum_map_take_length[T, A: AddCommMonoid](items: List[T], f: T -> A) {
    sum(map(list_take(items, items.length), f)) = sum(map(items, f))
}

theorem sum_map_take_range_length[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    sum(map(list_take(n.range, n), f)) = partial(f, n)
}

theorem sum_map_zero_fn[T, A: AddCommMonoid](items: List[T], f: T -> A) {
    (forall(item: T) { f(item) = A.0 }) implies sum[A](map[T, A](items, f)) = A.0
}

define sum_set_contains[T, U](left: Set[T], right: Set[U], s: Sum[T, U]) -> Bool {
    match s {
        Sum.inl(x) {
            left.contains(x)
        }
        Sum.inr(y) {
            right.contains(y)
        }
    }
}

define sum_set[T, U](left: Set[T], right: Set[U]) -> Set[Sum[T, U]] {
    Set[Sum[T, U]].new(sum_set_contains(left, right))
}

theorem surjective_fn_has_preimage[T, U](f: T -> U, y: U) {
    is_surjective_fn(f) implies exists(x: T) {
        f(x) = y
    }
}

theorem symmetric_flip[T](f: (T, T) -> Bool, x: T, y: T) {
    is_symmetric(f) and f(x, y) implies f(y, x)
}

theorem symmetric_imp_relation_converse_eq[T](r: (T, T) -> Bool) {
    is_symmetric(r) implies relation_converse(r) = r
}

theorem symmetric_relation_converse_eq_at[T](r: (T, T) -> Bool, x: T, y: T) {
    is_symmetric(r) implies relation_converse(r, x, y) = r(x, y)
}

numerals Nat
theorem system_density_real_cons(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_density_real(List.cons(head, tail))
        = Real.1 / from_nat[Real](head.first) + system_density_real(tail)
}

theorem system_density_real_le_lower_density(system: List[Pair[Nat, Nat]]) {
    system_reduced(system) and system_disjoint_nat(system)
        implies system_density_real(system) <= lower_density(covers_nat(system))
}

theorem system_density_real_nil {
    system_density_real(List.nil[Pair[Nat, Nat]]) = Real.0
}

theorem system_disjoint_nat_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies head_disjoint_nat(head, tail)
}

theorem system_disjoint_nat_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_disjoint_nat(List.cons(head, tail)) implies system_disjoint_nat(tail)
}

theorem system_reduced_head(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies head.second < head.first
}

theorem system_reduced_tail(head: Pair[Nat, Nat], tail: List[Pair[Nat, Nat]]) {
    system_reduced(List.cons(head, tail)) implies system_reduced(tail)
}

theorem tail_inf_mono(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_below(a) and is_bounded_below(b)
        and (forall(k: Nat) { a(k) <= b(k) })
        implies tail_inf(a, n) <= tail_inf(b, n)
}

theorem tail_sup_mono(a: Nat -> Real, b: Nat -> Real, n: Nat) {
    is_bounded_above(a) and is_bounded_above(b)
        and (forall(k: Nat) { a(k) <= b(k) })
        implies tail_sup(a, n) <= tail_sup(b, n)
}

theorem transitive_step[T](f: (T, T) -> Bool, x: T, y: T, z: T) {
    is_transitive(f) and f(x, y) and f(y, z) implies f(x, z)
}

numerals Nat
define tri_diag_sum[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) -> A {
    range_sum(diag_sum(h), k.suc)
}

define tri_row_sum[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) -> A {
    range_sum(row_upto_sum(h, k), k.suc)
}

theorem tri_sum_eq[A: AddCommMonoid](h: Nat -> (Nat -> A), k: Nat) {
    tri_diag_sum(h, k) = tri_row_sum(h, k)
}

theorem two_pow_odd(m: Nat) {
    Nat.2.pow(m + m.suc) = Nat.2 * Nat.4.pow(m)
}

theorem two_pow_positive(i: Nat) {
    Nat.0 < two_pow(i)
}

theorem two_pow_suc(i: Nat) {
    two_pow(i.suc) = two_pow(i) + two_pow(i)
}

theorem two_pow_zero {
    two_pow(Nat.0) = Nat.1
}

theorem two_sided_inverse_fn_imp_bijection_fn[T, U](f: T -> U, g: U -> T) {
    is_two_sided_inverse_fn(f, g) implies is_bijection_fn(f)
}

theorem two_sided_inverse_fn_left_apply[T, U](f: T -> U, g: U -> T, x: T) {
    is_two_sided_inverse_fn(f, g) implies g(f(x)) = x
}

theorem two_sided_inverse_fn_right_apply[T, U](f: T -> U, g: U -> T, y: U) {
    is_two_sided_inverse_fn(f, g) implies f(g(y)) = y
}

theorem two_sided_inverse_fn_symm[T, U](f: T -> U, g: U -> T) {
    is_two_sided_inverse_fn(f, g) implies is_two_sided_inverse_fn(g, f)
}

theorem unary_congruence_eq[T](r: (T, T) -> Bool, q: (T, T) -> Bool, op: T -> T, op2: T -> T) {
    r = q and op = op2 and is_unary_congruence(r, op) implies is_unary_congruence(q, op2)
}

theorem unary_congruence_eq_op[T](r: (T, T) -> Bool, op: T -> T, op2: T -> T) {
    op = op2 and is_unary_congruence(r, op) implies is_unary_congruence(r, op2)
}

theorem unary_congruence_eq_relation[T](r: (T, T) -> Bool, q: (T, T) -> Bool, op: T -> T) {
    r = q and is_unary_congruence(r, op) implies is_unary_congruence(q, op)
}

define unary_op_pushforward[A: Inhabited, B](f: A -> B, op: A -> A, y: B) -> B {
    f(op(inverse_fn(f, y)))
}

theorem union_assoc[K](a: Set[K], b: Set[K], c: Set[K]) {
    a.union(b.union(c)) = a.union(b).union(c)
}

theorem union_cardinality_with_difference[K](s: Set[K], t: Set[K], n_s: Nat, n_diff: Nat) {
    s.cardinality_is(n_s) and t.difference(s).cardinality_is(n_diff) implies s.union(t).cardinality_is(n_s + n_diff)
}

theorem union_comm[K](a: Set[K], b: Set[K]) {
    a.union(b) = b.union(a)
}

theorem union_compl_is_universal[K](s: Set[K]) {
    s.union(s.c) = Set[K].universal_set
}

theorem union_contains_cases[K](a: Set[K], b: Set[K], x: K) {
    a.union(b).contains(x) implies a.contains(x) or b.contains(x)
}

theorem union_contains_eq[K](a: Set[K], b: Set[K], x: K) {
    a.union(b).contains(x) = (a.contains(x) or b.contains(x))
}

theorem union_contains_left[K](a: Set[K], b: Set[K], x: K) {
    a.contains(x) implies a.union(b).contains(x)
}

theorem union_contains_right[K](a: Set[K], b: Set[K], x: K) {
    b.contains(x) implies a.union(b).contains(x)
}

theorem union_idemp[K](s: Set[K]) {
    s.union(s) = s
}

theorem union_is_finite_of_finite[K](a: Set[K], b: Set[K]) {
    a.is_finite and b.is_finite implies (a.union(b)).is_finite
}

theorem union_of_countable_is_countable[T](s: Set[T], t: Set[T]) {
    is_countable[T](s) and is_countable[T](t) implies is_countable[T](s.union(t))
}

theorem union_with_difference_decomp_rev[K](s: Set[K], t: Set[K]) {
    s.union(t) = s.union(t.difference(s))
}

theorem union_with_empty_is_self[K](s: Set[K]) {
    s.union(Set[K].empty_set) = s
}

numerals Nat
theorem unique_cons_head_fresh[T](head: T, tail: List[T], item: T) {
    List.cons(head, tail).is_unique and tail.contains(item) implies head != item
}

theorem unique_cons_head_not_in_tail[T](head: T, tail: List[T]) {
    List.cons(head, tail).is_unique implies not tail.contains(head)
}

theorem unique_cons_parts[T](head: T, tail: List[T]) {
    List.cons(head, tail).is_unique implies tail.is_unique and not tail.contains(head)
}

theorem unique_list_set_cardinality_is_length[K](items: List[K]) {
    items.is_unique implies list_set(items).cardinality_is(items.length)
}

theorem unique_pairwise_implies_recursively_disjoint[K](items: List[Set[K]]) {
    items.is_unique and set_list_pairwise_disjoint[K](items)
    implies set_list_recursively_disjoint[K](items)
}

theorem universal_set_compl_is_empty[K] {
    (Set[K].universal_set).c = Set[K].empty_set
}

theorem universal_set_contains_eq[K](x: K) {
    (Set[K].universal_set).contains(x) = true
}

numerals Nat
theorem upper_density_covers_nat_le(system: List[Pair[Nat, Nat]]) {
    system_reduced(system)
        implies upper_density(covers_nat(system)) <= system_density_real(system)
}

theorem upper_density_le_one(p: Nat -> Bool) {
    upper_density(p) <= Real.1
}

numerals Nat
theorem upper_density_none {
    upper_density(none_pred) <= Real.0
}

theorem upper_density_residue_class(m: Nat, a: Nat) {
    a < m implies upper_density(in_residue_class(m, a)) = Real.1 / from_nat[Real](m)
}

theorem upper_density_subadditive(p: Nat -> Bool, r: Nat -> Bool) {
    upper_density(or_pred(p, r)) <= upper_density(p) + upper_density(r)
}

theorem value_lt_bound(n: Nat, x: Fin[n]) {
    x.value < n
}
