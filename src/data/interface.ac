define is_injective_fn[T, U](f: T -> U) -> Bool {
    forall(x: T, y: T) {
        f(x) = f(y) implies x = y
    }
}

define is_surjective_fn[T, U](f: T -> U) -> Bool {
    forall(y: U) {
        exists(x: T) {
            f(x) = y
        }
    }
}

define is_bijection_fn[T, U](f: T -> U) -> Bool {
    is_injective_fn(f) and is_surjective_fn(f)
}

structure Bijection[T, U] {
    /// The underlying map.
    map: T -> U
} constraint {
    is_bijection_fn(map)
}

structure Fin[n: Nat] {
    value: Nat
} constraint {
    value < n
}

typeclass I: Inhabited {
    /// A distinguished element of the type.
    default: I
}

structure Matrix[A, m: Nat, n: Nat] {
    /// The entry function of the matrix.
    entry: (Fin[m], Fin[n]) -> A
}

structure Set[K] {
    /// True if the element is in the set.
    contains: K -> Bool
}

define is_reflexive[T](f: (T, T) -> Bool) -> Bool {
    forall(t: T) {
        f(t, t)
    }
}

define is_symmetric[T](f: (T, T) -> Bool) -> Bool {
    forall(x: T, y: T) {
        f(x, y) implies f(y, x)
    }
}

define is_transitive[T](f: (T, T) -> Bool) -> Bool {
    forall(x: T, y: T, z: T) {
        f(x, y) and f(y, z) implies f(x, z)
    }
}

define is_equivalence[T](f: (T, T) -> Bool) -> Bool {
    is_reflexive(f) and is_symmetric(f) and is_transitive(f)
}

define equivalence_class_fun[T](r: (T, T) -> Bool, a: T, x: T) -> Bool {
    r(a, x)
}

define equivalence_class[T](r: (T, T) -> Bool, a: T) -> Set[T] {
    Set[T].new(equivalence_class_fun(r, a))
}

define is_equivalence_class[T](r: (T, T) -> Bool, c: Set[T]) -> Bool {
    exists(a: T) {
        c = equivalence_class(r, a)
    }
}

structure Quotient[T] {
    /// The equivalence relation whose classes form this quotient.
    rel: (T, T) -> Bool

    /// The equivalence class represented by this quotient element.
    carrier: Set[T]
} constraint {
    is_equivalence(rel) and is_equivalence_class(rel, carrier)
}

structure QuotientRelation[T] {
    /// The relation whose equivalence classes form quotient elements.
    rel: (T, T) -> Bool
} constraint {
    is_equivalence(rel)
}

structure QuotientOver[T] {
    /// The equivalence relation whose classes form this quotient element.
    qrel: QuotientRelation[T]

    /// The equivalence class represented by this quotient element.
    carrier: Set[T]
} constraint {
    is_equivalence_class(qrel.rel, carrier)
}


theorem abs_add_le(a: Real, b: Real) {
    (a + b).abs <= a.abs + b.abs
}

define abs_seq(f: Nat -> Real) -> (Nat -> Real) {
    function(k: Nat) {
        f(k).abs
    }
}

define respects_binary_op[T](r: (T, T) -> Bool, op: (T, T) -> T) -> Bool {
    forall(x1: T, y1: T, x2: T, y2: T) {
        r(x1, y1) and r(x2, y2) implies r(op(x1, x2), op(y1, y2))
    }
}

define is_binary_congruence[T](r: (T, T) -> Bool, op: (T, T) -> T) -> Bool {
    is_equivalence(r) and respects_binary_op(r, op)
}

define is_add_congruence[T: Add](r: (T, T) -> Bool) -> Bool {
    is_binary_congruence(r, T.add)
}

theorem add_congruence_eq_binary_congruence[T: Add](r: (T, T) -> Bool) {
    is_add_congruence(r) = is_binary_congruence(r, T.add)
}

theorem add_congruence_is_equivalence[T: Add](r: (T, T) -> Bool) {
    is_add_congruence(r) implies is_equivalence(r)
}

define respects_add[T: Add](r: (T, T) -> Bool) -> Bool {
    respects_binary_op(r, T.add)
}

theorem add_congruence_respects_add[T: Add](r: (T, T) -> Bool) {
    is_add_congruence(r) implies respects_add(r)
}

define kernel_relation[T, U](f: T -> U, x: T, y: T) -> Bool {
    f(x) = f(y)
}

theorem add_group_hom_kernel_is_add_congruence[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    is_add_congruence(kernel_relation(f.hom))
}

define respects_unary_op[T](r: (T, T) -> Bool, op: T -> T) -> Bool {
    forall(x: T, y: T) {
        r(x, y) implies r(op(x), op(y))
    }
}

define is_unary_congruence[T](r: (T, T) -> Bool, op: T -> T) -> Bool {
    is_equivalence(r) and respects_unary_op(r, op)
}

define is_add_group_congruence[A: AddGroup](r: (A, A) -> Bool) -> Bool {
    is_add_congruence(r) and is_unary_congruence(r, A.neg)
}

theorem add_group_hom_kernel_is_add_group_congruence[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    is_add_group_congruence(kernel_relation(f.hom))
}

let quotient_over_mk[T](qrel: QuotientRelation[T], a: T) -> result: QuotientOver[T] satisfy {
    QuotientOver[T].new(qrel, equivalence_class(qrel.rel, a)) = Option.some(result)
}

let quotient_over_lift_to_at[T, U](f: T -> U, q: QuotientOver[T]) -> result: U satisfy {
    exists(a: T) {
        quotient_over_mk(q.qrel, a) = q and result = f(a)
    }
}

define quotient_over_lift_to[T, U](f: T -> U) -> QuotientOver[T] -> U {
    function(q: QuotientOver[T]) {
        quotient_over_lift_to_at(f, q)
    }
}

define add_group_hom_kernel_quotient_induced[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) ->
    QuotientOver[A] -> B {
    quotient_over_lift_to(f.hom)
}

let kernel_quotient_relation[T, U](f: T -> U) -> result: QuotientRelation[T] satisfy {
    QuotientRelation[T].new(kernel_relation(f)) = Option.some(result)
}

define add_group_hom_kernel_quotient_project[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B], a: A) -> QuotientOver[A] {
    quotient_over_mk(kernel_quotient_relation(f.hom), a)
}

theorem add_group_hom_kernel_respects_add[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    respects_add(kernel_relation(f.hom))
}

theorem add_group_hom_kernel_respects_neg[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B]) {
    respects_unary_op(kernel_relation(f.hom), A.neg)
}

theorem add_group_hom_kernel_step[A: AddGroup, B: AddGroup](f: AddGroupHom[A, B], x1: A, y1: A, x2: A, y2: A) {
    kernel_relation(f.hom, x1, y1) and kernel_relation(f.hom, x2, y2)
    implies kernel_relation(f.hom, x1 + x2, y1 + y2)
}

numerals Nat
theorem add_mod_self(x: Nat, n: Nat) {
    n != Nat.0 implies (x + n).mod(n) = x.mod(n)
}

theorem add_monoid_hom_kernel_is_add_congruence[A: AddMonoid, B: AddMonoid](f: A -> B) {
    is_add_monoid_hom(f) implies is_add_congruence(kernel_relation(f))
}

define add_monoid_hom_kernel_quotient_induced[A: AddMonoid, B: AddMonoid](f: AddMonoidHom[A, B]) ->
    QuotientOver[A] -> B {
    quotient_over_lift_to(f.hom)
}

define add_monoid_hom_kernel_quotient_project[A: AddMonoid, B: AddMonoid](
    f: AddMonoidHom[A, B], a: A
) -> QuotientOver[A] {
    quotient_over_mk(kernel_quotient_relation(f.hom), a)
}

theorem add_monoid_hom_kernel_respects_add[A: AddMonoid, B: AddMonoid](f: A -> B) {
    is_add_monoid_hom(f) implies respects_add(kernel_relation(f))
}

theorem add_monoid_hom_kernel_step[A: AddMonoid, B: AddMonoid](f: A -> B, x1: A, y1: A, x2: A, y2: A) {
    is_add_monoid_hom(f) and kernel_relation(f, x1, y1) and kernel_relation(f, x2, y2)
    implies kernel_relation(f, x1 + x2, y1 + y2)
}

numerals Nat
define all_divide(list: List[Nat], n: Nat) -> Bool {
    forall(d: Nat) {
        list.contains(d) implies d.divides(n)
    }
}

theorem all_sets_subset_universal[K](s: Set[K]) {
    s.subset(Set[K].universal_set)
}

numerals Nat
theorem alternating_sign_add[R: Ring](m: Nat, n: Nat) {
    alternating_sign[R](m) * alternating_sign[R](n) = alternating_sign[R](m + n)
}

theorem and_assoc(a: Bool, b: Bool, c: Bool) {
    ((a and b) and c) = (a and (b and c))
}

theorem and_comm(a: Bool, b: Bool) {
    (a and b) = (b and a)
}

define and_family[K, I] (f: I -> Set[K], x: K) -> Bool {
    forall(i: I) {
        f(i).contains(x)
    }
}

theorem and_intro(a: Bool, b: Bool) {
    a and b implies a and b
}

theorem and_left(a: Bool, b: Bool) {
    a and b implies a
}

theorem and_or_distrib_left(a: Bool, b: Bool, c: Bool) {
    (a and (b or c)) = ((a and b) or (a and c))
}

theorem and_or_distrib_right(a: Bool, b: Bool, c: Bool) {
    ((a or b) and c) = ((a and c) or (b and c))
}

theorem and_right(a: Bool, b: Bool) {
    a and b implies b
}

theorem and_self(a: Bool) {
    (a and a) = a
}

define is_antisymmetric[T](f: (T, T) -> Bool) -> Bool {
    forall(x: T, y: T) {
        f(x, y) and f(y, x) implies x = y
    }
}

theorem antisymmetric_eq[T](f: (T, T) -> Bool, x: T, y: T) {
    is_antisymmetric(f) and f(x, y) and f(y, x) implies x = y
}

define at_least(bound: Nat, n: Nat) -> Bool {
    n >= bound
}

theorem attribute_round_trip(n: Nat, x: Fin[n]) {
    x.bound = n and x.again = x
}

let inverse_fn_at[T: Inhabited, U](f: T -> U, y: U) -> result: T satisfy {
    is_surjective_fn(f) implies f(result) = y
}

define inverse_fn[T: Inhabited, U](f: T -> U, y: U) -> T {
    inverse_fn_at(f, y)
}

let inverse_bijection[T: Inhabited, U](e: Bijection[T, U]) -> result: Bijection[U, T] satisfy {
    result.map = inverse_fn(e.map)
}

theorem bijection_apply_inverse[T: Inhabited, U](e: Bijection[T, U], y: U) {
    e.map(inverse_bijection(e).map(y)) = y
}

theorem bijection_ext[T, U](e: Bijection[T, U], h: Bijection[T, U]) {
    e.map = h.map implies e = h
}

theorem bijection_fn_is_injective[T, U](f: T -> U) {
    is_bijection_fn(f) implies is_injective_fn(f)
}

theorem bijection_fn_is_surjective[T, U](f: T -> U) {
    is_bijection_fn(f) implies is_surjective_fn(f)
}

theorem bijection_map_is_bijection[T, U](e: Bijection[T, U]) {
    is_bijection_fn(e.map)
}

theorem bijection_map_is_injective[T, U](e: Bijection[T, U]) {
    is_injective_fn(e.map)
}

theorem bijection_map_is_surjective[T, U](e: Bijection[T, U]) {
    is_surjective_fn(e.map)
}

theorem bijection_new_map[T, U](f: T -> U, e: Bijection[T, U]) {
    Bijection[T, U].new(f) = Option.some(e) implies e.map = f
}

theorem bijection_some_injective[T, U](e: Bijection[T, U], h: Bijection[T, U]) {
    Option.some(e) = Option.some(h) implies e = h
}

theorem binary_congruence_eq[T](r: (T, T) -> Bool, q: (T, T) -> Bool, op: (T, T) -> T, op2: (T, T) -> T) {
    r = q and op = op2 and is_binary_congruence(r, op) implies is_binary_congruence(q, op2)
}

theorem binary_congruence_eq_op[T](r: (T, T) -> Bool, op: (T, T) -> T, op2: (T, T) -> T) {
    op = op2 and is_binary_congruence(r, op) implies is_binary_congruence(r, op2)
}

theorem binary_congruence_eq_relation[T](r: (T, T) -> Bool, q: (T, T) -> Bool, op: (T, T) -> T) {
    r = q and is_binary_congruence(r, op) implies is_binary_congruence(q, op)
}

theorem binary_congruence_is_equivalence[T](r: (T, T) -> Bool, op: (T, T) -> T) {
    is_binary_congruence(r, op) implies is_equivalence(r)
}

