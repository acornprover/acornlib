}

theorem range_sum_term_lte(f: Nat -> Nat, n: Nat, k: Nat) {
    k < n implies f(k) <= range_sum(f, n)
}

theorem range_sum_two_terms_lte(f: Nat -> Nat, n: Nat, j: Nat, k: Nat) {
    j < k and k < n implies f(j) + f(k) <= range_sum(f, n)
}

theorem range_sum_zero[A: AddCommMonoid](f: Nat -> A) {
    range_sum(f, Nat.0) = A.0
}

define zero_fn[A: AddCommMonoid](i: Nat) -> A {
    A.0
}

theorem range_sum_zero_fn[A: AddCommMonoid](n: Nat) {
    range_sum(zero_fn[A], n) = A.0
}

theorem range_sum_zero_of_vanishes[A: AddCommMonoid](f: Nat -> A, n: Nat) {
    (forall(i: Nat) { i < n implies f(i) = A.0 }) implies range_sum(f, n) = A.0
}

define row_encode(m: Nat) -> (Pair[Nat, Nat] -> Nat) {
    function(p: Pair[Nat, Nat]) { p.second * m + p.first }
}

define rectangle_values(m: Nat, n: Nat) -> List[Nat] {
    map[Pair[Nat, Nat], Nat](list_pair_product[Nat, Nat](m.range, n.range), row_encode(m))
}

theorem rectangle_values_contains_iff(m: Nat, n: Nat, x: Nat) {
    m != Nat.0 implies rectangle_values(m, n).contains(x) = (x < m * n)
}

theorem rectangle_values_contains_imp_lt(m: Nat, n: Nat, x: Nat) {
    rectangle_values(m, n).contains(x) implies x < m * n
}

theorem rectangle_values_contains_of_lt(m: Nat, n: Nat, x: Nat) {
    m != Nat.0 and x < m * n implies rectangle_values(m, n).contains(x)
}

define row_encode_filter_pred(m: Nat, pred: Nat -> Bool) -> (Pair[Nat, Nat] -> Bool) {
    function(p: Pair[Nat, Nat]) { pred(row_encode(m)(p)) }
}

theorem rectangle_values_filter_length_pair_product(m: Nat, n: Nat, pred: Nat -> Bool) {
    rectangle_values(m, n).filter(pred).length =
        list_pair_product[Nat, Nat](m.range, n.range).filter(row_encode_filter_pred(m, pred)).length
}

theorem rectangle_values_filter_length_range(m: Nat, n: Nat, pred: Nat -> Bool) {
    m != Nat.0 implies rectangle_values(m, n).filter(pred).length =
        (m * n).range.filter(pred).length
}

theorem rectangle_values_filter_permutation_range_filter(m: Nat, n: Nat, pred: Nat -> Bool) {
    m != Nat.0 implies is_permutation(
        rectangle_values(m, n).filter(pred),
        (m * n).range.filter(pred))
}

theorem rectangle_values_same_contains_range(m: Nat, n: Nat, x: Nat) {
    m != Nat.0 implies rectangle_values(m, n).contains(x) = (m * n).range.contains(x)
}

theorem rectangle_values_unique(m: Nat, n: Nat) {
    m != Nat.0 implies rectangle_values(m, n).is_unique
}

theorem reflexive_self[T](f: (T, T) -> Bool, x: T) {
    is_reflexive(f) implies f(x, x)
}

theorem reflexive_symmetric_transitive_imp_equivalence[T](f: (T, T) -> Bool) {
    is_reflexive(f) and is_symmetric(f) and is_transitive(f) implies is_equivalence(f)
}

theorem rel_of_quotient_mk_eq[T](qrel: QuotientRelation[T], a: T, b: T) {
    quotient_mk(qrel, a) = quotient_mk(qrel, b) implies qrel.rel(a, b)
}

theorem rel_of_quotient_over_mk_eq[T](qrel: QuotientRelation[T], a: T, b: T) {
    quotient_over_mk(qrel, a) = quotient_over_mk(qrel, b) implies qrel.rel(a, b)
}

theorem rel_of_quotient_projection_eq[T](qrel: QuotientRelation[T], a: T, b: T) {
    quotient_projection(qrel, a) = quotient_projection(qrel, b) implies qrel.rel(a, b)
}

define relation_compose[A, B, C](r: (A, B) -> Bool, s: (B, C) -> Bool, x: A, z: C) -> Bool {
    exists(y: B) {
        r(x, y) and s(y, z)
    }
}

theorem relation_compose_assoc[A, B, C, D](
    r: (A, B) -> Bool,
    s: (B, C) -> Bool,
    t: (C, D) -> Bool
) {
    relation_compose(relation_compose(r, s), t) = relation_compose(r, relation_compose(s, t))
}

theorem relation_compose_eq_relation_left[A, B](r: (A, B) -> Bool) {
    relation_compose(eq_relation[A], r) = r
}

theorem relation_compose_eq_relation_right[A, B](r: (A, B) -> Bool) {
    relation_compose(r, eq_relation[B]) = r
}

theorem relation_compose_has_witness[A, B, C](r: (A, B) -> Bool, s: (B, C) -> Bool, x: A, z: C) {
    relation_compose(r, s, x, z) implies exists(y: B) {
        r(x, y) and s(y, z)
    }
}

theorem relation_compose_intro[A, B, C](r: (A, B) -> Bool, s: (B, C) -> Bool, x: A, y: B, z: C) {
    r(x, y) and s(y, z) implies relation_compose(r, s, x, z)
}

theorem relation_converse_compose[A, B, C](r: (A, B) -> Bool, s: (B, C) -> Bool) {
    relation_converse(relation_compose(r, s)) = relation_compose(relation_converse(s), relation_converse(r))
}

theorem relation_converse_eq_relation[T] {
    relation_converse(eq_relation[T]) = eq_relation[T]
}

theorem relation_converse_is_antisymmetric[T](r: (T, T) -> Bool) {
    is_antisymmetric(r) implies is_antisymmetric(relation_converse(r))
}

theorem relation_converse_is_reflexive[T](r: (T, T) -> Bool) {
    is_reflexive(r) implies is_reflexive(relation_converse(r))
}

theorem relation_converse_is_total[T](r: (T, T) -> Bool) {
    is_total(r) implies is_total(relation_converse(r))
}

theorem relation_converse_is_transitive[T](r: (T, T) -> Bool) {
    is_transitive(r) implies is_transitive(relation_converse(r))
}

define relation_subset[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) -> Bool {
    forall(x: A, y: B) {
        r(x, y) implies s(x, y)
    }
}

theorem relation_converse_monotone[A, B](r1: (A, B) -> Bool, r2: (A, B) -> Bool) {
    relation_subset(r1, r2) implies relation_subset(relation_converse(r1), relation_converse(r2))
}

theorem relation_converse_subset_of_symmetric[T](r: (T, T) -> Bool) {
    is_symmetric(r) implies relation_subset(relation_converse(r), r)
}

define relation_union[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool, x: A, y: B) -> Bool {
    r(x, y) or s(x, y)
}

theorem relation_converse_union[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_converse(relation_union(r, s)) =
    relation_union(relation_converse(r), relation_converse(s))
}

theorem relation_eq_iff_subset_both[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    r = s = (relation_subset(r, s) and relation_subset(s, r))
}

theorem relation_eq_imp_antisymmetric[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_antisymmetric(f) implies is_antisymmetric(g)
}

theorem relation_eq_imp_antisymmetric_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_antisymmetric(g) implies is_antisymmetric(f)
}

theorem relation_eq_imp_asymmetric[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_asymmetric(f) implies is_asymmetric(g)
}

theorem relation_eq_imp_asymmetric_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_asymmetric(g) implies is_asymmetric(f)
}

theorem relation_eq_imp_equivalence[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_equivalence(f) implies is_equivalence(g)
}

theorem relation_eq_imp_equivalence_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_equivalence(g) implies is_equivalence(f)
}

theorem relation_eq_imp_irreflexive[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_irreflexive(f) implies is_irreflexive(g)
}

theorem relation_eq_imp_irreflexive_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_irreflexive(g) implies is_irreflexive(f)
}

theorem relation_eq_imp_partial_equivalence[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_partial_equivalence(f) implies is_partial_equivalence(g)
}

theorem relation_eq_imp_partial_equivalence_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_partial_equivalence(g) implies is_partial_equivalence(f)
}

theorem relation_eq_imp_reflexive[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_reflexive(f) implies is_reflexive(g)
}

theorem relation_eq_imp_reflexive_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_reflexive(g) implies is_reflexive(f)
}

theorem relation_eq_imp_symmetric[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_symmetric(f) implies is_symmetric(g)
}

theorem relation_eq_imp_symmetric_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_symmetric(g) implies is_symmetric(f)
}

theorem relation_eq_imp_total[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_total(f) implies is_total(g)
}

theorem relation_eq_imp_total_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_total(g) implies is_total(f)
}

theorem relation_eq_imp_transitive[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_transitive(f) implies is_transitive(g)
}

theorem relation_eq_imp_transitive_rev[T](f: (T, T) -> Bool, g: (T, T) -> Bool) {
    f = g and is_transitive(g) implies is_transitive(f)
}

define relation_power[T](r: (T, T) -> Bool, n: Nat, x: T, y: T) -> Bool {
    match n {
        Nat.zero {
            eq_relation[T](x, y)
        }
        Nat.suc(pred) {
            relation_compose(relation_power(r, pred), r, x, y)
        }
    }
}

define relation_refl_trans_closure[T](r: (T, T) -> Bool, x: T, y: T) -> Bool {
    exists(n: Nat) {
        relation_power(r, n, x, y)
    }
}

define relation_symmetric_closure[T](r: (T, T) -> Bool, x: T, y: T) -> Bool {
    r(x, y) or relation_converse(r, x, y)
}

define relation_equivalence_closure[T](r: (T, T) -> Bool, x: T, y: T) -> Bool {
    relation_refl_trans_closure(relation_symmetric_closure(r), x, y)
}

define relation_intersection[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool, x: A, y: B) -> Bool {
    r(x, y) and s(x, y)
}

theorem relation_intersection_assoc[A, B](
    r: (A, B) -> Bool,
    s: (A, B) -> Bool,
    t: (A, B) -> Bool
) {
    relation_intersection(r, relation_intersection(s, t)) =
    relation_intersection(relation_intersection(r, s), t)
}

theorem relation_intersection_comm[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_intersection(r, s) = relation_intersection(s, r)
}

theorem relation_intersection_idempotent[A, B](r: (A, B) -> Bool) {
    relation_intersection(r, r) = r
}

theorem relation_intersection_is_reflexive[T](r: (T, T) -> Bool, s: (T, T) -> Bool) {
    is_reflexive(r) and is_reflexive(s) implies is_reflexive(relation_intersection(r, s))
}

theorem relation_intersection_is_symmetric[T](r: (T, T) -> Bool, s: (T, T) -> Bool) {
    is_symmetric(r) and is_symmetric(s) implies is_symmetric(relation_intersection(r, s))
}

theorem relation_intersection_is_transitive[T](r: (T, T) -> Bool, s: (T, T) -> Bool) {
    is_transitive(r) and is_transitive(s) implies is_transitive(relation_intersection(r, s))
}

theorem relation_intersection_left_subset[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_subset(relation_intersection(r, s), r)
}

theorem relation_intersection_monotone[A, B](
    r1: (A, B) -> Bool,
    r2: (A, B) -> Bool,
    s1: (A, B) -> Bool,
    s2: (A, B) -> Bool
) {
    relation_subset(r1, r2) and relation_subset(s1, s2) implies
    relation_subset(relation_intersection(r1, s1), relation_intersection(r2, s2))
}

theorem relation_intersection_right_subset[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_subset(relation_intersection(r, s), s)
}

theorem relation_intersection_subset_left_eq[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_subset(r, s) implies relation_intersection(s, r) = r
}

theorem relation_intersection_subset_right_eq[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_subset(r, s) implies relation_intersection(r, s) = r
}

theorem relation_intersection_union_absorb[A, B](r: (A, B) -> Bool, s: (A, B) -> Bool) {
    relation_intersection(r, relation_union(r, s)) = r
}

theorem relation_intersection_union_distrib[A, B](
    r: (A, B) -> Bool,
    s: (A, B) -> Bool,
    t: (A, B) -> Bool
) {
    relation_intersection(r, relation_union(s, t)) =
    relation_union(relation_intersection(r, s), relation_intersection(r, t))
}

theorem relation_power_add[T](r: (T, T) -> Bool, m: Nat, n: Nat) {
    relation_compose(relation_power(r, m), relation_power(r, n)) = relation_power(r, m + n)
}

theorem relation_power_add_step_compose[T](r: (T, T) -> Bool, m: Nat, k: Nat) {
    relation_compose(relation_power(r, m), relation_power(r, k)) = relation_power(r, m + k)
    implies
    relation_compose(relation_power(r, m), relation_power(r, k.suc)) = relation_compose(relation_power(r, m + k), r)
}

theorem relation_power_add_step_power[T](r: (T, T) -> Bool, m: Nat, k: Nat) {
    relation_compose(relation_power(r, m + k), r) = relation_power(r, m + k.suc)
}

theorem relation_power_converse[T](r: (T, T) -> Bool, n: Nat) {
    relation_converse(relation_power(r, n)) = relation_power(relation_converse(r), n)
}

theorem relation_power_converse_step[T](r: (T, T) -> Bool, k: Nat) {
    relation_converse(relation_power(r, k)) = relation_power(relation_converse(r), k)
    implies
    relation_converse(relation_power(r, k.suc)) = relation_power(relation_converse(r), k.suc)
}

theorem relation_power_converse_suc_compose[T](r: (T, T) -> Bool, k: Nat) {
    relation_converse(relation_power(r, k.suc)) = relation_compose(relation_converse(r), relation_converse(relation_power(r, k)))
}

theorem relation_power_converse_suc_target[T](r: (T, T) -> Bool, k: Nat) {
    relation_compose(relation_converse(r), relation_power(relation_converse(r), k)) = relation_power(relation_converse(r), k.suc)
}

theorem relation_power_in_refl_trans_closure[T](r: (T, T) -> Bool, n: Nat, x: T, y: T) {
    relation_power(r, n, x, y) implies relation_refl_trans_closure(r, x, y)
}

theorem relation_power_monotone[T](r: (T, T) -> Bool, s: (T, T) -> Bool, n: Nat) {
    relation_subset(r, s) implies relation_subset(relation_power(r, n), relation_power(s, n))
}

theorem relation_power_monotone_step[T](r: (T, T) -> Bool, s: (T, T) -> Bool, n: Nat) {
    relation_subset(r, s) and relation_subset(relation_power(r, n), relation_power(s, n))
    implies
    relation_subset(relation_power(r, n.suc), relation_power(s, n.suc))
}

theorem relation_power_one[T](r: (T, T) -> Bool) {
    relation_power(r, Nat.zero.suc) = r
}

theorem relation_power_one_step[T](r: (T, T) -> Bool, x: T, y: T) {
    r(x, y) implies relation_power(r, Nat.zero.suc, x, y)
}

define relation_trans_closure[T](r: (T, T) -> Bool, x: T, y: T) -> Bool {
    exists(n: Nat) {
        relation_power(r, n.suc, x, y)
    }
}

theorem relation_power_positive_in_trans_closure[T](r: (T, T) -> Bool, n: Nat, x: T, y: T) {
    relation_power(r, n.suc, x, y) implies relation_trans_closure(r, x, y)
}

define relation_pullback[A, B](f: A -> B, r: (B, B) -> Bool, x: A, y: A) -> Bool {
    r(f(x), f(y))
}

theorem relation_power_positive_pullback_reverse_of_surjective[A, B](f: A -> B, r: (B, B) -> Bool, n: Nat, x: A, y: A) {
    is_surjective_fn(f) and relation_pullback(f, relation_power(r, n.suc), x, y)
    implies
    relation_power(relation_pullback(f, r), n.suc, x, y)
}

theorem relation_power_positive_pullback_reverse_of_surjective_step[A, B](f: A -> B, r: (B, B) -> Bool, n: Nat) {
    is_surjective_fn(f) and
    relation_subset(
        relation_pullback(f, relation_power(r, n.suc)),
        relation_power(relation_pullback(f, r), n.suc)
    )
    implies
    relation_subset(
        relation_pullback(f, relation_power(r, n.suc.suc)),
        relation_power(relation_pullback(f, r), n.suc.suc)
    )
}

theorem relation_power_positive_subset_of_transitive[T](r: (T, T) -> Bool, s: (T, T) -> Bool, n: Nat) {
    is_transitive(s) and relation_subset(r, s)
    implies
    relation_subset(relation_power(r, n.suc), s)
}

theorem relation_power_pullback_subset[A, B](f: A -> B, r: (B, B) -> Bool, n: Nat) {
    relation_subset(
        relation_power(relation_pullback(f, r), n),
        relation_pullback(f, relation_power(r, n))
    )
}

theorem relation_power_pullback_subset_step[A, B](f: A -> B, r: (B, B) -> Bool, n: Nat) {
    relation_subset(
        relation_power(relation_pullback(f, r), n),
        relation_pullback(f, relation_power(r, n))
    )
    implies
    relation_subset(
        relation_power(relation_pullback(f, r), n.suc),
        relation_pullback(f, relation_power(r, n.suc))
    )
}

theorem relation_power_subset_of_reflexive_transitive[T](r: (T, T) -> Bool, s: (T, T) -> Bool, n: Nat) {
    is_reflexive(s) and is_transitive(s) and relation_subset(r, s)
    implies
    relation_subset(relation_power(r, n), s)
}

theorem relation_power_suc[T](r: (T, T) -> Bool, n: Nat) {
    relation_power(r, n.suc) = relation_compose(relation_power(r, n), r)
}

theorem relation_power_suc_left[T](r: (T, T) -> Bool, n: Nat) {
    relation_compose(r, relation_power(r, n)) = relation_power(r, n.suc)
}

theorem relation_power_zero[T](r: (T, T) -> Bool) {
    relation_power(r, Nat.zero) = eq_relation[T]
}

theorem relation_power_zero_self[T](r: (T, T) -> Bool, x: T) {
    relation_power(r, Nat.zero, x, x)
}

theorem relation_pullback_converse[A, B](f: A -> B, r: (B, B) -> Bool) {
    relation_pullback(f, relation_converse(r)) = relation_converse(relation_pullback(f, r))
}

theorem relation_pullback_eq_relation_of_injective[T, U](f: T -> U) {
    is_injective_fn(f) implies relation_pullback(f, eq_relation[U]) = eq_relation[T]
}

theorem relation_pullback_eq_relation_of_injective_at[T, U](f: T -> U, x: T, y: T) {
    is_injective_fn(f) implies relation_pullback(f, eq_relation[U], x, y) = eq_relation[T](x, y)
}

theorem relation_pullback_is_antisymmetric_of_injective[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_injective_fn(f) and is_antisymmetric(r) implies is_antisymmetric(relation_pullback(f, r))
}

theorem relation_pullback_is_asymmetric[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_asymmetric(r) implies is_asymmetric(relation_pullback(f, r))
}

theorem relation_pullback_is_irreflexive[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_irreflexive(r) implies is_irreflexive(relation_pullback(f, r))
}

theorem relation_pullback_is_reflexive[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_reflexive(r) implies is_reflexive(relation_pullback(f, r))
}

theorem relation_pullback_is_total[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_total(r) implies is_total(relation_pullback(f, r))
}

theorem relation_pullback_is_transitive[A, B](f: A -> B, r: (B, B) -> Bool) {
    is_transitive(r) implies is_transitive(relation_pullback(f, r))
}

define relation_pushforward[A, B](f: A -> B, r: (A, A) -> Bool, u: B, v: B) -> Bool {
    exists(x: A, y: A) {
        f(x) = u and f(y) = v and r(x, y)
    }
}

theorem relation_pushforward_converse[A, B](f: A -> B, r: (A, A) -> Bool) {
    relation_pushforward(f, relation_converse(r)) = relation_converse(relation_pushforward(f, r))
}

theorem relation_pushforward_has_preimages[A, B](f: A -> B, r: (A, A) -> Bool, u: B, v: B) {
    relation_pushforward(f, r, u, v) implies exists(x: A, y: A) {
        f(x) = u and f(y) = v and r(x, y)
    }
}

theorem relation_pushforward_intro[A, B](f: A -> B, r: (A, A) -> Bool, x: A, y: A) {
    r(x, y) implies relation_pushforward(f, r, f(x), f(y))
}

theorem relation_refl_trans_closure_converse[T](r: (T, T) -> Bool, x: T, y: T) {
    relation_refl_trans_closure(relation_converse(r), x, y) = relation_refl_trans_closure(r, y, x)
}

theorem relation_refl_trans_closure_eq_eq_or_trans_closure[T](r: (T, T) -> Bool, x: T, y: T) {
    relation_refl_trans_closure(r, x, y) = (eq_relation[T](x, y) or relation_trans_closure(r, x, y))
}

theorem relation_refl_trans_closure_is_reflexive[T](r: (T, T) -> Bool) {
    is_reflexive(relation_refl_trans_closure(r))
}

theorem relation_refl_trans_closure_is_symmetric[T](r: (T, T) -> Bool) {
    is_symmetric(r) implies is_symmetric(relation_refl_trans_closure(r))
}

