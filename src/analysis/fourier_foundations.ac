        sin(Real.0) = Real.0
        sin(Real.0) * sin(Real.0) = Real.0
        sin_sq_fn(Real.0) = Real.0
        Real.one_half * sin_sq_fn(Real.0) = Real.0
        sincos_antiderivative(Real.0) = Real.0
        sincos_antiderivative(two * pi) - sincos_antiderivative(Real.0) = Real.0 - Real.0
        Real.0 - Real.0 = Real.0
        integral(sincos, Real.0, two * pi) = Real.0
    }
}

// ---------------------------------------------------------------------------
// The Dirichlet kernel: the summation identity
//   2 sin(x/2) * (1/2 + sum_{k=1}^{n} cos(k x)) = sin((n + 1/2) x)
// for the trigonometric polynomials of a partial Fourier sum.  This is the
// classic trig-polynomial summation identity, proved here with the exported
// sine/cosine API only.
// ---------------------------------------------------------------------------

/// The k-th cosine harmonic cos(k x).
define cos_harmonic(x: Real, k: Nat) -> Real {
    cos(from_nat[Real](k) * x)
}

/// The sum of the first n cosine harmonics, sum_{k=1}^{n} cos(k x),
/// indexed as a partial sum over the shifted sequence so that k runs from
/// one to n.
define cos_harmonic_sum(x: Real, n: Nat) -> Real {
    partial(compose(cos_harmonic(x), Nat.suc), n)
}

/// The half-angle harmonic sin((k + 1/2) x).
define half_angle_harmonic(x: Real, k: Nat) -> Real {
    sin((from_nat[Real](k) + Real.one_half) * x)
}

/// The successive difference of the half-angle harmonics at index i:
/// a(i + 1) - a(i) with a(i) = sin((i + 1/2) x).
define half_angle_diff(x: Real, i: Nat) -> Real {
    half_angle_harmonic(x, i.suc) - half_angle_harmonic(x, i)
}

/// The partial sums of the successive differences telescope:
/// sum_{i=0}^{n-1} (a(i+1) - a(i)) = a(n) - a(0).
theorem half_angle_diff_telescopes(x: Real, n: Nat) {
    partial(half_angle_diff(x), n) = half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0)
} by {
    define q(m: Nat) -> Bool {
        partial(half_angle_diff(x), m) = half_angle_harmonic(x, m) - half_angle_harmonic(x, Nat.0)
    }
    partial(half_angle_diff(x), Nat.0) = Real.0
    half_angle_harmonic(x, Nat.0) - half_angle_harmonic(x, Nat.0) = Real.0
    partial(half_angle_diff(x), Nat.0) = half_angle_harmonic(x, Nat.0) - half_angle_harmonic(x, Nat.0)
    q(Nat.0)
    forall(m: Nat) {
        if q(m) {
            partial(half_angle_diff(x), m.suc) = partial(half_angle_diff(x), m) + half_angle_diff(x, m)
            half_angle_diff(x, m) = half_angle_harmonic(x, m.suc) - half_angle_harmonic(x, m)
            partial(half_angle_diff(x), m) + half_angle_diff(x, m) =
                half_angle_harmonic(x, m) - half_angle_harmonic(x, Nat.0) +
                (half_angle_harmonic(x, m.suc) - half_angle_harmonic(x, m))
            half_angle_harmonic(x, m) - half_angle_harmonic(x, Nat.0) +
                (half_angle_harmonic(x, m.suc) - half_angle_harmonic(x, m)) =
                half_angle_harmonic(x, m.suc) - half_angle_harmonic(x, Nat.0)
            partial(half_angle_diff(x), m.suc) = half_angle_harmonic(x, m.suc) - half_angle_harmonic(x, Nat.0)
            q(m.suc)
        }
    }
    alt_induction(q)
    (q(Nat.0) and forall(k: Nat) { q(k) implies q(k.suc) }) implies forall(k: Nat) { q(k) }
    q(Nat.0) and forall(k: Nat) { q(k) implies q(k.suc) }
    forall(k: Nat) { q(k) }
    q(n)
}

/// 2 sin(x/2) cos((i+1) x) = sin((i + 3/2) x) - sin((i + 1/2) x).
theorem half_angle_diff_expansion(x: Real, i: Nat) {
    two * sin(x * Real.one_half) * cos_harmonic(x, i.suc) = half_angle_diff(x, i)
} by {
    half_angle_diff(x, i) = half_angle_harmonic(x, i.suc) - half_angle_harmonic(x, i)
    half_angle_harmonic(x, i.suc) = sin((from_nat[Real](i.suc) + Real.one_half) * x)
    half_angle_harmonic(x, i) = sin((from_nat[Real](i) + Real.one_half) * x)
    (from_nat[Real](i.suc) + Real.one_half) * x = from_nat[Real](i.suc) * x + Real.one_half * x
    from_nat_add[Real](i, Nat.1)
    from_nat[Real](i + Nat.1) = from_nat[Real](i) + from_nat[Real](Nat.1)
    i + Nat.1 = i.suc
    from_nat[Real](i.suc) = from_nat[Real](i) + from_nat[Real](Nat.1)
    from_nat[Real](Nat.1) = Real.1
    from_nat[Real](i.suc) = from_nat[Real](i) + Real.1
    one_half_plus_one_half
    Real.one_half + Real.one_half = Real.1
    sub_moves_sides(Real.one_half, Real.one_half, Real.1)
    Real.one_half = Real.1 - Real.one_half
    from_nat[Real](i) + Real.one_half = from_nat[Real](i) + (Real.1 - Real.one_half)
    from_nat[Real](i) + (Real.1 - Real.one_half) = from_nat[Real](i) + Real.1 - Real.one_half
    from_nat[Real](i) + Real.one_half = from_nat[Real](i.suc) - Real.one_half
    mul_sub_distrib_left(from_nat[Real](i.suc), Real.one_half, x)
    (from_nat[Real](i.suc) - Real.one_half) * x = from_nat[Real](i.suc) * x - Real.one_half * x
    (from_nat[Real](i) + Real.one_half) * x = (from_nat[Real](i.suc) - Real.one_half) * x
    (from_nat[Real](i) + Real.one_half) * x = from_nat[Real](i.suc) * x - Real.one_half * x
    half_angle_harmonic(x, i.suc) = sin(from_nat[Real](i.suc) * x + Real.one_half * x)
    half_angle_harmonic(x, i) = sin(from_nat[Real](i.suc) * x - Real.one_half * x)
    half_angle_diff(x, i) =
        sin(from_nat[Real](i.suc) * x + Real.one_half * x) - sin(from_nat[Real](i.suc) * x - Real.one_half * x)
    sin_add(from_nat[Real](i.suc) * x, Real.one_half * x)
    sin(from_nat[Real](i.suc) * x + Real.one_half * x) =
        sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) + cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    sin_add(from_nat[Real](i.suc) * x, -(Real.one_half * x))
    sin(from_nat[Real](i.suc) * x + (-(Real.one_half * x))) =
        sin(from_nat[Real](i.suc) * x) * cos(-(Real.one_half * x)) + cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x))
    from_nat[Real](i.suc) * x + (-(Real.one_half * x)) = from_nat[Real](i.suc) * x - Real.one_half * x
    sin(from_nat[Real](i.suc) * x - Real.one_half * x) =
        sin(from_nat[Real](i.suc) * x) * cos(-(Real.one_half * x)) + cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x))
    cos_neg(Real.one_half * x)
    cos(-(Real.one_half * x)) = cos(Real.one_half * x)
    sin_neg(Real.one_half * x)
    sin(-(Real.one_half * x)) = -sin(Real.one_half * x)
    sin(from_nat[Real](i.suc) * x) * cos(-(Real.one_half * x)) = sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x)
    cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x)) = cos(from_nat[Real](i.suc) * x) * (-sin(Real.one_half * x))
    mul_neg_one_right(sin(Real.one_half * x))
    sin(Real.one_half * x) * (-Real.1) = -sin(Real.one_half * x)
    cos(from_nat[Real](i.suc) * x) * (-sin(Real.one_half * x)) = cos(from_nat[Real](i.suc) * x) * (sin(Real.one_half * x) * (-Real.1))
    mul_assoc(cos(from_nat[Real](i.suc) * x), sin(Real.one_half * x), -Real.1)
    cos(from_nat[Real](i.suc) * x) * (sin(Real.one_half * x) * (-Real.1)) = (cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)) * (-Real.1)
    mul_neg_one_right(cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x))
    (cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)) * (-Real.1) = -(cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x))
    cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x)) = -(cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x))
    sin(from_nat[Real](i.suc) * x) * cos(-(Real.one_half * x)) + cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x)) =
        sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) + cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x))
    sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) + cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x)) =
        sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) + (-(cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)))
    sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) + (-(cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x))) =
        sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) - cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    sin(from_nat[Real](i.suc) * x) * cos(-(Real.one_half * x)) + cos(from_nat[Real](i.suc) * x) * sin(-(Real.one_half * x)) =
        sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) - cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    sin(from_nat[Real](i.suc) * x - Real.one_half * x) =
        sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) - cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    sin(from_nat[Real](i.suc) * x + Real.one_half * x) - sin(from_nat[Real](i.suc) * x - Real.one_half * x) =
        (sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) + cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)) -
        (sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) - cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x))
    ring_sub_sub_comm(sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x), cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x))
    (sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) + cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)) -
        (sin(from_nat[Real](i.suc) * x) * cos(Real.one_half * x) - cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)) =
        cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x) + cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x) + cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x) =
        two * (cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x))
    mul_assoc(two, cos(from_nat[Real](i.suc) * x), sin(Real.one_half * x))
    two * (cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)) = two * cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    sin(from_nat[Real](i.suc) * x + Real.one_half * x) - sin(from_nat[Real](i.suc) * x - Real.one_half * x) =
        two * cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    half_angle_diff(x, i) = two * cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x)
    cos_harmonic(x, i.suc) = cos(from_nat[Real](i.suc) * x)
    two * cos(from_nat[Real](i.suc) * x) * sin(Real.one_half * x) =
        two * sin(x * Real.one_half) * cos_harmonic(x, i.suc)
    two * sin(x * Real.one_half) * cos_harmonic(x, i.suc) = half_angle_diff(x, i)
}

/// The Dirichlet-kernel identity:
/// 2 sin(x/2) * (1/2 + sum_{k=1}^{n} cos(k x)) = sin((n + 1/2) x).
theorem dirichlet_kernel_identity(x: Real, n: Nat) {
    two * sin(x * Real.one_half) * (Real.one_half + cos_harmonic_sum(x, n)) = half_angle_harmonic(x, n)
} by {
    cos_harmonic_sum(x, n) = partial(compose(cos_harmonic(x), Nat.suc), n)
    partial_scalar_mul(two * sin(x * Real.one_half), compose(cos_harmonic(x), Nat.suc), n)
    (two * sin(x * Real.one_half)) * partial(compose(cos_harmonic(x), Nat.suc), n) =
        partial(mul_fn(two * sin(x * Real.one_half), compose(cos_harmonic(x), Nat.suc)), n)
    forall(i: Nat) {
        if i < n {
            half_angle_diff_expansion(x, i)
            two * sin(x * Real.one_half) * cos_harmonic(x, i.suc) = half_angle_diff(x, i)
            mul_fn(two * sin(x * Real.one_half), compose(cos_harmonic(x), Nat.suc))(i) =
                (two * sin(x * Real.one_half)) * compose(cos_harmonic(x), Nat.suc)(i)
            compose(cos_harmonic(x), Nat.suc)(i) = cos_harmonic(x, i.suc)
            (two * sin(x * Real.one_half)) * compose(cos_harmonic(x), Nat.suc)(i) =
                two * sin(x * Real.one_half) * cos_harmonic(x, i.suc)
            mul_fn(two * sin(x * Real.one_half), compose(cos_harmonic(x), Nat.suc))(i) = half_angle_diff(x, i)
        }
    }
    partial_pointwise_eq(mul_fn(two * sin(x * Real.one_half), compose(cos_harmonic(x), Nat.suc)), half_angle_diff(x), n)
    partial(mul_fn(two * sin(x * Real.one_half), compose(cos_harmonic(x), Nat.suc)), n) = partial(half_angle_diff(x), n)
    half_angle_diff_telescopes(x, n)
    partial(half_angle_diff(x), n) = half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0)
    partial(mul_fn(two * sin(x * Real.one_half), compose(cos_harmonic(x), Nat.suc)), n) =
        half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0)
    (two * sin(x * Real.one_half)) * partial(compose(cos_harmonic(x), Nat.suc), n) =
        half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0)
    two * sin(x * Real.one_half) * cos_harmonic_sum(x, n) = half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0)
    two * sin(x * Real.one_half) * (Real.one_half + cos_harmonic_sum(x, n)) =
        two * sin(x * Real.one_half) * Real.one_half + two * sin(x * Real.one_half) * cos_harmonic_sum(x, n)
    one_half_plus_one_half
    Real.one_half + Real.one_half = Real.1
    Real.one_half * two = Real.1
    mul_assoc(two, sin(x * Real.one_half), Real.one_half)
    two * sin(x * Real.one_half) * Real.one_half = two * (sin(x * Real.one_half) * Real.one_half)
    real_mul_comm(sin(x * Real.one_half), Real.one_half)
    sin(x * Real.one_half) * Real.one_half = Real.one_half * sin(x * Real.one_half)
    two * (sin(x * Real.one_half) * Real.one_half) = two * (Real.one_half * sin(x * Real.one_half))
    mul_assoc(two, Real.one_half, sin(x * Real.one_half))
    two * (Real.one_half * sin(x * Real.one_half)) = (two * Real.one_half) * sin(x * Real.one_half)
    real_mul_comm(two, Real.one_half)
    two * Real.one_half = Real.one_half * two
    (two * Real.one_half) * sin(x * Real.one_half) = (Real.one_half * two) * sin(x * Real.one_half)
    (Real.one_half * two) * sin(x * Real.one_half) = Real.1 * sin(x * Real.one_half)
    Real.1 * sin(x * Real.one_half) = sin(x * Real.one_half)
    two * sin(x * Real.one_half) * Real.one_half = sin(x * Real.one_half)
    two * sin(x * Real.one_half) * (Real.one_half + cos_harmonic_sum(x, n)) =
        sin(x * Real.one_half) + (half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0))
    half_angle_harmonic(x, Nat.0) = sin((from_nat[Real](Nat.0) + Real.one_half) * x)
    from_nat[Real](Nat.0) = Real.0
    (from_nat[Real](Nat.0) + Real.one_half) * x = Real.one_half * x
    half_angle_harmonic(x, Nat.0) = sin(Real.one_half * x)
    sin(Real.one_half * x) = sin(x * Real.one_half)
    half_angle_harmonic(x, Nat.0) = sin(x * Real.one_half)
    sin(x * Real.one_half) + (half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0)) =
        sin(x * Real.one_half) + (half_angle_harmonic(x, n) - sin(x * Real.one_half))
    add_comm(sin(x * Real.one_half), half_angle_harmonic(x, n) - sin(x * Real.one_half))
    sin(x * Real.one_half) + (half_angle_harmonic(x, n) - sin(x * Real.one_half)) =
        (half_angle_harmonic(x, n) - sin(x * Real.one_half)) + sin(x * Real.one_half)
    sub_add_cancel(half_angle_harmonic(x, n), sin(x * Real.one_half))
    (half_angle_harmonic(x, n) - sin(x * Real.one_half)) + sin(x * Real.one_half) = half_angle_harmonic(x, n)
    sin(x * Real.one_half) + (half_angle_harmonic(x, n) - half_angle_harmonic(x, Nat.0)) =
        half_angle_harmonic(x, n)
    two * sin(x * Real.one_half) * (Real.one_half + cos_harmonic_sum(x, n)) = half_angle_harmonic(x, n)
}
