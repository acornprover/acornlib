// ---------------------------------------------------------------------------
// The period 2*pi, and special values at the period
// ---------------------------------------------------------------------------

/// Two pi equals pi plus pi.
theorem two_pi_eq_pi_add_pi {
    two * pi = pi + pi
} by {
    two = Real.1 + Real.1
    two * pi = (Real.1 + Real.1) * pi
    (Real.1 + Real.1) * pi = pi + pi
    two * pi = pi + pi
}

/// The period 2*pi is positive.
theorem two_pi_pos {
    Real.0 < two * pi
} by {
    two_pi_eq_pi_add_pi
    two * pi = pi + pi
    pi_pos
    pi > Real.0
    gt_zero_imp_pos(pi)
    pi.is_positive
    lt_add_pos(pi, pi)
    pi.is_positive implies pi < pi + pi
    pi < pi + pi
    lt_trans(Real.0, pi, pi + pi)
    Real.0 < pi + pi
    two * pi = pi + pi
    Real.0 < two * pi
}

/// The sine of the period 2*pi is zero.
theorem sin_two_pi_value {
    sin(two * pi) = Real.0
} by {
    two_pi_eq_pi_add_pi
    two * pi = pi + pi
    sin(two * pi) = sin(pi + pi)
    sin_two_pi_zero
    sin(pi + pi) = Real.0
    sin(two * pi) = Real.0
}

/// The cosine of the period 2*pi is one.
theorem cos_two_pi_value {
    cos(two * pi) = Real.1
} by {
    two_pi_eq_pi_add_pi
    two * pi = pi + pi
    cos(two * pi) = cos(pi + pi)
    cos_two_pi_one
    cos(pi + pi) = Real.1
    cos(two * pi) = Real.1
}

// ---------------------------------------------------------------------------
// Integrals of sine and cosine over periods: the first orthogonality
// instances (the constant function 1 is orthogonal to sin and cos on a full
// period, and to cos on [0, pi]).
// ---------------------------------------------------------------------------

/// The integral of sine over one full period [0, 2*pi] is zero.
theorem integral_sin_zero_two_pi {
    integral(sin, Real.0, two * pi) = Real.0
} by {
    two_pi_pos
    Real.0 < two * pi
    lt_imp_lte(Real.0, two * pi)
    Real.0 <= two * pi
    integral_sin(Real.0, two * pi)
    Real.0 <= two * pi implies integral(sin, Real.0, two * pi) = cos(Real.0) - cos(two * pi)
    integral(sin, Real.0, two * pi) = cos(Real.0) - cos(two * pi)
    cos_zero
    cos(Real.0) = Real.1
    cos_two_pi_value
    cos(two * pi) = Real.1
    cos(Real.0) - cos(two * pi) = Real.1 - Real.1
    Real.1 - Real.1 = Real.0
    integral(sin, Real.0, two * pi) = Real.0
}

/// The integral of cosine over one full period [0, 2*pi] is zero.
theorem integral_cos_zero_two_pi {
    integral(cos, Real.0, two * pi) = Real.0
} by {
    two_pi_pos
    Real.0 < two * pi
    lt_imp_lte(Real.0, two * pi)
    Real.0 <= two * pi
    integral_cos(Real.0, two * pi)
    Real.0 <= two * pi implies integral(cos, Real.0, two * pi) = sin(two * pi) - sin(Real.0)
    integral(cos, Real.0, two * pi) = sin(two * pi) - sin(Real.0)
    sin_two_pi_value
    sin(two * pi) = Real.0
    sin_zero
    sin(Real.0) = Real.0
    sin(two * pi) - sin(Real.0) = Real.0 - Real.0
    Real.0 - Real.0 = Real.0
    integral(cos, Real.0, two * pi) = Real.0
}

/// The integral of cosine over [0, pi] is zero.
theorem integral_cos_zero_pi {
    integral(cos, Real.0, pi) = Real.0
} by {
    pi_pos
    pi > Real.0
    lt_imp_lte(Real.0, pi)
    Real.0 <= pi
    integral_cos(Real.0, pi)
    Real.0 <= pi implies integral(cos, Real.0, pi) = sin(pi) - sin(Real.0)
    integral(cos, Real.0, pi) = sin(pi) - sin(Real.0)
    sin_pi_zero
    sin(pi) = Real.0
    sin_zero
    sin(Real.0) = Real.0
    sin(pi) - sin(Real.0) = Real.0 - Real.0
    Real.0 - Real.0 = Real.0
    integral(cos, Real.0, pi) = Real.0
}

/// The integral of sine over [0, pi] is two (restated for this module).
theorem integral_sin_zero_pi_restated {
    integral(sin, Real.0, pi) = two
} by {
    integral_sin_zero_pi
}

// ---------------------------------------------------------------------------
// Double-angle and half-angle identities
// ---------------------------------------------------------------------------

/// The double-angle identity for sine: sin(2x) = 2 sin(x) cos(x).
theorem sin_double(x: Real) {
    sin(two * x) = two * sin(x) * cos(x)
} by {
    two * x = x + x
    sin(two * x) = sin(x + x)
    sin_add(x, x)
    sin(x + x) = sin(x) * cos(x) + cos(x) * sin(x)
    real_mul_comm(cos(x), sin(x))
    cos(x) * sin(x) = sin(x) * cos(x)
    sin(x) * cos(x) + cos(x) * sin(x) = sin(x) * cos(x) + sin(x) * cos(x)
    sin(x) * cos(x) + sin(x) * cos(x) = two * (sin(x) * cos(x))
    mul_assoc(two, sin(x), cos(x))
    two * (sin(x) * cos(x)) = two * sin(x) * cos(x)
    sin(x) * cos(x) + sin(x) * cos(x) = two * sin(x) * cos(x)
    sin(two * x) = two * sin(x) * cos(x)
}

/// The double-angle identity for cosine:
/// cos(2x) = cos(x) * cos(x) - sin(x) * sin(x).
theorem cos_double(x: Real) {
    cos(two * x) = cos(x) * cos(x) - sin(x) * sin(x)
} by {
    two * x = x + x
    cos(two * x) = cos(x + x)
    cos_add(x, x)
    cos(x + x) = cos(x) * cos(x) - sin(x) * sin(x)
    cos(two * x) = cos(x) * cos(x) - sin(x) * sin(x)
}

/// Ring helper: (a - b) + b = a, via unfolding the subtraction.
theorem sub_add_cancel(a: Real, b: Real) {
    (a - b) + b = a
} by {
    add_neg_eq_zero(b)
    b + -b = Real.0
    add_comm(b, -b)
    -b + b = Real.0
    (a - b) + b = a + -b + b
    a + -b + b = a + (-b + b)
    a + (-b + b) = a + Real.0
    add_zero_right(a)
    a + Real.0 = a
    a + (-b + b) = a
    (a - b) + b = a
}

/// Ring helper: telescoping of subtractions, (a - b) + (b - c) = a - c.
theorem add_sub_sub_cancel(a: Real, b: Real, c: Real) {
    (a - b) + (b - c) = a - c
} by {
    add_assoc(a - b, b, -c)
    ((a - b) + b) + -c = (a - b) + (b + -c)
    (a - b) + (b - c) = ((a - b) + b) + -c
    sub_add_cancel(a, b)
    (a - b) + b = a
    ((a - b) + b) + -c = a + -c
    a + -c = a - c
    (a - b) + (b - c) = a - c
}

/// Ring helper: (a + b) - (b + c) = a - c.
theorem add_sub_add_cancel(a: Real, b: Real, c: Real) {
    (a + b) - (b + c) = a - c
} by {
    add_assoc(a, b, -b)
    (a + b) + -b = a + (b + -b)
    add_neg_eq_zero(b)
    b + -b = Real.0
    a + (b + -b) = a + Real.0
    add_zero_right(a)
    a + Real.0 = a
    (a + b) + -b = a
    add_assoc(a + b, -b, -c)
    ((a + b) + -b) + -c = (a + b) + (-b + -c)
    neg_distrib(b, c)
    -(b + c) = -b + -c
    (a + b) - (b + c) = (a + b) + (-b + -c)
    ((a + b) + -b) + -c = a + -c
    a + -c = a - c
    (a + b) - (b + c) = a - c
}

/// Ring identity: a + b - (b - a) = a + a, used by the half-angle
/// identities below (the ring solver times out on it directly, so the
/// subtraction is unfolded explicitly).
theorem ring_add_sub_comm(a: Real, b: Real) {
    a + b - (b - a) = a + a
} by {
    a - b = a + (-b)
    a + b - (b - a) = a + b + (-(b - a))
    neg_distrib(b, -a)
    -(b + (-a)) = -b + -(-a)
    neg_neg(a)
    -(-a) = a
    b - a = b + (-a)
    -(b - a) = -b + a
    a + b + (-(b - a)) = a + b + (-b + a)
    add_assoc(a, b, -b + a)
    a + b + (-b + a) = a + (b + (-b + a))
    add_assoc(b, -b, a)
    b + (-b + a) = (b + (-b)) + a
    a + (b + (-b + a)) = a + ((b + (-b)) + a)
    add_neg_eq_zero(b)
    b + (-b) = Real.0
    a + ((b + (-b)) + a) = a + (Real.0 + a)
    add_zero_left(a)
    Real.0 + a = a
    a + (Real.0 + a) = a + a
    a + b + (-b + a) = a + a
    a + b + (-(b - a)) = a + a
    a + b - (b - a) = a + a
}


/// Ring identity: (a + b) - (a - b) = b + b, used to combine the two
/// halves of the sine addition law into 2 cos(a) sin(b).
theorem ring_sub_sub_comm(a: Real, b: Real) {
    (a + b) - (a - b) = b + b
} by {
    a - b = a + (-b)
    (a + b) - (a - b) = (a + b) + (-(a - b))
    neg_distrib(a, -b)
    -(a + (-b)) = -a + -(-b)
    neg_neg(b)
    -(-b) = b
    -(a - b) = -a + b
    (a + b) + (-(a - b)) = (a + b) + (-a + b)
    add_comm(a, b)
    a + b = b + a
    (a + b) + (-a + b) = (b + a) + (-a + b)
    add_assoc(b, a, -a + b)
    (b + a) + (-a + b) = b + (a + (-a + b))
    add_assoc(a, -a, b)
    a + (-a + b) = (a + -a) + b
    b + (a + (-a + b)) = b + ((a + -a) + b)
    add_neg_eq_zero(a)
    a + -a = Real.0
    b + ((a + -a) + b) = b + (Real.0 + b)
    add_zero_left(b)
    Real.0 + b = b
    b + (Real.0 + b) = b + b
    (a + b) - (a - b) = b + b
}

/// Ring identity: a + b + (a - b) = a + a, the companion of
/// ring_add_sub_comm (same explicit unfolding of the subtraction).
theorem ring_add_sub_comm_b(a: Real, b: Real) {
    a + b + (a - b) = a + a
} by {
    a - b = a + (-b)
    a + b + (a - b) = a + b + (a + (-b))
    add_assoc(a + b, a, -b)
    a + b + (a + (-b)) = (a + b + a) + (-b)
    add_comm(a + b, a)
    (a + b + a) + (-b) = (a + a + b) + (-b)
    add_comm(a + a, b)
    (a + a + b) + (-b) = (b + (a + a)) + (-b)
    add_assoc(b, a + a, -b)
    (b + (a + a)) + (-b) = b + ((a + a) + (-b))
    add_comm(a + a, -b)
    b + ((a + a) + (-b)) = b + ((-b) + (a + a))
    add_assoc(b, -b, a + a)
    b + ((-b) + (a + a)) = (b + (-b)) + (a + a)
    add_neg_eq_zero(b)
    b + (-b) = Real.0
    (b + (-b)) + (a + a) = Real.0 + (a + a)
    add_zero_left(a + a)
    Real.0 + (a + a) = a + a
    a + b + (a - b) = a + a
}

/// 2 sin(x)^2 = 1 - cos(2x), the half-angle identity for sine.
theorem sin_sq_times_two(x: Real) {
    two * (sin(x) * sin(x)) = Real.1 - cos(two * x)
} by {
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    cos(x).pow(Nat.2) = cos(x) * cos(x)
    sin(x) * sin(x) + cos(x) * cos(x) = Real.1
    cos_double(x)
    cos(two * x) = cos(x) * cos(x) - sin(x) * sin(x)
    Real.1 - cos(two * x) = Real.1 - (cos(x) * cos(x) - sin(x) * sin(x))
    Real.1 = sin(x) * sin(x) + cos(x) * cos(x)
    Real.1 - (cos(x) * cos(x) - sin(x) * sin(x)) = (sin(x) * sin(x) + cos(x) * cos(x)) - (cos(x) * cos(x) - sin(x) * sin(x))
    ring_add_sub_comm(sin(x) * sin(x), cos(x) * cos(x))
    (sin(x) * sin(x) + cos(x) * cos(x)) - (cos(x) * cos(x) - sin(x) * sin(x)) = sin(x) * sin(x) + sin(x) * sin(x)
    sin(x) * sin(x) + sin(x) * sin(x) = two * (sin(x) * sin(x))
    Real.1 - (cos(x) * cos(x) - sin(x) * sin(x)) = two * (sin(x) * sin(x))
    two * (sin(x) * sin(x)) = Real.1 - cos(two * x)
}

/// 2 cos(x)^2 = 1 + cos(2x), the half-angle identity for cosine.
theorem cos_sq_times_two(x: Real) {
    two * (cos(x) * cos(x)) = Real.1 + cos(two * x)
} by {
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    cos(x).pow(Nat.2) = cos(x) * cos(x)
    sin(x) * sin(x) + cos(x) * cos(x) = Real.1
    cos_double(x)
    cos(two * x) = cos(x) * cos(x) - sin(x) * sin(x)
    Real.1 + cos(two * x) = Real.1 + (cos(x) * cos(x) - sin(x) * sin(x))
    Real.1 = sin(x) * sin(x) + cos(x) * cos(x)
    Real.1 + (cos(x) * cos(x) - sin(x) * sin(x)) = (sin(x) * sin(x) + cos(x) * cos(x)) + (cos(x) * cos(x) - sin(x) * sin(x))
    add_comm(sin(x) * sin(x), cos(x) * cos(x))
    sin(x) * sin(x) + cos(x) * cos(x) = cos(x) * cos(x) + sin(x) * sin(x)
    (sin(x) * sin(x) + cos(x) * cos(x)) + (cos(x) * cos(x) - sin(x) * sin(x)) = (cos(x) * cos(x) + sin(x) * sin(x)) + (cos(x) * cos(x) - sin(x) * sin(x))
    ring_add_sub_comm_b(cos(x) * cos(x), sin(x) * sin(x))
    (cos(x) * cos(x) + sin(x) * sin(x)) + (cos(x) * cos(x) - sin(x) * sin(x)) = cos(x) * cos(x) + cos(x) * cos(x)
    (sin(x) * sin(x) + cos(x) * cos(x)) + (cos(x) * cos(x) - sin(x) * sin(x)) = cos(x) * cos(x) + cos(x) * cos(x)
    cos(x) * cos(x) + cos(x) * cos(x) = two * (cos(x) * cos(x))
    Real.1 + (cos(x) * cos(x) - sin(x) * sin(x)) = two * (cos(x) * cos(x))
    two * (cos(x) * cos(x)) = Real.1 + cos(two * x)
}

// ---------------------------------------------------------------------------
// Product-to-sum identities: the algebraic heart of orthogonality.  A
// product of two harmonics is a sum of two single harmonics.
// ---------------------------------------------------------------------------

/// 2 sin(x) cos(y) = sin(x + y) + sin(x - y).
theorem product_to_sum_sin_cos(x: Real, y: Real) {
    two * sin(x) * cos(y) = sin(x + y) + sin(x - y)
} by {
    sin_add(x, y)
    sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
    sin_add(x, -y)
    sin(x + (-y)) = sin(x) * cos(-y) + cos(x) * sin(-y)
    x + (-y) = x - y
    sin(x - y) = sin(x) * cos(-y) + cos(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    sin(x) * cos(-y) + cos(x) * sin(-y) = sin(x) * cos(y) - cos(x) * sin(y)
    sin(x - y) = sin(x) * cos(y) - cos(x) * sin(y)
    sin(x + y) + sin(x - y) = sin(x) * cos(y) + cos(x) * sin(y) + (sin(x) * cos(y) - cos(x) * sin(y))
    ring_add_sub_comm_b(sin(x) * cos(y), cos(x) * sin(y))
    sin(x) * cos(y) + cos(x) * sin(y) + (sin(x) * cos(y) - cos(x) * sin(y)) = sin(x) * cos(y) + sin(x) * cos(y)
    sin(x) * cos(y) + sin(x) * cos(y) = two * sin(x) * cos(y)
    sin(x + y) + sin(x - y) = two * sin(x) * cos(y)
    two * sin(x) * cos(y) = sin(x + y) + sin(x - y)
}

/// 2 sin(x) sin(y) = cos(x - y) - cos(x + y).
theorem product_to_sum_sin_sin(x: Real, y: Real) {
    two * sin(x) * sin(y) = cos(x - y) - cos(x + y)
} by {
    cos_add(x, y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    cos_add(x, -y)
    cos(x + (-y)) = cos(x) * cos(-y) - sin(x) * sin(-y)
    x + (-y) = x - y
    cos(x - y) = cos(x) * cos(-y) - sin(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    cos(x) * cos(-y) - sin(x) * sin(-y) = cos(x) * cos(y) + sin(x) * sin(y)
    cos(x - y) = cos(x) * cos(y) + sin(x) * sin(y)
    cos(x - y) - cos(x + y) = (cos(x) * cos(y) + sin(x) * sin(y)) - (cos(x) * cos(y) - sin(x) * sin(y))
    ring_add_sub_comm(sin(x) * sin(y), cos(x) * cos(y))
    (sin(x) * sin(y) + cos(x) * cos(y)) - (cos(x) * cos(y) - sin(x) * sin(y)) = sin(x) * sin(y) + sin(x) * sin(y)
    add_comm(sin(x) * sin(y), cos(x) * cos(y))
    sin(x) * sin(y) + cos(x) * cos(y) = cos(x) * cos(y) + sin(x) * sin(y)
    (cos(x) * cos(y) + sin(x) * sin(y)) - (cos(x) * cos(y) - sin(x) * sin(y)) = sin(x) * sin(y) + sin(x) * sin(y)
    sin(x) * sin(y) + sin(x) * sin(y) = two * sin(x) * sin(y)
    cos(x - y) - cos(x + y) = two * sin(x) * sin(y)
    two * sin(x) * sin(y) = cos(x - y) - cos(x + y)
}

/// 2 cos(x) cos(y) = cos(x + y) + cos(x - y).
theorem product_to_sum_cos_cos(x: Real, y: Real) {
    two * cos(x) * cos(y) = cos(x + y) + cos(x - y)
} by {
    cos_add(x, y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    cos_add(x, -y)
    cos(x + (-y)) = cos(x) * cos(-y) - sin(x) * sin(-y)
    x + (-y) = x - y
    cos(x - y) = cos(x) * cos(-y) - sin(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    cos(x) * cos(-y) - sin(x) * sin(-y) = cos(x) * cos(y) + sin(x) * sin(y)
    cos(x - y) = cos(x) * cos(y) + sin(x) * sin(y)
    cos(x + y) + cos(x - y) = (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) + sin(x) * sin(y))
    add_comm(cos(x) * cos(y) - sin(x) * sin(y), cos(x) * cos(y) + sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) + sin(x) * sin(y)) = (cos(x) * cos(y) + sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * sin(y))
    ring_add_sub_comm_b(cos(x) * cos(y), sin(x) * sin(y))
    (cos(x) * cos(y) + sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * sin(y)) = cos(x) * cos(y) + cos(x) * cos(y)
    cos(x) * cos(y) + cos(x) * cos(y) = two * cos(x) * cos(y)
    cos(x + y) + cos(x - y) = two * cos(x) * cos(y)
    two * cos(x) * cos(y) = cos(x + y) + cos(x - y)
}

// ---------------------------------------------------------------------------
// Boundedness, Lipschitz, and continuity of sin * cos
// ---------------------------------------------------------------------------

/// The product sin * cos.
define sincos(x: Real) -> Real {
    sin(x) * cos(x)
}

/// The product sin * cos is bounded in absolute value by one.
theorem sincos_abs_le_one(x: Real) {
    sincos(x).abs <= Real.1
} by {
    sincos(x) = sin(x) * cos(x)
    sin_abs_le_one(x)
    sin(x).abs <= Real.1
    cos_abs_le_one(x)
    cos(x).abs <= Real.1
    mul_abs(sin(x), cos(x))
    (sin(x) * cos(x)).abs = sin(x).abs * cos(x).abs
    abs_gte_zero(cos(x))
    Real.0 <= cos(x).abs
    mul_le_mul_of_nonneg_right(sin(x).abs, Real.1, cos(x).abs)
    sin(x).abs * cos(x).abs <= Real.1 * cos(x).abs
    Real.1 * cos(x).abs = cos(x).abs
    sin(x).abs * cos(x).abs <= cos(x).abs
    lte_trans(sin(x).abs * cos(x).abs, cos(x).abs, Real.1)
    sincos(x).abs <= Real.1
}

/// The product sin * cos is at most one.
theorem sincos_le_one(x: Real) {
    sincos(x) <= Real.1
} by {
    sincos_abs_le_one(x)
    sincos(x).abs <= Real.1
    lte_abs(sincos(x))
    sincos(x) <= sincos(x).abs
    lte_trans(sincos(x), sincos(x).abs, Real.1)
    sincos(x) <= Real.1
}

/// The product sin * cos is at least negative one.
theorem sincos_ge_neg_one(x: Real) {
    -Real.1 <= sincos(x)
} by {
    sincos_abs_le_one(x)
    sincos(x).abs <= Real.1
    lte_abs(-sincos(x))
    -sincos(x) <= (-sincos(x)).abs
    abs_neg(sincos(x))
    (-sincos(x)).abs = sincos(x).abs
    -sincos(x) <= sincos(x).abs
    lte_trans(-sincos(x), sincos(x).abs, Real.1)
    -sincos(x) <= Real.1
    neg_lte_flip(-sincos(x), Real.1)
    -Real.1 <= -(-sincos(x))
    neg_neg(sincos(x))
    -(-sincos(x)) = sincos(x)
    -Real.1 <= sincos(x)
}

/// sin * cos is two-Lipschitz: |sin(u)cos(u) - sin(v)cos(v)| <= 2 |u - v|.
theorem sincos_lipschitz_m2(u: Real, v: Real) {
    (sincos(u) - sincos(v)).abs <= two * (u - v).abs
} by {
    sincos(u) = sin(u) * cos(u)
    sincos(v) = sin(v) * cos(v)
    sincos(u) - sincos(v) = sin(u) * cos(u) - sin(v) * cos(v)
    (sincos(u) - sincos(v)).abs <= (sin(u) * cos(u) - sin(v) * cos(v)).abs
    mul_sub_distrib_right(sin(u), cos(u), cos(v))
    sin(u) * (cos(u) - cos(v)) = sin(u) * cos(u) - sin(u) * cos(v)
    mul_sub_distrib_left(sin(u), sin(v), cos(v))
    (sin(u) - sin(v)) * cos(v) = sin(u) * cos(v) - sin(v) * cos(v)
    real_mul_comm(sin(u) - sin(v), cos(v))
    (sin(u) - sin(v)) * cos(v) = cos(v) * (sin(u) - sin(v))
    real_mul_comm(sin(v), cos(v))
    sin(v) * cos(v) = cos(v) * sin(v)
    sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v)) =
        sin(u) * cos(u) - sin(u) * cos(v) + (sin(u) * cos(v) - sin(v) * cos(v))
    sin(u) * cos(u) - sin(u) * cos(v) + (sin(u) * cos(v) - sin(v) * cos(v)) =
        sin(u) * cos(u) - sin(u) * cos(v) + (sin(u) * cos(v) - cos(v) * sin(v))
    add_sub_sub_cancel(sin(u) * cos(u), sin(u) * cos(v), cos(v) * sin(v))
    (sin(u) * cos(u) - sin(u) * cos(v)) + (sin(u) * cos(v) - cos(v) * sin(v)) = sin(u) * cos(u) - cos(v) * sin(v)
    sin(u) * cos(u) - sin(u) * cos(v) + (sin(u) * cos(v) - cos(v) * sin(v)) = sin(u) * cos(u) - cos(v) * sin(v)
    sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v)) = sin(u) * cos(u) - cos(v) * sin(v)
    sin(u) * cos(u) - sin(v) * cos(v) = sin(u) * cos(u) - cos(v) * sin(v)
    sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v)) = sin(u) * cos(u) - sin(v) * cos(v)
    sin(u) * cos(u) - sin(v) * cos(v) = sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v))
    (sin(u) * cos(u) - sin(v) * cos(v)).abs <= (sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v))).abs
    triangle_ineq(sin(u) * (cos(u) - cos(v)), cos(v) * (sin(u) - sin(v)))
    (sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v))).abs <= (sin(u) * (cos(u) - cos(v))).abs + (cos(v) * (sin(u) - sin(v))).abs
    mul_abs(sin(u), cos(u) - cos(v))
    (sin(u) * (cos(u) - cos(v))).abs = sin(u).abs * (cos(u) - cos(v)).abs
    mul_abs(cos(v), sin(u) - sin(v))
    (cos(v) * (sin(u) - sin(v))).abs = cos(v).abs * (sin(u) - sin(v)).abs
    (sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v))).abs <= sin(u).abs * (cos(u) - cos(v)).abs + cos(v).abs * (sin(u) - sin(v)).abs
    sin_abs_le_one(u)
    sin(u).abs <= Real.1
    cos_lipschitz(u, v)
    (cos(u) - cos(v)).abs <= (u - v).abs
    abs_gte_zero(cos(u) - cos(v))
    Real.0 <= (cos(u) - cos(v)).abs
    mul_le_mul_of_nonneg_right(sin(u).abs, Real.1, (cos(u) - cos(v)).abs)
    sin(u).abs * (cos(u) - cos(v)).abs <= Real.1 * (cos(u) - cos(v)).abs
    Real.1 * (cos(u) - cos(v)).abs = (cos(u) - cos(v)).abs
    sin(u).abs * (cos(u) - cos(v)).abs <= (cos(u) - cos(v)).abs
    lte_trans(sin(u).abs * (cos(u) - cos(v)).abs, (cos(u) - cos(v)).abs, (u - v).abs)
    sin(u).abs * (cos(u) - cos(v)).abs <= (u - v).abs
    cos_abs_le_one(v)
    cos(v).abs <= Real.1
    sin_lipschitz(u, v)
    (sin(u) - sin(v)).abs <= (u - v).abs
    abs_gte_zero(sin(u) - sin(v))
    Real.0 <= (sin(u) - sin(v)).abs
    mul_le_mul_of_nonneg_right(cos(v).abs, Real.1, (sin(u) - sin(v)).abs)
    cos(v).abs * (sin(u) - sin(v)).abs <= Real.1 * (sin(u) - sin(v)).abs
    Real.1 * (sin(u) - sin(v)).abs = (sin(u) - sin(v)).abs
    cos(v).abs * (sin(u) - sin(v)).abs <= (sin(u) - sin(v)).abs
    lte_trans(cos(v).abs * (sin(u) - sin(v)).abs, (sin(u) - sin(v)).abs, (u - v).abs)
    cos(v).abs * (sin(u) - sin(v)).abs <= (u - v).abs
    add_le_add(sin(u).abs * (cos(u) - cos(v)).abs, (u - v).abs, cos(v).abs * (sin(u) - sin(v)).abs, (u - v).abs)
    sin(u).abs * (cos(u) - cos(v)).abs + cos(v).abs * (sin(u) - sin(v)).abs <= (u - v).abs + (u - v).abs
    (u - v).abs + (u - v).abs = two * (u - v).abs
    sin(u).abs * (cos(u) - cos(v)).abs + cos(v).abs * (sin(u) - sin(v)).abs <= two * (u - v).abs
    lte_trans((sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v))).abs, sin(u).abs * (cos(u) - cos(v)).abs + cos(v).abs * (sin(u) - sin(v)).abs, two * (u - v).abs)
    (sin(u) * (cos(u) - cos(v)) + cos(v) * (sin(u) - sin(v))).abs <= two * (u - v).abs
    (sin(u) * cos(u) - sin(v) * cos(v)).abs <= two * (u - v).abs
    (sincos(u) - sincos(v)).abs <= two * (u - v).abs
}

/// The product sin * cos is continuous.
theorem sincos_continuous {
    continuous(sincos)
} by {
    sin_continuous
    continuous(sin)
    cos_continuous
    continuous(cos)
    continuous_pointwise_mul(sin, cos)
    continuous(pointwise_mul[Real, Real](sin, cos))
    forall(x: Real) {
        pointwise_mul[Real, Real](sin, cos)(x) = sin(x) * cos(x)
        sincos(x) = sin(x) * cos(x)
        pointwise_mul[Real, Real](sin, cos)(x) = sincos(x)
    }
    function_extensionality(pointwise_mul[Real, Real](sin, cos), sincos)
    pointwise_mul[Real, Real](sin, cos) = sincos
    continuous(sincos)
}

// ---------------------------------------------------------------------------
// The integral of sin * cos over [0, 2*pi] is zero: the first genuine
// orthogonality instance among the harmonics.  The antiderivative of
// sin * cos is sin^2 / 2 (by the product rule and sin' = cos), and the
// fundamental theorem gives integral(sin cos, 0, 2*pi) = sin(2*pi)^2/2 -
// sin(0)^2/2 = 0.
// ---------------------------------------------------------------------------

/// The pointwise function x -> sin(x) * sin(x) is the square of sine.
define sin_sq_fn(x: Real) -> Real {
    sin(x) * sin(x)
}

/// sin(x)^2 / 2, the antiderivative of sin * cos.
define sincos_antiderivative(x: Real) -> Real {
    Real.one_half * sin_sq_fn(x)
}

/// The pointwise derivative of sin^2 is 2 sin cos.
theorem sin_sq_derivative {
    is_derivative_fn(sin_sq_fn, pointwise_mul(constant[Real, Real](two), sincos))
} by {
    sin_is_derivative_fn
    is_derivative_fn(sin, cos)
    derivative_fn_square(sin, cos)
    is_derivative_fn(pointwise_mul(sin, sin), pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)))
    forall(x: Real) {
        pointwise_mul(sin, sin)(x) = sin(x) * sin(x)
        sin_sq_fn(x) = sin(x) * sin(x)
        pointwise_mul(sin, sin)(x) = sin_sq_fn(x)
        pointwise_add_apply(pointwise_mul(sin, cos), pointwise_mul(sin, cos), x)
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos))(x) =
            pointwise_mul(sin, cos)(x) + pointwise_mul(sin, cos)(x)
        pointwise_mul_apply(sin, cos, x)
        pointwise_mul(sin, cos)(x) = sin(x) * cos(x)
        sincos(x) = sin(x) * cos(x)
        pointwise_mul(sin, cos)(x) = sincos(x)
        pointwise_mul(sin, cos)(x) + pointwise_mul(sin, cos)(x) = sincos(x) + sincos(x)
        sincos(x) + sincos(x) = two * sincos(x)
        pointwise_mul_apply(constant[Real, Real](two), sincos, x)
        pointwise_mul(constant[Real, Real](two), sincos)(x) = constant[Real, Real](two, x) * sincos(x)
        constant[Real, Real](two, x) = two
        pointwise_mul(constant[Real, Real](two), sincos)(x) = two * sincos(x)
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos))(x) =
            pointwise_mul(constant[Real, Real](two), sincos)(x)
    }
    function_extensionality(pointwise_mul(sin, sin), sin_sq_fn)
    pointwise_mul(sin, sin) = sin_sq_fn
    function_extensionality(
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)),
        pointwise_mul(constant[Real, Real](two), sincos))
    pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)) =
        pointwise_mul(constant[Real, Real](two), sincos)
    is_derivative_fn(sin_sq_fn, pointwise_mul(constant[Real, Real](two), sincos))
}

/// The pointwise derivative of sin^2 / 2 is sin * cos.
theorem sincos_antiderivative_derivative {
    is_derivative_fn(sincos_antiderivative, sincos)
} by {
    sin_sq_derivative
    is_derivative_fn(sin_sq_fn, pointwise_mul(constant[Real, Real](two), sincos))
    derivative_fn_const_mul(Real.one_half, sin_sq_fn, pointwise_mul(constant[Real, Real](two), sincos))
    is_derivative_fn(
        pointwise_mul(constant[Real, Real](Real.one_half), sin_sq_fn),
        pointwise_mul(constant[Real, Real](Real.one_half), pointwise_mul(constant[Real, Real](two), sincos)))
    forall(x: Real) {
        pointwise_mul_apply(constant[Real, Real](Real.one_half), sin_sq_fn, x)
        pointwise_mul(constant[Real, Real](Real.one_half), sin_sq_fn)(x) =
            constant[Real, Real](Real.one_half, x) * sin_sq_fn(x)
        constant[Real, Real](Real.one_half, x) = Real.one_half
        pointwise_mul(constant[Real, Real](Real.one_half), sin_sq_fn)(x) = Real.one_half * sin_sq_fn(x)
        sincos_antiderivative(x) = Real.one_half * sin_sq_fn(x)
        pointwise_mul(constant[Real, Real](Real.one_half), sin_sq_fn)(x) = sincos_antiderivative(x)
    }
    function_extensionality(
        pointwise_mul(constant[Real, Real](Real.one_half), sin_sq_fn), sincos_antiderivative)
    pointwise_mul(constant[Real, Real](Real.one_half), sin_sq_fn) = sincos_antiderivative
    forall(x: Real) {
        pointwise_mul_apply(constant[Real, Real](Real.one_half), pointwise_mul(constant[Real, Real](two), sincos), x)
        pointwise_mul(constant[Real, Real](Real.one_half), pointwise_mul(constant[Real, Real](two), sincos))(x) =
            constant[Real, Real](Real.one_half, x) * pointwise_mul(constant[Real, Real](two), sincos)(x)
        pointwise_mul_apply(constant[Real, Real](two), sincos, x)
        pointwise_mul(constant[Real, Real](two), sincos)(x) = constant[Real, Real](two, x) * sincos(x)
        pointwise_mul(constant[Real, Real](Real.one_half), pointwise_mul(constant[Real, Real](two), sincos))(x) =
            Real.one_half * (two * sincos(x))
        one_half_plus_one_half
        Real.one_half + Real.one_half = Real.1
        Real.one_half * two = Real.1
        mul_assoc(Real.one_half, two, sincos(x))
        Real.one_half * (two * sincos(x)) = (Real.one_half * two) * sincos(x)
        (Real.one_half * two) * sincos(x) = Real.1 * sincos(x)
        Real.1 * sincos(x) = sincos(x)
        Real.one_half * (two * sincos(x)) = sincos(x)
        pointwise_mul(constant[Real, Real](Real.one_half), pointwise_mul(constant[Real, Real](two), sincos))(x) =
            sincos(x)
    }
    function_extensionality(
        pointwise_mul(constant[Real, Real](Real.one_half), pointwise_mul(constant[Real, Real](two), sincos)),
        sincos)
    pointwise_mul(constant[Real, Real](Real.one_half), pointwise_mul(constant[Real, Real](two), sincos)) =
        sincos
    is_derivative_fn(sincos_antiderivative, sincos)
}

/// The antiderivative sin^2 / 2 of sin * cos is continuous.
theorem sincos_antiderivative_continuous {
    continuous(sincos_antiderivative)
} by {
    sin_continuous
    continuous(sin)
    continuous_pointwise_mul(sin, sin)
    continuous(pointwise_mul[Real, Real](sin, sin))
    forall(x: Real) {
        pointwise_mul[Real, Real](sin, sin)(x) = sin(x) * sin(x)
        sin_sq_fn(x) = sin(x) * sin(x)
        pointwise_mul[Real, Real](sin, sin)(x) = sin_sq_fn(x)
    }
    function_extensionality(pointwise_mul[Real, Real](sin, sin), sin_sq_fn)
    pointwise_mul[Real, Real](sin, sin) = sin_sq_fn
    continuous(sin_sq_fn)
    continuous_const_mul_left(Real.one_half, sin_sq_fn)
    continuous(sin_sq_fn) implies continuous(const_mul_left(Real.one_half, sin_sq_fn))
    continuous(const_mul_left(Real.one_half, sin_sq_fn))
    forall(x: Real) {
        const_mul_left(Real.one_half, sin_sq_fn)(x) = Real.one_half * sin_sq_fn(x)
        sincos_antiderivative(x) = Real.one_half * sin_sq_fn(x)
        const_mul_left(Real.one_half, sin_sq_fn)(x) = sincos_antiderivative(x)
    }
    function_extensionality(const_mul_left(Real.one_half, sin_sq_fn), sincos_antiderivative)
    const_mul_left(Real.one_half, sin_sq_fn) = sincos_antiderivative
    continuous(sincos_antiderivative)
}

/// sin * cos is integrable on [0, 2*pi].
theorem sincos_integrable_zero_two_pi {
    is_integrable(sincos, Real.0, two * pi)
} by {
    two_pi_pos
    Real.0 < two * pi
