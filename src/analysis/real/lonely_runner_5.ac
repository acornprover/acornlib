/// Division distributes over addition when the denominator is nonzero.
theorem div_add_distrib_local(a: Real, b: Real, c: Real) {
    c != Real.0 implies (a + b) / c = a / c + b / c
} by {
    if c != Real.0 {
        (a + b) * c.inverse = a * c.inverse + b * c.inverse
        ((a + b) / c = (a + b) * c.inverse)
        (a / c = a * c.inverse)
        (b / c = b * c.inverse)
        (a + b) / c = a / c + b / c
    }
}

