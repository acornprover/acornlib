theorem nat_lt_three_six {
    Nat.3 < Nat.6
} by {
    lt_add_suc(Nat.3, Nat.2)
    Nat.3 < Nat.3 + Nat.2.suc
    (Nat.3 + Nat.2.suc = Nat.6)
    Nat.3 < Nat.6
