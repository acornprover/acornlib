        c <= y
        is_set_upper_bound(s, c) = forall(z: Real) { s.contains(z) implies z <= c }
        s.contains(x) implies x <= c
        x <= c
        closed_interval(x, y, c)
        closed_interval_set_contains_eq(x, y, c)
