        pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))))
    derivative_fn_identity
    is_derivative_fn(identity_fn[Real], constant[Real, Real](Real.1))
    derivative_fn_add(identity_fn[Real], pointwise_neg(pointwise_mul(sin, cos)),
        constant[Real, Real](Real.1),
        pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))))
    is_derivative_fn(pointwise_add(identity_fn[Real], pointwise_neg(pointwise_mul(sin, cos))),
        pointwise_add(constant[Real, Real](Real.1),
            pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)))))
    derivative_fn_const_mul(Real.1 / two,
        pointwise_add(identity_fn[Real], pointwise_neg(pointwise_mul(sin, cos))),
        pointwise_add(constant[Real, Real](Real.1),
            pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)))))
    is_derivative_fn(g_sin_sq,
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(constant[Real, Real](Real.1),
                pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))))))
    forall(x: Real) {
        pointwise_mul_apply(constant[Real, Real](Real.1 / two),
            pointwise_add(constant[Real, Real](Real.1),
                pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)))), x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(constant[Real, Real](Real.1),
                pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)))), x) =
            constant[Real, Real](Real.1 / two, x) * pointwise_add(constant[Real, Real](Real.1),
                pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))), x)
        constant[Real, Real](Real.1 / two, x) = Real.1 / two
        pointwise_add_apply(constant[Real, Real](Real.1),
            pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))), x)
        pointwise_add(constant[Real, Real](Real.1),
            pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))), x) =
            constant[Real, Real](Real.1, x) + pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)), x)
        constant[Real, Real](Real.1, x) = Real.1
        pointwise_neg_apply(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)), x)
        pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)), x) =
            -(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos), x))
        pointwise_add_apply(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos), x)
        pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos), x) =
            pointwise_mul(sin, pointwise_neg(sin), x) + pointwise_mul(cos, cos, x)
        pointwise_mul_apply(sin, pointwise_neg(sin), x)
        pointwise_mul(sin, pointwise_neg(sin), x) = sin(x) * pointwise_neg(sin, x)
        pointwise_neg_apply(sin, x)
        pointwise_neg(sin, x) = -sin(x)
        pointwise_mul_apply(cos, cos, x)
        pointwise_mul(cos, cos, x) = cos(x) * cos(x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(constant[Real, Real](Real.1),
                pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)))), x) =
            (Real.1 / two) * (Real.1 + -(sin(x) * pointwise_neg(sin, x) + cos(x) * cos(x)))
        pointwise_neg(sin, x) = -sin(x)
        (Real.1 / two) * (Real.1 + -(sin(x) * pointwise_neg(sin, x) + cos(x) * cos(x))) =
            (Real.1 / two) * (Real.1 + -(sin(x) * -sin(x) + cos(x) * cos(x)))
        sin(x) * -sin(x) = -(sin(x) * sin(x))
        (Real.1 / two) * (Real.1 + -(sin(x) * -sin(x) + cos(x) * cos(x))) =
            (Real.1 / two) * (Real.1 + sin(x) * sin(x) - cos(x) * cos(x))
        half_pythag_sin_sq(x)
        Real.1 + sin(x) * sin(x) - cos(x) * cos(x) = two * (sin(x) * sin(x))
        half_pythag_then_sin(x)
        (Real.1 / two) * (Real.1 + sin(x) * sin(x) - cos(x) * cos(x)) =
            sin(x) * sin(x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(constant[Real, Real](Real.1),
                pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)))), x) =
            sin(x) * sin(x)
        fn_sin_sq(x) = sin(x) * sin(x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(constant[Real, Real](Real.1),
                pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos)))), x) =
            fn_sin_sq(x)
    }
    function_extensionality(pointwise_mul(constant[Real, Real](Real.1 / two),
        pointwise_add(constant[Real, Real](Real.1),
            pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))))),
        fn_sin_sq)
    pointwise_mul(constant[Real, Real](Real.1 / two),
        pointwise_add(constant[Real, Real](Real.1),
            pointwise_neg(pointwise_add(pointwise_mul(sin, pointwise_neg(sin)), pointwise_mul(cos, cos))))) =
        fn_sin_sq
    is_derivative_fn(g_sin_sq, fn_sin_sq)
}

