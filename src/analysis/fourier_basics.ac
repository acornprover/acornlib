    (u.sin * u.sin + u.sin * v.sin) - (v.sin * u.sin + v.sin * v.sin) =
        (u.sin * u.sin + v.sin * u.sin) - (v.sin * u.sin + v.sin * v.sin)
    add_sub_add_cancel(u.sin * u.sin, v.sin * u.sin, v.sin * v.sin)
