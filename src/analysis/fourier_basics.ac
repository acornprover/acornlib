    lte_trans[Real]((fn_sincos(u) - fn_sincos(v)).abs,
        (sin(u) - sin(v)).abs * cos(u).abs + (cos(u) - cos(v)).abs * sin(v).abs,
        two * (u - v).abs)
    (fn_sincos(u) - fn_sincos(v)).abs <= two * (u - v).abs
}

