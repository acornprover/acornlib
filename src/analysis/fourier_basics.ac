        sin_abs_le_one(x)
        sin(x).abs <= Real.1
        abs_gte_zero(x)
        Real.0 <= x.abs
        mul_le_mul_of_nonneg_right(x.abs, two_pi, sin(x).abs)
        x.abs <= two_pi implies x.abs * sin(x).abs <= two_pi * sin(x).abs
        abs_gte_zero(sin(x))
        Real.0 <= sin(x).abs
        x.abs * sin(x).abs <= two_pi * sin(x).abs
        mul_le_mul_of_nonneg_left(sin(x).abs, Real.1, two_pi)
        sin(x).abs <= Real.1 implies two_pi * sin(x).abs <= two_pi * Real.1
        two_pi * sin(x).abs <= two_pi * Real.1
        two_pi * Real.1 = two_pi
        two_pi * sin(x).abs <= two_pi
        lte_trans[Real](x.abs * sin(x).abs, two_pi * sin(x).abs, two_pi)
        x.abs * sin(x).abs <= two_pi
        (x * sin(x)).abs <= two_pi
        fn_x_sin(x).abs <= two_pi
