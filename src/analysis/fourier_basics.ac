/// |x.sin^2 - y.sin^2| <= 2|x - y|.
theorem fn_sin_sq_lipschitz_m2(u: Real, v: Real) {
    (fn_sin_sq(u) - fn_sin_sq(v)).abs <= two * (u - v).abs
