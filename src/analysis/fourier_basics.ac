    cos(u).abs <= Real.1
    abs_gte_zero((u - v).abs)
    Real.0 <= (u - v).abs
    mul_le_mul_of_nonneg_left(cos(u).abs, Real.1, (u - v).abs)
    (u - v).abs * cos(u).abs <= (u - v).abs * Real.1
    (u - v).abs * Real.1 = (u - v).abs
    (u - v).abs * cos(u).abs <= (u - v).abs
    lte_trans[Real]((sin(u) - sin(v)).abs * cos(u).abs, (u - v).abs * cos(u).abs, (u - v).abs)
    (sin(u) - sin(v)).abs * cos(u).abs <= (u - v).abs
    cos_lipschitz(u, v)
    (cos(u) - cos(v)).abs <= (u - v).abs
    abs_gte_zero(sin(v))
    Real.0 <= sin(v).abs
    mul_le_mul_of_nonneg_right((cos(u) - cos(v)).abs, (u - v).abs, sin(v).abs)
    (cos(u) - cos(v)).abs * sin(v).abs <= (u - v).abs * sin(v).abs
    sin_abs_le_one(v)
    sin(v).abs <= Real.1
    mul_le_mul_of_nonneg_left(sin(v).abs, Real.1, (u - v).abs)
    (u - v).abs * sin(v).abs <= (u - v).abs * Real.1
    (u - v).abs * sin(v).abs <= (u - v).abs
    lte_trans[Real]((cos(u) - cos(v)).abs * sin(v).abs, (u - v).abs * sin(v).abs, (u - v).abs)
    (cos(u) - cos(v)).abs * sin(v).abs <= (u - v).abs
    add_le_add(
        (sin(u) - sin(v)).abs * cos(u).abs, (u - v).abs,
        (cos(u) - cos(v)).abs * sin(v).abs, (u - v).abs)
