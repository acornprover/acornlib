    ((sin(u) - sin(v)) * cos(u) + sin(v) * (cos(u) - cos(v))).abs <= ((sin(u) - sin(v)) * cos(u)).abs + (sin(v) * (cos(u) - cos(v))).abs
    mul_abs(sin(u) - sin(v), cos(u))
    ((sin(u) - sin(v)) * cos(u)).abs = (sin(u) - sin(v)).abs * cos(u).abs
    mul_abs(sin(v), cos(u) - cos(v))
    (sin(v) * (cos(u) - cos(v))).abs = sin(v).abs * (cos(u) - cos(v)).abs
    (fn_sincos(u) - fn_sincos(v)).abs <= (sin(u) - sin(v)).abs * cos(u).abs + sin(v).abs * (cos(u) - cos(v)).abs
    sin_lipschitz(u, v)
    (sin(u) - sin(v)).abs <= (u - v).abs
    abs_gte_zero(cos(u))
    Real.0 <= cos(u).abs
    mul_le_mul_of_nonneg_right((sin(u) - sin(v)).abs, (u - v).abs, cos(u).abs)
