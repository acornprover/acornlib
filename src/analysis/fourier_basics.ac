                pointwise_neg(pointwise_add(pointwise_mul(Real.sin, pointwise_neg(Real.sin)), pointwise_mul(Real.cos, Real.cos)))), x) =
            (Real.1 / two) * (Real.1 + -(x.sin * pointwise_neg(Real.sin, x) + x.cos * x.cos))
