/// |x.sin(2x).sin - y.sin(2y).sin| <= 3|x - y|.
theorem fn_sin_sin2_lipschitz_m3(u: Real, v: Real) {
    (fn_sin_sin2(u) - fn_sin_sin2(v)).abs <= from_nat[Real](Nat.3) * (u - v).abs
