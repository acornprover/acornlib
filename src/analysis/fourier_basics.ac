            -(pointwise_add(pointwise_mul(Real.sin, pointwise_neg(Real.sin)), pointwise_mul(Real.cos, Real.cos), x))
        pointwise_add_apply(pointwise_mul(Real.sin, pointwise_neg(Real.sin)), pointwise_mul(Real.cos, Real.cos), x)
