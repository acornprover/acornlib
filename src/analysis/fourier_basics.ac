    Real.1 * (u - v).abs = (u - v).abs
    from_nat[Real](Nat.3) * (u - v).abs = (u - v).abs + two * (u - v).abs
    (u - v).abs + two * (u - v).abs = from_nat[Real](Nat.3) * (u - v).abs
    (sin(u) - sin(v)).abs * sin(two * u).abs +
        (sin(two * u) - sin(two * v)).abs * sin(v).abs <= from_nat[Real](Nat.3) * (u - v).abs
    lte_trans[Real]((fn_sin_sin2(u) - fn_sin_sin2(v)).abs,
        (sin(u) - sin(v)).abs * sin(two * u).abs +
            (sin(two * u) - sin(two * v)).abs * sin(v).abs,
        from_nat[Real](Nat.3) * (u - v).abs)
    (fn_sin_sin2(u) - fn_sin_sin2(v)).abs <= from_nat[Real](Nat.3) * (u - v).abs
}

/// |x sin(x) - y sin(y)| <= (1 + 2pi)|x - y| on [0, 2pi].
theorem fn_x_sin_lipschitz_on(u: Real, v: Real) {
    interval_contains(Real.0, two_pi, u) and interval_contains(Real.0, two_pi, v)
    implies
    (fn_x_sin(u) - fn_x_sin(v)).abs <= (Real.1 + two_pi) * (u - v).abs
} by {
    if interval_contains(Real.0, two_pi, u) and interval_contains(Real.0, two_pi, v) {
        fn_x_sin(u) = identity_fn[Real](u) * sin(u)
        identity_fn[Real](u) = u
        fn_x_sin(u) = u * sin(u)
        fn_x_sin(v) = identity_fn[Real](v) * sin(v)
        identity_fn[Real](v) = v
        fn_x_sin(v) = v * sin(v)
        fn_x_sin(u) - fn_x_sin(v) = u * sin(u) - v * sin(v)
        mul_sub_distrib_left(u, v, sin(u))
        (u - v) * sin(u) = u * sin(u) - v * sin(u)
        mul_sub_distrib_left(v, sin(u), sin(v))
        v * (sin(u) - sin(v)) = v * sin(u) - v * sin(v)
        (u - v) * sin(u) + v * (sin(u) - sin(v)) =
            (u * sin(u) - v * sin(u)) + (v * sin(u) - v * sin(v))
        add_sub_sub_cancel(u * sin(u), v * sin(u), v * sin(v))
        (u * sin(u) - v * sin(u)) + (v * sin(u) - v * sin(v)) =
            u * sin(u) - v * sin(v)
        (u - v) * sin(u) + v * (sin(u) - sin(v)) =
            u * sin(u) - v * sin(v)
        (fn_x_sin(u) - fn_x_sin(v)).abs <= ((u - v) * sin(u) + v * (sin(u) - sin(v))).abs
        triangle_ineq((u - v) * sin(u), v * (sin(u) - sin(v)))
        ((u - v) * sin(u) + v * (sin(u) - sin(v))).abs <= ((u - v) * sin(u)).abs + (v * (sin(u) - sin(v))).abs
        mul_abs(u - v, sin(u))
        ((u - v) * sin(u)).abs = (u - v).abs * sin(u).abs
        mul_abs(v, sin(u) - sin(v))
        (v * (sin(u) - sin(v))).abs = v.abs * (sin(u) - sin(v)).abs
        (fn_x_sin(u) - fn_x_sin(v)).abs <= (u - v).abs * sin(u).abs + v.abs * (sin(u) - sin(v)).abs
        sin_abs_le_one(u)
        sin(u).abs <= Real.1
        abs_gte_zero((u - v).abs)
        Real.0 <= (u - v).abs
        mul_le_mul_of_nonneg_left(sin(u).abs, Real.1, (u - v).abs)
        (u - v).abs * sin(u).abs <= (u - v).abs * Real.1
        (u - v).abs * Real.1 = (u - v).abs
        (u - v).abs * sin(u).abs <= (u - v).abs
        interval_contains_left(Real.0, two_pi, v)
        interval_contains(Real.0, two_pi, v) implies Real.0 <= v
        Real.0 <= v
        interval_contains_right(Real.0, two_pi, v)
        interval_contains(Real.0, two_pi, v) implies v <= two_pi
        v <= two_pi
        abs_of_nonneg(v)
        v >= Real.0 implies v.abs = v
        v >= Real.0
        v.abs = v
        v.abs <= two_pi
        sin_lipschitz(u, v)
        (sin(u) - sin(v)).abs <= (u - v).abs
        abs_gte_zero(v.abs)
        Real.0 <= v.abs
        mul_le_mul_of_nonneg_right((sin(u) - sin(v)).abs, (u - v).abs, v.abs)
        (sin(u) - sin(v)).abs * v.abs <= (u - v).abs * v.abs
        abs_gte_zero((u - v).abs)
        Real.0 <= (u - v).abs
        mul_le_mul_of_nonneg_left(v.abs, two_pi, (u - v).abs)
        v.abs <= two_pi implies (u - v).abs * v.abs <= (u - v).abs * two_pi
        (u - v).abs * v.abs <= (u - v).abs * two_pi
        (u - v).abs * two_pi = two_pi * (u - v).abs
        (u - v).abs * v.abs <= two_pi * (u - v).abs
        lte_trans[Real]((sin(u) - sin(v)).abs * v.abs, (u - v).abs * v.abs,
            two_pi * (u - v).abs)
        (sin(u) - sin(v)).abs * v.abs <= two_pi * (u - v).abs
        add_le_add((u - v).abs * sin(u).abs, (u - v).abs,
            (sin(u) - sin(v)).abs * v.abs, two_pi * (u - v).abs)
        (u - v).abs * sin(u).abs + (sin(u) - sin(v)).abs * v.abs <= (u - v).abs + two_pi * (u - v).abs
        (u - v).abs + two_pi * (u - v).abs = (Real.1 + two_pi) * (u - v).abs
        (u - v).abs * sin(u).abs + (sin(u) - sin(v)).abs * v.abs <= (Real.1 + two_pi) * (u - v).abs
        lte_trans[Real]((fn_x_sin(u) - fn_x_sin(v)).abs,
            (u - v).abs * sin(u).abs + (sin(u) - sin(v)).abs * v.abs,
            (Real.1 + two_pi) * (u - v).abs)
        (fn_x_sin(u) - fn_x_sin(v)).abs <= (Real.1 + two_pi) * (u - v).abs
    }
}

// ---------------------------------------------------------------------------
// Antiderivatives of the product functions
// ---------------------------------------------------------------------------

/// An antiderivative of sin(x)cos(x): x ↦ sin(x)^2 / 2.
define g_sincos(x: Real) -> Real {
    pointwise_mul(constant[Real, Real](Real.1 / two), pointwise_mul(sin, sin), x)
}

/// An antiderivative of sin(x)^2: x ↦ (x - sin(x)cos(x)) / 2.
define g_sin_sq(x: Real) -> Real {
    pointwise_mul(constant[Real, Real](Real.1 / two),
        pointwise_add(identity_fn[Real], pointwise_neg(pointwise_mul(sin, cos))), x)
}

/// An antiderivative of cos(x)^2: x ↦ (x + sin(x)cos(x)) / 2.
define g_cos_sq(x: Real) -> Real {
    pointwise_mul(constant[Real, Real](Real.1 / two),
        pointwise_add(identity_fn[Real], pointwise_mul(sin, cos)), x)
}

/// An antiderivative of sin(x)sin(2x): x ↦ 2 sin(x)^3 / 3.
define g_sin_sin2(x: Real) -> Real {
    pointwise_mul(constant[Real, Real](two / from_nat[Real](Nat.3)),
        pointwise_mul(pointwise_mul(sin, sin), sin), x)
}

/// An antiderivative of x sin(x): x ↦ sin(x) - x cos(x).
define g_x_sin(x: Real) -> Real {
    pointwise_add(sin, pointwise_neg(pointwise_mul(identity_fn[Real], cos)), x)
}

// ---------------------------------------------------------------------------
// Derivative of the antiderivatives
// ---------------------------------------------------------------------------

/// The derivative of g_sincos is fn_sincos.
theorem g_sincos_has_derivative {
    is_derivative_fn(g_sincos, fn_sincos)
} by {
    sin_is_derivative_fn
    is_derivative_fn(sin, cos)
    derivative_fn_square(sin, cos)
    is_derivative_fn(pointwise_mul(sin, sin),
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)))
    derivative_fn_const_mul(Real.1 / two, pointwise_mul(sin, sin),
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)))
    is_derivative_fn(
        pointwise_mul(constant[Real, Real](Real.1 / two), pointwise_mul(sin, sin)),
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos))))
    forall(x: Real) {
        pointwise_mul_apply(constant[Real, Real](Real.1 / two),
            pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)), x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)), x) =
            constant[Real, Real](Real.1 / two, x) *
                pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos), x)
        constant[Real, Real](Real.1 / two, x) = Real.1 / two
        pointwise_add_apply(pointwise_mul(sin, cos), pointwise_mul(sin, cos), x)
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos), x) =
            pointwise_mul(sin, cos, x) + pointwise_mul(sin, cos, x)
        pointwise_mul_apply(sin, cos, x)
        pointwise_mul(sin, cos, x) = sin(x) * cos(x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)), x) =
            (Real.1 / two) * (sin(x) * cos(x) + sin(x) * cos(x))
        sin(x) * cos(x) + sin(x) * cos(x) = two * (sin(x) * cos(x))
        two_nonzero
        two != Real.0
        mul_div_cancel(Real.1, two)
        two != Real.0 implies two * (Real.1 / two) = Real.1
        two * (Real.1 / two) = Real.1
        (Real.1 / two) * two = Real.1
        (Real.1 / two) * (two * (sin(x) * cos(x))) = sin(x) * cos(x)
        (Real.1 / two) * (sin(x) * cos(x) + sin(x) * cos(x)) = sin(x) * cos(x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)), x) =
            sin(x) * cos(x)
        fn_sincos(x) = sin(x) * cos(x)
        pointwise_mul(constant[Real, Real](Real.1 / two),
            pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos)), x) =
            fn_sincos(x)
    }
    function_extensionality(pointwise_mul(constant[Real, Real](Real.1 / two),
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos))), fn_sincos)
    pointwise_mul(constant[Real, Real](Real.1 / two),
        pointwise_add(pointwise_mul(sin, cos), pointwise_mul(sin, cos))) = fn_sincos
    is_derivative_fn(pointwise_mul(constant[Real, Real](Real.1 / two), pointwise_mul(sin, sin)),
        fn_sincos)
    is_derivative_fn(g_sincos, fn_sincos)
}

/// The derivative of g_sin_sq is fn_sin_sq.
theorem g_sin_sq_has_derivative {
