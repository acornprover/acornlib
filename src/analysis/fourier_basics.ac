    ((two * u).sin - (two * v).sin).abs <= two * (u - v).abs
    abs_gte_zero(v.sin)
    Real.0 <= v.sin.abs
    mul_le_mul_of_nonneg_right(((two * u).sin - (two * v).sin).abs,
