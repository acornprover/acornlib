    (u.sin - v.sin) * u.cos = u.sin * u.cos - v.sin * u.cos
    mul_sub_distrib_left(v.sin, u.cos, v.cos)
    v.sin * (u.cos - v.cos) = v.sin * u.cos - v.sin * v.cos
