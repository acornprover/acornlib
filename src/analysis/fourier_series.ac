        from_nat[Real](Nat.2) = from_nat[Real](Nat.1) + from_nat[Real](Nat.1)
        from_nat[Real](Nat.1) = Real.1
        from_nat[Real](Nat.2) = Real.1 + Real.1
        Real.1 + Real.1 = two
