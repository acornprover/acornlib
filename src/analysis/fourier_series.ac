                pointwise_mul(Real.cos, pointwise_neg(pointwise_mul(constant[Real, Real](from_nat[Real](m)), sin_nt(m))), x)
        pointwise_mul_apply(cos_nt(m), pointwise_neg(Real.sin), x)
