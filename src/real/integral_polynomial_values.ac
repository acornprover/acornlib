            (u + v - Real.1).abs * (u - v).abs <= Real.1 * (u - v).abs
            real_mul_comm((u + v - Real.1).abs, (u - v).abs)
            (u - v).abs * (u + v - Real.1).abs <= Real.1 * (u - v).abs
            (centered_square_unit(u) - centered_square_unit(v)).abs <= Real.1 * (u - v).abs
        }
    }
}

