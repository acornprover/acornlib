}

/// On a cell of the uniform partition whose width is below the uniform
/// continuity modulus, the oscillation of f (supremum minus infimum of the
/// cell) is at most twice the tolerance.
/// Multiplying by two is adding a real to itself.
theorem two_mul(e: Real) {
    two * e = e + e
} by {
    two = Real.1 + Real.1
    two * e = (Real.1 + Real.1) * e
    (Real.1 + Real.1) * e = e + e
}

/// (x + e) - (x - e) is two times e.
theorem add_eps_sub_eps(x: Real, e: Real) {
    (x + e) - (x - e) = two * e
} by {
    two_mul(e)
    two * e = e + e
    x - e = x + -e
    (x + e) - (x - e) = (x + e) + -(x + -e)
    neg_distrib(x, -e)
    -(x + -e) = -x + -(-e)
    neg_neg(e)
    -(-e) = e
    -(x + -e) = -x + e
    (x + e) + -(x + -e) = (x + e) + (-x + e)
    add_assoc(x, e, -x)
    (x + e) + -x = x + (e + -x)
    add_comm(e, -x)
    e + -x = -x + e
    x + (e + -x) = x + (-x + e)
    (x + e) + -x = x + (-x + e)
    add_assoc(x, -x, e)
    (x + -x) + e = x + (-x + e)
    x + -x = Real.0
    (x + -x) + e = Real.0 + e
    Real.0 + e = e
    (x + e) + -x = e
    add_assoc(x + e, -x, e)
    ((x + e) + -x) + e = (x + e) + (-x + e)
    ((x + e) + -x) + e = e + e
    (x + e) + (-x + e) = e + e
    (x + e) - (x - e) = e + e
    (x + e) - (x - e) = two * e
}

