        pi_over_two - Real.0 = pi_over_two
        secant_slope(sin, Real.0, pi_over_two) = sin(pi_over_two) / pi_over_two
        sin(pi_over_two) < Real.0
        Real.0 < pi_over_two
        div_lt_div_pos(sin(pi_over_two), Real.0, pi_over_two)
        sin(pi_over_two) / pi_over_two < Real.0 / pi_over_two
        Real.0 / pi_over_two = Real.0
        sin(pi_over_two) / pi_over_two < Real.0
        secant_slope(sin, Real.0, pi_over_two) < Real.0
        cos(k) < Real.0
        Real.0 < k
        lt_imp_lte(Real.0, k)
        Real.0 <= k
        k < pi_over_two
        lt_imp_lte(k, pi_over_two)
