        cos_two_tail_odd_partial(k) <= partial(cos_two_tail, Nat.1)
        const_seq(partial(cos_two_tail, Nat.1), k) = partial(cos_two_tail, Nat.1)
        cos_two_tail_odd_partial(k) <= const_seq(partial(cos_two_tail, Nat.1), k)
