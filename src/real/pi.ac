            sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1))
        (cos(x) - cos(x0)).abs <= two * cos(x0).abs * (x - x0).abs.pow(Nat.2) + sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1)
