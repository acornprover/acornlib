/// The sine function is continuous everywhere.
theorem sin_continuous {
    continuous(sin)
} by {
    sin_is_derivative_fn
    is_derivative_fn_imp_continuous(sin, cos)
    continuous(sin)
}

/// The absolute value of the difference of cosine at a small argument from one.
theorem cos_shift_diff_bound(h: Real) {
    h.abs < Real.1 / two implies (cos(h) - Real.1).abs <= two * h.abs.pow(Nat.2)
} by {
    if h.abs < Real.1 / two {
        lt_imp_lte(h.abs, Real.1 / two)
        h.abs <= Real.1 / two
        half_lt_one
        Real.1 / two < Real.1
        lt_of_lte_of_lt(h.abs, Real.1 / two, Real.1)
        h.abs < Real.1
        cos_sub_one_series_small(h)
        cos(h) - Real.1 = h.pow(Nat.2) * cos_shift_sum(h)
        (cos(h) - Real.1).abs = (h.pow(Nat.2) * cos_shift_sum(h)).abs
        mul_abs(h.pow(Nat.2), cos_shift_sum(h))
        (h.pow(Nat.2) * cos_shift_sum(h)).abs = h.pow(Nat.2).abs * cos_shift_sum(h).abs
        abs_pow(h, Nat.2)
        h.pow(Nat.2).abs = h.abs.pow(Nat.2)
        (h.pow(Nat.2) * cos_shift_sum(h)).abs = h.abs.pow(Nat.2) * cos_shift_sum(h).abs
        cos_shift_sum_bound(h)
        cos_shift_sum(h).abs <= two
        abs_gte_zero(h.abs.pow(Nat.2))
        lte_mul_nonneg_right(cos_shift_sum(h).abs, two, h.abs.pow(Nat.2))
        cos_shift_sum(h).abs * h.abs.pow(Nat.2) <= two * h.abs.pow(Nat.2)
        h.abs.pow(Nat.2) * cos_shift_sum(h).abs <= two * h.abs.pow(Nat.2)
        (cos(h) - Real.1).abs <= two * h.abs.pow(Nat.2)
    }
}

/// The absolute value of sine at a small argument.
theorem sin_small_bound(h: Real) {
    h.abs < Real.1 / two implies sin(h).abs <= h.abs * (two * h.abs.pow(Nat.2) + Real.1)
} by {
    if h.abs < Real.1 / two {
        lt_imp_lte(h.abs, Real.1 / two)
        h.abs <= Real.1 / two
        half_lt_one
        Real.1 / two < Real.1
        lt_of_lte_of_lt(h.abs, Real.1 / two, Real.1)
        h.abs < Real.1
        sin_series_small(h)
        sin(h) = h * sin_shift_sum(h)
        sin(h).abs = (h * sin_shift_sum(h)).abs
        mul_abs(h, sin_shift_sum(h))
        (h * sin_shift_sum(h)).abs = h.abs * sin_shift_sum(h).abs
        sin(h).abs = h.abs * sin_shift_sum(h).abs
        sin_shift_sum_close_one(h)
        (sin_shift_sum(h) - Real.1).abs <= two * h.abs.pow(Nat.2)
        triangle_ineq(sin_shift_sum(h) - Real.1, Real.1)
        ((sin_shift_sum(h) - Real.1) + Real.1).abs <= (sin_shift_sum(h) - Real.1).abs + Real.1.abs
        Real.1.abs = Real.1
        (sin_shift_sum(h) - Real.1) + Real.1 = sin_shift_sum(h)
        sin_shift_sum(h).abs <= (sin_shift_sum(h) - Real.1).abs + Real.1
        lte_add_right((sin_shift_sum(h) - Real.1).abs, two * h.abs.pow(Nat.2), Real.1)
        (sin_shift_sum(h) - Real.1).abs + Real.1 <= two * h.abs.pow(Nat.2) + Real.1
        lte_trans(sin_shift_sum(h).abs, (sin_shift_sum(h) - Real.1).abs + Real.1, two * h.abs.pow(Nat.2) + Real.1)
        sin_shift_sum(h).abs <= two * h.abs.pow(Nat.2) + Real.1
        abs_gte_zero(h)
        lte_mul_nonneg_right(sin_shift_sum(h).abs, two * h.abs.pow(Nat.2) + Real.1, h.abs)
        sin_shift_sum(h).abs * h.abs <= (two * h.abs.pow(Nat.2) + Real.1) * h.abs
        h.abs * sin_shift_sum(h).abs <= h.abs * (two * h.abs.pow(Nat.2) + Real.1)
        sin(h).abs <= h.abs * (two * h.abs.pow(Nat.2) + Real.1)
    }
}

/// The cosine of a sum differs from the cosine of the base point by a signed combination.
theorem cos_sub_identity(x0: Real, h: Real) {
    cos(x0 + h) - cos(x0) = cos(x0) * (cos(h) - Real.1) - sin(x0) * sin(h)
} by {
    cos_add(x0, h)
    cos(x0 + h) = cos(x0) * cos(h) - sin(x0) * sin(h)
    cos(x0 + h) - cos(x0) = cos(x0) * cos(h) - sin(x0) * sin(h) - cos(x0)
    cos(x0) * cos(h) - sin(x0) * sin(h) - cos(x0) =
        cos(x0) * cos(h) - cos(x0) - sin(x0) * sin(h)
    cos(x0) * cos(h) - cos(x0) = cos(x0) * (cos(h) - Real.1)
    cos(x0) * cos(h) - cos(x0) - sin(x0) * sin(h) =
        cos(x0) * (cos(h) - Real.1) - sin(x0) * sin(h)
    cos(x0 + h) - cos(x0) = cos(x0) * (cos(h) - Real.1) - sin(x0) * sin(h)
}

/// The absolute difference of cosine is bounded by a linear multiple of the argument difference.
/// The absolute difference of cosine is bounded by the triangle inequality applied to the
/// addition formula.
theorem cos_abs_triangle(x0: Real, h: Real) {
    (cos(x0 + h) - cos(x0)).abs <= (cos(x0) * (cos(h) - Real.1)).abs + (sin(x0) * sin(h)).abs
} by {
    cos_sub_identity(x0, h)
    cos(x0 + h) - cos(x0) = cos(x0) * (cos(h) - Real.1) - sin(x0) * sin(h)
    triangle_ineq(cos(x0) * (cos(h) - Real.1), -(sin(x0) * sin(h)))
}

/// The absolute difference of cosine is bounded by a linear multiple of the argument difference.
theorem cos_abs_diff_bound(x0: Real, x: Real) {
    (x - x0).abs < Real.1 / two implies
    (cos(x) - cos(x0)).abs <= (two * (sin(x0).abs + cos(x0).abs)) * (x - x0).abs
} by {
    if (x - x0).abs < Real.1 / two {
        x - x0 = x + -x0
        x0 + (x - x0) = x0 + (x + -x0)
        add_comm(x0, x + -x0)
        x0 + (x + -x0) = (x + -x0) + x0
        (x + -x0) + x0 = x + (-x0 + x0)
        -x0 + x0 = Real.0
        x + (-x0 + x0) = x + Real.0
        x + Real.0 = x
        x0 + (x - x0) = x
        cos_abs_triangle(x0, x - x0)
        (cos(x0 + (x - x0)) - cos(x0)).abs <= (cos(x0) * (cos(x - x0) - Real.1)).abs + (sin(x0) * sin(x - x0)).abs
        cos(x0 + (x - x0)) = cos(x)
        (cos(x0 + (x - x0)) - cos(x0)).abs = (cos(x) - cos(x0)).abs
        (cos(x) - cos(x0)).abs <= (cos(x0) * (cos(x - x0) - Real.1)).abs + (sin(x0) * sin(x - x0)).abs
        mul_abs(cos(x0), cos(x - x0) - Real.1)
        (cos(x0) * (cos(x - x0) - Real.1)).abs = cos(x0).abs * (cos(x - x0) - Real.1).abs
        mul_abs(sin(x0), sin(x - x0))
        (sin(x0) * sin(x - x0)).abs = sin(x0).abs * sin(x - x0).abs
        (cos(x) - cos(x0)).abs <= cos(x0).abs * (cos(x - x0) - Real.1).abs + sin(x0).abs * sin(x - x0).abs
        cos_shift_diff_bound(x - x0)
        (cos(x - x0) - Real.1).abs <= two * (x - x0).abs.pow(Nat.2)
        abs_gte_zero(cos(x0))
        lte_mul_nonneg_right((cos(x - x0) - Real.1).abs, two * (x - x0).abs.pow(Nat.2), cos(x0).abs)
        cos(x0).abs * (cos(x - x0) - Real.1).abs <= cos(x0).abs * (two * (x - x0).abs.pow(Nat.2))
        cos(x0).abs * (two * (x - x0).abs.pow(Nat.2)) = two * cos(x0).abs * (x - x0).abs.pow(Nat.2)
        cos(x0).abs * (cos(x - x0) - Real.1).abs <= two * cos(x0).abs * (x - x0).abs.pow(Nat.2)
        sin_small_bound(x - x0)
        sin(x - x0).abs <= (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1)
        abs_gte_zero(sin(x0))
        lte_mul_nonneg_right(sin(x - x0).abs, (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1), sin(x0).abs)
        sin(x0).abs * sin(x - x0).abs <= sin(x0).abs * ((x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1))
        sin(x0).abs * ((x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1)) =
            sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1)
        sin(x0).abs * sin(x - x0).abs <= sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1)
        lte_add_right(cos(x0).abs * (cos(x - x0) - Real.1).abs,
            two * cos(x0).abs * (x - x0).abs.pow(Nat.2),
            sin(x0).abs * sin(x - x0).abs)
        cos(x0).abs * (cos(x - x0) - Real.1).abs + sin(x0).abs * sin(x - x0).abs <= two * cos(x0).abs * (x - x0).abs.pow(Nat.2) + sin(x0).abs * sin(x - x0).abs
        lte_add_right(sin(x0).abs * sin(x - x0).abs,
            sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1),
            two * cos(x0).abs * (x - x0).abs.pow(Nat.2))
        two * cos(x0).abs * (x - x0).abs.pow(Nat.2) + sin(x0).abs * sin(x - x0).abs <= two * cos(x0).abs * (x - x0).abs.pow(Nat.2) +
            sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1)
        lte_trans(cos(x0).abs * (cos(x - x0) - Real.1).abs + sin(x0).abs * sin(x - x0).abs,
            two * cos(x0).abs * (x - x0).abs.pow(Nat.2) + sin(x0).abs * sin(x - x0).abs,
            two * cos(x0).abs * (x - x0).abs.pow(Nat.2) +
            sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1))
        cos(x0).abs * (cos(x - x0) - Real.1).abs + sin(x0).abs * sin(x - x0).abs <= two * cos(x0).abs * (x - x0).abs.pow(Nat.2) + sin(x0).abs * (x - x0).abs * (two * (x - x0).abs.pow(Nat.2) + Real.1)
        lte_trans((cos(x) - cos(x0)).abs,
            cos(x0).abs * (cos(x - x0) - Real.1).abs + sin(x0).abs * sin(x - x0).abs,
