        (cos(x) - cos(x0)).abs <= two * cos(x0).abs * (x - x0).abs + two * sin(x0).abs * (x - x0).abs
        two * cos(x0).abs * (x - x0).abs + two * sin(x0).abs * (x - x0).abs =
            (two * cos(x0).abs + two * sin(x0).abs) * (x - x0).abs
        two * cos(x0).abs + two * sin(x0).abs = two * (cos(x0).abs + sin(x0).abs)
        (two * cos(x0).abs + two * sin(x0).abs) * (x - x0).abs =
            (two * (cos(x0).abs + sin(x0).abs)) * (x - x0).abs
        two * (cos(x0).abs + sin(x0).abs) = two * (sin(x0).abs + cos(x0).abs)
        (two * (cos(x0).abs + sin(x0).abs)) * (x - x0).abs =
            (two * (sin(x0).abs + cos(x0).abs)) * (x - x0).abs
        (cos(x) - cos(x0)).abs <= (two * (sin(x0).abs + cos(x0).abs)) * (x - x0).abs
    }
}

/// The cosine function is continuous at every point.
theorem cos_continuous_at(x0: Real) {
    continuous_at(cos, x0)
} by {
    forall(eps: Real) {
        if eps.is_positive {
            exists_small_mul_variant(two * (sin(x0).abs + cos(x0).abs), eps)
            let delta1: Real satisfy {
                delta1.is_positive and (two * (sin(x0).abs + cos(x0).abs)).abs * delta1 < eps
            }
            half_pos
            Real.1 / two > Real.0
            eps_smaller_than_both(Real.1 / two, delta1)
            let delta: Real satisfy {
                delta.is_positive and delta < Real.1 / two and delta < delta1
            }
            forall(x: Real) {
                if x.is_close(x0, delta) {
                    x.is_close(x0, delta) = (x - x0).abs < delta
                    (x - x0).abs < delta
                    lt_trans((x - x0).abs, delta, Real.1 / two)
                    (x - x0).abs < Real.1 / two
                    lt_trans((x - x0).abs, delta, delta1)
                    (x - x0).abs < delta1
                    cos_abs_diff_bound(x0, x)
                    (cos(x) - cos(x0)).abs <= (two * (sin(x0).abs + cos(x0).abs)) * (x - x0).abs
                    lte_abs(two * (sin(x0).abs + cos(x0).abs))
                    two * (sin(x0).abs + cos(x0).abs) <= (two * (sin(x0).abs + cos(x0).abs)).abs
                    abs_gte_zero(x - x0)
                    (x - x0).abs >= Real.0
                    lte_mul_nonneg_right(two * (sin(x0).abs + cos(x0).abs),
                        (two * (sin(x0).abs + cos(x0).abs)).abs, (x - x0).abs)
                    (two * (sin(x0).abs + cos(x0).abs)) * (x - x0).abs <= (two * (sin(x0).abs + cos(x0).abs)).abs * (x - x0).abs
                    lte_trans((cos(x) - cos(x0)).abs,
                        (two * (sin(x0).abs + cos(x0).abs)) * (x - x0).abs,
                        (two * (sin(x0).abs + cos(x0).abs)).abs * (x - x0).abs)
                    (cos(x) - cos(x0)).abs <= (two * (sin(x0).abs + cos(x0).abs)).abs * (x - x0).abs
                    lt_imp_lte((x - x0).abs, delta1)
                    (x - x0).abs <= delta1
                    abs_gte_zero(two * (sin(x0).abs + cos(x0).abs))
                    lte_mul_nonneg_right((x - x0).abs, delta1, (two * (sin(x0).abs + cos(x0).abs)).abs)
                    (x - x0).abs * (two * (sin(x0).abs + cos(x0).abs)).abs <= delta1 * (two * (sin(x0).abs + cos(x0).abs)).abs
                    (two * (sin(x0).abs + cos(x0).abs)).abs * (x - x0).abs <= (two * (sin(x0).abs + cos(x0).abs)).abs * delta1
                    lte_trans((cos(x) - cos(x0)).abs,
                        (two * (sin(x0).abs + cos(x0).abs)).abs * (x - x0).abs,
                        (two * (sin(x0).abs + cos(x0).abs)).abs * delta1)
                    (cos(x) - cos(x0)).abs <= (two * (sin(x0).abs + cos(x0).abs)).abs * delta1
                    lt_imp_lte(delta1, delta1)
                    lte_lt_trans((cos(x) - cos(x0)).abs,
                        (two * (sin(x0).abs + cos(x0).abs)).abs * delta1, eps)
                    (cos(x) - cos(x0)).abs < eps
                    cos(x).is_close(cos(x0), eps)
                }
            }
            continuous_condition(cos, x0, delta, eps)
            delta.is_positive and continuous_condition(cos, x0, delta, eps)
            exists(delta2: Real) {
                delta2.is_positive and continuous_condition(cos, x0, delta2, eps)
            }
        }
    }
    continuous_at(cos, x0) = forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and continuous_condition(cos, x0, delta, eps)
        }
    }
    if not continuous_at(cos, x0) {
        not forall(eps: Real) {
            eps.is_positive implies exists(delta: Real) {
                delta.is_positive and continuous_condition(cos, x0, delta, eps)
            }
        }
        let bad_eps: Real satisfy {
            bad_eps.is_positive and forall(delta: Real) {
                not (delta.is_positive and continuous_condition(cos, x0, delta, bad_eps))
            }
        }
        exists(delta: Real) {
            delta.is_positive and continuous_condition(cos, x0, delta, bad_eps)
        }
        false
    }
}

/// The cosine function is continuous everywhere.
theorem cos_continuous {
    continuous(cos)
} by {
    forall(x: Real) {
        cos_continuous_at(x)
        continuous_at(cos, x)
    }
    continuous(cos) = forall(x: Real) {
        continuous_at(cos, x)
    }
    continuous(cos)
}

/// The pointwise negation of cosine.
define cos_neg_fn(x: Real) -> Real {
    -cos(x)
}

/// The negation of cosine is continuous at every point.
theorem cos_neg_fn_continuous_at(x0: Real) {
    continuous_at(cos_neg_fn, x0)
} by {
    forall(eps: Real) {
        if eps.is_positive {
            cos_continuous_at(x0)
            continuous_at(cos, x0) = forall(eps0: Real) {
                eps0.is_positive implies exists(delta: Real) {
                    delta.is_positive and continuous_condition(cos, x0, delta, eps0)
                }
            }
            let delta: Real satisfy {
                delta.is_positive and continuous_condition(cos, x0, delta, eps)
            }
            forall(x: Real) {
                if x.is_close(x0, delta) {
                    continuous_condition(cos, x0, delta, eps) = forall(x1: Real) {
                        x1.is_close(x0, delta) implies cos(x1).is_close(cos(x0), eps)
                    }
                    cos(x).is_close(cos(x0), eps)
                    (cos(x) - cos(x0)).abs < eps
                    cos_neg_fn(x) = -cos(x)
                    cos_neg_fn(x0) = -cos(x0)
                    cos_neg_fn(x) - cos_neg_fn(x0) = -cos(x) - (-cos(x0))
                    -cos(x) - (-cos(x0)) = -(cos(x) - cos(x0))
                    abs_neg(cos(x) - cos(x0))
                    (-(cos(x) - cos(x0))).abs = (cos(x) - cos(x0)).abs
                    (cos_neg_fn(x) - cos_neg_fn(x0)).abs < eps
                    cos_neg_fn(x).is_close(cos_neg_fn(x0), eps)
                }
            }
            continuous_condition(cos_neg_fn, x0, delta, eps)
            delta.is_positive and continuous_condition(cos_neg_fn, x0, delta, eps)
            exists(delta2: Real) {
                delta2.is_positive and continuous_condition(cos_neg_fn, x0, delta2, eps)
            }
        }
    }
    continuous_at(cos_neg_fn, x0) = forall(eps: Real) {
        eps.is_positive implies exists(delta: Real) {
            delta.is_positive and continuous_condition(cos_neg_fn, x0, delta, eps)
        }
    }
    if not continuous_at(cos_neg_fn, x0) {
        not forall(eps: Real) {
            eps.is_positive implies exists(delta: Real) {
                delta.is_positive and continuous_condition(cos_neg_fn, x0, delta, eps)
            }
        }
        let bad_eps: Real satisfy {
            bad_eps.is_positive and forall(delta: Real) {
                not (delta.is_positive and continuous_condition(cos_neg_fn, x0, delta, bad_eps))
            }
        }
        exists(delta: Real) {
            delta.is_positive and continuous_condition(cos_neg_fn, x0, delta, bad_eps)
        }
        false
    }
}

/// The negation of cosine is continuous everywhere.
theorem cos_neg_fn_continuous {
    continuous(cos_neg_fn)
} by {
    forall(x: Real) {
        cos_neg_fn_continuous_at(x)
        continuous_at(cos_neg_fn, x)
    }
    continuous(cos_neg_fn) = forall(x: Real) {
        continuous_at(cos_neg_fn, x)
    }
    continuous(cos_neg_fn)
}


