/// The sine of pi over two is nonnegative.
theorem sin_pi_over_two_nonneg {
    Real.0 <= sin(pi_over_two)
} by {
    if sin(pi_over_two) < Real.0 {
        sin_continuous
        continuous(sin)
        pi_over_two_pos
        Real.0 < pi_over_two
        mean_value_theorem(sin, cos, Real.0, pi_over_two)
        exists(k: Real) {
            Real.0 < k and k < pi_over_two and has_derivative_at(sin, k, secant_slope(sin, Real.0, pi_over_two))
        }
        let k: Real satisfy {
            Real.0 < k and k < pi_over_two and has_derivative_at(sin, k, secant_slope(sin, Real.0, pi_over_two))
        }
        Real.0 < k and k < pi_over_two and has_derivative_at(sin, k, secant_slope(sin, Real.0, pi_over_two))
        Real.0 < k
        k < pi_over_two
        has_derivative_at(sin, k, secant_slope(sin, Real.0, pi_over_two))
        sin_is_derivative_fn
        is_derivative_fn_at(sin, cos, k)
