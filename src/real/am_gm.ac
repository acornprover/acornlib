        partial(tri_fn(a, b, c), Nat.3) = partial(tri_fn(a, b, c), Nat.2) + tri_fn(a, b, c)(Nat.2)
        partial(tri_fn(a, b, c), Nat.3) = (a + b) + c
        (a + b) + c = a + b + c
        partial(tri_fn(a, b, c), Nat.3) = a + b + c
        finite_real_mean(tri_fn(a, b, c), Nat.3) = partial(tri_fn(a, b, c), Nat.3) / from_nat[Real](Nat.3)
