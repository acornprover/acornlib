// ---------------------------------------------------------------------------
// Pointwise bounds of sine and cosine
// ---------------------------------------------------------------------------
//
// From sin(x)^2 + cos(x)^2 = 1 and the nonnegativity of squares, both
// sin(x)^2 and cos(x)^2 are at most one, so sine and cosine lie in [-1, 1].

/// A nonnegative real whose square is at most one is at most one.
theorem nonneg_sq_le_one_imp_le_one(x: Real) {
    x >= Real.0 and x.pow(Nat.2) <= Real.1 implies x <= Real.1
} by {
    if x >= Real.0 and x.pow(Nat.2) <= Real.1 {
        if Real.1 < x {
            pow_suc(x, Nat.1)
            x.pow(Nat.1.suc) = x * x.pow(Nat.1)
            pow_one[Real](x)
            x.pow(Nat.1) = x
            Nat.1.suc = Nat.2
            x.pow(Nat.2) = x * x
            Real.0 < Real.1
            lt_trans[Real](Real.0, Real.1, x)
            Real.0 < x
            gt_zero_imp_pos(x)
            x.is_positive
            lt_mul_pos_left(Real.1, x, x)
            x * Real.1 < x * x
            x * Real.1 = x
            x < x * x
            lt_trans[Real](Real.1, x, x * x)
            Real.1 < x * x
            x.pow(Nat.2) <= Real.1
            lt_of_lte_of_lt(x.pow(Nat.2), Real.1, x.pow(Nat.2))
            x.pow(Nat.2) < x.pow(Nat.2)
            not_lt_self(x.pow(Nat.2))
            false
        }
        not Real.1 < x
        not_lt_imp_gte[Real](Real.1, x)
        x <= Real.1
    }
}

/// A real whose square is at most one has absolute value at most one.
theorem abs_le_one_of_sq_le_one(x: Real) {
    x.pow(Nat.2) <= Real.1 implies x.abs <= Real.1
} by {
    if x.pow(Nat.2) <= Real.1 {
        abs_gte_zero(x)
        Real.0 <= x.abs
        abs_pow(x, Nat.2)
        x.pow(Nat.2).abs = x.abs.pow(Nat.2)
        pow_suc(x, Nat.1)
        x.pow(Nat.1.suc) = x * x.pow(Nat.1)
        pow_one[Real](x)
        x.pow(Nat.1) = x
        Nat.1.suc = Nat.2
        x.pow(Nat.2) = x * x
        square_nonneg(x)
        x * x >= Real.0
        x.pow(Nat.2) >= Real.0
        abs_of_nonneg(x.pow(Nat.2))
        x.pow(Nat.2).abs = x.pow(Nat.2)
        x.abs.pow(Nat.2) = x.pow(Nat.2)
        x.abs.pow(Nat.2) <= Real.1
        nonneg_sq_le_one_imp_le_one(x.abs)
        x.abs <= Real.1
    }
}

/// The square of any real is nonnegative.
theorem sq_pow_nonneg(x: Real) {
    Real.0 <= x.pow(Nat.2)
} by {
    pow_suc(x, Nat.1)
    x.pow(Nat.1.suc) = x * x.pow(Nat.1)
    pow_one[Real](x)
    x.pow(Nat.1) = x
    Nat.1.suc = Nat.2
    x.pow(Nat.2) = x * x
    square_nonneg(x)
    x * x >= Real.0
    Real.0 <= x.pow(Nat.2)
}

/// The absolute value of sine is at most one.
theorem sin_abs_le_one(x: Real) {
    sin(x).abs <= Real.1
} by {
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    sub_moves_sides(sin(x).pow(Nat.2), cos(x).pow(Nat.2), Real.1)
    sin(x).pow(Nat.2) = Real.1 - cos(x).pow(Nat.2)
    sq_pow_nonneg(cos(x))
    Real.0 <= cos(x).pow(Nat.2)
    lte_imp_neg_lte_neg(Real.0, cos(x).pow(Nat.2))
    -cos(x).pow(Nat.2) <= -Real.0
    neg_zero
    -Real.0 = Real.0
    -cos(x).pow(Nat.2) <= Real.0
    lte_self(Real.1)
    Real.1 <= Real.1
    add_le_add[Real](Real.1, Real.1, -cos(x).pow(Nat.2), Real.0)
    Real.1 + -cos(x).pow(Nat.2) <= Real.1 + Real.0
    Real.1 - cos(x).pow(Nat.2) = Real.1 + -cos(x).pow(Nat.2)
    Real.1 - cos(x).pow(Nat.2) <= Real.1 + Real.0
    Real.1 + Real.0 = Real.1
    Real.1 - cos(x).pow(Nat.2) <= Real.1
    sin(x).pow(Nat.2) <= Real.1
    abs_le_one_of_sq_le_one(sin(x))
    sin(x).abs <= Real.1
}

/// The absolute value of cosine is at most one.
theorem cos_abs_le_one(x: Real) {
    cos(x).abs <= Real.1
} by {
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    add_comm(sin(x).pow(Nat.2), cos(x).pow(Nat.2))
    cos(x).pow(Nat.2) + sin(x).pow(Nat.2) = Real.1
    sub_moves_sides(cos(x).pow(Nat.2), sin(x).pow(Nat.2), Real.1)
    cos(x).pow(Nat.2) = Real.1 - sin(x).pow(Nat.2)
    sq_pow_nonneg(sin(x))
    Real.0 <= sin(x).pow(Nat.2)
    lte_imp_neg_lte_neg(Real.0, sin(x).pow(Nat.2))
    -sin(x).pow(Nat.2) <= -Real.0
    neg_zero
    -Real.0 = Real.0
    -sin(x).pow(Nat.2) <= Real.0
    lte_self(Real.1)
    Real.1 <= Real.1
    add_le_add[Real](Real.1, Real.1, -sin(x).pow(Nat.2), Real.0)
    Real.1 + -sin(x).pow(Nat.2) <= Real.1 + Real.0
    Real.1 - sin(x).pow(Nat.2) = Real.1 + -sin(x).pow(Nat.2)
    Real.1 - sin(x).pow(Nat.2) <= Real.1 + Real.0
    Real.1 + Real.0 = Real.1
    Real.1 - sin(x).pow(Nat.2) <= Real.1
    cos(x).pow(Nat.2) <= Real.1
    abs_le_one_of_sq_le_one(cos(x))
    cos(x).abs <= Real.1
}

/// Sine is at most one.
theorem sin_le_one(x: Real) {
    sin(x) <= Real.1
} by {
    sin_abs_le_one(x)
    sin(x).abs <= Real.1
    lte_abs(sin(x))
    sin(x) <= sin(x).abs
    lte_trans[Real](sin(x), sin(x).abs, Real.1)
    sin(x) <= Real.1
}

/// Sine is at least negative one.
theorem sin_ge_neg_one(x: Real) {
    -Real.1 <= sin(x)
} by {
    lte_abs(-sin(x))
    -sin(x) <= (-sin(x)).abs
    abs_neg(sin(x))
    (-sin(x)).abs = sin(x).abs
    -sin(x) <= sin(x).abs
    sin_abs_le_one(x)
    sin(x).abs <= Real.1
    lte_trans[Real](-sin(x), sin(x).abs, Real.1)
    -sin(x) <= Real.1
    lte_imp_neg_lte_neg(-sin(x), Real.1)
    -Real.1 <= -(-sin(x))
    neg_neg(sin(x))
    -(-sin(x)) = sin(x)
    -Real.1 <= sin(x)
}

/// Cosine is at most one.
theorem cos_le_one(x: Real) {
    cos(x) <= Real.1
} by {
    cos_abs_le_one(x)
    cos(x).abs <= Real.1
    lte_abs(cos(x))
    cos(x) <= cos(x).abs
    lte_trans[Real](cos(x), cos(x).abs, Real.1)
    cos(x) <= Real.1
}

/// Cosine is at least negative one.
theorem cos_ge_neg_one(x: Real) {
    -Real.1 <= cos(x)
} by {
    lte_abs(-cos(x))
    -cos(x) <= (-cos(x)).abs
    abs_neg(cos(x))
    (-cos(x)).abs = cos(x).abs
    -cos(x) <= cos(x).abs
    cos_abs_le_one(x)
    cos(x).abs <= Real.1
    lte_trans[Real](-cos(x), cos(x).abs, Real.1)
    -cos(x) <= Real.1
    lte_imp_neg_lte_neg(-cos(x), Real.1)
    -Real.1 <= -(-cos(x))
    neg_neg(cos(x))
    -(-cos(x)) = cos(x)
    -Real.1 <= cos(x)
}

// ---------------------------------------------------------------------------
// The derivative of cosine
// ---------------------------------------------------------------------------
//
// cos(x) = sin(x + pi/2), so by the chain rule applied to the shift
// x ↦ x + pi/2 composed with sine, the derivative of cosine at x is
// cos(x + pi/2) = -sin(x).

/// The sine of x plus pi over two is cosine of x.
theorem sin_add_pi_over_two(x: Real) {
    sin(x + pi_over_two) = cos(x)
} by {
    sin_add(x, pi_over_two)
    sin(x + pi_over_two) = sin(x) * cos(pi_over_two) + cos(x) * sin(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    sin(x) * cos(pi_over_two) + cos(x) * sin(pi_over_two) = sin(x) * Real.0 + cos(x) * Real.1
    sin(x) * Real.0 = Real.0
    cos(x) * Real.1 = cos(x)
    sin(x) * Real.0 + cos(x) * Real.1 = Real.0 + cos(x)
    Real.0 + cos(x) = cos(x)
    sin(x + pi_over_two) = cos(x)
}

/// The cosine of x plus pi over two is negative sine of x.
theorem cos_add_pi_over_two(x: Real) {
    cos(x + pi_over_two) = -sin(x)
} by {
    cos_add(x, pi_over_two)
    cos(x + pi_over_two) = cos(x) * cos(pi_over_two) - sin(x) * sin(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    cos(x) * cos(pi_over_two) - sin(x) * sin(pi_over_two) = cos(x) * Real.0 - sin(x) * Real.1
    cos(x) * Real.0 = Real.0
    sin(x) * Real.1 = sin(x)
    cos(x) * Real.0 - sin(x) * Real.1 = Real.0 - sin(x)
    Real.0 - sin(x) = -sin(x)
    cos(x + pi_over_two) = -sin(x)
}

/// The cosine function is everywhere differentiable with derivative negative sine.
theorem cos_is_derivative_fn {
    is_derivative_fn(cos, pointwise_neg(sin))
} by {
    forall(y: Real) {
        compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two)), y) =
            sin(pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two), y))
        pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two), y) =
            identity_fn[Real](y) + constant[Real, Real](pi_over_two, y)
        identity_fn[Real](y) = y
        constant[Real, Real](pi_over_two, y) = pi_over_two
        pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two), y) = y + pi_over_two
        compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two)), y) =
            sin(y + pi_over_two)
        sin_add_pi_over_two(y)
        sin(y + pi_over_two) = cos(y)
        compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two)), y) = cos(y)
    }
    compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two))) = cos
    forall(x: Real) {
        identity_has_derivative_at(x)
        has_derivative_at(identity_fn[Real], x, Real.1)
        constant_has_derivative_at(pi_over_two, x)
        has_derivative_at(constant[Real, Real](pi_over_two), x, Real.0)
        derivative_pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two), x, Real.1, Real.0)
        has_derivative_at(pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two)), x,
            Real.1 + Real.0)
        Real.1 + Real.0 = Real.1
        has_derivative_at(pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two)), x, Real.1)
        pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two), x) =
            identity_fn[Real](x) + constant[Real, Real](pi_over_two, x)
        identity_fn[Real](x) = x
        constant[Real, Real](pi_over_two, x) = pi_over_two
        pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two), x) = x + pi_over_two
        sin_has_derivative_at(x + pi_over_two)
        has_derivative_at(sin, x + pi_over_two, cos(x + pi_over_two))
        derivative_compose(pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two)), sin,
            x, Real.1, cos(x + pi_over_two))
        has_derivative_at(compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two))),
            x, cos(x + pi_over_two) * Real.1)
        cos(x + pi_over_two) * Real.1 = cos(x + pi_over_two)
        has_derivative_at(compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two))),
            x, cos(x + pi_over_two))
        cos_add_pi_over_two(x)
        cos(x + pi_over_two) = -sin(x)
        pointwise_neg(sin, x) = -sin(x)
        has_derivative_at(compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two))),
            x, pointwise_neg(sin, x))
        define pred(h: Real -> Real) -> Bool {
            has_derivative_at(h, x, pointwise_neg(sin, x))
        }
        function_eq_transport_predicate(pred,
            compose(sin, pointwise_add(identity_fn[Real], constant[Real, Real](pi_over_two))), cos)
        has_derivative_at(cos, x, pointwise_neg(sin, x))
    }
    is_derivative_fn_iff(cos, pointwise_neg(sin))
    is_derivative_fn(cos, pointwise_neg(sin))
}

/// The cosine has derivative negative sine at every point.
theorem cos_has_derivative_at(x0: Real) {
    has_derivative_at(cos, x0, -sin(x0))
} by {
    cos_is_derivative_fn
    is_derivative_fn_at(cos, pointwise_neg(sin), x0)
    has_derivative_at(cos, x0, pointwise_neg(sin, x0))
    pointwise_neg(sin, x0) = -sin(x0)
    has_derivative_at(cos, x0, -sin(x0))
}

/// The pointwise negation of cosine has derivative sine everywhere.
theorem neg_cos_is_derivative_fn {
    is_derivative_fn(pointwise_neg(cos), sin)
} by {
    forall(x: Real) {
        cos_has_derivative_at(x)
        has_derivative_at(cos, x, -sin(x))
        derivative_pointwise_neg(cos, x, -sin(x))
        has_derivative_at(pointwise_neg(cos), x, -(-sin(x)))
        neg_neg(sin(x))
        -(-sin(x)) = sin(x)
        has_derivative_at(pointwise_neg(cos), x, sin(x))
    }
    is_derivative_fn_iff(pointwise_neg(cos), sin)
    is_derivative_fn(pointwise_neg(cos), sin)
}

/// The pointwise negation of cosine is continuous everywhere.
theorem neg_cos_continuous {
    continuous(pointwise_neg(cos))
} by {
    cos_continuous
    continuous(cos)
    continuous_pointwise_neg(cos)
    continuous(pointwise_neg(cos))
}

/// On [a, b] sine is bounded below by negative one.
theorem sin_lower_bound_on(a: Real, b: Real) {
    a <= b implies forall(t: Real) { interval_contains(a, b, t) implies -Real.1 <= sin(t) }
} by {
    if a <= b {
        forall(t: Real) {
            if interval_contains(a, b, t) {
                sin_ge_neg_one(t)
                -Real.1 <= sin(t)
            }
        }
    }
}

/// On [a, b] sine is bounded above by one.
theorem sin_upper_bound_on(a: Real, b: Real) {
    a <= b implies forall(t: Real) { interval_contains(a, b, t) implies sin(t) <= Real.1 }
} by {
    if a <= b {
        forall(t: Real) {
            if interval_contains(a, b, t) {
                sin_le_one(t)
                sin(t) <= Real.1
            }
        }
    }
}

/// On [a, b] cosine is bounded below by negative one.
theorem cos_lower_bound_on(a: Real, b: Real) {
    a <= b implies forall(t: Real) { interval_contains(a, b, t) implies -Real.1 <= cos(t) }
} by {
    if a <= b {
        forall(t: Real) {
            if interval_contains(a, b, t) {
                cos_ge_neg_one(t)
                -Real.1 <= cos(t)
            }
        }
    }
}

/// On [a, b] cosine is bounded above by one.
theorem cos_upper_bound_on(a: Real, b: Real) {
    a <= b implies forall(t: Real) { interval_contains(a, b, t) implies cos(t) <= Real.1 }
} by {
    if a <= b {
        forall(t: Real) {
            if interval_contains(a, b, t) {
                cos_le_one(t)
                cos(t) <= Real.1
            }
        }
    }
}

// ---------------------------------------------------------------------------
// Sine and cosine are one-Lipschitz
// ---------------------------------------------------------------------------
//
// By the mean value theorem on [x, y], sin(y) - sin(x) = cos(c) * (y - x) for
// some c between x and y; since |cos(c)| <= 1, |sin(y) - sin(x)| <= |y - x|.
// The argument for cosine is identical with derivative -sin.

/// If f has global derivative df with |df| <= m everywhere, then f is
/// m-Lipschitz on the increasing interval [x, y].
theorem lipschitz_lt_of_bounded_derivative(f: Real -> Real, df: Real -> Real, m: Real, x: Real, y: Real) {
    x < y and continuous(f) and is_derivative_fn(f, df) and
    (forall(z: Real) { df(z).abs <= m }) implies
    (f(x) - f(y)).abs <= m * (y - x)
} by {
    if x < y and continuous(f) and is_derivative_fn(f, df) and
       (forall(z: Real) { df(z).abs <= m }) {
        mean_value_theorem(f, df, x, y)
        let c: Real satisfy {
            x < c and c < y and has_derivative_at(f, c, secant_slope(f, x, y))
        }
        x < c and c < y
        has_derivative_at(f, c, secant_slope(f, x, y))
        is_derivative_fn_at(f, df, c)
        has_derivative_at(f, c, df(c))
        has_derivative_at_unique(f, c, secant_slope(f, x, y), df(c))
        secant_slope(f, x, y) = df(c)
        secant_slope(f, x, y) = (f(y) - f(x)) / (y - x)
        df(c) = (f(y) - f(x)) / (y - x)
        lt_imp_ne_symm(x, y)
        y != x
        sub_ne_zero_of_ne(y, x)
        y - x != Real.0
        div_mul_cancel_denominator(f(y) - f(x), y - x)
        ((f(y) - f(x)) / (y - x)) * (y - x) = f(y) - f(x)
        df(c) * (y - x) = f(y) - f(x)
        mul_abs(df(c), y - x)
        (df(c) * (y - x)).abs = df(c).abs * (y - x).abs
        lt_imp_lte(x, y)
        x <= y
        sub_nonneg(x, y)
        Real.0 <= y - x
        abs_of_nonneg(y - x)
        (y - x).abs = y - x
        (df(c) * (y - x)).abs = df(c).abs * (y - x)
        (f(y) - f(x)).abs = (df(c) * (y - x)).abs
        (f(y) - f(x)).abs = df(c).abs * (y - x)
        forall(z: Real) {
            df(z).abs <= m
        }
        df(c).abs <= m
        mul_le_mul_of_nonneg_right(df(c).abs, m, y - x)
        df(c).abs * (y - x) <= m * (y - x)
        (f(y) - f(x)).abs <= m * (y - x)
        abs_neg(f(x) - f(y))
        (-(f(x) - f(y))).abs = (f(x) - f(y)).abs
        -(f(x) - f(y)) = f(y) - f(x)
        (f(x) - f(y)).abs = (f(y) - f(x)).abs
        (f(x) - f(y)).abs <= m * (y - x)
    }
}

/// Sine is one-Lipschitz on increasing intervals.
theorem sin_lipschitz_lt(x: Real, y: Real) {
    x < y implies (sin(x) - sin(y)).abs <= (x - y).abs
} by {
    if x < y {
        sin_continuous
        continuous(sin)
        sin_is_derivative_fn
        is_derivative_fn(sin, cos)
        forall(z: Real) {
            cos_abs_le_one(z)
            cos(z).abs <= Real.1
        }
        lipschitz_lt_of_bounded_derivative(sin, cos, Real.1, x, y)
        (sin(x) - sin(y)).abs <= Real.1 * (y - x)
        Real.1 * (y - x) = y - x
        (sin(x) - sin(y)).abs <= y - x
        lt_imp_lte(x, y)
        x <= y
        sub_nonneg(x, y)
        Real.0 <= y - x
        abs_of_nonneg(y - x)
        (y - x).abs = y - x
        abs_neg(x - y)
        (-(x - y)).abs = (x - y).abs
        -(x - y) = y - x
        (x - y).abs = (y - x).abs
        (x - y).abs = y - x
        (sin(x) - sin(y)).abs <= (x - y).abs
    }
}

