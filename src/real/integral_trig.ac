                interval_sup(f, uniform_partition(a, b, n, i), uniform_partition(a, b, n, i + 1)) -
                    interval_inf(f, uniform_partition(a, b, n, i), uniform_partition(a, b, n, i + 1)) <= uniform_mesh(a, b, n)
