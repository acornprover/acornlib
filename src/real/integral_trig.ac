        (-(x - y)).abs = (x - y).abs
        -(x - y) = y - x
        (x - y).abs = (y - x).abs
        (x - y).abs = y - x
        (cos(x) - cos(y)).abs <= (x - y).abs
    }
}

/// If x is not less than y and they are distinct, then y is less than x.
theorem not_lt_and_ne_imp_gt(x: Real, y: Real) {
    not x < y and x != y implies y < x
} by {
    if not x < y and x != y {
        not_lt_imp_gte[Real](x, y)
        y <= x
        if y < x {
            y < x
        } else {
            not y < x
            not_lt_imp_gte[Real](y, x)
            x <= y
            lte_antisymm[Real](x, y)
            x = y
            x != y
            false
        }
    }
}

/// Sine is one-Lipschitz: |sin(x) - sin(y)| <= |x - y|.
theorem sin_lipschitz(x: Real, y: Real) {
    (sin(x) - sin(y)).abs <= (x - y).abs
} by {
    if x < y {
        sin_lipschitz_lt(x, y)
        (sin(x) - sin(y)).abs <= (x - y).abs
    } else {
        not x < y
        not_lt_imp_gte[Real](x, y)
        y <= x
        if x = y {
            sin(x) - sin(y) = Real.0
            x - y = Real.0
            (sin(x) - sin(y)).abs = Real.0.abs
            (x - y).abs = Real.0.abs
            lte_self(Real.0.abs)
            Real.0.abs <= Real.0.abs
            (sin(x) - sin(y)).abs <= (x - y).abs
        } else {
            not x = y
            x != y
            not_lt_and_ne_imp_gt(x, y)
            y < x
            sin_lipschitz_lt(y, x)
            (sin(y) - sin(x)).abs <= (y - x).abs
            abs_neg(sin(x) - sin(y))
            (-(sin(x) - sin(y))).abs = (sin(x) - sin(y)).abs
            -(sin(x) - sin(y)) = sin(y) - sin(x)
            (sin(x) - sin(y)).abs = (sin(y) - sin(x)).abs
            abs_neg(x - y)
            (-(x - y)).abs = (x - y).abs
            -(x - y) = y - x
            (x - y).abs = (y - x).abs
            (sin(x) - sin(y)).abs <= (x - y).abs
        }
    }
}

/// Cosine is one-Lipschitz: |cos(x) - cos(y)| <= |x - y|.
theorem cos_lipschitz(x: Real, y: Real) {
    (cos(x) - cos(y)).abs <= (x - y).abs
} by {
