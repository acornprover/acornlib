from nat import Nat
from real.real_field import Real, div_mul_cancel_left, mul_div_cancel
from real.real_ring import real_mul_comm, mul_distrib_left, mul_one_left, mul_zero_left, mul_neg_one_left,
    mul_neg_right
from real.real_base import add_comm, add_assoc, add_zero_left, add_zero_right, add_neg_eq_zero,
    neg_distrib, neg_zero, neg_neg
from algebra.add_comm_group import sub_add_sub, sub_add_cancel
from real.trig import sin, cos, sin_neg, cos_neg
from real.trig_identities import sin_add, cos_add, sin_sq_add_cos_sq, div_add_same_denom,
    div_sub_same_denom
from real.exp import two, two_nonzero, pow_suc
from real.pi import pi
from real.trig_period import sin_add_two_pi

numerals Real

// Small algebraic helpers for rearranging sums and differences of real
// numbers.  These are stated generically and reused by the trig identities
// below.

/// Negating a difference swaps its terms: -(a - b) = b - a.
theorem neg_diff(a: Real, b: Real) {
    -(a - b) = b - a
} by {
    a - b = a + -b
    -(a - b) = -(a + -b)
    neg_distrib(a, -b)
    -(a + -b) = -a + -(-b)
    neg_neg(b)
    -(-b) = b
    -a + -(-b) = -a + b
    -(a - b) = -a + b
    add_comm(-a, b)
    -a + b = b + -a
    b - a = b + -a
    -(a - b) = b - a
}

/// Subtracting a common minuend cancels: (a - b) - (a - c) = c - b.
theorem sub_sub_cancel(a: Real, b: Real, c: Real) {
    (a - b) - (a - c) = c - b
} by {
    neg_distrib(a, -c)
    -(a + -c) = -a + -(-c)
    neg_neg(c)
    -(-c) = c
    -a + -(-c) = -a + c
    a - c = a + -c
    -(a - c) = -(a + -c)
    (a - b) - (a - c) = (a + -b) + -(a - c)
    (a + -b) + -(a - c) = (a + -b) + (-a + c)
    add_assoc(a, -b, -a + c)
    (a + -b) + (-a + c) = a + (-b + (-a + c))
    add_assoc(-b, -a, c)
    -b + (-a + c) = (-b + -a) + c
    add_comm(-b, -a)
    -b + -a = -a + -b
    (-b + -a) + c = (-a + -b) + c
    a + (-b + (-a + c)) = a + ((-a + -b) + c)
    add_assoc(a, -a + -b, c)
    a + ((-a + -b) + c) = (a + (-a + -b)) + c
    add_assoc(a, -a, -b)
    (a + -a) + -b = a + (-a + -b)
    add_neg_eq_zero(a)
    a + -a = Real.0
    ((a + -a) + -b) + c = (Real.0 + -b) + c
    add_zero_left(-b)
    Real.0 + -b = -b
    (Real.0 + -b) + c = -b + c
    c - b = c + -b
    (a - b) - (a - c) = c - b
}

/// A difference cancels when subtracted from its minuend: a - (a - b) = b.
theorem sub_minus_sub(a: Real, b: Real) {
    a - (a - b) = b
} by {
    sub_sub_cancel(a, Real.0, b)
    (a - Real.0) - (a - b) = b - Real.0
    neg_zero
    -Real.0 = Real.0
    a - Real.0 = a + -Real.0
    a + -Real.0 = a + Real.0
    add_zero_right(a)
    a + Real.0 = a
    a - Real.0 = a
    b - Real.0 = b + -Real.0
    b + -Real.0 = b + Real.0
    add_zero_right(b)
    b + Real.0 = b
    b - Real.0 = b
    a - (a - b) = b
}

/// A sum and its mirrored difference add to twice the first summand:
/// (a + b) + (a - b) = 2a.
theorem add_sum_diff(a: Real, b: Real) {
    (a + b) + (a - b) = two * a
} by {
    sub_add_cancel(a, b)
    (a - b) + b = a
    add_comm(b, a - b)
    b + (a - b) = (a - b) + b
    b + (a - b) = a
    add_assoc(a, b, a - b)
    (a + b) + (a - b) = a + (b + (a - b))
    (a + b) + (a - b) = a + a
    a + a = two * a
    (a + b) + (a - b) = two * a
}

/// A sum minus its mirrored difference is twice the second summand:
/// (a + b) - (a - b) = 2b.
theorem sub_sum_diff(a: Real, b: Real) {
    (a + b) - (a - b) = two * b
} by {
    neg_neg(b)
    -(-b) = b
    a - (-b) = a + b
    sub_sub_cancel(a, -b, b)
    (a - (-b)) - (a - b) = b - (-b)
    (a + b) - (a - b) = (a - (-b)) - (a - b)
    b - (-b) = b + b
    b + b = two * b
    (a + b) - (a - b) = two * b
}

/// The sum of a difference and its negated-difference mirror is twice the
/// common minuend: (a - b) + (a - (-b)) = 2a.
theorem add_diff_neg_diff(a: Real, b: Real) {
    (a - b) + (a - (-b)) = two * a
} by {
    sub_add_sub(a, b, a, -b)
    (a - b) + (a - (-b)) = (a + a) - (b + -b)
    add_neg_eq_zero(b)
    b + -b = Real.0
    (a + a) - (b + -b) = (a + a) - Real.0
    (a + a) - Real.0 = a + a
    a + a = two * a
    (a - b) + (a - (-b)) = two * a
}

/// The difference of a negated-difference mirror and the difference itself is
/// twice the common subtrahend: (a - (-b)) - (a - b) = 2b.
theorem sub_neg_diff_sub(a: Real, b: Real) {
    (a - (-b)) - (a - b) = two * b
} by {
    sub_sub_cancel(a, -b, b)
    (a - (-b)) - (a - b) = b - (-b)
    neg_neg(b)
    -(-b) = b
    b - (-b) = b + b
    b + b = two * b
    (a - (-b)) - (a - b) = two * b
}

// Double-angle formulas, derived directly from the addition formulas with
// y = x.

/// The sine of twice an angle is twice the product of sine and cosine.
theorem sin_two(x: Real) {
    sin(two * x) = two * sin(x) * cos(x)
} by {
    sin_add(x, x)
    sin(x + x) = sin(x) * cos(x) + cos(x) * sin(x)
    two = Real.1 + Real.1
    two * x = x + x
    sin(two * x) = sin(x) * cos(x) + cos(x) * sin(x)
    cos(x) * sin(x) = sin(x) * cos(x)
    sin(x) * cos(x) + cos(x) * sin(x) = sin(x) * cos(x) + sin(x) * cos(x)
    sin(x) * cos(x) + sin(x) * cos(x) = two * (sin(x) * cos(x))
    two * (sin(x) * cos(x)) = two * sin(x) * cos(x)
    sin(two * x) = two * sin(x) * cos(x)
}

/// The cosine of twice an angle is the difference of the squares.
theorem cos_two(x: Real) {
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
} by {
    cos_add(x, x)
    cos(x + x) = cos(x) * cos(x) - sin(x) * sin(x)
    two = Real.1 + Real.1
    two * x = x + x
    cos(two * x) = cos(x) * cos(x) - sin(x) * sin(x)
    pow_suc(cos(x), Nat.1)
    cos(x).pow(Nat.2) = cos(x) * cos(x)
    pow_suc(sin(x), Nat.1)
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
}

/// The cosine of twice an angle in terms of cosine squared alone.
theorem cos_two_alt1(x: Real) {
    cos(two * x) = two * cos(x).pow(Nat.2) - Real.1
} by {
    cos_two(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    sin(x).pow(Nat.2) = Real.1 - cos(x).pow(Nat.2)
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = cos(x).pow(Nat.2) - (Real.1 - cos(x).pow(Nat.2))
    neg_diff(Real.1, cos(x).pow(Nat.2))
    -(Real.1 - cos(x).pow(Nat.2)) = cos(x).pow(Nat.2) - Real.1
    cos(x).pow(Nat.2) - (Real.1 - cos(x).pow(Nat.2)) = cos(x).pow(Nat.2) + (cos(x).pow(Nat.2) - Real.1)
    cos(x).pow(Nat.2) + (cos(x).pow(Nat.2) - Real.1) = cos(x).pow(Nat.2) + cos(x).pow(Nat.2) - Real.1
    cos(x).pow(Nat.2) + cos(x).pow(Nat.2) = two * cos(x).pow(Nat.2)
    cos(x).pow(Nat.2) - (Real.1 - cos(x).pow(Nat.2)) = two * cos(x).pow(Nat.2) - Real.1
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = two * cos(x).pow(Nat.2) - Real.1
    cos(two * x) = two * cos(x).pow(Nat.2) - Real.1
}

/// The cosine of twice an angle in terms of sine squared alone.
theorem cos_two_alt2(x: Real) {
    cos(two * x) = Real.1 - two * sin(x).pow(Nat.2)
} by {
    cos_two(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    cos(x).pow(Nat.2) = Real.1 - sin(x).pow(Nat.2)
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = (Real.1 - sin(x).pow(Nat.2)) - sin(x).pow(Nat.2)
    (Real.1 - sin(x).pow(Nat.2)) - sin(x).pow(Nat.2) = Real.1 - (sin(x).pow(Nat.2) + sin(x).pow(Nat.2))
    sin(x).pow(Nat.2) + sin(x).pow(Nat.2) = two * sin(x).pow(Nat.2)
    Real.1 - (sin(x).pow(Nat.2) + sin(x).pow(Nat.2)) = Real.1 - two * sin(x).pow(Nat.2)
    (Real.1 - sin(x).pow(Nat.2)) - sin(x).pow(Nat.2) = Real.1 - two * sin(x).pow(Nat.2)
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = Real.1 - two * sin(x).pow(Nat.2)
    cos(two * x) = Real.1 - two * sin(x).pow(Nat.2)
}

// Half-angle (power-reduction) formulas, rearranged from the double-angle
// formulas.

/// The square of cosine is one plus cosine of twice the angle, over two.
theorem cos_sq_half(x: Real) {
    cos(x).pow(Nat.2) = (Real.1 + cos(two * x)) / two
} by {
    cos_two_alt1(x)
    cos(two * x) = two * cos(x).pow(Nat.2) - Real.1
    Real.1 + cos(two * x) = Real.1 + (two * cos(x).pow(Nat.2) - Real.1)
    Real.1 + (two * cos(x).pow(Nat.2) - Real.1) = Real.1 + two * cos(x).pow(Nat.2) - Real.1
    Real.1 + two * cos(x).pow(Nat.2) - Real.1 = two * cos(x).pow(Nat.2)
    Real.1 + (two * cos(x).pow(Nat.2) - Real.1) = two * cos(x).pow(Nat.2)
    Real.1 + cos(two * x) = two * cos(x).pow(Nat.2)
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, cos(x).pow(Nat.2))
    (two * cos(x).pow(Nat.2)) / two = cos(x).pow(Nat.2)
    (Real.1 + cos(two * x)) / two = (two * cos(x).pow(Nat.2)) / two
    (Real.1 + cos(two * x)) / two = cos(x).pow(Nat.2)
}

/// The square of sine is one minus cosine of twice the angle, over two.
theorem sin_sq_half(x: Real) {
    sin(x).pow(Nat.2) = (Real.1 - cos(two * x)) / two
} by {
    cos_two_alt2(x)
    cos(two * x) = Real.1 - two * sin(x).pow(Nat.2)
    Real.1 - cos(two * x) = Real.1 - (Real.1 - two * sin(x).pow(Nat.2))
    sub_minus_sub(Real.1, two * sin(x).pow(Nat.2))
    Real.1 - (Real.1 - two * sin(x).pow(Nat.2)) = two * sin(x).pow(Nat.2)
    Real.1 - cos(two * x) = two * sin(x).pow(Nat.2)
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, sin(x).pow(Nat.2))
    (two * sin(x).pow(Nat.2)) / two = sin(x).pow(Nat.2)
    (Real.1 - cos(two * x)) / two = (two * sin(x).pow(Nat.2)) / two
    (Real.1 - cos(two * x)) / two = sin(x).pow(Nat.2)
}

// Product-to-sum formulas, from adding and subtracting the addition formulas.

/// Sine times cosine is half the sum of the sine of the sum and the sine of
/// the difference.
theorem sin_mul_cos(x: Real, y: Real) {
    sin(x) * cos(y) = (sin(x + y) + sin(x - y)) / two
} by {
    sin_add(x, y)
    sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
    sin_add(x, -y)
    sin(x + (-y)) = sin(x) * cos(-y) + cos(x) * sin(-y)
    x + (-y) = x - y
    sin(x - y) = sin(x) * cos(-y) + cos(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    sin(x - y) = sin(x) * cos(y) + cos(x) * (-sin(y))
    mul_neg_right(cos(x), sin(y))
    cos(x) * (-sin(y)) = -(cos(x) * sin(y))
    sin(x - y) = sin(x) * cos(y) - cos(x) * sin(y)
    sin(x + y) + sin(x - y) = (sin(x) * cos(y) + cos(x) * sin(y)) + sin(x - y)
    sin(x + y) + sin(x - y) =
        (sin(x) * cos(y) + cos(x) * sin(y)) + (sin(x) * cos(y) - cos(x) * sin(y))
    add_sum_diff(sin(x) * cos(y), cos(x) * sin(y))
    (sin(x) * cos(y) + cos(x) * sin(y)) + (sin(x) * cos(y) - cos(x) * sin(y)) =
        two * (sin(x) * cos(y))
    sin(x + y) + sin(x - y) = two * (sin(x) * cos(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, sin(x) * cos(y))
    (two * (sin(x) * cos(y))) / two = sin(x) * cos(y)
    (sin(x + y) + sin(x - y)) / two = (two * (sin(x) * cos(y))) / two
    (sin(x + y) + sin(x - y)) / two = sin(x) * cos(y)
}

/// Cosine times sine is half the difference of the sine of the sum and the
/// sine of the difference.
theorem cos_mul_sin(x: Real, y: Real) {
    cos(x) * sin(y) = (sin(x + y) - sin(x - y)) / two
} by {
    sin_add(x, y)
    sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
    sin_add(x, -y)
    sin(x + (-y)) = sin(x) * cos(-y) + cos(x) * sin(-y)
    x + (-y) = x - y
    sin(x - y) = sin(x) * cos(-y) + cos(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    sin(x - y) = sin(x) * cos(y) + cos(x) * (-sin(y))
    mul_neg_right(cos(x), sin(y))
    cos(x) * (-sin(y)) = -(cos(x) * sin(y))
    sin(x - y) = sin(x) * cos(y) - cos(x) * sin(y)
    sin(x + y) - sin(x - y) = (sin(x) * cos(y) + cos(x) * sin(y)) - sin(x - y)
    sin(x + y) - sin(x - y) =
        (sin(x) * cos(y) + cos(x) * sin(y)) - (sin(x) * cos(y) - cos(x) * sin(y))
    sub_sum_diff(sin(x) * cos(y), cos(x) * sin(y))
    (sin(x) * cos(y) + cos(x) * sin(y)) - (sin(x) * cos(y) - cos(x) * sin(y)) =
        two * (cos(x) * sin(y))
    sin(x + y) - sin(x - y) = two * (cos(x) * sin(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, cos(x) * sin(y))
    (two * (cos(x) * sin(y))) / two = cos(x) * sin(y)
    (sin(x + y) - sin(x - y)) / two = (two * (cos(x) * sin(y))) / two
    (sin(x + y) - sin(x - y)) / two = cos(x) * sin(y)
}

/// Cosine times cosine is half the sum of the cosines of the sum and the
/// difference.
theorem cos_mul_cos(x: Real, y: Real) {
    cos(x) * cos(y) = (cos(x + y) + cos(x - y)) / two
} by {
    cos_add(x, y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    cos_add(x, -y)
    cos(x + (-y)) = cos(x) * cos(-y) - sin(x) * sin(-y)
    x + (-y) = x - y
    cos(x - y) = cos(x) * cos(-y) - sin(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    cos(x - y) = cos(x) * cos(y) - sin(x) * (-sin(y))
    cos(x + y) + cos(x - y) = (cos(x) * cos(y) - sin(x) * sin(y)) + cos(x - y)
    cos(x + y) + cos(x - y) =
        (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * (-sin(y)))
    mul_neg_right(sin(x), sin(y))
    sin(x) * (-sin(y)) = -(sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * (-sin(y))) =
        (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - (-(sin(x) * sin(y))))
    add_diff_neg_diff(cos(x) * cos(y), sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - (-(sin(x) * sin(y)))) =
        two * (cos(x) * cos(y))
    (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * (-sin(y))) =
        two * (cos(x) * cos(y))
    cos(x + y) + cos(x - y) = two * (cos(x) * cos(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, cos(x) * cos(y))
    (two * (cos(x) * cos(y))) / two = cos(x) * cos(y)
    (cos(x + y) + cos(x - y)) / two = (two * (cos(x) * cos(y))) / two
    (cos(x + y) + cos(x - y)) / two = cos(x) * cos(y)
}

/// Sine times sine is half the difference of the cosines of the difference and
/// the sum.
theorem sin_mul_sin(x: Real, y: Real) {
    sin(x) * sin(y) = (cos(x - y) - cos(x + y)) / two
} by {
    cos_add(x, -y)
    cos(x + (-y)) = cos(x) * cos(-y) - sin(x) * sin(-y)
    x + (-y) = x - y
    cos(x - y) = cos(x) * cos(-y) - sin(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    cos(x - y) = cos(x) * cos(y) - sin(x) * (-sin(y))
    cos_add(x, y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    cos(x - y) - cos(x + y) = cos(x - y) - (cos(x) * cos(y) - sin(x) * sin(y))
    cos(x - y) - cos(x + y) =
        (cos(x) * cos(y) - sin(x) * (-sin(y))) - (cos(x) * cos(y) - sin(x) * sin(y))
    mul_neg_right(sin(x), sin(y))
    sin(x) * (-sin(y)) = -(sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * (-sin(y))) - (cos(x) * cos(y) - sin(x) * sin(y)) =
        (cos(x) * cos(y) - (-(sin(x) * sin(y)))) - (cos(x) * cos(y) - sin(x) * sin(y))
    sub_neg_diff_sub(cos(x) * cos(y), sin(x) * sin(y))
    (cos(x) * cos(y) - (-(sin(x) * sin(y)))) - (cos(x) * cos(y) - sin(x) * sin(y)) =
        two * (sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * (-sin(y))) - (cos(x) * cos(y) - sin(x) * sin(y)) =
        two * (sin(x) * sin(y))
    cos(x - y) - cos(x + y) = two * (sin(x) * sin(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, sin(x) * sin(y))
    (two * (sin(x) * sin(y))) / two = sin(x) * sin(y)
    (cos(x - y) - cos(x + y)) / two = (two * (sin(x) * sin(y))) / two
    (cos(x - y) - cos(x + y)) / two = sin(x) * sin(y)
}

// Further consequences.

/// The sine of x plus itself is the sine of twice x.
theorem sin_add_self(x: Real) {
    sin(x + x) = sin(two * x)
} by {
    two = Real.1 + Real.1
    two * x = x + x
    sin(two * x) = sin(x + x)
    sin(x + x) = sin(two * x)
}

/// Two pi is a period of sine: sin(x + 2pi) = sin(x).
theorem sin_add_two_pi_two(x: Real) {
    sin(x + two * pi) = sin(x)
} by {
    sin_add_two_pi(x)
    sin(x + (pi + pi)) = sin(x)
    two = Real.1 + Real.1
    two * pi = pi + pi
    sin(x + two * pi) = sin(x)
}

/// The sum of two sines is twice the sine of the average times the cosine of
/// the half-difference.
theorem sin_add_sin(x: Real, y: Real) {
    sin(x) + sin(y) = two * sin((x + y) / two) * cos((x - y) / two)
} by {
    sin_mul_cos((x + y) / two, (x - y) / two)
    sin((x + y) / two) * cos((x - y) / two) =
        (sin((x + y) / two + (x - y) / two) + sin((x + y) / two - (x - y) / two)) / two
    two_nonzero
    two != Real.0
    div_add_same_denom(Real.1, x + y, x - y, two)
    Real.1 * (x + y) / two + Real.1 * (x - y) / two = Real.1 * ((x + y) + (x - y)) / two
    Real.1 * (x + y) / two + Real.1 * (x - y) / two = (x + y) / two + (x - y) / two
    Real.1 * ((x + y) + (x - y)) / two = ((x + y) + (x - y)) / two
    (x + y) / two + (x - y) / two = ((x + y) + (x - y)) / two
    add_sum_diff(x, y)
    (x + y) + (x - y) = two * x
    ((x + y) + (x - y)) / two = (two * x) / two
    div_mul_cancel_left(two, x)
    (two * x) / two = x
    ((x + y) + (x - y)) / two = x
    (x + y) / two + (x - y) / two = x
    sin((x + y) / two + (x - y) / two) = sin(x)
    div_sub_same_denom(Real.1, Real.1, x + y, x - y, two)
    Real.1 * (x + y) / two - Real.1 * (x - y) / two = (Real.1 * (x + y) - Real.1 * (x - y)) / two
    Real.1 * (x + y) / two - Real.1 * (x - y) / two = (x + y) / two - (x - y) / two
    (Real.1 * (x + y) - Real.1 * (x - y)) / two = ((x + y) - (x - y)) / two
    (x + y) / two - (x - y) / two = ((x + y) - (x - y)) / two
    sub_sum_diff(x, y)
    (x + y) - (x - y) = two * y
    ((x + y) - (x - y)) / two = (two * y) / two
    div_mul_cancel_left(two, y)
    (two * y) / two = y
    ((x + y) - (x - y)) / two = y
    (x + y) / two - (x - y) / two = y
    sin((x + y) / two - (x - y) / two) = sin(y)
    sin((x + y) / two) * cos((x - y) / two) = (sin(x) + sin(y)) / two
    mul_div_cancel(sin(x) + sin(y), two)
    two * ((sin(x) + sin(y)) / two) = sin(x) + sin(y)
    two * ((sin(x) + sin(y)) / two) = two * (sin((x + y) / two) * cos((x - y) / two))
    two * (sin((x + y) / two) * cos((x - y) / two)) = sin(x) + sin(y)
    two * sin((x + y) / two) * cos((x - y) / two) = two * (sin((x + y) / two) * cos((x - y) / two))
    two * sin((x + y) / two) * cos((x - y) / two) = sin(x) + sin(y)
}
