numerals Real

/// Four as a real number.
let four = Real.1 + Real.1 + Real.1 + Real.1

// Small algebraic helpers for rearranging sums and differences of real
// numbers.  These are stated generically and reused by the trig identities
// below.

/// Negating a difference swaps its terms: -(a - b) = b - a.
theorem neg_diff(a: Real, b: Real) {
    -(a - b) = b - a
} by {
    a - b = a + -b
    -(a - b) = -(a + -b)
    neg_distrib(a, -b)
    -(a + -b) = -a + -(-b)
    neg_neg(b)
    -(-b) = b
    -a + -(-b) = -a + b
    -(a - b) = -a + b
    add_comm(-a, b)
    -a + b = b + -a
    b - a = b + -a
    -(a - b) = b - a
}

/// Subtracting a common minuend cancels: (a - b) - (a - c) = c - b.
theorem sub_sub_cancel(a: Real, b: Real, c: Real) {
    (a - b) - (a - c) = c - b
} by {
    neg_distrib(a, -c)
    -(a + -c) = -a + -(-c)
    neg_neg(c)
    -(-c) = c
    -a + -(-c) = -a + c
    a - c = a + -c
    -(a - c) = -(a + -c)
    (a - b) - (a - c) = (a + -b) + -(a - c)
    (a + -b) + -(a - c) = (a + -b) + (-a + c)
    add_assoc(a, -b, -a + c)
    (a + -b) + (-a + c) = a + (-b + (-a + c))
    add_assoc(-b, -a, c)
    -b + (-a + c) = (-b + -a) + c
    add_comm(-b, -a)
    -b + -a = -a + -b
    (-b + -a) + c = (-a + -b) + c
    a + (-b + (-a + c)) = a + ((-a + -b) + c)
    add_assoc(a, -a + -b, c)
    a + ((-a + -b) + c) = (a + (-a + -b)) + c
    add_assoc(a, -a, -b)
    (a + -a) + -b = a + (-a + -b)
    add_neg_eq_zero(a)
    a + -a = Real.0
    ((a + -a) + -b) + c = (Real.0 + -b) + c
    add_zero_left(-b)
    Real.0 + -b = -b
    (Real.0 + -b) + c = -b + c
    c - b = c + -b
    (a - b) - (a - c) = c - b
}

/// A difference cancels when subtracted from its minuend: a - (a - b) = b.
theorem sub_minus_sub(a: Real, b: Real) {
    a - (a - b) = b
} by {
    sub_sub_cancel(a, Real.0, b)
    (a - Real.0) - (a - b) = b - Real.0
    neg_zero
    -Real.0 = Real.0
    a - Real.0 = a + -Real.0
    a + -Real.0 = a + Real.0
    add_zero_right(a)
    a + Real.0 = a
    a - Real.0 = a
    b - Real.0 = b + -Real.0
    b + -Real.0 = b + Real.0
    add_zero_right(b)
    b + Real.0 = b
    b - Real.0 = b
    a - (a - b) = b
}

/// A sum and its mirrored difference add to twice the first summand:
/// (a + b) + (a - b) = 2a.
theorem add_sum_diff(a: Real, b: Real) {
    (a + b) + (a - b) = two * a
} by {
    sub_add_cancel(a, b)
    (a - b) + b = a
    add_comm(b, a - b)
    b + (a - b) = (a - b) + b
    b + (a - b) = a
    add_assoc(a, b, a - b)
    (a + b) + (a - b) = a + (b + (a - b))
    (a + b) + (a - b) = a + a
    a + a = two * a
    (a + b) + (a - b) = two * a
}

/// A sum minus its mirrored difference is twice the second summand:
/// (a + b) - (a - b) = 2b.
theorem sub_sum_diff(a: Real, b: Real) {
    (a + b) - (a - b) = two * b
} by {
    neg_neg(b)
    -(-b) = b
    a - (-b) = a + b
    sub_sub_cancel(a, -b, b)
    (a - (-b)) - (a - b) = b - (-b)
    (a + b) - (a - b) = (a - (-b)) - (a - b)
    b - (-b) = b + b
    b + b = two * b
    (a + b) - (a - b) = two * b
}

/// The sum of a difference and its negated-difference mirror is twice the
/// common minuend: (a - b) + (a - (-b)) = 2a.
theorem add_diff_neg_diff(a: Real, b: Real) {
    (a - b) + (a - (-b)) = two * a
} by {
    sub_add_sub(a, b, a, -b)
    (a - b) + (a - (-b)) = (a + a) - (b + -b)
    add_neg_eq_zero(b)
    b + -b = Real.0
    (a + a) - (b + -b) = (a + a) - Real.0
    (a + a) - Real.0 = a + a
    a + a = two * a
    (a - b) + (a - (-b)) = two * a
}

/// The difference of a negated-difference mirror and the difference itself is
/// twice the common subtrahend: (a - (-b)) - (a - b) = 2b.
theorem sub_neg_diff_sub(a: Real, b: Real) {
    (a - (-b)) - (a - b) = two * b
} by {
    sub_sub_cancel(a, -b, b)
    (a - (-b)) - (a - b) = b - (-b)
    neg_neg(b)
    -(-b) = b
    b - (-b) = b + b
    b + b = two * b
    (a - (-b)) - (a - b) = two * b
}

/// The product of two negated numbers is the product of the originals:
/// (-a)(-b) = ab.
theorem neg_mul_neg(a: Real, b: Real) {
    (-a) * (-b) = a * b
} by {
    mul_neg_one_left(a)
    -Real.1 * a = -a
    mul_neg_one_left(b)
    -Real.1 * b = -b
    (-a) * (-b) = (-Real.1 * a) * (-Real.1 * b)
    signed_mul_combine(-Real.1, -Real.1, a, b)
    (-Real.1 * a) * (-Real.1 * b) = (-Real.1 * -Real.1) * (a * b)
    mul_neg_one_left(-Real.1)
    -Real.1 * -Real.1 = --Real.1
    neg_neg(Real.1)
    --Real.1 = Real.1
    (-Real.1 * -Real.1) * (a * b) = Real.1 * (a * b)
    Real.1 * (a * b) = a * b
    (-a) * (-b) = a * b
}

/// One and two times a summand combine to three times it: a + 2a = 3a.
theorem one_add_two_mul(a: Real) {
    a + two * a = three * a
}

/// One and three times a summand combine to four times it: a + 3a = 4a.
theorem one_add_three_mul(a: Real) {
    a + three * a = four * a
}

/// Three and one times a summand combine to four times it: 3a + a = 4a.
theorem three_add_one_mul(a: Real) {
    three * a + a = four * a
} by {
    one_add_three_mul(a)
    a + three * a = four * a
    add_comm(a, three * a)
    a + three * a = three * a + a
    three * a + a = four * a
}

/// Subtracting a difference expands into a sum: a - (b - c) = a - b + c.
theorem sub_diff_add(a: Real, b: Real, c: Real) {
    a - (b - c) = a - b + c
} by {
    b - c = b + -c
    a - (b - c) = a - (b + -c)
    a - (b + -c) = a + -(b + -c)
    neg_distrib(b, -c)
    -(b + -c) = -b + -(-c)
    neg_neg(c)
    -(-c) = c
    -b + -(-c) = -b + c
    a + -(b + -c) = a + (-b + c)
    a + (-b + c) = a + -b + c
    a - b + c = a + -b + c
    a - (b - c) = a - b + c
}

// Double-angle formulas, derived directly from the addition formulas with
// y = x.

/// The sine of twice an angle is twice the product of sine and cosine.
theorem sin_two(x: Real) {
    sin(two * x) = two * sin(x) * cos(x)
} by {
    sin_add(x, x)
    sin(x + x) = sin(x) * cos(x) + cos(x) * sin(x)
    two = Real.1 + Real.1
    two * x = x + x
    sin(two * x) = sin(x) * cos(x) + cos(x) * sin(x)
    cos(x) * sin(x) = sin(x) * cos(x)
    sin(x) * cos(x) + cos(x) * sin(x) = sin(x) * cos(x) + sin(x) * cos(x)
    sin(x) * cos(x) + sin(x) * cos(x) = two * (sin(x) * cos(x))
    two * (sin(x) * cos(x)) = two * sin(x) * cos(x)
    sin(two * x) = two * sin(x) * cos(x)
}

/// The cosine of twice an angle is the difference of the squares.
theorem cos_two(x: Real) {
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
} by {
    cos_add(x, x)
    cos(x + x) = cos(x) * cos(x) - sin(x) * sin(x)
    two = Real.1 + Real.1
    two * x = x + x
    cos(two * x) = cos(x) * cos(x) - sin(x) * sin(x)
    pow_suc(cos(x), Nat.1)
    cos(x).pow(Nat.2) = cos(x) * cos(x)
    pow_suc(sin(x), Nat.1)
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
}

/// The cosine of twice an angle in terms of cosine squared alone.
theorem cos_two_alt1(x: Real) {
    cos(two * x) = two * cos(x).pow(Nat.2) - Real.1
} by {
    cos_two(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    sin(x).pow(Nat.2) = Real.1 - cos(x).pow(Nat.2)
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = cos(x).pow(Nat.2) - (Real.1 - cos(x).pow(Nat.2))
    neg_diff(Real.1, cos(x).pow(Nat.2))
    -(Real.1 - cos(x).pow(Nat.2)) = cos(x).pow(Nat.2) - Real.1
    cos(x).pow(Nat.2) - (Real.1 - cos(x).pow(Nat.2)) = cos(x).pow(Nat.2) + (cos(x).pow(Nat.2) - Real.1)
    cos(x).pow(Nat.2) + (cos(x).pow(Nat.2) - Real.1) = cos(x).pow(Nat.2) + cos(x).pow(Nat.2) - Real.1
    cos(x).pow(Nat.2) + cos(x).pow(Nat.2) = two * cos(x).pow(Nat.2)
    cos(x).pow(Nat.2) - (Real.1 - cos(x).pow(Nat.2)) = two * cos(x).pow(Nat.2) - Real.1
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = two * cos(x).pow(Nat.2) - Real.1
    cos(two * x) = two * cos(x).pow(Nat.2) - Real.1
}

/// The cosine of twice an angle in terms of sine squared alone.
theorem cos_two_alt2(x: Real) {
    cos(two * x) = Real.1 - two * sin(x).pow(Nat.2)
} by {
    cos_two(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    cos(x).pow(Nat.2) = Real.1 - sin(x).pow(Nat.2)
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = (Real.1 - sin(x).pow(Nat.2)) - sin(x).pow(Nat.2)
    (Real.1 - sin(x).pow(Nat.2)) - sin(x).pow(Nat.2) = Real.1 - (sin(x).pow(Nat.2) + sin(x).pow(Nat.2))
    sin(x).pow(Nat.2) + sin(x).pow(Nat.2) = two * sin(x).pow(Nat.2)
    Real.1 - (sin(x).pow(Nat.2) + sin(x).pow(Nat.2)) = Real.1 - two * sin(x).pow(Nat.2)
    (Real.1 - sin(x).pow(Nat.2)) - sin(x).pow(Nat.2) = Real.1 - two * sin(x).pow(Nat.2)
    cos(x).pow(Nat.2) - sin(x).pow(Nat.2) = Real.1 - two * sin(x).pow(Nat.2)
    cos(two * x) = Real.1 - two * sin(x).pow(Nat.2)
}

// Half-angle (power-reduction) formulas, rearranged from the double-angle
// formulas.

/// The square of cosine is one plus cosine of twice the angle, over two.
theorem cos_sq_half(x: Real) {
    cos(x).pow(Nat.2) = (Real.1 + cos(two * x)) / two
} by {
    cos_two_alt1(x)
    cos(two * x) = two * cos(x).pow(Nat.2) - Real.1
    Real.1 + cos(two * x) = Real.1 + (two * cos(x).pow(Nat.2) - Real.1)
    Real.1 + (two * cos(x).pow(Nat.2) - Real.1) = Real.1 + two * cos(x).pow(Nat.2) - Real.1
    Real.1 + two * cos(x).pow(Nat.2) - Real.1 = two * cos(x).pow(Nat.2)
    Real.1 + (two * cos(x).pow(Nat.2) - Real.1) = two * cos(x).pow(Nat.2)
    Real.1 + cos(two * x) = two * cos(x).pow(Nat.2)
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, cos(x).pow(Nat.2))
    (two * cos(x).pow(Nat.2)) / two = cos(x).pow(Nat.2)
    (Real.1 + cos(two * x)) / two = (two * cos(x).pow(Nat.2)) / two
    (Real.1 + cos(two * x)) / two = cos(x).pow(Nat.2)
}

/// The square of sine is one minus cosine of twice the angle, over two.
theorem sin_sq_half(x: Real) {
    sin(x).pow(Nat.2) = (Real.1 - cos(two * x)) / two
} by {
    cos_two_alt2(x)
    cos(two * x) = Real.1 - two * sin(x).pow(Nat.2)
    Real.1 - cos(two * x) = Real.1 - (Real.1 - two * sin(x).pow(Nat.2))
    sub_minus_sub(Real.1, two * sin(x).pow(Nat.2))
    Real.1 - (Real.1 - two * sin(x).pow(Nat.2)) = two * sin(x).pow(Nat.2)
    Real.1 - cos(two * x) = two * sin(x).pow(Nat.2)
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, sin(x).pow(Nat.2))
    (two * sin(x).pow(Nat.2)) / two = sin(x).pow(Nat.2)
    (Real.1 - cos(two * x)) / two = (two * sin(x).pow(Nat.2)) / two
    (Real.1 - cos(two * x)) / two = sin(x).pow(Nat.2)
}

// Product-to-sum formulas, from adding and subtracting the addition formulas.

/// Sine times cosine is half the sum of the sine of the sum and the sine of
/// the difference.
theorem sin_mul_cos(x: Real, y: Real) {
    sin(x) * cos(y) = (sin(x + y) + sin(x - y)) / two
} by {
    sin_add(x, y)
    sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
    sin_add(x, -y)
    sin(x + (-y)) = sin(x) * cos(-y) + cos(x) * sin(-y)
    x + (-y) = x - y
    sin(x - y) = sin(x) * cos(-y) + cos(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    sin(x - y) = sin(x) * cos(y) + cos(x) * (-sin(y))
    mul_neg_right(cos(x), sin(y))
    cos(x) * (-sin(y)) = -(cos(x) * sin(y))
    sin(x - y) = sin(x) * cos(y) - cos(x) * sin(y)
    sin(x + y) + sin(x - y) = (sin(x) * cos(y) + cos(x) * sin(y)) + sin(x - y)
    sin(x + y) + sin(x - y) =
        (sin(x) * cos(y) + cos(x) * sin(y)) + (sin(x) * cos(y) - cos(x) * sin(y))
    add_sum_diff(sin(x) * cos(y), cos(x) * sin(y))
    (sin(x) * cos(y) + cos(x) * sin(y)) + (sin(x) * cos(y) - cos(x) * sin(y)) =
        two * (sin(x) * cos(y))
    sin(x + y) + sin(x - y) = two * (sin(x) * cos(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, sin(x) * cos(y))
    (two * (sin(x) * cos(y))) / two = sin(x) * cos(y)
    (sin(x + y) + sin(x - y)) / two = (two * (sin(x) * cos(y))) / two
    (sin(x + y) + sin(x - y)) / two = sin(x) * cos(y)
}

/// Cosine times sine is half the difference of the sine of the sum and the
/// sine of the difference.
theorem cos_mul_sin(x: Real, y: Real) {
    cos(x) * sin(y) = (sin(x + y) - sin(x - y)) / two
} by {
    sin_add(x, y)
    sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
    sin_add(x, -y)
    sin(x + (-y)) = sin(x) * cos(-y) + cos(x) * sin(-y)
    x + (-y) = x - y
    sin(x - y) = sin(x) * cos(-y) + cos(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    sin(x - y) = sin(x) * cos(y) + cos(x) * (-sin(y))
    mul_neg_right(cos(x), sin(y))
    cos(x) * (-sin(y)) = -(cos(x) * sin(y))
    sin(x - y) = sin(x) * cos(y) - cos(x) * sin(y)
    sin(x + y) - sin(x - y) = (sin(x) * cos(y) + cos(x) * sin(y)) - sin(x - y)
    sin(x + y) - sin(x - y) =
        (sin(x) * cos(y) + cos(x) * sin(y)) - (sin(x) * cos(y) - cos(x) * sin(y))
    sub_sum_diff(sin(x) * cos(y), cos(x) * sin(y))
    (sin(x) * cos(y) + cos(x) * sin(y)) - (sin(x) * cos(y) - cos(x) * sin(y)) =
        two * (cos(x) * sin(y))
    sin(x + y) - sin(x - y) = two * (cos(x) * sin(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, cos(x) * sin(y))
    (two * (cos(x) * sin(y))) / two = cos(x) * sin(y)
    (sin(x + y) - sin(x - y)) / two = (two * (cos(x) * sin(y))) / two
    (sin(x + y) - sin(x - y)) / two = cos(x) * sin(y)
}

/// Cosine times cosine is half the sum of the cosines of the sum and the
/// difference.
theorem cos_mul_cos(x: Real, y: Real) {
    cos(x) * cos(y) = (cos(x + y) + cos(x - y)) / two
} by {
    cos_add(x, y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    cos_add(x, -y)
    cos(x + (-y)) = cos(x) * cos(-y) - sin(x) * sin(-y)
    x + (-y) = x - y
    cos(x - y) = cos(x) * cos(-y) - sin(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    cos(x - y) = cos(x) * cos(y) - sin(x) * (-sin(y))
    cos(x + y) + cos(x - y) = (cos(x) * cos(y) - sin(x) * sin(y)) + cos(x - y)
    cos(x + y) + cos(x - y) =
        (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * (-sin(y)))
    mul_neg_right(sin(x), sin(y))
    sin(x) * (-sin(y)) = -(sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * (-sin(y))) =
        (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - (-(sin(x) * sin(y))))
    add_diff_neg_diff(cos(x) * cos(y), sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - (-(sin(x) * sin(y)))) =
        two * (cos(x) * cos(y))
    (cos(x) * cos(y) - sin(x) * sin(y)) + (cos(x) * cos(y) - sin(x) * (-sin(y))) =
        two * (cos(x) * cos(y))
    cos(x + y) + cos(x - y) = two * (cos(x) * cos(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, cos(x) * cos(y))
    (two * (cos(x) * cos(y))) / two = cos(x) * cos(y)
    (cos(x + y) + cos(x - y)) / two = (two * (cos(x) * cos(y))) / two
    (cos(x + y) + cos(x - y)) / two = cos(x) * cos(y)
}

/// Sine times sine is half the difference of the cosines of the difference and
/// the sum.
theorem sin_mul_sin(x: Real, y: Real) {
    sin(x) * sin(y) = (cos(x - y) - cos(x + y)) / two
} by {
    cos_add(x, -y)
    cos(x + (-y)) = cos(x) * cos(-y) - sin(x) * sin(-y)
    x + (-y) = x - y
    cos(x - y) = cos(x) * cos(-y) - sin(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    cos(x - y) = cos(x) * cos(y) - sin(x) * (-sin(y))
    cos_add(x, y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    cos(x - y) - cos(x + y) = cos(x - y) - (cos(x) * cos(y) - sin(x) * sin(y))
    cos(x - y) - cos(x + y) =
        (cos(x) * cos(y) - sin(x) * (-sin(y))) - (cos(x) * cos(y) - sin(x) * sin(y))
    mul_neg_right(sin(x), sin(y))
    sin(x) * (-sin(y)) = -(sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * (-sin(y))) - (cos(x) * cos(y) - sin(x) * sin(y)) =
        (cos(x) * cos(y) - (-(sin(x) * sin(y)))) - (cos(x) * cos(y) - sin(x) * sin(y))
    sub_neg_diff_sub(cos(x) * cos(y), sin(x) * sin(y))
    (cos(x) * cos(y) - (-(sin(x) * sin(y)))) - (cos(x) * cos(y) - sin(x) * sin(y)) =
        two * (sin(x) * sin(y))
    (cos(x) * cos(y) - sin(x) * (-sin(y))) - (cos(x) * cos(y) - sin(x) * sin(y)) =
        two * (sin(x) * sin(y))
    cos(x - y) - cos(x + y) = two * (sin(x) * sin(y))
    two_nonzero
    two != Real.0
    div_mul_cancel_left(two, sin(x) * sin(y))
    (two * (sin(x) * sin(y))) / two = sin(x) * sin(y)
    (cos(x - y) - cos(x + y)) / two = (two * (sin(x) * sin(y))) / two
    (cos(x - y) - cos(x + y)) / two = sin(x) * sin(y)
}

// Further consequences.

/// The sine of x plus itself is the sine of twice x.
theorem sin_add_self(x: Real) {
    sin(x + x) = sin(two * x)
} by {
    two = Real.1 + Real.1
    two * x = x + x
    sin(two * x) = sin(x + x)
    sin(x + x) = sin(two * x)
}

/// Two pi is a period of sine: sin(x + 2pi) = sin(x).
theorem sin_add_two_pi_two(x: Real) {
    sin(x + two * pi) = sin(x)
} by {
    sin_add_two_pi(x)
    sin(x + (pi + pi)) = sin(x)
    two = Real.1 + Real.1
    two * pi = pi + pi
    sin(x + two * pi) = sin(x)
}

/// The average plus the half-difference is the larger term:
/// (x + y)/2 + (x - y)/2 = x.
theorem half_sum_add(x: Real, y: Real) {
    (x + y) / two + (x - y) / two = x
} by {
    two_nonzero
    two != Real.0
    div_add_same_denom(Real.1, x + y, x - y, two)
    Real.1 * (x + y) / two + Real.1 * (x - y) / two = Real.1 * ((x + y) + (x - y)) / two
    Real.1 * (x + y) / two + Real.1 * (x - y) / two = (x + y) / two + (x - y) / two
    Real.1 * ((x + y) + (x - y)) / two = ((x + y) + (x - y)) / two
    (x + y) / two + (x - y) / two = ((x + y) + (x - y)) / two
    add_sum_diff(x, y)
    (x + y) + (x - y) = two * x
    ((x + y) + (x - y)) / two = (two * x) / two
    div_mul_cancel_left(two, x)
    (two * x) / two = x
    ((x + y) + (x - y)) / two = x
    (x + y) / two + (x - y) / two = x
}

/// The average minus the half-difference is the smaller term:
/// (x + y)/2 - (x - y)/2 = y.
theorem half_sum_sub(x: Real, y: Real) {
    (x + y) / two - (x - y) / two = y
} by {
    two_nonzero
    two != Real.0
    div_sub_same_denom(Real.1, Real.1, x + y, x - y, two)
    Real.1 * (x + y) / two - Real.1 * (x - y) / two = (Real.1 * (x + y) - Real.1 * (x - y)) / two
    Real.1 * (x + y) / two - Real.1 * (x - y) / two = (x + y) / two - (x - y) / two
    (Real.1 * (x + y) - Real.1 * (x - y)) / two = ((x + y) - (x - y)) / two
    (x + y) / two - (x - y) / two = ((x + y) - (x - y)) / two
    sub_sum_diff(x, y)
    (x + y) - (x - y) = two * y
    ((x + y) - (x - y)) / two = (two * y) / two
    div_mul_cancel_left(two, y)
    (two * y) / two = y
    ((x + y) - (x - y)) / two = y
    (x + y) / two - (x - y) / two = y
}

/// The sum of two sines is twice the sine of the average times the cosine of
/// the half-difference.
theorem sin_add_sin(x: Real, y: Real) {
    sin(x) + sin(y) = two * sin((x + y) / two) * cos((x - y) / two)
} by {
    sin_mul_cos((x + y) / two, (x - y) / two)
    sin((x + y) / two) * cos((x - y) / two) =
        (sin((x + y) / two + (x - y) / two) + sin((x + y) / two - (x - y) / two)) / two
    half_sum_add(x, y)
    (x + y) / two + (x - y) / two = x
    half_sum_sub(x, y)
    (x + y) / two - (x - y) / two = y
    sin((x + y) / two + (x - y) / two) = sin(x)
    sin((x + y) / two - (x - y) / two) = sin(y)
    sin((x + y) / two) * cos((x - y) / two) = (sin(x) + sin(y)) / two
    mul_div_cancel(sin(x) + sin(y), two)
    two * ((sin(x) + sin(y)) / two) = sin(x) + sin(y)
    two * ((sin(x) + sin(y)) / two) = two * (sin((x + y) / two) * cos((x - y) / two))
    two * (sin((x + y) / two) * cos((x - y) / two)) = sin(x) + sin(y)
    two * sin((x + y) / two) * cos((x - y) / two) = two * (sin((x + y) / two) * cos((x - y) / two))
    two * sin((x + y) / two) * cos((x - y) / two) = sin(x) + sin(y)
}

/// The difference of two sines is twice the cosine of the average times the
/// sine of the half-difference.
theorem sin_sub_sin(x: Real, y: Real) {
    sin(x) - sin(y) = two * cos((x + y) / two) * sin((x - y) / two)
} by {
    cos_mul_sin((x + y) / two, (x - y) / two)
    cos((x + y) / two) * sin((x - y) / two) =
        (sin((x + y) / two + (x - y) / two) - sin((x + y) / two - (x - y) / two)) / two
    half_sum_add(x, y)
    (x + y) / two + (x - y) / two = x
    half_sum_sub(x, y)
    (x + y) / two - (x - y) / two = y
    sin((x + y) / two + (x - y) / two) = sin(x)
    sin((x + y) / two - (x - y) / two) = sin(y)
    cos((x + y) / two) * sin((x - y) / two) = (sin(x) - sin(y)) / two
    mul_div_cancel(sin(x) - sin(y), two)
    two * ((sin(x) - sin(y)) / two) = sin(x) - sin(y)
    two * ((sin(x) - sin(y)) / two) = two * (cos((x + y) / two) * sin((x - y) / two))
    two * (cos((x + y) / two) * sin((x - y) / two)) = sin(x) - sin(y)
    two * cos((x + y) / two) * sin((x - y) / two) = two * (cos((x + y) / two) * sin((x - y) / two))
    two * cos((x + y) / two) * sin((x - y) / two) = sin(x) - sin(y)
}

/// The sum of two cosines is twice the cosine of the average times the cosine
/// of the half-difference.
theorem cos_add_cos(x: Real, y: Real) {
    cos(x) + cos(y) = two * cos((x + y) / two) * cos((x - y) / two)
} by {
    cos_mul_cos((x + y) / two, (x - y) / two)
    cos((x + y) / two) * cos((x - y) / two) =
        (cos((x + y) / two + (x - y) / two) + cos((x + y) / two - (x - y) / two)) / two
    half_sum_add(x, y)
    (x + y) / two + (x - y) / two = x
    half_sum_sub(x, y)
    (x + y) / two - (x - y) / two = y
    cos((x + y) / two + (x - y) / two) = cos(x)
    cos((x + y) / two - (x - y) / two) = cos(y)
    cos((x + y) / two) * cos((x - y) / two) = (cos(x) + cos(y)) / two
    mul_div_cancel(cos(x) + cos(y), two)
    two * ((cos(x) + cos(y)) / two) = cos(x) + cos(y)
    two * ((cos(x) + cos(y)) / two) = two * (cos((x + y) / two) * cos((x - y) / two))
    two * (cos((x + y) / two) * cos((x - y) / two)) = cos(x) + cos(y)
    two * cos((x + y) / two) * cos((x - y) / two) = two * (cos((x + y) / two) * cos((x - y) / two))
    two * cos((x + y) / two) * cos((x - y) / two) = cos(x) + cos(y)
}

/// The difference of two cosines is minus twice the sine of the average times
/// the sine of the half-difference.
theorem cos_sub_cos(x: Real, y: Real) {
    cos(x) - cos(y) = -(two * sin((x + y) / two) * sin((x - y) / two))
} by {
    sin_mul_sin((x + y) / two, (x - y) / two)
    sin((x + y) / two) * sin((x - y) / two) =
        (cos((x + y) / two - (x - y) / two) - cos((x + y) / two + (x - y) / two)) / two
    half_sum_add(x, y)
    (x + y) / two + (x - y) / two = x
    half_sum_sub(x, y)
    (x + y) / two - (x - y) / two = y
    cos((x + y) / two - (x - y) / two) = cos(y)
    cos((x + y) / two + (x - y) / two) = cos(x)
    sin((x + y) / two) * sin((x - y) / two) = (cos(y) - cos(x)) / two
    mul_div_cancel(cos(y) - cos(x), two)
    two * ((cos(y) - cos(x)) / two) = cos(y) - cos(x)
    two * ((cos(y) - cos(x)) / two) = two * (sin((x + y) / two) * sin((x - y) / two))
    two * (sin((x + y) / two) * sin((x - y) / two)) = cos(y) - cos(x)
    neg_diff(cos(y), cos(x))
    -(cos(y) - cos(x)) = cos(x) - cos(y)
    -(two * (sin((x + y) / two) * sin((x - y) / two))) = -(cos(y) - cos(x))
    -(two * (sin((x + y) / two) * sin((x - y) / two))) = cos(x) - cos(y)
    two * sin((x + y) / two) * sin((x - y) / two) = two * (sin((x + y) / two) * sin((x - y) / two))
    -(two * sin((x + y) / two) * sin((x - y) / two)) = -(two * (sin((x + y) / two) * sin((x - y) / two)))
    -(two * sin((x + y) / two) * sin((x - y) / two)) = cos(x) - cos(y)
}

// Triple-angle formulas.

/// The sine of three times an angle in terms of sine and cosine.
theorem sin_three(x: Real) {
    sin(two * x + x) = three * sin(x) * cos(x).pow(Nat.2) - sin(x).pow(Nat.3)
} by {
    sin_add(two * x, x)
    sin(two * x + x) = sin(two * x) * cos(x) + cos(two * x) * sin(x)
    sin_two(x)
    sin(two * x) = two * sin(x) * cos(x)
    cos_two(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
    sin(two * x + x) = (two * sin(x) * cos(x)) * cos(x) + (cos(x).pow(Nat.2) - sin(x).pow(Nat.2)) * sin(x)
    pow_suc(cos(x), Nat.1)
    cos(x).pow(Nat.2) = cos(x) * cos(x)
    pow_suc(sin(x), Nat.1)
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    (two * sin(x) * cos(x)) * cos(x) = two * sin(x) * cos(x).pow(Nat.2)
    pow_suc(sin(x), Nat.2)
    sin(x).pow(Nat.3) = sin(x) * sin(x).pow(Nat.2)
    mul_sub_distrib_left(cos(x).pow(Nat.2), sin(x).pow(Nat.2), sin(x))
    (cos(x).pow(Nat.2) - sin(x).pow(Nat.2)) * sin(x) = cos(x).pow(Nat.2) * sin(x) - sin(x).pow(Nat.2) * sin(x)
    sin(x).pow(Nat.2) * sin(x) = sin(x).pow(Nat.3)
    (cos(x).pow(Nat.2) - sin(x).pow(Nat.2)) * sin(x) = cos(x).pow(Nat.2) * sin(x) - sin(x).pow(Nat.3)
    cos(x).pow(Nat.2) * sin(x) = sin(x) * cos(x).pow(Nat.2)
    two * sin(x) * cos(x).pow(Nat.2) + sin(x) * cos(x).pow(Nat.2) = three * sin(x) * cos(x).pow(Nat.2)
    two * sin(x) * cos(x).pow(Nat.2) + (cos(x).pow(Nat.2) * sin(x) - sin(x).pow(Nat.3)) =
        (two * sin(x) * cos(x).pow(Nat.2) + cos(x).pow(Nat.2) * sin(x)) - sin(x).pow(Nat.3)
    two * sin(x) * cos(x).pow(Nat.2) + (cos(x).pow(Nat.2) * sin(x) - sin(x).pow(Nat.3)) =
        three * sin(x) * cos(x).pow(Nat.2) - sin(x).pow(Nat.3)
    sin(two * x + x) = three * sin(x) * cos(x).pow(Nat.2) - sin(x).pow(Nat.3)
}

/// The cosine of three times an angle in terms of sine and cosine.
theorem cos_three(x: Real) {
    cos(two * x + x) = cos(x).pow(Nat.3) - three * sin(x).pow(Nat.2) * cos(x)
} by {
    cos_add(two * x, x)
    cos(two * x + x) = cos(two * x) * cos(x) - sin(two * x) * sin(x)
    cos_two(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
    sin_two(x)
    sin(two * x) = two * sin(x) * cos(x)
    cos(two * x + x) = (cos(x).pow(Nat.2) - sin(x).pow(Nat.2)) * cos(x) - (two * sin(x) * cos(x)) * sin(x)
    pow_suc(cos(x), Nat.1)
    cos(x).pow(Nat.2) = cos(x) * cos(x)
    pow_suc(sin(x), Nat.1)
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    pow_suc(cos(x), Nat.2)
    cos(x).pow(Nat.3) = cos(x) * cos(x).pow(Nat.2)
    (cos(x).pow(Nat.2) - sin(x).pow(Nat.2)) * cos(x) = cos(x).pow(Nat.3) - sin(x).pow(Nat.2) * cos(x)
    (two * sin(x) * cos(x)) * sin(x) = two * sin(x) * (cos(x) * sin(x))
    two * sin(x) * (cos(x) * sin(x)) = two * sin(x) * (sin(x) * cos(x))
    two * sin(x) * (sin(x) * cos(x)) = two * (sin(x) * sin(x)) * cos(x)
    two * (sin(x) * sin(x)) * cos(x) = two * sin(x).pow(Nat.2) * cos(x)
    (two * sin(x) * cos(x)) * sin(x) = two * sin(x).pow(Nat.2) * cos(x)
    one_add_two_mul(sin(x).pow(Nat.2) * cos(x))
    sin(x).pow(Nat.2) * cos(x) + two * sin(x).pow(Nat.2) * cos(x) = three * sin(x).pow(Nat.2) * cos(x)
    cos(x).pow(Nat.3) - sin(x).pow(Nat.2) * cos(x) - two * sin(x).pow(Nat.2) * cos(x) =
        cos(x).pow(Nat.3) - (sin(x).pow(Nat.2) * cos(x) + two * sin(x).pow(Nat.2) * cos(x))
    cos(x).pow(Nat.3) - (sin(x).pow(Nat.2) * cos(x) + two * sin(x).pow(Nat.2) * cos(x)) =
        cos(x).pow(Nat.3) - three * sin(x).pow(Nat.2) * cos(x)
    cos(x).pow(Nat.3) - sin(x).pow(Nat.2) * cos(x) - two * sin(x).pow(Nat.2) * cos(x) =
        cos(x).pow(Nat.3) - three * sin(x).pow(Nat.2) * cos(x)
    cos(two * x + x) = cos(x).pow(Nat.3) - three * sin(x).pow(Nat.2) * cos(x)
}

/// The sine of three times an angle in terms of sine alone.
theorem sin_three_sin(x: Real) {
    sin(two * x + x) = three * sin(x) - four * sin(x).pow(Nat.3)
} by {
    sin_three(x)
    sin(two * x + x) = three * sin(x) * cos(x).pow(Nat.2) - sin(x).pow(Nat.3)
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    cos(x).pow(Nat.2) = Real.1 - sin(x).pow(Nat.2)
    pow_suc(sin(x), Nat.2)
    sin(x).pow(Nat.3) = sin(x) * sin(x).pow(Nat.2)
    three * sin(x) * cos(x).pow(Nat.2) = three * sin(x) * (Real.1 - sin(x).pow(Nat.2))
    three * sin(x) * (Real.1 - sin(x).pow(Nat.2)) = three * sin(x) - three * sin(x) * sin(x).pow(Nat.2)
    three * sin(x) * sin(x).pow(Nat.2) = three * sin(x).pow(Nat.3)
    three * sin(x) * cos(x).pow(Nat.2) = three * sin(x) - three * sin(x).pow(Nat.3)
    three * sin(x) * cos(x).pow(Nat.2) - sin(x).pow(Nat.3) =
        three * sin(x) - three * sin(x).pow(Nat.3) - sin(x).pow(Nat.3)
    three_add_one_mul(sin(x).pow(Nat.3))
    three * sin(x).pow(Nat.3) + sin(x).pow(Nat.3) = four * sin(x).pow(Nat.3)
    three * sin(x) - three * sin(x).pow(Nat.3) - sin(x).pow(Nat.3) =
        three * sin(x) - (three * sin(x).pow(Nat.3) + sin(x).pow(Nat.3))
    three * sin(x) - (three * sin(x).pow(Nat.3) + sin(x).pow(Nat.3)) =
        three * sin(x) - four * sin(x).pow(Nat.3)
    three * sin(x) - three * sin(x).pow(Nat.3) - sin(x).pow(Nat.3) = three * sin(x) - four * sin(x).pow(Nat.3)
    sin(two * x + x) = three * sin(x) - four * sin(x).pow(Nat.3)
}

/// The cosine of three times an angle in terms of cosine alone.
theorem cos_three_cos(x: Real) {
    cos(two * x + x) = four * cos(x).pow(Nat.3) - three * cos(x)
} by {
    cos_three(x)
    cos(two * x + x) = cos(x).pow(Nat.3) - three * sin(x).pow(Nat.2) * cos(x)
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    sin(x).pow(Nat.2) = Real.1 - cos(x).pow(Nat.2)
    pow_suc(cos(x), Nat.2)
    cos(x).pow(Nat.3) = cos(x) * cos(x).pow(Nat.2)
    three * sin(x).pow(Nat.2) * cos(x) = three * (Real.1 - cos(x).pow(Nat.2)) * cos(x)
    three * (Real.1 - cos(x).pow(Nat.2)) * cos(x) = three * cos(x) - three * cos(x).pow(Nat.2) * cos(x)
    three * cos(x).pow(Nat.2) * cos(x) = three * cos(x).pow(Nat.3)
    three * sin(x).pow(Nat.2) * cos(x) = three * cos(x) - three * cos(x).pow(Nat.3)
    cos(x).pow(Nat.3) - three * sin(x).pow(Nat.2) * cos(x) =
        cos(x).pow(Nat.3) - (three * cos(x) - three * cos(x).pow(Nat.3))
    sub_diff_add(cos(x).pow(Nat.3), three * cos(x), three * cos(x).pow(Nat.3))
    cos(x).pow(Nat.3) - (three * cos(x) - three * cos(x).pow(Nat.3)) =
        cos(x).pow(Nat.3) - three * cos(x) + three * cos(x).pow(Nat.3)
    cos(x).pow(Nat.3) - three * cos(x) + three * cos(x).pow(Nat.3) =
        cos(x).pow(Nat.3) + three * cos(x).pow(Nat.3) - three * cos(x)
    one_add_three_mul(cos(x).pow(Nat.3))
    cos(x).pow(Nat.3) + three * cos(x).pow(Nat.3) = four * cos(x).pow(Nat.3)
    cos(x).pow(Nat.3) + three * cos(x).pow(Nat.3) - three * cos(x) = four * cos(x).pow(Nat.3) - three * cos(x)
    cos(x).pow(Nat.3) - three * cos(x) + three * cos(x).pow(Nat.3) = four * cos(x).pow(Nat.3) - three * cos(x)
    cos(x).pow(Nat.3) - three * sin(x).pow(Nat.2) * cos(x) = four * cos(x).pow(Nat.3) - three * cos(x)
    cos(two * x + x) = four * cos(x).pow(Nat.3) - three * cos(x)
}

// Half-angle applications of the double-angle formulas.

/// Cosine in terms of the square of the cosine of the half-angle.
theorem cos_half_sq(x: Real) {
    cos(x) = two * cos(x / two).pow(Nat.2) - Real.1
} by {
    cos_two_alt1(x / two)
    cos(two * (x / two)) = two * cos(x / two).pow(Nat.2) - Real.1
    mul_div_cancel(x, two)
    two * (x / two) = x
    cos(two * (x / two)) = cos(x)
    cos(x) = two * cos(x / two).pow(Nat.2) - Real.1
}

/// Sine in terms of the product of sine and cosine of the half-angle.
theorem sin_half_sq(x: Real) {
    sin(x) = two * sin(x / two) * cos(x / two)
} by {
    sin_two(x / two)
    sin(two * (x / two)) = two * sin(x / two) * cos(x / two)
    mul_div_cancel(x, two)
    two * (x / two) = x
    sin(two * (x / two)) = sin(x)
    sin(x) = two * sin(x / two) * cos(x / two)
}

/// Cosine in terms of the square of the sine of the half-angle.
theorem cos_half_sin(x: Real) {
    cos(x) = Real.1 - two * sin(x / two).pow(Nat.2)
} by {
    cos_two_alt2(x / two)
    cos(two * (x / two)) = Real.1 - two * sin(x / two).pow(Nat.2)
    mul_div_cancel(x, two)
    two * (x / two) = x
    cos(two * (x / two)) = cos(x)
    cos(x) = Real.1 - two * sin(x / two).pow(Nat.2)
}

// Parity combinations.

/// The square of sine at -x is the square at x.
theorem sin_sq_neg(x: Real) {
    sin(-x).pow(Nat.2) = sin(x).pow(Nat.2)
} by {
    sin_neg(x)
    sin(-x) = -sin(x)
    sin(-x).pow(Nat.2) = (-sin(x)).pow(Nat.2)
    pow_suc(-sin(x), Nat.1)
    (-sin(x)).pow(Nat.2) = (-sin(x)) * (-sin(x))
    neg_mul_neg(sin(x), sin(x))
    (-sin(x)) * (-sin(x)) = sin(x) * sin(x)
    pow_suc(sin(x), Nat.1)
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    (-sin(x)).pow(Nat.2) = sin(x).pow(Nat.2)
    sin(-x).pow(Nat.2) = sin(x).pow(Nat.2)
}

/// The square of cosine at -x is the square at x.
theorem cos_sq_neg(x: Real) {
    cos(-x).pow(Nat.2) = cos(x).pow(Nat.2)
} by {
    cos_neg(x)
    cos(-x) = cos(x)
    cos(-x).pow(Nat.2) = cos(x).pow(Nat.2)
}

/// The product of sine and cosine at -x is the negative of the product at x.
theorem sin_neg_mul_cos_neg(x: Real) {
    sin(-x) * cos(-x) = -sin(x) * cos(x)
} by {
    sin_neg(x)
    sin(-x) = -sin(x)
    cos_neg(x)
    cos(-x) = cos(x)
    sin(-x) * cos(-x) = (-sin(x)) * cos(x)
    (-sin(x)) * cos(x) = -sin(x) * cos(x)
    sin(-x) * cos(-x) = -sin(x) * cos(x)
}

/// The product of sine and cosine of -x is the product at x.
theorem sin_mul_cos_neg(x: Real) {
    sin(x) * cos(-x) = sin(x) * cos(x)
} by {
    cos_neg(x)
    cos(-x) = cos(x)
    sin(x) * cos(-x) = sin(x) * cos(x)
}

// Tangent and the reciprocal trigonometric functions.
//
// The tangent is defined as sine over cosine; secant, cosecant and cotangent
// are the usual reciprocals.  The identities below are mostly conditional on
// the relevant denominators being nonzero.

/// The tangent function: sine over cosine.
define tan(x: Real) -> Real {
    sin(x) / cos(x)
}

/// The secant function: the reciprocal of cosine.
define sec(x: Real) -> Real {
    Real.1 / cos(x)
}

/// The cosecant function: the reciprocal of sine.
define csc(x: Real) -> Real {
    Real.1 / sin(x)
}

/// The cotangent function: cosine over sine.
define cot(x: Real) -> Real {
    cos(x) / sin(x)
}

/// Negative one is not zero.
theorem neg_one_ne_zero {
    -Real.1 != Real.0
} by {
    if -Real.1 = Real.0 {
        --Real.1 = -Real.0
        neg_neg(Real.1)
        --Real.1 = Real.1
        neg_zero
        -Real.0 = Real.0
        Real.1 = Real.0
        zero_is_different_than_one
        Real.0 != Real.1
        false
    }
}

/// The tangent of zero is zero.
theorem tan_zero {
    tan(Real.0) = Real.0
} by {
    tan(Real.0) = sin(Real.0) / cos(Real.0)
    sin_zero
    sin(Real.0) = Real.0
    cos_zero
    cos(Real.0) = Real.1
    sin(Real.0) / cos(Real.0) = Real.0 / Real.1
    Real.0 / Real.1 = Real.0
    tan(Real.0) = Real.0
}

/// The tangent of pi is zero.
theorem tan_pi {
    tan(pi) = Real.0
} by {
    tan(pi) = sin(pi) / cos(pi)
    sin_pi_zero
    sin(pi) = Real.0
    cos_pi_neg_one
    cos(pi) = -Real.1
    sin(pi) / cos(pi) = Real.0 / -Real.1
    Real.0 / -Real.1 = Real.0
    tan(pi) = Real.0
}

/// Tangent is odd: tan(-x) = -tan(x).
theorem tan_neg(x: Real) {
    tan(-x) = -tan(x)
} by {
    tan(-x) = sin(-x) / cos(-x)
    sin_neg(x)
    sin(-x) = -sin(x)
    cos_neg(x)
    cos(-x) = cos(x)
    sin(-x) / cos(-x) = (-sin(x)) / cos(x)
    (-sin(x)) / cos(x) = -(sin(x) / cos(x))
    tan(x) = sin(x) / cos(x)
    -(sin(x) / cos(x)) = -tan(x)
    tan(-x) = -tan(x)
}

/// The tangent of a sum as a single fraction.
theorem tan_add_basic(x: Real, y: Real) {
    tan(x + y) = (sin(x) * cos(y) + cos(x) * sin(y)) / (cos(x) * cos(y) - sin(x) * sin(y))
} by {
    tan(x + y) = sin(x + y) / cos(x + y)
    sin_add(x, y)
    sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
    cos_add(x, y)
    cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
    sin(x + y) / cos(x + y) = (sin(x) * cos(y) + cos(x) * sin(y)) / (cos(x) * cos(y) - sin(x) * sin(y))
    tan(x + y) = (sin(x) * cos(y) + cos(x) * sin(y)) / (cos(x) * cos(y) - sin(x) * sin(y))
}

/// Tangent times cosine recovers sine.
theorem tan_mul_cos(x: Real) {
    cos(x) != Real.0 implies tan(x) * cos(x) = sin(x)
} by {
    if cos(x) != Real.0 {
        tan(x) = sin(x) / cos(x)
        tan(x) * cos(x) = (sin(x) / cos(x)) * cos(x)
        (sin(x) / cos(x)) * cos(x) = cos(x) * (sin(x) / cos(x))
        mul_div_cancel(sin(x), cos(x))
        cos(x) * (sin(x) / cos(x)) = sin(x)
        tan(x) * cos(x) = sin(x)
    }
}

/// The sine of a sum in terms of tangents.
theorem sin_add_tan(x: Real, y: Real) {
    cos(x) != Real.0 and cos(y) != Real.0
    implies
    sin(x + y) = cos(x) * cos(y) * (tan(x) + tan(y))
} by {
    if cos(x) != Real.0 and cos(y) != Real.0 {
        sin_add(x, y)
        sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
        tan_mul_cos(x)
        tan(x) * cos(x) = sin(x)
        tan_mul_cos(y)
        tan(y) * cos(y) = sin(y)
        sin(x) * cos(y) + cos(x) * sin(y) = (tan(x) * cos(x)) * cos(y) + cos(x) * sin(y)
        sin(x) * cos(y) + cos(x) * sin(y) = (tan(x) * cos(x)) * cos(y) + cos(x) * (tan(y) * cos(y))
        (tan(x) * cos(x)) * cos(y) = tan(x) * (cos(x) * cos(y))
        cos(x) * (tan(y) * cos(y)) = tan(y) * (cos(x) * cos(y))
        tan(x) * (cos(x) * cos(y)) + tan(y) * (cos(x) * cos(y)) = (tan(x) + tan(y)) * (cos(x) * cos(y))
        (tan(x) + tan(y)) * (cos(x) * cos(y)) = cos(x) * cos(y) * (tan(x) + tan(y))
        sin(x) * cos(y) + cos(x) * sin(y) = cos(x) * cos(y) * (tan(x) + tan(y))
        sin(x + y) = cos(x) * cos(y) * (tan(x) + tan(y))
    }
}

/// The cosine of a sum in terms of tangents.
theorem cos_add_tan(x: Real, y: Real) {
    cos(x) != Real.0 and cos(y) != Real.0
    implies
    cos(x + y) = cos(x) * cos(y) * (Real.1 - tan(x) * tan(y))
} by {
    if cos(x) != Real.0 and cos(y) != Real.0 {
        cos_add(x, y)
        cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
        tan_mul_cos(x)
        tan(x) * cos(x) = sin(x)
        tan_mul_cos(y)
        tan(y) * cos(y) = sin(y)
        cos(x) * cos(y) - sin(x) * sin(y) = cos(x) * cos(y) - (tan(x) * cos(x)) * sin(y)
        cos(x) * cos(y) - sin(x) * sin(y) = cos(x) * cos(y) - (tan(x) * cos(x)) * (tan(y) * cos(y))
        signed_mul_combine(tan(x), tan(y), cos(x), cos(y))
        (tan(x) * cos(x)) * (tan(y) * cos(y)) = (tan(x) * tan(y)) * (cos(x) * cos(y))
        cos(x) * cos(y) - (tan(x) * cos(x)) * (tan(y) * cos(y)) =
            cos(x) * cos(y) - (tan(x) * tan(y)) * (cos(x) * cos(y))
        cos(x) * cos(y) - (tan(x) * tan(y)) * (cos(x) * cos(y)) = cos(x) * cos(y) * (Real.1 - tan(x) * tan(y))
        cos(x + y) = cos(x) * cos(y) * (Real.1 - tan(x) * tan(y))
    }
}

/// The tangent addition formula.
theorem tan_add(x: Real, y: Real) {
    cos(x) != Real.0 and cos(y) != Real.0 and Real.1 - tan(x) * tan(y) != Real.0
    implies
    tan(x + y) = (tan(x) + tan(y)) / (Real.1 - tan(x) * tan(y))
} by {
    if cos(x) != Real.0 and cos(y) != Real.0 and Real.1 - tan(x) * tan(y) != Real.0 {
        tan_add_basic(x, y)
        tan(x + y) = (sin(x) * cos(y) + cos(x) * sin(y)) / (cos(x) * cos(y) - sin(x) * sin(y))
        sin_add_tan(x, y)
        sin(x + y) = cos(x) * cos(y) * (tan(x) + tan(y))
        sin_add(x, y)
        sin(x + y) = sin(x) * cos(y) + cos(x) * sin(y)
        sin(x) * cos(y) + cos(x) * sin(y) = cos(x) * cos(y) * (tan(x) + tan(y))
        cos_add_tan(x, y)
        cos(x + y) = cos(x) * cos(y) * (Real.1 - tan(x) * tan(y))
        cos_add(x, y)
        cos(x + y) = cos(x) * cos(y) - sin(x) * sin(y)
        cos(x) * cos(y) - sin(x) * sin(y) = cos(x) * cos(y) * (Real.1 - tan(x) * tan(y))
        tan(x + y) = (cos(x) * cos(y) * (tan(x) + tan(y))) / (cos(x) * cos(y) * (Real.1 - tan(x) * tan(y)))
        mul_not_zero[Real](cos(x), cos(y))
        cos(x) != Real.0 and cos(y) != Real.0 implies cos(x) * cos(y) != Real.0
        cos(x) * cos(y) != Real.0
        div_cancel_common(tan(x) + tan(y), cos(x) * cos(y), Real.1 - tan(x) * tan(y))
        ((tan(x) + tan(y)) * (cos(x) * cos(y))) / ((Real.1 - tan(x) * tan(y)) * (cos(x) * cos(y))) =
            (tan(x) + tan(y)) / (Real.1 - tan(x) * tan(y))
        (cos(x) * cos(y) * (tan(x) + tan(y))) / (cos(x) * cos(y) * (Real.1 - tan(x) * tan(y))) =
            ((tan(x) + tan(y)) * (cos(x) * cos(y))) / ((Real.1 - tan(x) * tan(y)) * (cos(x) * cos(y)))
        tan(x + y) = (tan(x) + tan(y)) / (Real.1 - tan(x) * tan(y))
    }
}

/// Pi is a period of the tangent.
theorem tan_add_pi(x: Real) {
    cos(x) != Real.0 implies tan(x + pi) = tan(x)
} by {
    if cos(x) != Real.0 {
        cos_pi_neg_one
        cos(pi) = -Real.1
        neg_one_ne_zero
        -Real.1 != Real.0
        cos(pi) != Real.0
        tan_pi
        tan(pi) = Real.0
        Real.1 - tan(x) * tan(pi) = Real.1 - tan(x) * Real.0
        tan(x) * Real.0 = Real.0
        Real.1 - tan(x) * Real.0 = Real.1 - Real.0
        Real.1 - Real.0 = Real.1
        Real.1 - tan(x) * tan(pi) = Real.1
        zero_is_different_than_one
        Real.0 != Real.1
        Real.1 - tan(x) * tan(pi) != Real.0
        tan_add(x, pi)
        tan(x + pi) = (tan(x) + tan(pi)) / (Real.1 - tan(x) * tan(pi))
        (tan(x) + tan(pi)) / (Real.1 - tan(x) * tan(pi)) = (tan(x) + Real.0) / (Real.1 - tan(x) * Real.0)
        tan(x) + Real.0 = tan(x)
        Real.1 - tan(x) * Real.0 = Real.1 - Real.0
        Real.1 - Real.0 = Real.1
        (tan(x) + Real.0) / (Real.1 - tan(x) * Real.0) = tan(x) / Real.1
        tan(x) / Real.1 = tan(x)
        tan(x + pi) = tan(x)
    }
}

/// The tangent of twice an angle.
theorem tan_two(x: Real) {
    cos(x) != Real.0 and Real.1 - tan(x).pow(Nat.2) != Real.0
    implies
    tan(two * x) = two * tan(x) / (Real.1 - tan(x).pow(Nat.2))
} by {
    if cos(x) != Real.0 and Real.1 - tan(x).pow(Nat.2) != Real.0 {
        pow_suc(tan(x), Nat.1)
        tan(x).pow(Nat.2) = tan(x) * tan(x)
        Real.1 - tan(x) * tan(x) != Real.0
        tan_add(x, x)
        tan(x + x) = (tan(x) + tan(x)) / (Real.1 - tan(x) * tan(x))
        two = Real.1 + Real.1
        two * x = x + x
        tan(two * x) = tan(x + x)
        tan(x) + tan(x) = two * tan(x)
        (tan(x) + tan(x)) / (Real.1 - tan(x) * tan(x)) = two * tan(x) / (Real.1 - tan(x) * tan(x))
        two * tan(x) / (Real.1 - tan(x) * tan(x)) = two * tan(x) / (Real.1 - tan(x).pow(Nat.2))
        tan(two * x) = two * tan(x) / (Real.1 - tan(x).pow(Nat.2))
    }
}

/// Secant times cosine is one.
theorem sec_mul_cos(x: Real) {
    cos(x) != Real.0 implies sec(x) * cos(x) = Real.1
} by {
    if cos(x) != Real.0 {
        sec(x) = Real.1 / cos(x)
        sec(x) * cos(x) = (Real.1 / cos(x)) * cos(x)
        (Real.1 / cos(x)) * cos(x) = cos(x) * (Real.1 / cos(x))
        mul_div_cancel(Real.1, cos(x))
        cos(x) * (Real.1 / cos(x)) = Real.1
        sec(x) * cos(x) = Real.1
    }
}

/// Cosecant times sine is one.
theorem csc_mul_sin(x: Real) {
    sin(x) != Real.0 implies csc(x) * sin(x) = Real.1
} by {
    if sin(x) != Real.0 {
        csc(x) = Real.1 / sin(x)
        csc(x) * sin(x) = (Real.1 / sin(x)) * sin(x)
        (Real.1 / sin(x)) * sin(x) = sin(x) * (Real.1 / sin(x))
        mul_div_cancel(Real.1, sin(x))
        sin(x) * (Real.1 / sin(x)) = Real.1
        csc(x) * sin(x) = Real.1
    }
}

/// Tangent times cotangent is one.
theorem tan_mul_cot(x: Real) {
    sin(x) != Real.0 and cos(x) != Real.0 implies tan(x) * cot(x) = Real.1
} by {
    if sin(x) != Real.0 and cos(x) != Real.0 {
        tan(x) = sin(x) / cos(x)
        cot(x) = cos(x) / sin(x)
        tan(x) * cot(x) = (sin(x) / cos(x)) * (cos(x) / sin(x))
        mul_div(sin(x), cos(x), cos(x), sin(x))
        (sin(x) / cos(x)) * (cos(x) / sin(x)) = (sin(x) * cos(x)) / (cos(x) * sin(x))
        sin(x) * cos(x) = cos(x) * sin(x)
        (sin(x) * cos(x)) / (cos(x) * sin(x)) = (cos(x) * sin(x)) / (cos(x) * sin(x))
        mul_not_zero[Real](cos(x), sin(x))
        cos(x) != Real.0 and sin(x) != Real.0 implies cos(x) * sin(x) != Real.0
        cos(x) * sin(x) != Real.0
        div_mul_cancel_left(cos(x) * sin(x), Real.1)
        ((cos(x) * sin(x)) * Real.1) / (cos(x) * sin(x)) = Real.1
        (cos(x) * sin(x)) / (cos(x) * sin(x)) = Real.1
        tan(x) * cot(x) = Real.1
    }
}

/// The square of secant minus the square of tangent is one.
theorem sec_sq_sub_tan_sq(x: Real) {
    cos(x) != Real.0 implies sec(x).pow(Nat.2) - tan(x).pow(Nat.2) = Real.1
} by {
    if cos(x) != Real.0 {
        sin_sq_add_cos_sq(x)
        sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
        sec(x) = Real.1 / cos(x)
        tan(x) = sin(x) / cos(x)
        pow_suc(sec(x), Nat.1)
        sec(x).pow(Nat.2) = sec(x) * sec(x)
        pow_suc(tan(x), Nat.1)
        tan(x).pow(Nat.2) = tan(x) * tan(x)
        pow_suc(sin(x), Nat.1)
        sin(x).pow(Nat.2) = sin(x) * sin(x)
        pow_suc(cos(x), Nat.1)
        cos(x).pow(Nat.2) = cos(x) * cos(x)
        sec(x).pow(Nat.2) - tan(x).pow(Nat.2) = (Real.1 / cos(x)) * (Real.1 / cos(x)) - (sin(x) / cos(x)) * (sin(x) / cos(x))
        mul_div(Real.1, cos(x), Real.1, cos(x))
        (Real.1 / cos(x)) * (Real.1 / cos(x)) = (Real.1 * Real.1) / (cos(x) * cos(x))
        mul_div(sin(x), cos(x), sin(x), cos(x))
        (sin(x) / cos(x)) * (sin(x) / cos(x)) = (sin(x) * sin(x)) / (cos(x) * cos(x))
        (Real.1 / cos(x)) * (Real.1 / cos(x)) - (sin(x) / cos(x)) * (sin(x) / cos(x)) =
            (Real.1 * Real.1) / (cos(x) * cos(x)) - (sin(x) * sin(x)) / (cos(x) * cos(x))
        mul_not_zero[Real](cos(x), cos(x))
        cos(x) != Real.0 and cos(x) != Real.0 implies cos(x) * cos(x) != Real.0
        cos(x) * cos(x) != Real.0
        div_sub_same_denom(Real.1, Real.1, Real.1, sin(x) * sin(x), cos(x) * cos(x))
        Real.1 * Real.1 / (cos(x) * cos(x)) - Real.1 * (sin(x) * sin(x)) / (cos(x) * cos(x)) =
            (Real.1 * Real.1 - Real.1 * (sin(x) * sin(x))) / (cos(x) * cos(x))
        Real.1 * Real.1 / (cos(x) * cos(x)) - Real.1 * (sin(x) * sin(x)) / (cos(x) * cos(x)) =
            (Real.1 * Real.1) / (cos(x) * cos(x)) - (sin(x) * sin(x)) / (cos(x) * cos(x))
        Real.1 * Real.1 - Real.1 * (sin(x) * sin(x)) = Real.1 - sin(x) * sin(x)
        (Real.1 * Real.1 - Real.1 * (sin(x) * sin(x))) / (cos(x) * cos(x)) =
            (Real.1 - sin(x) * sin(x)) / (cos(x) * cos(x))
        sin(x) * sin(x) = sin(x).pow(Nat.2)
        (Real.1 - sin(x) * sin(x)) / (cos(x) * cos(x)) = (Real.1 - sin(x).pow(Nat.2)) / (cos(x) * cos(x))
        (Real.1 - sin(x).pow(Nat.2)) / (cos(x) * cos(x)) = (Real.1 - sin(x).pow(Nat.2)) / cos(x).pow(Nat.2)
        cos(x).pow(Nat.2) = Real.1 - sin(x).pow(Nat.2)
        (Real.1 - sin(x).pow(Nat.2)) / cos(x).pow(Nat.2) = cos(x).pow(Nat.2) / cos(x).pow(Nat.2)
        cos(x).pow(Nat.2) != Real.0
        div_mul_cancel_left(cos(x).pow(Nat.2), Real.1)
        ((cos(x).pow(Nat.2) * Real.1) / cos(x).pow(Nat.2)) = Real.1
        cos(x).pow(Nat.2) / cos(x).pow(Nat.2) = Real.1
        sec(x).pow(Nat.2) - tan(x).pow(Nat.2) = Real.1
    }
}

/// The square of cosecant minus the square of cotangent is one.
theorem csc_sq_sub_cot_sq(x: Real) {
    sin(x) != Real.0 implies csc(x).pow(Nat.2) - cot(x).pow(Nat.2) = Real.1
} by {
    if sin(x) != Real.0 {
        sin_sq_add_cos_sq(x)
        sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
        csc(x) = Real.1 / sin(x)
        cot(x) = cos(x) / sin(x)
        pow_suc(csc(x), Nat.1)
        csc(x).pow(Nat.2) = csc(x) * csc(x)
        pow_suc(cot(x), Nat.1)
        cot(x).pow(Nat.2) = cot(x) * cot(x)
        pow_suc(cos(x), Nat.1)
        cos(x).pow(Nat.2) = cos(x) * cos(x)
        pow_suc(sin(x), Nat.1)
        sin(x).pow(Nat.2) = sin(x) * sin(x)
        csc(x).pow(Nat.2) - cot(x).pow(Nat.2) = (Real.1 / sin(x)) * (Real.1 / sin(x)) - (cos(x) / sin(x)) * (cos(x) / sin(x))
        mul_div(Real.1, sin(x), Real.1, sin(x))
        (Real.1 / sin(x)) * (Real.1 / sin(x)) = (Real.1 * Real.1) / (sin(x) * sin(x))
        mul_div(cos(x), sin(x), cos(x), sin(x))
        (cos(x) / sin(x)) * (cos(x) / sin(x)) = (cos(x) * cos(x)) / (sin(x) * sin(x))
        (Real.1 / sin(x)) * (Real.1 / sin(x)) - (cos(x) / sin(x)) * (cos(x) / sin(x)) =
            (Real.1 * Real.1) / (sin(x) * sin(x)) - (cos(x) * cos(x)) / (sin(x) * sin(x))
        mul_not_zero[Real](sin(x), sin(x))
        sin(x) != Real.0 and sin(x) != Real.0 implies sin(x) * sin(x) != Real.0
        sin(x) * sin(x) != Real.0
        div_sub_same_denom(Real.1, Real.1, Real.1, cos(x) * cos(x), sin(x) * sin(x))
        Real.1 * Real.1 / (sin(x) * sin(x)) - Real.1 * (cos(x) * cos(x)) / (sin(x) * sin(x)) =
            (Real.1 * Real.1 - Real.1 * (cos(x) * cos(x))) / (sin(x) * sin(x))
        Real.1 * Real.1 / (sin(x) * sin(x)) - Real.1 * (cos(x) * cos(x)) / (sin(x) * sin(x)) =
            (Real.1 * Real.1) / (sin(x) * sin(x)) - (cos(x) * cos(x)) / (sin(x) * sin(x))
        Real.1 * Real.1 - Real.1 * (cos(x) * cos(x)) = Real.1 - cos(x) * cos(x)
        (Real.1 * Real.1 - Real.1 * (cos(x) * cos(x))) / (sin(x) * sin(x)) =
            (Real.1 - cos(x) * cos(x)) / (sin(x) * sin(x))
        cos(x) * cos(x) = cos(x).pow(Nat.2)
        (Real.1 - cos(x) * cos(x)) / (sin(x) * sin(x)) = (Real.1 - cos(x).pow(Nat.2)) / (sin(x) * sin(x))
        (Real.1 - cos(x).pow(Nat.2)) / (sin(x) * sin(x)) = (Real.1 - cos(x).pow(Nat.2)) / sin(x).pow(Nat.2)
        sin(x).pow(Nat.2) = Real.1 - cos(x).pow(Nat.2)
        (Real.1 - cos(x).pow(Nat.2)) / sin(x).pow(Nat.2) = sin(x).pow(Nat.2) / sin(x).pow(Nat.2)
        sin(x).pow(Nat.2) != Real.0
        div_mul_cancel_left(sin(x).pow(Nat.2), Real.1)
        ((sin(x).pow(Nat.2) * Real.1) / sin(x).pow(Nat.2)) = Real.1
        sin(x).pow(Nat.2) / sin(x).pow(Nat.2) = Real.1
        csc(x).pow(Nat.2) - cot(x).pow(Nat.2) = Real.1
    }
}

// Special value at pi over four.
//
// Pi over four is not predefined, so we define it as half of pi over two and
// derive the squared sine and cosine values, their equality, and the tangent.
// The exact value (2).sqrt/2 is out of reach because sqrt is Option-valued.

/// Pi over four as a real number.
let pi_over_four = pi_over_two / two

/// The reciprocal of two is not zero.
theorem real_one_over_two_ne_zero {
    Real.1 / two != Real.0
} by {
    two_nonzero
    two != Real.0
    mul_div_cancel(Real.1, two)
    two * (Real.1 / two) = Real.1
    zero_is_different_than_one
    Real.0 != Real.1
    two * (Real.1 / two) != Real.0
    if Real.1 / two = Real.0 {
        two * (Real.1 / two) = two * Real.0
        two * Real.0 = Real.0
        two * (Real.1 / two) = Real.0
        two * (Real.1 / two) != Real.0
        false
    }
}

/// The square of the cosine of pi over four is one half.
theorem cos_sq_pi_over_four {
    cos(pi_over_four).pow(Nat.2) = Real.1 / two
} by {
    cos_two_alt1(pi_over_four)
    cos(two * pi_over_four) = two * cos(pi_over_four).pow(Nat.2) - Real.1
    mul_div_cancel(pi_over_two, two)
    two * (pi_over_two / two) = pi_over_two
    pi_over_four = pi_over_two / two
    two * pi_over_four = two * (pi_over_two / two)
    two * pi_over_four = pi_over_two
    cos(two * pi_over_four) = cos(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    two * cos(pi_over_four).pow(Nat.2) - Real.1 = Real.0
    two * cos(pi_over_four).pow(Nat.2) = Real.1
    (two * cos(pi_over_four).pow(Nat.2)) / two = Real.1 / two
    div_mul_cancel_left(two, cos(pi_over_four).pow(Nat.2))
    (two * cos(pi_over_four).pow(Nat.2)) / two = cos(pi_over_four).pow(Nat.2)
    cos(pi_over_four).pow(Nat.2) = Real.1 / two
}

/// The square of the sine of pi over four is one half.
theorem sin_sq_pi_over_four {
    sin(pi_over_four).pow(Nat.2) = Real.1 / two
} by {
    cos_two_alt2(pi_over_four)
    cos(two * pi_over_four) = Real.1 - two * sin(pi_over_four).pow(Nat.2)
    mul_div_cancel(pi_over_two, two)
    two * (pi_over_two / two) = pi_over_two
    pi_over_four = pi_over_two / two
    two * pi_over_four = two * (pi_over_two / two)
    two * pi_over_four = pi_over_two
    cos(two * pi_over_four) = cos(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    Real.1 - two * sin(pi_over_four).pow(Nat.2) = Real.0
    two * sin(pi_over_four).pow(Nat.2) = Real.1
    (two * sin(pi_over_four).pow(Nat.2)) / two = Real.1 / two
    div_mul_cancel_left(two, sin(pi_over_four).pow(Nat.2))
    (two * sin(pi_over_four).pow(Nat.2)) / two = sin(pi_over_four).pow(Nat.2)
    sin(pi_over_four).pow(Nat.2) = Real.1 / two
}

/// The product of sine and cosine of pi over four is one half.
theorem sin_cos_pi_over_four {
    sin(pi_over_four) * cos(pi_over_four) = Real.1 / two
} by {
    sin_two(pi_over_four)
    sin(two * pi_over_four) = two * sin(pi_over_four) * cos(pi_over_four)
    mul_div_cancel(pi_over_two, two)
    two * (pi_over_two / two) = pi_over_two
    pi_over_four = pi_over_two / two
    two * pi_over_four = two * (pi_over_two / two)
    two * pi_over_four = pi_over_two
    sin(two * pi_over_four) = sin(pi_over_two)
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    two * sin(pi_over_four) * cos(pi_over_four) = Real.1
    (two * sin(pi_over_four) * cos(pi_over_four)) / two = Real.1 / two
    div_mul_cancel_left(two, sin(pi_over_four) * cos(pi_over_four))
    (two * (sin(pi_over_four) * cos(pi_over_four))) / two = sin(pi_over_four) * cos(pi_over_four)
    two * sin(pi_over_four) * cos(pi_over_four) = two * (sin(pi_over_four) * cos(pi_over_four))
    sin(pi_over_four) * cos(pi_over_four) = Real.1 / two
}

/// Sine and cosine of pi over four are equal.
theorem sin_eq_cos_pi_over_four {
    sin(pi_over_four) = cos(pi_over_four)
} by {
    sin_pi_over_two_sub(pi_over_four)
    sin(pi_over_two - pi_over_four) = cos(pi_over_four)
    pi_over_four = pi_over_two / two
    mul_div_cancel(pi_over_two, two)
    two * (pi_over_two / two) = pi_over_two
    two * pi_over_four = pi_over_two
    pi_over_two - pi_over_four = two * pi_over_four - pi_over_four
    pi_over_four + pi_over_four = two * pi_over_four
    two * pi_over_four - pi_over_four = pi_over_four + pi_over_four - pi_over_four
    sub_cancels(pi_over_four, pi_over_four)
    pi_over_four + pi_over_four - pi_over_four = pi_over_four
    two * pi_over_four - pi_over_four = pi_over_four
    pi_over_two - pi_over_four = pi_over_four
    sin(pi_over_two - pi_over_four) = sin(pi_over_four)
    sin(pi_over_four) = cos(pi_over_four)
}

/// The cosine of pi over four is not zero.
theorem cos_pi_over_four_ne_zero {
    cos(pi_over_four) != Real.0
} by {
    if cos(pi_over_four) = Real.0 {
        pow_suc(cos(pi_over_four), Nat.1)
        cos(pi_over_four).pow(Nat.2) = cos(pi_over_four) * cos(pi_over_four)
        cos(pi_over_four) * cos(pi_over_four) = Real.0
        cos(pi_over_four).pow(Nat.2) = Real.0
        cos_sq_pi_over_four
        cos(pi_over_four).pow(Nat.2) = Real.1 / two
        real_one_over_two_ne_zero
        Real.1 / two != Real.0
        Real.0 != Real.1 / two
        false
    }
}

/// The tangent of pi over four is one.
theorem tan_pi_over_four {
    tan(pi_over_four) = Real.1
} by {
    tan(pi_over_four) = sin(pi_over_four) / cos(pi_over_four)
    sin_eq_cos_pi_over_four
    sin(pi_over_four) = cos(pi_over_four)
    sin(pi_over_four) / cos(pi_over_four) = cos(pi_over_four) / cos(pi_over_four)
    cos_pi_over_four_ne_zero
    cos(pi_over_four) != Real.0
    div_mul_cancel_left(cos(pi_over_four), Real.1)
    ((cos(pi_over_four) * Real.1) / cos(pi_over_four)) = Real.1
    cos(pi_over_four) / cos(pi_over_four) = Real.1
    tan(pi_over_four) = Real.1
}

// Periodicity in terms of two pi times a natural number.

/// Two pi is a period of cosine: cos(x + 2pi) = cos(x).
theorem cos_add_two_pi_two(x: Real) {
    cos(x + two * pi) = cos(x)
} by {
    cos_add_two_pi(x)
    cos(x + (pi + pi)) = cos(x)
    two = Real.1 + Real.1
    two * pi = pi + pi
    cos(x + two * pi) = cos(x)
}

/// The sine of x plus 2n pi is the sine of x, for every natural n.
theorem sin_add_two_pi_n(x: Real, n: Nat) {
    sin(x + two * (from_nat[Real](n) * pi)) = sin(x)
} by {
    define p(k: Nat) -> Bool {
        sin(x + two * (from_nat[Real](k) * pi)) = sin(x)
    }
    from_nat_zero[Real]
    from_nat[Real](Nat.0) = Real.0
    from_nat[Real](Nat.0) * pi = Real.0
    two * (from_nat[Real](Nat.0) * pi) = Real.0
    x + two * (from_nat[Real](Nat.0) * pi) = x + Real.0
    x + Real.0 = x
    sin(x + two * (from_nat[Real](Nat.0) * pi)) = sin(x)
    p(Nat.0)
    forall(k: Nat) {
        if p(k) {
            from_nat_add[Real](k, Nat.1)
            from_nat[Real](k + Nat.1) = from_nat[Real](k) + from_nat[Real](Nat.1)
            k + Nat.1 = k.suc
            from_nat[Real](k.suc) = from_nat[Real](k) + from_nat[Real](Nat.1)
            from_nat_one[Real]
            from_nat[Real](Nat.1) = Real.1
            from_nat[Real](k.suc) = from_nat[Real](k) + Real.1
            from_nat[Real](k.suc) * pi = (from_nat[Real](k) + Real.1) * pi
            (from_nat[Real](k) + Real.1) * pi = from_nat[Real](k) * pi + pi
            from_nat[Real](k.suc) * pi = from_nat[Real](k) * pi + pi
            two * (from_nat[Real](k.suc) * pi) = two * (from_nat[Real](k) * pi + pi)
            two * (from_nat[Real](k) * pi + pi) = two * (from_nat[Real](k) * pi) + two * pi
            two * (from_nat[Real](k.suc) * pi) = two * (from_nat[Real](k) * pi) + two * pi
            x + two * (from_nat[Real](k.suc) * pi) = x + (two * (from_nat[Real](k) * pi) + two * pi)
            x + (two * (from_nat[Real](k) * pi) + two * pi) = (x + two * (from_nat[Real](k) * pi)) + two * pi
            sin(x + two * (from_nat[Real](k.suc) * pi)) = sin((x + two * (from_nat[Real](k) * pi)) + two * pi)
            sin_add_two_pi_two(x + two * (from_nat[Real](k) * pi))
            sin((x + two * (from_nat[Real](k) * pi)) + two * pi) = sin(x + two * (from_nat[Real](k) * pi))
            p(k)
            sin(x + two * (from_nat[Real](k) * pi)) = sin(x)
            sin(x + two * (from_nat[Real](k.suc) * pi)) = sin(x)
            p(k.suc)
        }
    }
    p(Nat.0) and forall(k: Nat) { p(k) implies p(k.suc) }
    Nat.induction(p)
    p(n)
}

/// The cosine of x plus 2n pi is the cosine of x, for every natural n.
theorem cos_add_two_pi_n(x: Real, n: Nat) {
    cos(x + two * (from_nat[Real](n) * pi)) = cos(x)
} by {
    define p(k: Nat) -> Bool {
        cos(x + two * (from_nat[Real](k) * pi)) = cos(x)
    }
    from_nat_zero[Real]
    from_nat[Real](Nat.0) = Real.0
    from_nat[Real](Nat.0) * pi = Real.0
    two * (from_nat[Real](Nat.0) * pi) = Real.0
    x + two * (from_nat[Real](Nat.0) * pi) = x + Real.0
    x + Real.0 = x
    cos(x + two * (from_nat[Real](Nat.0) * pi)) = cos(x)
    p(Nat.0)
    forall(k: Nat) {
        if p(k) {
            from_nat_add[Real](k, Nat.1)
            from_nat[Real](k + Nat.1) = from_nat[Real](k) + from_nat[Real](Nat.1)
            k + Nat.1 = k.suc
            from_nat[Real](k.suc) = from_nat[Real](k) + from_nat[Real](Nat.1)
            from_nat_one[Real]
            from_nat[Real](Nat.1) = Real.1
            from_nat[Real](k.suc) = from_nat[Real](k) + Real.1
            from_nat[Real](k.suc) * pi = (from_nat[Real](k) + Real.1) * pi
            (from_nat[Real](k) + Real.1) * pi = from_nat[Real](k) * pi + pi
            from_nat[Real](k.suc) * pi = from_nat[Real](k) * pi + pi
            two * (from_nat[Real](k.suc) * pi) = two * (from_nat[Real](k) * pi + pi)
            two * (from_nat[Real](k) * pi + pi) = two * (from_nat[Real](k) * pi) + two * pi
            two * (from_nat[Real](k.suc) * pi) = two * (from_nat[Real](k) * pi) + two * pi
            x + two * (from_nat[Real](k.suc) * pi) = x + (two * (from_nat[Real](k) * pi) + two * pi)
            x + (two * (from_nat[Real](k) * pi) + two * pi) = (x + two * (from_nat[Real](k) * pi)) + two * pi
            cos(x + two * (from_nat[Real](k.suc) * pi)) = cos((x + two * (from_nat[Real](k) * pi)) + two * pi)
            cos_add_two_pi_two(x + two * (from_nat[Real](k) * pi))
            cos((x + two * (from_nat[Real](k) * pi)) + two * pi) = cos(x + two * (from_nat[Real](k) * pi))
            p(k)
            cos(x + two * (from_nat[Real](k) * pi)) = cos(x)
            cos(x + two * (from_nat[Real](k.suc) * pi)) = cos(x)
            p(k.suc)
        }
    }
    p(Nat.0) and forall(k: Nat) { p(k) implies p(k.suc) }
    Nat.induction(p)
    p(n)
}

// Further period and parity consequences.

/// The square of sine is unchanged by the two pi shift.
theorem sin_sq_period(x: Real) {
    sin(x + two * pi).pow(Nat.2) = sin(x).pow(Nat.2)
} by {
    sin_add_two_pi_two(x)
    sin(x + two * pi) = sin(x)
    sin(x + two * pi).pow(Nat.2) = sin(x).pow(Nat.2)
}

/// The square of cosine is unchanged by the two pi shift.
theorem cos_sq_period(x: Real) {
    cos(x + two * pi).pow(Nat.2) = cos(x).pow(Nat.2)
} by {
    cos_add_two_pi_two(x)
    cos(x + two * pi) = cos(x)
    cos(x + two * pi).pow(Nat.2) = cos(x).pow(Nat.2)
}

/// The square of sine plus the square of cosine is one.
theorem cos_sq_add_sin_sq(x: Real) {
    cos(x).pow(Nat.2) + sin(x).pow(Nat.2) = Real.1
} by {
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    add_comm(sin(x).pow(Nat.2), cos(x).pow(Nat.2))
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = cos(x).pow(Nat.2) + sin(x).pow(Nat.2)
    cos(x).pow(Nat.2) + sin(x).pow(Nat.2) = Real.1
}

/// The cosine of a difference in terms of the products.
theorem cos_add_neg(x: Real, y: Real) {
    cos(x - y) = cos(x) * cos(y) + sin(x) * sin(y)
} by {
    cos_add(x, -y)
    cos(x + (-y)) = cos(x) * cos(-y) - sin(x) * sin(-y)
    x + (-y) = x - y
    cos(x - y) = cos(x) * cos(-y) - sin(x) * sin(-y)
    cos_neg(y)
    cos(-y) = cos(y)
    sin_neg(y)
    sin(-y) = -sin(y)
    cos(x - y) = cos(x) * cos(y) - sin(x) * (-sin(y))
    cos(x) * cos(y) - sin(x) * (-sin(y)) = cos(x) * cos(y) + sin(x) * sin(y)
    cos(x - y) = cos(x) * cos(y) + sin(x) * sin(y)
}

/// Secant is periodic with period two pi.
theorem sec_add_two_pi(x: Real) {
    sec(x + two * pi) = sec(x)
} by {
    sec(x + two * pi) = Real.1 / cos(x + two * pi)
    cos_add_two_pi_two(x)
    cos(x + two * pi) = cos(x)
    Real.1 / cos(x + two * pi) = Real.1 / cos(x)
    sec(x) = Real.1 / cos(x)
    sec(x + two * pi) = sec(x)
}

/// Cosecant is periodic with period two pi.
theorem csc_add_two_pi(x: Real) {
    csc(x + two * pi) = csc(x)
} by {
    csc(x + two * pi) = Real.1 / sin(x + two * pi)
    sin_add_two_pi_two(x)
    sin(x + two * pi) = sin(x)
    Real.1 / sin(x + two * pi) = Real.1 / sin(x)
    csc(x) = Real.1 / sin(x)
    csc(x + two * pi) = csc(x)
}

/// Tangent is periodic with period two pi.
theorem tan_add_two_pi(x: Real) {
    tan(x + two * pi) = tan(x)
} by {
    tan(x + two * pi) = sin(x + two * pi) / cos(x + two * pi)
    sin_add_two_pi_two(x)
    sin(x + two * pi) = sin(x)
    cos_add_two_pi_two(x)
    cos(x + two * pi) = cos(x)
    sin(x + two * pi) / cos(x + two * pi) = sin(x) / cos(x)
    tan(x) = sin(x) / cos(x)
    tan(x + two * pi) = tan(x)
}

/// Cotangent is periodic with period two pi.
theorem cot_add_two_pi(x: Real) {
    cot(x + two * pi) = cot(x)
} by {
    cot(x + two * pi) = cos(x + two * pi) / sin(x + two * pi)
    sin_add_two_pi_two(x)
    sin(x + two * pi) = sin(x)
    cos_add_two_pi_two(x)
    cos(x + two * pi) = cos(x)
    cos(x + two * pi) / sin(x + two * pi) = cos(x) / sin(x)
    cot(x) = cos(x) / sin(x)
    cot(x + two * pi) = cot(x)
}

// Derivative corollaries of the trig identities.
//
// These use the chain rule and the quotient rule from the calculus API to
// differentiate scaled and composed trig functions.

/// The function x ↦ 2 sin(x) has derivative 2 cos(x).
theorem sin_scaled_derivative(x: Real) {
    has_derivative_at(compose(affine_real(two, Real.0), sin), x, two * cos(x))
} by {
    sin_has_derivative_at(x)
    has_derivative_at(sin, x, cos(x))
    derivative_affine_real_after(sin, two, Real.0, x, cos(x))
    has_derivative_at(compose(affine_real(two, Real.0), sin), x, two * cos(x))
}

/// The function x ↦ 2 cos(x) has derivative -2 sin(x).
theorem cos_scaled_derivative(x: Real) {
    has_derivative_at(compose(affine_real(two, Real.0), cos), x, two * (-sin(x)))
} by {
    cos_has_derivative_at(x)
    has_derivative_at(cos, x, -sin(x))
    derivative_affine_real_after(cos, two, Real.0, x, -sin(x))
    has_derivative_at(compose(affine_real(two, Real.0), cos), x, two * (-sin(x)))
}

/// The function x ↦ sin(2x) has derivative 2 cos(2x).
theorem sin_two_derivative(x: Real) {
    has_derivative_at(compose(sin, affine_real(two, Real.0)), x, cos(two * x) * two)
} by {
    affine_real_has_derivative_at(two, Real.0, x)
    has_derivative_at(affine_real(two, Real.0), x, two)
    affine_real(two, Real.0, x) = two * x + Real.0
    two * x + Real.0 = two * x
    affine_real(two, Real.0, x) = two * x
    sin_has_derivative_at(affine_real(two, Real.0, x))
    has_derivative_at(sin, affine_real(two, Real.0, x), cos(affine_real(two, Real.0, x)))
    derivative_compose(affine_real(two, Real.0), sin, x, two, cos(affine_real(two, Real.0, x)))
    has_derivative_at(compose(sin, affine_real(two, Real.0)), x, cos(affine_real(two, Real.0, x)) * two)
    cos(affine_real(two, Real.0, x)) = cos(two * x)
    cos(affine_real(two, Real.0, x)) * two = cos(two * x) * two
    has_derivative_at(compose(sin, affine_real(two, Real.0)), x, cos(two * x) * two)
}

/// The function x ↦ cos(2x) has derivative -2 sin(2x).
theorem cos_two_derivative(x: Real) {
    has_derivative_at(compose(cos, affine_real(two, Real.0)), x, (-sin(two * x)) * two)
} by {
    affine_real_has_derivative_at(two, Real.0, x)
    has_derivative_at(affine_real(two, Real.0), x, two)
    affine_real(two, Real.0, x) = two * x + Real.0
    two * x + Real.0 = two * x
    affine_real(two, Real.0, x) = two * x
    cos_has_derivative_at(affine_real(two, Real.0, x))
    has_derivative_at(cos, affine_real(two, Real.0, x), -sin(affine_real(two, Real.0, x)))
    derivative_compose(affine_real(two, Real.0), cos, x, two, -sin(affine_real(two, Real.0, x)))
    has_derivative_at(compose(cos, affine_real(two, Real.0)), x, (-sin(affine_real(two, Real.0, x))) * two)
    sin(affine_real(two, Real.0, x)) = sin(two * x)
    -sin(affine_real(two, Real.0, x)) = -sin(two * x)
    (-sin(affine_real(two, Real.0, x))) * two = (-sin(two * x)) * two
    has_derivative_at(compose(cos, affine_real(two, Real.0)), x, (-sin(two * x)) * two)
}

/// The square of secant is the reciprocal of the square of cosine.
theorem sec_sq_eq(x: Real) {
    cos(x) != Real.0 implies sec(x).pow(Nat.2) = Real.1 / cos(x).pow(Nat.2)
} by {
    if cos(x) != Real.0 {
        sec(x) = Real.1 / cos(x)
        sec(x).pow(Nat.2) = (Real.1 / cos(x)).pow(Nat.2)
        pow_suc(Real.1 / cos(x), Nat.1)
        (Real.1 / cos(x)).pow(Nat.2) = (Real.1 / cos(x)) * (Real.1 / cos(x))
        mul_div(Real.1, cos(x), Real.1, cos(x))
        (Real.1 / cos(x)) * (Real.1 / cos(x)) = (Real.1 * Real.1) / (cos(x) * cos(x))
        Real.1 * Real.1 = Real.1
        (Real.1 * Real.1) / (cos(x) * cos(x)) = Real.1 / (cos(x) * cos(x))
        pow_suc(cos(x), Nat.1)
        cos(x).pow(Nat.2) = cos(x) * cos(x)
        Real.1 / (cos(x) * cos(x)) = Real.1 / cos(x).pow(Nat.2)
        sec(x).pow(Nat.2) = Real.1 / cos(x).pow(Nat.2)
    }
}

/// The tangent function equals the pointwise quotient of sine and cosine.
theorem tan_eq_pointwise_div {
    tan = pointwise_div_real(sin, cos)
} by {
    forall(y: Real) {
        tan(y) = sin(y) / cos(y)
        pointwise_div_real_apply(sin, cos, y)
        pointwise_div_real(sin, cos, y) = sin(y) / cos(y)
        tan(y) = pointwise_div_real(sin, cos, y)
    }
    function_extensionality(tan, pointwise_div_real(sin, cos))
    tan = pointwise_div_real(sin, cos)
}

/// The tangent has derivative secant squared wherever cosine is nonzero.
theorem tan_has_derivative_at(x: Real) {
    cos(x) != Real.0 implies has_derivative_at(tan, x, sec(x).pow(Nat.2))
} by {
    if cos(x) != Real.0 {
        define derivative_pred(h: Real -> Real) -> Bool {
            has_derivative_at(h, x, sec(x).pow(Nat.2))
        }
        sin_has_derivative_at(x)
        has_derivative_at(sin, x, cos(x))
        cos_has_derivative_at(x)
        has_derivative_at(cos, x, -sin(x))
        quotient_has_derivative_at(sin, cos, x, cos(x), -sin(x))
        has_derivative_at(pointwise_div_real(sin, cos), x,
            (cos(x) * cos(x) - sin(x) * (-sin(x))) / (cos(x) * cos(x)))
        sin(x) * (-sin(x)) = -(sin(x) * sin(x))
        cos(x) * cos(x) - sin(x) * (-sin(x)) = cos(x) * cos(x) + sin(x) * sin(x)
        pow_suc(cos(x), Nat.1)
        cos(x).pow(Nat.2) = cos(x) * cos(x)
        pow_suc(sin(x), Nat.1)
        sin(x).pow(Nat.2) = sin(x) * sin(x)
        sin_sq_add_cos_sq(x)
        sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
        cos(x).pow(Nat.2) + sin(x).pow(Nat.2) = Real.1
        cos(x) * cos(x) + sin(x) * sin(x) = cos(x).pow(Nat.2) + sin(x).pow(Nat.2)
        cos(x) * cos(x) - sin(x) * (-sin(x)) = Real.1
        (cos(x) * cos(x) - sin(x) * (-sin(x))) / (cos(x) * cos(x)) = Real.1 / (cos(x) * cos(x))
        Real.1 / (cos(x) * cos(x)) = Real.1 / cos(x).pow(Nat.2)
        sec_sq_eq(x)
        sec(x).pow(Nat.2) = Real.1 / cos(x).pow(Nat.2)
        Real.1 / cos(x).pow(Nat.2) = sec(x).pow(Nat.2)
        (cos(x) * cos(x) - sin(x) * (-sin(x))) / (cos(x) * cos(x)) = sec(x).pow(Nat.2)
        has_derivative_at(pointwise_div_real(sin, cos), x, sec(x).pow(Nat.2))
        derivative_pred(pointwise_div_real(sin, cos))
        tan_eq_pointwise_div
        tan = pointwise_div_real(sin, cos)
        function_eq_transport_predicate_rev(derivative_pred, tan, pointwise_div_real(sin, cos))
        has_derivative_at(tan, x, sec(x).pow(Nat.2))
    }
}

// Further rearrangements and cofunction values.

/// The difference of the squares of sine and cosine is minus the cosine of
/// twice the angle.
theorem sin_sq_sub_cos_sq(x: Real) {
    sin(x).pow(Nat.2) - cos(x).pow(Nat.2) = -cos(two * x)
} by {
    cos_two(x)
    cos(two * x) = cos(x).pow(Nat.2) - sin(x).pow(Nat.2)
    sin(x).pow(Nat.2) - cos(x).pow(Nat.2) = -(cos(x).pow(Nat.2) - sin(x).pow(Nat.2))
    -(cos(x).pow(Nat.2) - sin(x).pow(Nat.2)) = -cos(two * x)
    sin(x).pow(Nat.2) - cos(x).pow(Nat.2) = -cos(two * x)
}

/// One minus the cosine of twice an angle is twice the square of sine.
theorem one_minus_cos_two(x: Real) {
    Real.1 - cos(two * x) = two * sin(x).pow(Nat.2)
} by {
    cos_two_alt2(x)
    cos(two * x) = Real.1 - two * sin(x).pow(Nat.2)
    Real.1 - cos(two * x) = Real.1 - (Real.1 - two * sin(x).pow(Nat.2))
    sub_minus_sub(Real.1, two * sin(x).pow(Nat.2))
    Real.1 - (Real.1 - two * sin(x).pow(Nat.2)) = two * sin(x).pow(Nat.2)
    Real.1 - cos(two * x) = two * sin(x).pow(Nat.2)
}

/// One plus the cosine of twice an angle is twice the square of cosine.
theorem one_add_cos_two(x: Real) {
    Real.1 + cos(two * x) = two * cos(x).pow(Nat.2)
} by {
    cos_two_alt1(x)
    cos(two * x) = two * cos(x).pow(Nat.2) - Real.1
    Real.1 + cos(two * x) = Real.1 + (two * cos(x).pow(Nat.2) - Real.1)
    Real.1 + (two * cos(x).pow(Nat.2) - Real.1) = Real.1 + two * cos(x).pow(Nat.2) - Real.1
    Real.1 + two * cos(x).pow(Nat.2) - Real.1 = two * cos(x).pow(Nat.2)
    Real.1 + (two * cos(x).pow(Nat.2) - Real.1) = two * cos(x).pow(Nat.2)
    Real.1 + cos(two * x) = two * cos(x).pow(Nat.2)
}

/// The sine of pi over two plus x is the cosine of x.
theorem sin_pi_over_two_add(x: Real) {
    sin(pi_over_two + x) = cos(x)
} by {
    sin_add_pi_over_two(x)
    sin(x + pi_over_two) = cos(x)
    add_comm(x, pi_over_two)
    x + pi_over_two = pi_over_two + x
    sin(x + pi_over_two) = sin(pi_over_two + x)
    sin(pi_over_two + x) = cos(x)
}

/// The cosine of pi over two plus x is minus the sine of x.
theorem cos_pi_over_two_add(x: Real) {
    cos(pi_over_two + x) = -sin(x)
} by {
    cos_add_pi_over_two(x)
    cos(x + pi_over_two) = -sin(x)
    add_comm(x, pi_over_two)
    x + pi_over_two = pi_over_two + x
    cos(x + pi_over_two) = cos(pi_over_two + x)
    cos(pi_over_two + x) = -sin(x)
}

/// The cosine of x minus pi over two is the sine of x.
theorem cos_x_sub_pi_over_two(x: Real) {
    cos(x - pi_over_two) = sin(x)
} by {
    cos_add_neg(x, pi_over_two)
    cos(x - pi_over_two) = cos(x) * cos(pi_over_two) + sin(x) * sin(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    cos(x) * cos(pi_over_two) + sin(x) * sin(pi_over_two) = cos(x) * Real.0 + sin(x) * Real.1
    cos(x) * Real.0 = Real.0
    sin(x) * Real.1 = sin(x)
    cos(x) * Real.0 + sin(x) * Real.1 = Real.0 + sin(x)
    Real.0 + sin(x) = sin(x)
    cos(x - pi_over_two) = sin(x)
}

/// The sine of x minus pi over two is minus the cosine of x.
theorem sin_x_sub_pi_over_two(x: Real) {
    sin(x - pi_over_two) = -cos(x)
} by {
    sin_add(x, -pi_over_two)
    sin(x + (-pi_over_two)) = sin(x) * cos(-pi_over_two) + cos(x) * sin(-pi_over_two)
    x + (-pi_over_two) = x - pi_over_two
    sin(x - pi_over_two) = sin(x) * cos(-pi_over_two) + cos(x) * sin(-pi_over_two)
    cos_neg(pi_over_two)
    cos(-pi_over_two) = cos(pi_over_two)
    sin_neg(pi_over_two)
    sin(-pi_over_two) = -sin(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    sin(x) * cos(-pi_over_two) + cos(x) * sin(-pi_over_two) = sin(x) * Real.0 + cos(x) * -Real.1
    sin(x) * Real.0 = Real.0
    cos(x) * -Real.1 = -cos(x)
    sin(x) * Real.0 + cos(x) * -Real.1 = Real.0 + -cos(x)
    Real.0 + -cos(x) = -cos(x)
    sin(x - pi_over_two) = -cos(x)
}

/// The sine of pi plus x is minus the sine of x.
theorem sin_pi_add(x: Real) {
    sin(pi + x) = -sin(x)
} by {
    sin_add_pi(x)
    sin(x + pi) = -sin(x)
    add_comm(x, pi)
    x + pi = pi + x
    sin(x + pi) = sin(pi + x)
    sin(pi + x) = -sin(x)
}

/// The cosine of pi plus x is minus the cosine of x.
theorem cos_pi_add(x: Real) {
    cos(pi + x) = -cos(x)
} by {
    cos_add_pi(x)
    cos(x + pi) = -cos(x)
    add_comm(x, pi)
    x + pi = pi + x
    cos(x + pi) = cos(pi + x)
    cos(pi + x) = -cos(x)
}

/// The sine of two pi plus x is the sine of x.
theorem sin_two_pi_add(x: Real) {
    sin(two * pi + x) = sin(x)
} by {
    sin_add_two_pi_two(x)
    sin(x + two * pi) = sin(x)
    add_comm(x, two * pi)
    x + two * pi = two * pi + x
    sin(x + two * pi) = sin(two * pi + x)
    sin(two * pi + x) = sin(x)
}

/// The cosine of two pi plus x is the cosine of x.
theorem cos_two_pi_add(x: Real) {
    cos(two * pi + x) = cos(x)
} by {
    cos_add_two_pi_two(x)
    cos(x + two * pi) = cos(x)
    add_comm(x, two * pi)
    x + two * pi = two * pi + x
    cos(x + two * pi) = cos(two * pi + x)
    cos(two * pi + x) = cos(x)
}

/// The square of secant minus one is the square of tangent.
theorem sec_sq_sub_one(x: Real) {
    cos(x) != Real.0 implies sec(x).pow(Nat.2) - Real.1 = tan(x).pow(Nat.2)
} by {
    if cos(x) != Real.0 {
        sec_sq_sub_tan_sq(x)
        sec(x).pow(Nat.2) - tan(x).pow(Nat.2) = Real.1
        sec(x).pow(Nat.2) - tan(x).pow(Nat.2) - Real.1 = Real.0
        sec(x).pow(Nat.2) - tan(x).pow(Nat.2) - Real.1 = sec(x).pow(Nat.2) - (tan(x).pow(Nat.2) + Real.1)
        sec(x).pow(Nat.2) - (tan(x).pow(Nat.2) + Real.1) = Real.0
        sec(x).pow(Nat.2) = tan(x).pow(Nat.2) + Real.1
        sec(x).pow(Nat.2) - Real.1 = tan(x).pow(Nat.2)
    }
}

/// The tangent of two pi is zero.
theorem tan_two_pi {
    tan(pi + pi) = Real.0
} by {
    tan(pi + pi) = sin(pi + pi) / cos(pi + pi)
    sin_two_pi_zero
    sin(pi + pi) = Real.0
    cos_two_pi_one
    cos(pi + pi) = Real.1
    sin(pi + pi) / cos(pi + pi) = Real.0 / Real.1
    Real.0 / Real.1 = Real.0
    tan(pi + pi) = Real.0
}

/// The secant of zero is one.
theorem sec_zero {
    sec(Real.0) = Real.1
} by {
    sec(Real.0) = Real.1 / cos(Real.0)
    cos_zero
    cos(Real.0) = Real.1
    Real.1 / cos(Real.0) = Real.1 / Real.1
    Real.1 / Real.1 = Real.1
    sec(Real.0) = Real.1
}

/// The cotangent of pi over two is zero.
theorem cot_pi_over_two {
    cot(pi_over_two) = Real.0
} by {
    cot(pi_over_two) = cos(pi_over_two) / sin(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    cos(pi_over_two) / sin(pi_over_two) = Real.0 / Real.1
    Real.0 / Real.1 = Real.0
    cot(pi_over_two) = Real.0
}

/// The cosecant of pi over two is one.
theorem csc_pi_over_two {
    csc(pi_over_two) = Real.1
} by {
    csc(pi_over_two) = Real.1 / sin(pi_over_two)
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    Real.1 / sin(pi_over_two) = Real.1 / Real.1
    Real.1 / Real.1 = Real.1
    csc(pi_over_two) = Real.1
}

/// Twice the product of sine and cosine of the same angle is the sine of
/// twice the angle.
theorem sin_mul_cos_two(x: Real) {
    sin(x) * cos(x) + sin(x) * cos(x) = sin(two * x)
} by {
    sin_two(x)
    sin(two * x) = two * sin(x) * cos(x)
    sin(x) * cos(x) + sin(x) * cos(x) = two * (sin(x) * cos(x))
    two * (sin(x) * cos(x)) = two * sin(x) * cos(x)
    sin(x) * cos(x) + sin(x) * cos(x) = two * sin(x) * cos(x)
    sin(x) * cos(x) + sin(x) * cos(x) = sin(two * x)
}

// Parity of the reciprocal functions and final shifts.

/// The inverse of a negation is the negation of the inverse.
theorem neg_inverse_eq(a: Real) {
    a != Real.0 implies (-a).inverse = -a.inverse
} by {
    if a != Real.0 {
        neg_mul_neg(a, a.inverse)
        (-a) * (-(a.inverse)) = a * a.inverse
        mul_inverse(a)
        a * a.inverse = Real.1
        (-a) * (-(a.inverse)) = Real.1
        unique_inverse[Real](-a, -(a.inverse))
        -(a.inverse) = (-a).inverse
        (-a).inverse = -a.inverse
    }
}

/// Secant is even: sec(-x) = sec(x).
theorem sec_neg(x: Real) {
    sec(-x) = sec(x)
} by {
    sec(-x) = Real.1 / cos(-x)
    cos_neg(x)
    cos(-x) = cos(x)
    Real.1 / cos(-x) = Real.1 / cos(x)
    sec(x) = Real.1 / cos(x)
    sec(-x) = sec(x)
}

/// Cosecant is odd: csc(-x) = -csc(x) wherever sine is nonzero.
theorem csc_neg(x: Real) {
    sin(x) != Real.0 implies csc(-x) = -csc(x)
} by {
    if sin(x) != Real.0 {
        csc(-x) = Real.1 / sin(-x)
        sin_neg(x)
        sin(-x) = -sin(x)
        Real.1 / sin(-x) = Real.1 / (-sin(x))
        Real.1 / (-sin(x)) = Real.1 * (-sin(x)).inverse
        neg_inverse_eq(sin(x))
        (-sin(x)).inverse = -sin(x).inverse
        Real.1 * (-sin(x)).inverse = Real.1 * (-sin(x).inverse)
        Real.1 * (-sin(x).inverse) = -sin(x).inverse
        Real.1 / (-sin(x)) = -sin(x).inverse
        csc(x) = Real.1 / sin(x)
        Real.1 / sin(x) = Real.1 * sin(x).inverse
        Real.1 * sin(x).inverse = sin(x).inverse
        -(Real.1 / sin(x)) = -sin(x).inverse
        -csc(x) = -(Real.1 / sin(x))
        Real.1 / (-sin(x)) = -csc(x)
        csc(-x) = -csc(x)
    }
}

/// Cotangent is odd: cot(-x) = -cot(x) wherever sine and cosine are nonzero.
theorem cot_neg(x: Real) {
    sin(x) != Real.0 and cos(x) != Real.0 implies cot(-x) = -cot(x)
} by {
    if sin(x) != Real.0 and cos(x) != Real.0 {
        cot(-x) = cos(-x) / sin(-x)
        cos_neg(x)
        cos(-x) = cos(x)
        sin_neg(x)
        sin(-x) = -sin(x)
        cos(-x) / sin(-x) = cos(x) / (-sin(x))
        cos(x) / (-sin(x)) = cos(x) * (-sin(x)).inverse
        neg_inverse_eq(sin(x))
        (-sin(x)).inverse = -sin(x).inverse
        cos(x) * (-sin(x)).inverse = cos(x) * (-sin(x).inverse)
        mul_neg_right(cos(x), sin(x).inverse)
        cos(x) * (-sin(x).inverse) = -(cos(x) * sin(x).inverse)
        cos(x) * sin(x).inverse = cos(x) / sin(x)
        -(cos(x) * sin(x).inverse) = -(cos(x) / sin(x))
        cos(x) / (-sin(x)) = -(cos(x) / sin(x))
        cot(x) = cos(x) / sin(x)
        -(cos(x) / sin(x)) = -cot(x)
        cos(x) / (-sin(x)) = -cot(x)
        cot(-x) = -cot(x)
    }
}

/// The square of sine in terms of cosine squared.
theorem sin_sq_alt(x: Real) {
    sin(x).pow(Nat.2) = Real.1 - cos(x).pow(Nat.2)
} by {
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    sin(x).pow(Nat.2) = Real.1 - cos(x).pow(Nat.2)
}

/// The square of cosine in terms of sine squared.
theorem cos_sq_alt(x: Real) {
    cos(x).pow(Nat.2) = Real.1 - sin(x).pow(Nat.2)
} by {
    sin_sq_add_cos_sq(x)
    sin(x).pow(Nat.2) + cos(x).pow(Nat.2) = Real.1
    cos(x).pow(Nat.2) = Real.1 - sin(x).pow(Nat.2)
}

/// The square of sine is unchanged by the pi shift.
theorem sin_sq_period_pi(x: Real) {
    sin(x + pi).pow(Nat.2) = sin(x).pow(Nat.2)
} by {
    sin_add_pi(x)
    sin(x + pi) = -sin(x)
    sin(x + pi).pow(Nat.2) = (-sin(x)).pow(Nat.2)
    pow_suc(-sin(x), Nat.1)
    (-sin(x)).pow(Nat.2) = (-sin(x)) * (-sin(x))
    neg_mul_neg(sin(x), sin(x))
    (-sin(x)) * (-sin(x)) = sin(x) * sin(x)
    pow_suc(sin(x), Nat.1)
    sin(x).pow(Nat.2) = sin(x) * sin(x)
    (-sin(x)).pow(Nat.2) = sin(x).pow(Nat.2)
    sin(x + pi).pow(Nat.2) = sin(x).pow(Nat.2)
}

/// The square of cosine is unchanged by the pi shift.
theorem cos_sq_period_pi(x: Real) {
    cos(x + pi).pow(Nat.2) = cos(x).pow(Nat.2)
} by {
    cos_add_pi(x)
    cos(x + pi) = -cos(x)
    cos(x + pi).pow(Nat.2) = (-cos(x)).pow(Nat.2)
    pow_suc(-cos(x), Nat.1)
    (-cos(x)).pow(Nat.2) = (-cos(x)) * (-cos(x))
    neg_mul_neg(cos(x), cos(x))
    (-cos(x)) * (-cos(x)) = cos(x) * cos(x)
    pow_suc(cos(x), Nat.1)
    cos(x).pow(Nat.2) = cos(x) * cos(x)
    (-cos(x)).pow(Nat.2) = cos(x).pow(Nat.2)
    cos(x + pi).pow(Nat.2) = cos(x).pow(Nat.2)
}

/// The cosine of x minus pi is minus the cosine of x.
theorem cos_sub_pi(x: Real) {
    cos(x - pi) = -cos(x)
} by {
    cos_add_neg(x, pi)
    cos(x - pi) = cos(x) * cos(pi) + sin(x) * sin(pi)
    cos_pi_neg_one
    cos(pi) = -Real.1
    sin_pi_zero
    sin(pi) = Real.0
    cos(x) * cos(pi) + sin(x) * sin(pi) = cos(x) * -Real.1 + sin(x) * Real.0
    cos(x) * -Real.1 = -cos(x)
    sin(x) * Real.0 = Real.0
    cos(x) * -Real.1 + sin(x) * Real.0 = -cos(x) + Real.0
    -cos(x) + Real.0 = -cos(x)
    cos(x - pi) = -cos(x)
}

/// The sine of x minus pi is minus the sine of x.
theorem sin_sub_pi(x: Real) {
    sin(x - pi) = -sin(x)
} by {
    sin_add(x, -pi)
    sin(x + (-pi)) = sin(x) * cos(-pi) + cos(x) * sin(-pi)
    x + (-pi) = x - pi
    sin(x - pi) = sin(x) * cos(-pi) + cos(x) * sin(-pi)
    cos_neg(pi)
    cos(-pi) = cos(pi)
    sin_neg(pi)
    sin(-pi) = -sin(pi)
    cos_pi_neg_one
    cos(pi) = -Real.1
    sin_pi_zero
    sin(pi) = Real.0
    sin(x) * cos(-pi) + cos(x) * sin(-pi) = sin(x) * -Real.1 + cos(x) * -Real.0
    sin(x) * -Real.1 = -sin(x)
    cos(x) * -Real.0 = Real.0
    sin(x) * -Real.1 + cos(x) * -Real.0 = -sin(x) + Real.0
    -sin(x) + Real.0 = -sin(x)
    sin(x - pi) = -sin(x)
}
