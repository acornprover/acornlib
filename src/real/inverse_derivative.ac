from real.monotone_theorems import increasing_on, increasing_on_apply,
    f_inv_of, f_inv_spec, f_inv_left_inverse, f_inv_between_trap,
    increasing_on_values_imp_args_eq
from real.monotone_base import closed_interval_set_contains_of_bounds
from real.real_base import lt_add_pos, lt_add_right, lt_add_converse, pos_imp_eq_abs,
    close_imp_bounds, bounds_imp_close, pos_gt_zero, gt_zero_imp_pos,
    add_zero_left, add_zero_right, abs_neg, sub_cancels, abs_gte_zero
