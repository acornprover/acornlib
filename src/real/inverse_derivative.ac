/// The derivative of the inverse of a strictly increasing function.
/// /// If f is continuous and strictly increasing on [a, b], differentiable at an
/// interior point x0 with f'(x0) != 0, then the inverse function is
/// differentiable at f(x0) with derivative 1 / f'(x0).

from order import lte_trans, lt_trans, lt_imp_lte, not_lt_imp_gte, lte_antisymm,
    lt_of_lt_of_lte, not_lt_self
from order_set import closed_interval_set, closed_interval_set_contains_eq,
    closed_interval_set_lower_le, closed_interval_set_le_upper,
    closed_interval_set_contains_lower, closed_interval_set_contains_upper
from order import closed_interval
from real.continuity_base import Real, continuous
from real.derivative_basic import has_derivative_at, difference_quotient,
    has_derivative_at_delta, sub_ne_zero_of_ne
