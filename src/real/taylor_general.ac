        (f(b) - f(a) - df(a) * (b - a) - ddf(a) * (b - a).pow(Nat.2) / taylor_two -
            dddf(a) * (b - a).pow(Nat.3) / taylor_six) +
            (f(a) + df(a) * (b - a) + ddf(a) * (b - a).pow(Nat.2) / taylor_two +
                dddf(a) * (b - a).pow(Nat.3) / taylor_six) =
            (dddd(c) / taylor_24) * (b - a).pow(Nat.4) +
                (f(a) + df(a) * (b - a) + ddf(a) * (b - a).pow(Nat.2) / taylor_two +
