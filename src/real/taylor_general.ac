                function(h: Real -> Real) {
                    has_derivative_at(h, x, taylor3_aux_derivative(f, df, ddf, dddf, a, b, x))
                },
                taylor3_aux(f, df, ddf, a, b),
                taylor3_aux_pointwise(f, df, ddf, a, b))
