        taylor_chain2(f, df, ddf, Nat.2) = ddf
        taylor_chain2(f, df, ddf, Nat.2, c) = ddf(c)
        iterated_derivative(f, taylor_chain2(f, df, ddf), Nat.2, c) = ddf(c)
