        pointwise_neg(pointwise_mul(constant[Real, Real](taylor4_remainder_coeff(f, df, ddf, dddf, a, b)),
            pointwise_mul(compose(square_real, affine_real(-Real.1, b)),
                compose(square_real, affine_real(-Real.1, b)))), x) =
