        add_comm(-(f(w) * (w - z)), f(w) * (w - z))
        -(f(w) * (w - z)) + f(w) * (w - z) = f(w) * (w - z) + -(f(w) * (w - z))
        add_neg_eq_zero(f(w) * (w - z))
        f(w) * (w - z) + -(f(w) * (w - z)) = Real.0
        f(w) * (w - x) + (-(f(w) * (w - z)) + f(w) * (w - z)) = f(w) * (w - x) + Real.0
        add_zero_right(f(w) * (w - x))
        f(w) * (w - x) + Real.0 = f(w) * (w - x)
