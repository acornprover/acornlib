        // regroup the left side: f(z) (w - x) + (f(w) - f(x)) (w - z)
        add_assoc(f(z) * (w - x), -(f(x) * (w - z)), f(w) * (w - z))
        (f(z) * (w - x) + -(f(x) * (w - z))) + f(w) * (w - z) = f(z) * (w - x) + (-(f(x) * (w - z)) + f(w) * (w - z))
        add_comm(-(f(x) * (w - z)), f(w) * (w - z))
        -(f(x) * (w - z)) + f(w) * (w - z) = f(w) * (w - z) + -(f(x) * (w - z))
