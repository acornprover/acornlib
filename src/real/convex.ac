        add_comm(f(x) * (w - z), f(w) * (z - x))
        f(x) * (w - z) + f(w) * (z - x) = f(w) * (z - x) + f(x) * (w - z)
        sub_cancels(f(w) * (z - x), f(x) * (w - z))
