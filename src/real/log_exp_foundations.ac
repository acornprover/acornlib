from nat import Nat, from_nat
from order import lte_antisymm, not_lt_imp_gte
from real.exp import Real, exp, exp_add, exp_zero, exp_pos, mul_one_over
from real.exp_inequalities import exp_monotone
from real.exp_log_properties import exp_rpow_mul
from real.harmonic import real_one_div_pos
from real.log import log, log_or_zero, log_one, log_some_of_pos, log_exp, exp_neg,
    exp_injective, exp_log_or_zero, log_mul, log_rpow, rpow, rpow_nat
from real.log_inequalities import log_monotone

numerals Real

// =====================================================================
// Logarithm basic identities
// =====================================================================

/// The logarithm of one is zero (value form).
theorem log_or_zero_one {
    log_or_zero(Real.1) = Real.0
} by {
    Real.1 > Real.0
    log_some_of_pos(Real.1)
    log(Real.1) = Option.some(log_or_zero(Real.1))
    log_one
    log(Real.1) = Option.some(Real.0)
    Option.some(log_or_zero(Real.1)) = Option.some(Real.0)
    some_injective[Real](log_or_zero(Real.1), Real.0)
    log_or_zero(Real.1) = Real.0
}

/// The logarithm of Euler's number is one.
theorem log_e {
    log(Real.e) = Option.some(Real.1)
} by {
    Real.e = exp(Real.1)
    log_exp(Real.1)
    log(exp(Real.1)) = Option.some(Real.1)
    log(Real.e) = Option.some(Real.1)
}

/// The logarithm of Euler's number is one (value form).
theorem log_or_zero_e {
    log_or_zero(Real.e) = Real.1
} by {
    Real.e = exp(Real.1)
    exp_pos(Real.1)
    exp(Real.1) > Real.0
    Real.e > Real.0
    log_some_of_pos(Real.e)
    log(Real.e) = Option.some(log_or_zero(Real.e))
    log_e
    log(Real.e) = Option.some(Real.1)
    Option.some(log_or_zero(Real.e)) = Option.some(Real.1)
    some_injective[Real](log_or_zero(Real.e), Real.1)
    log_or_zero(Real.e) = Real.1
}

/// The logarithm recovers the argument of the exponential (value form).
theorem log_or_zero_exp(x: Real) {
    log_or_zero(exp(x)) = x
} by {
    log_exp(x)
    log(exp(x)) = Option.some(x)
    exp_pos(x)
    exp(x) > Real.0
    log_some_of_pos(exp(x))
    log(exp(x)) = Option.some(log_or_zero(exp(x)))
    Option.some(log_or_zero(exp(x))) = Option.some(x)
    some_injective[Real](log_or_zero(exp(x)), x)
    log_or_zero(exp(x)) = x
}

// =====================================================================
// Exponential basic identities
// =====================================================================

/// The exponential of a difference is the quotient of the exponentials.
theorem exp_sub(x: Real, y: Real) {
    exp(x - y) = exp(x) / exp(y)
} by {
    exp_add(x, -y)
    exp(x + -y) = exp(x) * exp(-y)
    x + -y = x - y
    exp(x - y) = exp(x + -y)
    exp(x - y) = exp(x) * exp(-y)
    exp_neg(y)
    exp(-y) = Real.1 / exp(y)
    exp(x) * exp(-y) = exp(x) * (Real.1 / exp(y))
    exp_pos(y)
    exp(y) > Real.0
    exp(y) != Real.0
    mul_one_over(x, exp(y))
    exp(x) * (Real.1 / exp(y)) = exp(x) / exp(y)
    exp(x - y) = exp(x) / exp(y)
}

/// The exponential of an argument and its negation multiply to one.
theorem exp_mul_exp_neg(x: Real) {
    exp(x) * exp(-x) = Real.1
} by {
    exp_add(x, -x)
    exp(x + -x) = exp(x) * exp(-x)
    x + -x = Real.0
    exp(Real.0) = exp(x) * exp(-x)
    exp_zero
    exp(Real.0) = Real.1
    exp(x) * exp(-x) = Real.1
}

/// Real powers of an exponential are exponentials of the scaled argument (value form).
theorem exp_rpow_val(x: Real, r: Real, v: Real) {
    rpow(exp(x), r) = Option.some(v) implies v = exp(x * r)
} by {
    if rpow(exp(x), r) = Option.some(v) {
        exp_rpow_mul(x, r)
        rpow(exp(x), r) = Option.some(exp(x * r))
        Option.some(v) = Option.some(exp(x * r))
        some_injective[Real](v, exp(x * r))
        v = exp(x * r)
    }
}

/// The logarithm of a product is the sum of the logarithms (value form).
theorem log_or_zero_mul(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies log_or_zero(x * y) = log_or_zero(x) + log_or_zero(y)
} by {
    if x > Real.0 and y > Real.0 {
        log_mul(x, y)
        log(x * y) = Option.some(log_or_zero(x) + log_or_zero(y))
        x.is_positive
        y.is_positive
        (x * y).is_positive
        x * y > Real.0
        log_some_of_pos(x * y)
        log(x * y) = Option.some(log_or_zero(x * y))
        Option.some(log_or_zero(x * y)) = Option.some(log_or_zero(x) + log_or_zero(y))
        some_injective[Real](log_or_zero(x * y), log_or_zero(x) + log_or_zero(y))
        log_or_zero(x * y) = log_or_zero(x) + log_or_zero(y)
    }
}

/// The logarithm of a product with explicit logarithm values.
theorem log_mul_val(x: Real, y: Real, lx: Real, ly: Real) {
    x > Real.0 and y > Real.0 and log(x) = Option.some(lx) and log(y) = Option.some(ly)
    implies log(x * y) = Option.some(lx + ly)
} by {
    if x > Real.0 and y > Real.0 and log(x) = Option.some(lx) and log(y) = Option.some(ly) {
        log_mul(x, y)
        log(x * y) = Option.some(log_or_zero(x) + log_or_zero(y))
        log_some_of_pos(x)
        log(x) = Option.some(log_or_zero(x))
        log_some_of_pos(y)
        log(y) = Option.some(log_or_zero(y))
        Option.some(lx) = Option.some(log_or_zero(x))
        some_injective[Real](lx, log_or_zero(x))
        lx = log_or_zero(x)
        Option.some(ly) = Option.some(log_or_zero(y))
        some_injective[Real](ly, log_or_zero(y))
        ly = log_or_zero(y)
        lx + ly = log_or_zero(x) + log_or_zero(y)
        Option.some(log_or_zero(x) + log_or_zero(y)) = Option.some(lx + ly)
        log(x * y) = Option.some(lx + ly)
    }
}

/// The logarithm of a quotient is the difference of the logarithms (value form).
theorem log_or_zero_div(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies log_or_zero(x / y) = log_or_zero(x) - log_or_zero(y)
} by {
    if x > Real.0 and y > Real.0 {
        x / y > Real.0
        exp_log_or_zero(x / y)
        exp(log_or_zero(x / y)) = x / y
        exp_log_or_zero(x)
        exp(log_or_zero(x)) = x
        exp_log_or_zero(y)
        exp(log_or_zero(y)) = y
        exp_sub(log_or_zero(x), log_or_zero(y))
        exp(log_or_zero(x) - log_or_zero(y)) = exp(log_or_zero(x)) / exp(log_or_zero(y))
        exp(log_or_zero(x)) / exp(log_or_zero(y)) = x / y
        exp(log_or_zero(x) - log_or_zero(y)) = x / y
        exp(log_or_zero(x / y)) = exp(log_or_zero(x) - log_or_zero(y))
        exp_injective(log_or_zero(x / y), log_or_zero(x) - log_or_zero(y))
        log_or_zero(x / y) = log_or_zero(x) - log_or_zero(y)
    }
}

/// The logarithm of a quotient is the difference of the logarithms.
theorem log_div(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies log(x / y) = Option.some(log_or_zero(x) - log_or_zero(y))
} by {
    if x > Real.0 and y > Real.0 {
        log_or_zero_div(x, y)
        log_or_zero(x / y) = log_or_zero(x) - log_or_zero(y)
        x / y > Real.0
        log_some_of_pos(x / y)
        log(x / y) = Option.some(log_or_zero(x / y))
        Option.some(log_or_zero(x / y)) = Option.some(log_or_zero(x) - log_or_zero(y))
        log(x / y) = Option.some(log_or_zero(x) - log_or_zero(y))
    }
}

/// The logarithm of a reciprocal is the negated logarithm (value form).
theorem log_or_zero_recip(x: Real) {
    x > Real.0 implies log_or_zero(Real.1 / x) = -log_or_zero(x)
} by {
    if x > Real.0 {
        log_or_zero_div(Real.1, x)
        log_or_zero(Real.1 / x) = log_or_zero(Real.1) - log_or_zero(x)
        log_or_zero_one
        log_or_zero(Real.1) = Real.0
        log_or_zero(Real.1) - log_or_zero(x) = -log_or_zero(x)
        log_or_zero(Real.1 / x) = -log_or_zero(x)
    }
}

/// The logarithm of a reciprocal is the negated logarithm.
theorem log_recip(x: Real) {
    x > Real.0 implies log(Real.1 / x) = Option.some(-log_or_zero(x))
} by {
    if x > Real.0 {
        log_or_zero_recip(x)
        log_or_zero(Real.1 / x) = -log_or_zero(x)
        real_one_div_pos(x)
        Real.1 / x > Real.0
        log_some_of_pos(Real.1 / x)
        log(Real.1 / x) = Option.some(log_or_zero(Real.1 / x))
        Option.some(log_or_zero(Real.1 / x)) = Option.some(-log_or_zero(x))
        log(Real.1 / x) = Option.some(-log_or_zero(x))
    }
}

/// The logarithm of a real power is the exponent times the logarithm of the base.
theorem log_rpow_val(base: Real, r: Real, v: Real) {
    base > Real.0 and rpow(base, r) = Option.some(v)
    implies log(v) = Option.some(r * log_or_zero(base))
} by {
    if base > Real.0 and rpow(base, r) = Option.some(v) {
        rpow(base, r) = Option.some(exp(r * log_or_zero(base)))
        Option.some(v) = Option.some(exp(r * log_or_zero(base)))
        some_injective[Real](v, exp(r * log_or_zero(base)))
        v = exp(r * log_or_zero(base))
        log_rpow(base, r)
        log(exp(r * log_or_zero(base))) = Option.some(r * log_or_zero(base))
        log(v) = Option.some(r * log_or_zero(base))
    }
}

/// The logarithm of a real power equals the exponent times the base logarithm (value form).
theorem log_or_zero_rpow(base: Real, r: Real, v: Real) {
    base > Real.0 and rpow(base, r) = Option.some(v)
    implies log_or_zero(v) = r * log_or_zero(base)
} by {
    if base > Real.0 and rpow(base, r) = Option.some(v) {
        log_rpow_val(base, r, v)
        log(v) = Option.some(r * log_or_zero(base))
        rpow(base, r) = Option.some(exp(r * log_or_zero(base)))
        Option.some(v) = Option.some(exp(r * log_or_zero(base)))
        some_injective[Real](v, exp(r * log_or_zero(base)))
        v = exp(r * log_or_zero(base))
        exp_pos(r * log_or_zero(base))
        exp(r * log_or_zero(base)) > Real.0
        v > Real.0
        log_some_of_pos(v)
        log(v) = Option.some(log_or_zero(v))
        Option.some(log_or_zero(v)) = Option.some(r * log_or_zero(base))
        some_injective[Real](log_or_zero(v), r * log_or_zero(base))
        log_or_zero(v) = r * log_or_zero(base)
    }
}

/// The logarithm of a natural power is the natural multiple of the logarithm.
theorem log_nat_pow(x: Real, n: Nat) {
    x > Real.0 implies log(x.pow(n)) = Option.some(from_nat[Real](n) * log_or_zero(x))
} by {
    if x > Real.0 {
        rpow_nat(x, n)
        rpow(x, from_nat[Real](n)) = Option.some(x.pow(n))
        log_rpow_val(x, from_nat[Real](n), x.pow(n))
        log(x.pow(n)) = Option.some(from_nat[Real](n) * log_or_zero(x))
    }
}

// =====================================================================
// Logarithm monotonicity
// =====================================================================

/// The logarithm is monotone on positive reals (value form).
theorem log_or_zero_monotone(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and x <= y implies log_or_zero(x) <= log_or_zero(y)
} by {
    if x > Real.0 and y > Real.0 and x <= y {
        log_some_of_pos(x)
        log(x) = Option.some(log_or_zero(x))
        log_some_of_pos(y)
        log(y) = Option.some(log_or_zero(y))
        log_monotone(x, y, log_or_zero(x), log_or_zero(y))
        log_or_zero(x) <= log_or_zero(y)
    }
}

/// Ordered logarithms imply ordered arguments.
theorem log_le_imp_le(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and log_or_zero(x) <= log_or_zero(y) implies x <= y
} by {
    if x > Real.0 and y > Real.0 and log_or_zero(x) <= log_or_zero(y) {
        exp_monotone(log_or_zero(x), log_or_zero(y))
        exp(log_or_zero(x)) <= exp(log_or_zero(y))
        exp_log_or_zero(x)
        exp(log_or_zero(x)) = x
        exp_log_or_zero(y)
        exp(log_or_zero(y)) = y
        x <= y
    }
}

/// Reverse-ordered logarithms imply reverse-ordered arguments.
theorem log_ge_imp_ge(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and log_or_zero(x) >= log_or_zero(y) implies x >= y
} by {
    if x > Real.0 and y > Real.0 and log_or_zero(x) >= log_or_zero(y) {
        log_or_zero(y) <= log_or_zero(x)
        exp_monotone(log_or_zero(y), log_or_zero(x))
        exp(log_or_zero(y)) <= exp(log_or_zero(x))
        exp_log_or_zero(y)
        exp(log_or_zero(y)) = y
        exp_log_or_zero(x)
        exp(log_or_zero(x)) = x
        y <= x
        x >= y
    }
}

/// Strictly ordered logarithms imply strictly ordered arguments.
theorem log_lt_imp_lt(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and log_or_zero(x) < log_or_zero(y) implies x < y
} by {
    if x > Real.0 and y > Real.0 and log_or_zero(x) < log_or_zero(y) {
        log_or_zero(x) <= log_or_zero(y)
        log_le_imp_le(x, y)
        x <= y
        if not x < y {
            not_lt_imp_gte(x, y)
            x >= y
            lte_antisymm(x, y)
            x = y
            log_or_zero(x) = log_or_zero(y)
            false
        }
        x < y
    }
}

/// The logarithm is injective on positive reals (value form).
theorem log_injective(x: Real, y: Real) {
    x > Real.0 and y > Real.0 and log_or_zero(x) = log_or_zero(y) implies x = y
} by {
    if x > Real.0 and y > Real.0 and log_or_zero(x) = log_or_zero(y) {
        exp_log_or_zero(x)
        exp(log_or_zero(x)) = x
        exp_log_or_zero(y)
        exp(log_or_zero(y)) = y
        exp(log_or_zero(x)) = exp(log_or_zero(y))
        x = y
    }
}

/// The logarithm is injective on positive reals (option form).
theorem log_injective_opt(x: Real, y: Real, lx: Real, ly: Real) {
    x > Real.0 and y > Real.0 and log(x) = Option.some(lx) and log(y) = Option.some(ly) and lx = ly
    implies x = y
} by {
    if x > Real.0 and y > Real.0 and log(x) = Option.some(lx) and log(y) = Option.some(ly) and lx = ly {
        log_some_of_pos(x)
        log(x) = Option.some(log_or_zero(x))
        Option.some(lx) = Option.some(log_or_zero(x))
        some_injective[Real](lx, log_or_zero(x))
        lx = log_or_zero(x)
        log_some_of_pos(y)
        log(y) = Option.some(log_or_zero(y))
        Option.some(ly) = Option.some(log_or_zero(y))
        some_injective[Real](ly, log_or_zero(y))
        ly = log_or_zero(y)
        log_or_zero(x) = log_or_zero(y)
        log_injective(x, y)
        x = y
    }
}
