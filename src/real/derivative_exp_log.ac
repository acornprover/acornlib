        x0 * delta2 > Real.0
        exp_gt_one_plus_x(delta2)
        exp(delta2) > Real.1 + delta2
        pos_gt_zero(delta2)
        delta2 > Real.0
        lt_add_left(Real.0, delta2, Real.1)
        Real.1 + Real.0 < Real.1 + delta2
        Real.1 + Real.0 = Real.1
        Real.1 < Real.1 + delta2
        Real.1 + delta2 > Real.1
