/// The shifted-series partial sums from index one are bounded by |h| when |h| <= 1/2.
theorem shift_partial_sum_bound(h: Real, n: Nat) {
    h.abs < Real.1 / two implies partial(tail(abs_fn(exp_shift_term(h)), Nat.1), n) <= h.abs
} by {
    if h.abs < Real.1 / two {
