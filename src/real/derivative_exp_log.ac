        pos_gt_zero(x0 * (Real.1 - exp(-delta2)))
        x0 * (Real.1 - exp(-delta2)) > Real.0
        eps_smaller_than_both(x0 * delta2, x0 * (Real.1 - exp(-delta2)))
        let m: Real satisfy {
