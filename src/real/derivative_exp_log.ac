                        exp(x0.log.get_or_else(Real.0)) = x0
                        exp(x0.log.get_or_else(Real.0) + delta2) = x0 * exp(delta2)
                        exp(x.log.get_or_else(Real.0)) = x
                        x >= x0 * exp(delta2)
                        lte_add_right(x0 * exp(delta2), x, -x0)
                        x0 * exp(delta2) + -x0 <= x + -x0
                        x0 * exp(delta2) - x0 <= x - x0
                        x - x0 >= x0 * exp(delta2) - x0
                        x0 * exp(delta2) - x0 = x0 * (exp(delta2) - Real.1)
                        x - x0 >= x0 * (exp(delta2) - Real.1)
