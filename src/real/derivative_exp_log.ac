        Real.1 * (Real.1 / (Real.1 - h.abs)) <= (two * (Real.1 - h.abs)) * (Real.1 / (Real.1 - h.abs))
        Real.1 * (Real.1 / (Real.1 - h.abs)) = Real.1 / (Real.1 - h.abs)
        Real.1 - h.abs != Real.0
        (Real.1 - h.abs) * (Real.1 / (Real.1 - h.abs)) = Real.1
        (two * (Real.1 - h.abs)) * (Real.1 / (Real.1 - h.abs)) =
            two * ((Real.1 - h.abs) * (Real.1 / (Real.1 - h.abs)))
