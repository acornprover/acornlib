                        Real.1 + delta2 < exp(delta2)
                        lt_add_right(Real.1 + delta2, exp(delta2), -Real.1)
                        Real.1 + delta2 + -Real.1 < exp(delta2) + -Real.1
                        Real.1 + delta2 + -Real.1 = delta2 + Real.1 + -Real.1
                        delta2 + Real.1 + -Real.1 = delta2 + (Real.1 + -Real.1)
                        Real.1 + -Real.1 = Real.0
                        delta2 + (Real.1 + -Real.1) = delta2 + Real.0
                        delta2 + Real.0 = delta2
                        Real.1 + delta2 + -Real.1 = delta2
                        delta2 < exp(delta2) - Real.1
                        exp(delta2) - Real.1 > delta2
                        lt_mul_pos_left(delta2, exp(delta2) - Real.1, x0)
                        x0 * delta2 < x0 * (exp(delta2) - Real.1)
                        x0 * (exp(delta2) - Real.1) > x0 * delta2
                        x0 * delta2 < x0 * (exp(delta2) - Real.1)
