        (Real.1 / two) * (h.abs / (Real.1 - h.abs)) <= (Real.1 / two) * (two * h.abs)
        (Real.1 / two) * (two * h.abs) = h.abs
        (Real.1 / two) * (h.abs / (Real.1 - h.abs)) <= h.abs
