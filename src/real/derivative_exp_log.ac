                    exp(x) - exp(x0) = exp(x0) * exp(x - x0) - exp(x0)
                    exp(x0) * exp(x - x0) - exp(x0) = exp(x0) * (exp(x - x0) - Real.1)
                    exp(x) - exp(x0) = exp(x0) * (exp(x - x0) - Real.1)
                    difference_quotient(exp, x0, x) = (exp(x) - exp(x0)) / (x - x0)
                    difference_quotient(exp, x0, x) =
                        (exp(x0) * (exp(x - x0) - Real.1)) / (x - x0)
                    exp_sub_one_series_sum(x - x0)
                    exp(x - x0) - Real.1 = (x - x0) * exp_shift_sum(x - x0)
                    exp(x0) * (exp(x - x0) - Real.1) =
                        exp(x0) * ((x - x0) * exp_shift_sum(x - x0))
                    difference_quotient(exp, x0, x) =
                        (exp(x0) * ((x - x0) * exp_shift_sum(x - x0))) / (x - x0)
                    (exp(x0) * ((x - x0) * exp_shift_sum(x - x0))) / (x - x0) =
                        exp(x0) * (((x - x0) * exp_shift_sum(x - x0)) / (x - x0))
                    ((x - x0) * exp_shift_sum(x - x0)) / (x - x0) = exp_shift_sum(x - x0)
                    difference_quotient(exp, x0, x) = exp(x0) * exp_shift_sum(x - x0)
                    difference_quotient(exp, x0, x) - exp(x0) =
                        exp(x0) * exp_shift_sum(x - x0) - exp(x0)
                    exp(x0) * exp_shift_sum(x - x0) - exp(x0) =
                        exp(x0) * (exp_shift_sum(x - x0) - Real.1)
                    difference_quotient(exp, x0, x) - exp(x0) =
                        exp(x0) * (exp_shift_sum(x - x0) - Real.1)
                    exp_shift_sum_close_one_sum(x - x0)
                    (exp_shift_sum(x - x0) - Real.1).abs <= (x - x0).abs
                    abs_gte_zero(exp(x0))
                    Real.0 <= exp(x0).abs
                    lte_mul_nonneg_right((exp_shift_sum(x - x0) - Real.1).abs,
                        (x - x0).abs, exp(x0).abs)
(exp_shift_sum(x - x0) - Real.1).abs * exp(x0).abs <= (x - x0).abs * exp(x0).abs
exp(x0).abs * (exp_shift_sum(x - x0) - Real.1).abs <= exp(x0).abs * (x - x0).abs
                    mul_abs(exp(x0), exp_shift_sum(x - x0) - Real.1)
                    (exp(x0) * (exp_shift_sum(x - x0) - Real.1)).abs =
                        exp(x0).abs * (exp_shift_sum(x - x0) - Real.1).abs
                    (difference_quotient(exp, x0, x) - exp(x0)).abs =
                        (exp(x0) * (exp_shift_sum(x - x0) - Real.1)).abs
(difference_quotient(exp, x0, x) - exp(x0)).abs <= exp(x0).abs * (x - x0).abs
                    lt_mul_pos_left((x - x0).abs, delta, exp(x0).abs)
                    exp(x0).abs * (x - x0).abs < exp(x0).abs * delta
                    lte_lt_trans((difference_quotient(exp, x0, x) - exp(x0)).abs,
                        exp(x0).abs * (x - x0).abs, exp(x0).abs * delta)
                    (difference_quotient(exp, x0, x) - exp(x0)).abs < exp(x0).abs * delta
                    lt_mul_pos_left(delta, delta1, exp(x0).abs)
                    exp(x0).abs * delta < exp(x0).abs * delta1
                    lt_trans((difference_quotient(exp, x0, x) - exp(x0)).abs,
                        exp(x0).abs * delta, exp(x0).abs * delta1)
                    (difference_quotient(exp, x0, x) - exp(x0)).abs < exp(x0).abs * delta1
                    exp(x0).abs * delta1 = delta1 * exp(x0)
                    delta1 * exp(x0) < eps
                    exp(x0).abs * delta1 < eps
