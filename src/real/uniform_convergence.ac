                        interval_contains_mono(a, b, p(k), p(k + 1), t)
                        interval_contains(a, b, t)
                        forall(t2: Real) {
                            interval_contains(a, b, t2) implies g(t2) - eps <= f(t2)
                        }
                        interval_contains(a, b, t) implies g(t) - eps <= f(t)
