                (interval_inf(g, p(k), p(k + 1)) - eps) * diff_step(p, k) = interval_inf(g, p(k), p(k + 1)) * diff_step(p, k) - eps * diff_step(p, k)
                interval_inf(g, p(k), p(k + 1)) * diff_step(p, k) - eps * diff_step(p, k) <= interval_inf(f, p(k), p(k + 1)) * diff_step(p, k)
