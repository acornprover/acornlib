// Toward pi/2: sin stays above sin(pi/4) > 0 (strict monotonicity) while cos
// tends to zero (continuity of cosine at pi/2 with cos(pi/2) = 0), so the
// quotient tan = sin/cos grows without bound.  Toward -pi/2 the same holds by
// oddness.

/// The tangent of pi over four is one.
theorem tan_pi_over_four {
    tan(pi_over_four) = Real.1
} by {
    sin_pi_over_two_sub(pi_over_four)
    sin(pi_over_two - pi_over_four) = cos(pi_over_four)
    pi_over_two_eq_two_mul_pi_over_four
    pi_over_four + pi_over_four = pi_over_two
