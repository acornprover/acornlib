}

// The derivative of the arctangent.
//
// Following `log_has_derivative_at_pos` in `derivative_exp_log.ac`, the
// derivative of the arctangent is obtained from the derivative of the tangent
// by reciprocating the difference quotient: if y = arctan(x), then
//     (arctan(x) - arctan(x0)) / (x - x0) = 1 / ((tan(y) - tan(y0)) / (y - y0)),
// and tan'(y0) = 1/cos(y0)^2 = 1/(1 + x0^2).

/// The tangent has derivative 1/cos(x0)^2 at every point where cos(x0) is nonzero.
theorem tan_has_derivative_at(x0: Real) {
    cos(x0) != Real.0 implies
    has_derivative_at(tan, x0, Real.1 / (cos(x0) * cos(x0)))
} by {
    if cos(x0) != Real.0 {
        sin_has_derivative_at(x0)
        has_derivative_at(sin, x0, cos(x0))
        cos_has_derivative_at(x0)
        has_derivative_at(cos, x0, -sin(x0))
        derivative_pointwise_div(sin, cos, x0, cos(x0), -sin(x0))
        has_derivative_at(pointwise_div_real(sin, cos), x0,
            (cos(x0) * cos(x0) - sin(x0) * -sin(x0)) / (cos(x0) * cos(x0)))
        mul_neg_right(sin(x0), sin(x0))
        sin(x0) * -sin(x0) = -(sin(x0) * sin(x0))
        neg_neg(sin(x0) * sin(x0))
        -(-(sin(x0) * sin(x0))) = sin(x0) * sin(x0)
        cos(x0) * cos(x0) - (-(sin(x0) * sin(x0))) = cos(x0) * cos(x0) + sin(x0) * sin(x0)
        cos(x0) * cos(x0) - sin(x0) * -sin(x0) = cos(x0) * cos(x0) + sin(x0) * sin(x0)
        pow_suc(sin(x0), Nat.1)
        sin(x0).pow(Nat.1.suc) = sin(x0) * sin(x0).pow(Nat.1)
        Nat.1.suc = Nat.2
        pow_one[Real](sin(x0))
        sin(x0).pow(Nat.1) = sin(x0)
        sin(x0).pow(Nat.2) = sin(x0) * sin(x0)
        pow_suc(cos(x0), Nat.1)
        cos(x0).pow(Nat.1.suc) = cos(x0) * cos(x0).pow(Nat.1)
        pow_one[Real](cos(x0))
        cos(x0).pow(Nat.1) = cos(x0)
        cos(x0).pow(Nat.2) = cos(x0) * cos(x0)
        sin_sq_add_cos_sq(x0)
        sin(x0).pow(Nat.2) + cos(x0).pow(Nat.2) = Real.1
        cos(x0) * cos(x0) + sin(x0) * sin(x0) = Real.1
        cos(x0) * cos(x0) - sin(x0) * -sin(x0) = Real.1
        (cos(x0) * cos(x0) - sin(x0) * -sin(x0)) / (cos(x0) * cos(x0)) =
            Real.1 / (cos(x0) * cos(x0))
        has_derivative_at(pointwise_div_real(sin, cos), x0, Real.1 / (cos(x0) * cos(x0)))
        tan_eq_pointwise_div
        tan = pointwise_div_real(sin, cos)
        function_eq_transport_predicate_rev(
            function(h: Real -> Real) {
                has_derivative_at(h, x0, Real.1 / (cos(x0) * cos(x0)))
            },
            tan,
            pointwise_div_real(sin, cos)
        )
        has_derivative_at(tan, x0, Real.1 / (cos(x0) * cos(x0)))
    }
}

/// Cosine squared of the arctangent is 1/(1 + x^2).
theorem cos_sq_arctan_eq(x: Real) {
    cos(arctan(x)) * cos(arctan(x)) = Real.1 / (Real.1 + x * x)
} by {
    tan_arctan(x)
