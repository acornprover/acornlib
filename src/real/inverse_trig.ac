        sin(pi_over_four) / cos(yw) = sin(pi_over_four) * cos(yw).inverse
        x < sin(pi_over_four) / cos(yw)
        inverse_of_positive_is_positive(cos(yw))
        Real.0 < cos(yw).inverse
        multiply_inequality_with_nonnegative_element(sin(pi_over_four), sin(yw), cos(yw).inverse)
        sin(pi_over_four) * cos(yw).inverse <= sin(yw) * cos(yw).inverse
        sin(yw) / cos(yw) = sin(yw) * cos(yw).inverse
        sin(pi_over_four) * cos(yw).inverse <= sin(yw) / cos(yw)
        tan(yw) = sin(yw) / cos(yw)
        sin(pi_over_four) / cos(yw) <= tan(yw)
        lt_of_lt_of_lte(x, sin(pi_over_four) / cos(yw), tan(yw))
        x < tan(yw)
        Real.0 < yw and yw < pi_over_two and x < tan(yw)
        exists(y: Real) {
            Real.0 < y and y < pi_over_two and x < tan(y)
