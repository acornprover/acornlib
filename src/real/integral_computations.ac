                        interval_contains_left(uniform_partition(a, b, n, i), uniform_partition(a, b, n, i + 1), t)
                        uniform_partition(a, b, n, i) <= t
                        interval_contains_right(uniform_partition(a, b, n, i), uniform_partition(a, b, n, i + 1), t)
