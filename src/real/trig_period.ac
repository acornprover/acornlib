from real.real_field import Real, zero_is_different_than_one
from real.trig import sin, cos, sin_zero, cos_zero, sin_neg, cos_neg
from real.trig_identities import sin_add, cos_add
from real.pi import pi, pi_over_two, cos_pi_over_two_zero, sin_pi_over_two_one,
    cos_pi_neg_one, sin_pi_zero, sin_two_pi_zero, cos_two_pi_one

numerals Real

// Cofunction identities.
//
// These follow from the addition formulas and the values cos(pi/2) = 0 and
// sin(pi/2) = 1 proved in real/pi.ac.  Parity (sin(-x) = -sin(x),
// cos(-x) = cos(x)) was already proved in real/trig.ac.

/// The sine of x plus pi over two is cosine of x.
theorem sin_add_pi_over_two(x: Real) {
    sin(x + pi_over_two) = cos(x)
} by {
    sin_add(x, pi_over_two)
    sin(x + pi_over_two) = sin(x) * cos(pi_over_two) + cos(x) * sin(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    sin(x) * cos(pi_over_two) + cos(x) * sin(pi_over_two) = sin(x) * Real.0 + cos(x) * Real.1
    sin(x) * Real.0 = Real.0
    cos(x) * Real.1 = cos(x)
    sin(x) * Real.0 + cos(x) * Real.1 = Real.0 + cos(x)
    Real.0 + cos(x) = cos(x)
    sin(x + pi_over_two) = cos(x)
}

/// The cosine of x plus pi over two is negative sine of x.
theorem cos_add_pi_over_two(x: Real) {
    cos(x + pi_over_two) = -sin(x)
} by {
    cos_add(x, pi_over_two)
    cos(x + pi_over_two) = cos(x) * cos(pi_over_two) - sin(x) * sin(pi_over_two)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    cos(x) * cos(pi_over_two) - sin(x) * sin(pi_over_two) = cos(x) * Real.0 - sin(x) * Real.1
    cos(x) * Real.0 = Real.0
    sin(x) * Real.1 = sin(x)
    cos(x) * Real.0 - sin(x) * Real.1 = Real.0 - sin(x)
    Real.0 - sin(x) = -sin(x)
    cos(x + pi_over_two) = -sin(x)
}

/// The sine of pi over two minus x is cosine of x.
theorem sin_pi_over_two_sub(x: Real) {
    sin(pi_over_two - x) = cos(x)
} by {
    pi_over_two - x = pi_over_two + -x
    sin_add(pi_over_two, -x)
    sin(pi_over_two + -x) = sin(pi_over_two) * cos(-x) + cos(pi_over_two) * sin(-x)
    sin(pi_over_two - x) = sin(pi_over_two) * cos(-x) + cos(pi_over_two) * sin(-x)
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    cos_neg(x)
    cos(-x) = cos(x)
    sin_neg(x)
    sin(-x) = -sin(x)
    sin(pi_over_two) * cos(-x) + cos(pi_over_two) * sin(-x) = Real.1 * cos(x) + Real.0 * -sin(x)
    Real.1 * cos(x) = cos(x)
    Real.0 * -sin(x) = Real.0
    Real.1 * cos(x) + Real.0 * -sin(x) = cos(x) + Real.0
    cos(x) + Real.0 = cos(x)
    sin(pi_over_two - x) = cos(x)
}

/// The cosine of pi over two minus x is sine of x.
theorem cos_pi_over_two_sub(x: Real) {
    cos(pi_over_two - x) = sin(x)
} by {
    pi_over_two - x = pi_over_two + -x
    cos_add(pi_over_two, -x)
    cos(pi_over_two + -x) = cos(pi_over_two) * cos(-x) - sin(pi_over_two) * sin(-x)
    cos(pi_over_two - x) = cos(pi_over_two) * cos(-x) - sin(pi_over_two) * sin(-x)
    cos_pi_over_two_zero
    cos(pi_over_two) = Real.0
    sin_pi_over_two_one
    sin(pi_over_two) = Real.1
    cos_neg(x)
    cos(-x) = cos(x)
    sin_neg(x)
    sin(-x) = -sin(x)
    cos(pi_over_two) * cos(-x) - sin(pi_over_two) * sin(-x) = Real.0 * cos(x) - Real.1 * -sin(x)
    Real.0 * cos(x) = Real.0
    Real.1 * -sin(x) = -sin(x)
    Real.0 * cos(x) - Real.1 * -sin(x) = Real.0 - -sin(x)
    Real.0 - -sin(x) = sin(x)
    cos(pi_over_two - x) = sin(x)
}

// Periodicity.
//
// Two pi is a period of sine and cosine, and pi is a half-period: shifting by
// pi negates both functions.  Both facts follow from the addition formulas and
// the values cos(2pi) = 1, sin(2pi) = 0, cos(pi) = -1, sin(pi) = 0 proved in
// real/pi.ac.

/// The sine of x plus two pi is sine of x.
theorem sin_add_two_pi(x: Real) {
    sin(x + (pi + pi)) = sin(x)
} by {
    sin_add(x, pi + pi)
    sin(x + (pi + pi)) = sin(x) * cos(pi + pi) + cos(x) * sin(pi + pi)
    cos_two_pi_one
    cos(pi + pi) = Real.1
    sin_two_pi_zero
    sin(pi + pi) = Real.0
    sin(x) * cos(pi + pi) + cos(x) * sin(pi + pi) = sin(x) * Real.1 + cos(x) * Real.0
    sin(x) * Real.1 = sin(x)
    cos(x) * Real.0 = Real.0
    sin(x) * Real.1 + cos(x) * Real.0 = sin(x) + Real.0
    sin(x) + Real.0 = sin(x)
    sin(x + (pi + pi)) = sin(x)
}

/// The cosine of x plus two pi is cosine of x.
theorem cos_add_two_pi(x: Real) {
    cos(x + (pi + pi)) = cos(x)
} by {
    cos_add(x, pi + pi)
    cos(x + (pi + pi)) = cos(x) * cos(pi + pi) - sin(x) * sin(pi + pi)
    cos_two_pi_one
    cos(pi + pi) = Real.1
    sin_two_pi_zero
    sin(pi + pi) = Real.0
    cos(x) * cos(pi + pi) - sin(x) * sin(pi + pi) = cos(x) * Real.1 - sin(x) * Real.0
    cos(x) * Real.1 = cos(x)
    sin(x) * Real.0 = Real.0
    cos(x) * Real.1 - sin(x) * Real.0 = cos(x) - Real.0
    cos(x) - Real.0 = cos(x)
    cos(x + (pi + pi)) = cos(x)
}

/// The sine of x plus pi is negative sine of x.
theorem sin_add_pi(x: Real) {
    sin(x + pi) = -sin(x)
} by {
    sin_add(x, pi)
    sin(x + pi) = sin(x) * cos(pi) + cos(x) * sin(pi)
    cos_pi_neg_one
    cos(pi) = -Real.1
    sin_pi_zero
    sin(pi) = Real.0
    sin(x) * cos(pi) + cos(x) * sin(pi) = sin(x) * -Real.1 + cos(x) * Real.0
    sin(x) * -Real.1 = -sin(x)
    cos(x) * Real.0 = Real.0
    sin(x) * -Real.1 + cos(x) * Real.0 = -sin(x) + Real.0
    -sin(x) + Real.0 = -sin(x)
    sin(x + pi) = -sin(x)
}

/// The cosine of x plus pi is negative cosine of x.
theorem cos_add_pi(x: Real) {
    cos(x + pi) = -cos(x)
} by {
    cos_add(x, pi)
    cos(x + pi) = cos(x) * cos(pi) - sin(x) * sin(pi)
    cos_pi_neg_one
    cos(pi) = -Real.1
    sin_pi_zero
    sin(pi) = Real.0
    cos(x) * cos(pi) - sin(x) * sin(pi) = cos(x) * -Real.1 - sin(x) * Real.0
    cos(x) * -Real.1 = -cos(x)
    sin(x) * Real.0 = Real.0
    cos(x) * -Real.1 - sin(x) * Real.0 = -cos(x) - Real.0
    -cos(x) - Real.0 = -cos(x)
    cos(x + pi) = -cos(x)
}

// Sine and cosine are not constant.  Minimality of the period is left as a
// comment: 2pi is the smallest positive period of sine and cosine — every
// period is an integer multiple of 2pi — but proving that needs sin(x) > 0 on
// (0, pi/2), which requires the derivative-based monotonicity machinery that is
// not yet available.

/// Sine is not a constant function.
theorem sin_not_constant {
    not exists(c: Real) {
        forall(x: Real) { sin(x) = c }
    }
} by {
    if exists(c: Real) {
        forall(x: Real) { sin(x) = c }
    } {
        let c: Real satisfy {
            forall(x: Real) { sin(x) = c }
        }
        forall(x: Real) { sin(x) = c }
        sin_zero
        sin(Real.0) = Real.0
        sin(Real.0) = c
        Real.0 = c
        sin_pi_over_two_one
        sin(pi_over_two) = Real.1
        sin(pi_over_two) = c
        Real.1 = c
        Real.1 = Real.0
        zero_is_different_than_one
        Real.0 != Real.1
        false
    }
}

/// Cosine is not a constant function.
theorem cos_not_constant {
    not exists(c: Real) {
        forall(x: Real) { cos(x) = c }
    }
} by {
    if exists(c: Real) {
        forall(x: Real) { cos(x) = c }
    } {
        let c: Real satisfy {
            forall(x: Real) { cos(x) = c }
        }
        forall(x: Real) { cos(x) = c }
        cos_zero
        cos(Real.0) = Real.1
        cos(Real.0) = c
        Real.1 = c
        cos_pi_over_two_zero
        cos(pi_over_two) = Real.0
        cos(pi_over_two) = c
        Real.0 = c
        Real.0 = Real.1
        zero_is_different_than_one
        Real.0 != Real.1
        false
    }
}
