// =====================================================================
// Logarithm algebraic identities
// =====================================================================

/// The logarithm of a three-factor product is the sum of the logarithms.
theorem log_or_zero_mul3(x: Real, y: Real, z: Real) {
    x > Real.0 and y > Real.0 and z > Real.0 implies
        log_or_zero(x * y * z) = log_or_zero(x) + log_or_zero(y) + log_or_zero(z)
} by {
    if x > Real.0 and y > Real.0 and z > Real.0 {
        x.is_positive
        y.is_positive
        (x * y).is_positive
        x * y > Real.0
        log_or_zero_mul(x * y, z)
        log_or_zero((x * y) * z) = log_or_zero(x * y) + log_or_zero(z)
        (x * y) * z = x * y * z
        log_or_zero(x * y * z) = log_or_zero(x * y) + log_or_zero(z)
        log_or_zero_mul(x, y)
        log_or_zero(x * y) = log_or_zero(x) + log_or_zero(y)
        log_or_zero(x * y * z) = log_or_zero(x) + log_or_zero(y) + log_or_zero(z)
    }
}

/// The logarithm of a three-factor product with explicit logarithm values.
theorem log_mul3_val(x: Real, y: Real, z: Real, lx: Real, ly: Real, lz: Real) {
    x > Real.0 and y > Real.0 and z > Real.0 and
    x.log = Option.some(lx) and y.log = Option.some(ly) and z.log = Option.some(lz)
    implies (x * y * z).log = Option.some(lx + ly + lz)
} by {
    if x > Real.0 and y > Real.0 and z > Real.0 and
        x.log = Option.some(lx) and y.log = Option.some(ly) and z.log = Option.some(lz) {
        log_mul_val(x, y, lx, ly)
        (x * y).log = Option.some(lx + ly)
        x.is_positive
        y.is_positive
        (x * y).is_positive
        x * y > Real.0
        log_mul_val(x * y, z, lx + ly, lz)
        ((x * y) * z).log = Option.some((lx + ly) + lz)
        (x * y) * z = x * y * z
        (lx + ly) + lz = lx + ly + lz
        (x * y * z).log = Option.some(lx + ly + lz)
    }
}

/// The logarithm of a square is twice the logarithm.
theorem log_or_zero_sq(x: Real) {
    x > Real.0 implies log_or_zero(x.pow(Nat.2)) = two * log_or_zero(x)
} by {
    if x > Real.0 {
        log_nat_pow(x, Nat.2)
        (x.pow(Nat.2)).log = Option.some(from_nat[Real](Nat.2) * log_or_zero(x))
        pow_pos(x, Nat.2)
        x.pow(Nat.2) > Real.0
        log_some_of_pos_exists(x.pow(Nat.2))
        let lz: Real satisfy {
            (x.pow(Nat.2)).log = Option.some(lz)
        }
        log_or_zero(x.pow(Nat.2)) = lz
        (x.pow(Nat.2)).log = Option.some(log_or_zero(x.pow(Nat.2)))
        Option.some(log_or_zero(x.pow(Nat.2))) = Option.some(from_nat[Real](Nat.2) * log_or_zero(x))
        some_injective[Real](log_or_zero(x.pow(Nat.2)), from_nat[Real](Nat.2) * log_or_zero(x))
        log_or_zero(x.pow(Nat.2)) = from_nat[Real](Nat.2) * log_or_zero(x)
        from_nat_two_eq
        from_nat[Real](Nat.2) = two
        log_or_zero(x.pow(Nat.2)) = two * log_or_zero(x)
    }
}

/// The logarithm of a natural power is the natural multiple of the logarithm.
theorem log_or_zero_pow(x: Real, n: Nat) {
    x > Real.0 implies log_or_zero(x.pow(n)) = from_nat[Real](n) * log_or_zero(x)
} by {
    if x > Real.0 {
        log_nat_pow(x, n)
        (x.pow(n)).log = Option.some(from_nat[Real](n) * log_or_zero(x))
        pow_pos(x, n)
        x.pow(n) > Real.0
        log_some_of_pos_exists(x.pow(n))
        let lz: Real satisfy {
            (x.pow(n)).log = Option.some(lz)
        }
        log_or_zero(x.pow(n)) = lz
        (x.pow(n)).log = Option.some(log_or_zero(x.pow(n)))
        Option.some(log_or_zero(x.pow(n))) = Option.some(from_nat[Real](n) * log_or_zero(x))
        some_injective[Real](log_or_zero(x.pow(n)), from_nat[Real](n) * log_or_zero(x))
        log_or_zero(x.pow(n)) = from_nat[Real](n) * log_or_zero(x)
    }
}

/// The logarithm of a natural power of Euler's number is the natural number.
theorem log_or_zero_e_pow(n: Nat) {
    log_or_zero(Real.e.pow(n)) = from_nat[Real](n)
} by {
    exp_pos(Real.1)
    exp(Real.1) > Real.0
    Real.e = exp(Real.1)
    Real.e > Real.0
    log_or_zero_pow(Real.e, n)
    log_or_zero(Real.e.pow(n)) = from_nat[Real](n) * log_or_zero(Real.e)
    log_or_zero_e
    log_or_zero(Real.e) = Real.1
    from_nat[Real](n) * Real.1 = from_nat[Real](n)
    log_or_zero(Real.e.pow(n)) = from_nat[Real](n)
}

/// The logarithm of a reciprocal exponential is the negation.
theorem log_or_zero_exp_recip(x: Real) {
    log_or_zero(Real.1 / exp(x)) = -x
} by {
    exp_pos(x)
    exp(x) > Real.0
    log_or_zero_recip(exp(x))
    log_or_zero(Real.1 / exp(x)) = -log_or_zero(exp(x))
    log_or_zero_exp(x)
    log_or_zero(exp(x)) = x
    log_or_zero(Real.1 / exp(x)) = -x
}

/// The logarithm of a quotient by itself is zero.
theorem log_or_zero_div_self(x: Real) {
    x > Real.0 implies log_or_zero(x / x) = Real.0
} by {
    if x > Real.0 {
        x != Real.0
        x / x = Real.1
        log_or_zero_one
        log_or_zero(Real.1) = Real.0
        log_or_zero(x / x) = Real.0
    }
}

// =====================================================================
// Logarithm inequalities
// =====================================================================

/// The logarithm of a positive real is at most the real minus one.
theorem log_or_zero_le_sub_one(x: Real) {
    x > Real.0 implies log_or_zero(x) <= x - Real.1
} by {
    if x > Real.0 {
        log_some_of_pos_exists(x)
        let lx: Real satisfy {
            x.log = Option.some(lx)
        }
        log_or_zero(x) = lx
        x.log = Option.some(log_or_zero(x))
        log_le_sub_one(x, log_or_zero(x))
        log_or_zero(x) <= x - Real.1
    }
}

/// The logarithm of a positive real is at least one minus the reciprocal.
theorem one_sub_recip_le_log_or_zero(x: Real) {
    x > Real.0 implies Real.1 - Real.1 / x <= log_or_zero(x)
} by {
    if x > Real.0 {
        log_some_of_pos_exists(x)
        let lx: Real satisfy {
            x.log = Option.some(lx)
        }
        log_or_zero(x) = lx
        x.log = Option.some(log_or_zero(x))
        one_sub_recip_le_log(x, log_or_zero(x))
        Real.1 - Real.1 / x <= log_or_zero(x)
    }
}

/// The logarithm of a positive real is strictly below the real.
theorem log_or_zero_lt_self(x: Real) {
    x > Real.0 implies log_or_zero(x) < x
} by {
    if x > Real.0 {
        log_or_zero_le_sub_one(x)
        log_or_zero(x) <= x - Real.1
        Real.0 < Real.1
        lt_swap_neg(Real.0, Real.1)
        -Real.1 < -Real.0
        -Real.0 = Real.0
        -Real.1 < Real.0
        lt_add_right(-Real.1, Real.0, x)
        -Real.1 + x < Real.0 + x
        -Real.1 + x = x - Real.1
        Real.0 + x = x
        x - Real.1 < x
        lte_lt_trans(log_or_zero(x), x - Real.1, x)
        log_or_zero(x) < x
    }
}

/// The logarithm of one plus x is at least x over one plus x.
theorem log_one_plus_x_ge_x_over_one_plus_x(x: Real) {
    x >= Real.0 implies x / (Real.1 + x) <= log_or_zero(Real.1 + x)
} by {
    if x >= Real.0 {
        Real.1 > Real.0
        Real.0 < Real.1
        lt_add_right(Real.0, Real.1, x)
        Real.0 + x < Real.1 + x
        Real.0 + x = x
        x < Real.1 + x
        x >= Real.0
        Real.0 <= x
        lt_of_lte_of_lt(Real.0, x, Real.1 + x)
        Real.0 < Real.1 + x
        Real.1 + x > Real.0
        one_sub_recip_le_log_or_zero(Real.1 + x)
        Real.1 - Real.1 / (Real.1 + x) <= log_or_zero(Real.1 + x)
        Real.1 + x != Real.0
        div_add_distrib(Real.1 + x, -Real.1, Real.1 + x)
        (Real.1 + x + -Real.1) / (Real.1 + x) =
            (Real.1 + x) / (Real.1 + x) + (-Real.1) / (Real.1 + x)
        Real.1 + x + -Real.1 = x + Real.1 + -Real.1
        x + Real.1 + -Real.1 = x + (Real.1 + -Real.1)
        Real.1 + -Real.1 = Real.0
        x + (Real.1 + -Real.1) = x + Real.0
        x + Real.0 = x
        Real.1 + x + -Real.1 = x
        x / (Real.1 + x) = (Real.1 + x) / (Real.1 + x) + (-Real.1) / (Real.1 + x)
        neg_div(Real.1, Real.1 + x)
        (-Real.1) / (Real.1 + x) = -(Real.1 / (Real.1 + x))
        (Real.1 + x) / (Real.1 + x) = Real.1
        x / (Real.1 + x) = Real.1 - Real.1 / (Real.1 + x)
        x / (Real.1 + x) <= log_or_zero(Real.1 + x)
    }
}

// =====================================================================
// Logarithm order characterizations
// =====================================================================

/// The logarithm preserves the strict order in both directions.
theorem log_or_zero_lt_iff(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (log_or_zero(x) < log_or_zero(y) iff x < y)
} by {
    if x > Real.0 and y > Real.0 {
        if log_or_zero(x) < log_or_zero(y) {
            log_lt_imp_lt(x, y)
            x < y
        }
        if x < y {
            log_strictly_increasing(x, y)
            log_or_zero(x) < log_or_zero(y)
        }
        log_or_zero(x) < log_or_zero(y) iff x < y
    }
}

/// The logarithm preserves the non-strict order in both directions.
theorem log_or_zero_le_iff(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (log_or_zero(x) <= log_or_zero(y) iff x <= y)
} by {
    if x > Real.0 and y > Real.0 {
        if log_or_zero(x) <= log_or_zero(y) {
            log_le_imp_le(x, y)
            x <= y
        }
        if x <= y {
            log_or_zero_monotone(x, y)
            log_or_zero(x) <= log_or_zero(y)
        }
        log_or_zero(x) <= log_or_zero(y) iff x <= y
    }
}

/// The logarithm is injective on positive reals in both directions.
theorem log_or_zero_eq_iff(x: Real, y: Real) {
    x > Real.0 and y > Real.0 implies (log_or_zero(x) = log_or_zero(y) iff x = y)
} by {
    if x > Real.0 and y > Real.0 {
        if log_or_zero(x) = log_or_zero(y) {
            log_injective(x, y)
            x = y
        }
        if x = y {
            log_or_zero(x) = log_or_zero(y)
        }
        log_or_zero(x) = log_or_zero(y) iff x = y
    }
}

// =====================================================================
// Logarithm sign characterizations
// =====================================================================

/// The logarithm is negative exactly between zero and one.
theorem log_or_zero_neg_iff_lt_one(x: Real) {
    x > Real.0 implies (log_or_zero(x) < Real.0 iff x < Real.1)
} by {
    if x > Real.0 {
        if log_or_zero(x) < Real.0 {
            exp_increasing(log_or_zero(x), Real.0)
            exp(log_or_zero(x)) < exp(Real.0)
            exp_zero
            exp(Real.0) = Real.1
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            exp_log_or_zero(x, lx)
            exp(lx) = x
            log_or_zero(x) = lx
            exp(log_or_zero(x)) = x
            x < Real.1
        }
        if x < Real.1 {
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            log_or_zero(x) = lx
            x.log = Option.some(log_or_zero(x))
            log_neg_of_pos_lt_one(x, log_or_zero(x))
            log_or_zero(x) < Real.0
        }
        log_or_zero(x) < Real.0 iff x < Real.1
    }
}

/// The logarithm is positive exactly above one.
theorem log_or_zero_pos_iff_gt_one(x: Real) {
    x > Real.0 implies (log_or_zero(x) > Real.0 iff x > Real.1)
} by {
    if x > Real.0 {
        if log_or_zero(x) > Real.0 {
            exp_increasing(Real.0, log_or_zero(x))
            exp(Real.0) < exp(log_or_zero(x))
            exp_zero
            exp(Real.0) = Real.1
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            exp_log_or_zero(x, lx)
            exp(lx) = x
            log_or_zero(x) = lx
            exp(log_or_zero(x)) = x
            Real.1 < x
            x > Real.1
        }
        if x > Real.1 {
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            log_or_zero(x) = lx
            x.log = Option.some(log_or_zero(x))
            log_pos_of_gt_one(x, log_or_zero(x))
            log_or_zero(x) > Real.0
        }
        log_or_zero(x) > Real.0 iff x > Real.1
    }
}

/// The logarithm is nonnegative exactly at or above one.
theorem log_or_zero_nonneg_iff_ge_one(x: Real) {
    x > Real.0 implies (log_or_zero(x) >= Real.0 iff x >= Real.1)
} by {
    if x > Real.0 {
        if log_or_zero(x) >= Real.0 {
            exp_monotone(Real.0, log_or_zero(x))
            exp(Real.0) <= exp(log_or_zero(x))
            exp_zero
            exp(Real.0) = Real.1
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            exp_log_or_zero(x, lx)
            exp(lx) = x
            log_or_zero(x) = lx
            exp(log_or_zero(x)) = x
            Real.1 <= x
            x >= Real.1
        }
        if x >= Real.1 {
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            log_or_zero(x) = lx
            x.log = Option.some(log_or_zero(x))
            log_nonneg_of_ge_one(x, log_or_zero(x))
            log_or_zero(x) >= Real.0
        }
        log_or_zero(x) >= Real.0 iff x >= Real.1
    }
}

/// The logarithm is nonpositive exactly between zero and one.
theorem log_or_zero_nonpos_iff_le_one(x: Real) {
    x > Real.0 implies (log_or_zero(x) <= Real.0 iff x <= Real.1)
} by {
    if x > Real.0 {
        if log_or_zero(x) <= Real.0 {
            exp_monotone(log_or_zero(x), Real.0)
            exp(log_or_zero(x)) <= exp(Real.0)
            exp_zero
            exp(Real.0) = Real.1
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            exp_log_or_zero(x, lx)
            exp(lx) = x
            log_or_zero(x) = lx
            exp(log_or_zero(x)) = x
            x <= Real.1
        }
        if x <= Real.1 {
            log_some_of_pos_exists(x)
            let lx: Real satisfy {
                x.log = Option.some(lx)
            }
            log_or_zero(x) = lx
            x.log = Option.some(log_or_zero(x))
            log_nonpos_of_pos_le_one(x, log_or_zero(x))
            log_or_zero(x) <= Real.0
        }
        log_or_zero(x) <= Real.0 iff x <= Real.1
    }
}

// =====================================================================
// Classical logarithm values
// =====================================================================

/// The logarithm of two is positive.
theorem log_or_zero_two_pos {
    log_or_zero(two) > Real.0
} by {
    Real.0 < Real.1
    lt_add_right(Real.0, Real.1, Real.1)
    Real.0 + Real.1 < Real.1 + Real.1
    Real.0 + Real.1 = Real.1
    Real.1 < Real.1 + Real.1
    Real.1 + Real.1 = two
    Real.1 < two
    lt_trans(Real.0, Real.1, two)
    Real.0 < two
    two > Real.0
    log_some_of_pos_exists(two)
    let lz: Real satisfy {
        two.log = Option.some(lz)
    }
    log_or_zero(two) = lz
    two.log = Option.some(log_or_zero(two))
    log_pos_of_gt_one(two, log_or_zero(two))
    log_or_zero(two) > Real.0
}

/// The logarithm of two is below one.
theorem log_or_zero_two_lt_one {
    log_or_zero(two) < Real.1
} by {
    e_gt_two
    Real.e > two
    two < Real.e
    Real.1 > Real.0
    lt_trans(Real.0, Real.1, two)
    Real.0 < two
    two > Real.0
    exp_pos(Real.1)
    exp(Real.1) > Real.0
    Real.e = exp(Real.1)
    Real.e > Real.0
    log_strictly_increasing(two, Real.e)
    log_or_zero(two) < log_or_zero(Real.e)
    log_or_zero_e
    log_or_zero(Real.e) = Real.1
    log_or_zero(two) < Real.1
}

/// The logarithm of the exponential of a negation is the negation.
theorem log_or_zero_exp_neg(x: Real) {
    log_or_zero(exp(-x)) = -x
} by {
    log_or_zero_exp(-x)
    log_or_zero(exp(-x)) = -x
}
