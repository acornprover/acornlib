                    List.cons(head, tail).contains(c) implies
                        exists(pre: List[V], suf: List[V]) {
                            List.cons(head, tail) = pre + suf and
                                simple_graph_walk(g, a, c, pre) and simple_graph_walk(g, c, b, suf)
