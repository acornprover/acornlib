                            (g.adj(a, head) and simple_graph_walk(g, head, c, pre))
                        g.adj(a, head)
                        simple_graph_walk(g, a, c, List.cons(head, pre))
                        exists(x: List[V], y: List[V]) {
                            List.cons(head, tail) = x + y and
