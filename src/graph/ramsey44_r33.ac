/// Three vertices of the six-set with equal edge colors to the first vertex.
define three_edges_from_a1_share_color(color: (Nat, Nat) -> Bool, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) -> Bool {
    exists(x: Nat, y: Nat, z: Nat) {
        w6_tail_member(x, a2, a3, a4, a5, a6) and w6_tail_member(y, a2, a3, a4, a5, a6) and w6_tail_member(z, a2, a3, a4, a5, a6)
        and x != y and x != z and y != z
        and color(a1, x) = color(a1, y) and color(a1, y) = color(a1, z)
    }
}

/// Three tail vertices with equal edge colors to the first vertex witness the pigeonhole.
theorem three_edges_from_a1_share_color_intro(color: (Nat, Nat) -> Bool, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat, x: Nat, y: Nat, z: Nat) {
    w6_tail_member(x, a2, a3, a4, a5, a6) and w6_tail_member(y, a2, a3, a4, a5, a6) and w6_tail_member(z, a2, a3, a4, a5, a6)
    and x != y and x != z and y != z
    and color(a1, x) = color(a1, y) and color(a1, y) = color(a1, z)
    implies three_edges_from_a1_share_color(color, a1, a2, a3, a4, a5, a6)
} by {
    if w6_tail_member(x, a2, a3, a4, a5, a6) and w6_tail_member(y, a2, a3, a4, a5, a6) and w6_tail_member(z, a2, a3, a4, a5, a6)
        and x != y and x != z and y != z
        and color(a1, x) = color(a1, y) and color(a1, y) = color(a1, z) {
        three_edges_from_a1_share_color(color, a1, a2, a3, a4, a5, a6) = exists(b: Nat, c: Nat, d: Nat) {
            w6_tail_member(b, a2, a3, a4, a5, a6) and w6_tail_member(c, a2, a3, a4, a5, a6) and w6_tail_member(d, a2, a3, a4, a5, a6)
            and b != c and b != d and c != d
            and color(a1, b) = color(a1, c) and color(a1, c) = color(a1, d)
        }
        exists_intro(function(b: Nat) {
            exists(c: Nat, d: Nat) {
                w6_tail_member(b, a2, a3, a4, a5, a6) and w6_tail_member(c, a2, a3, a4, a5, a6) and w6_tail_member(d, a2, a3, a4, a5, a6)
                and b != c and b != d and c != d
                and color(a1, b) = color(a1, c) and color(a1, c) = color(a1, d)
            }
        }, x)
        exists_intro(function(c: Nat) {
            exists(d: Nat) {
                w6_tail_member(x, a2, a3, a4, a5, a6) and w6_tail_member(c, a2, a3, a4, a5, a6) and w6_tail_member(d, a2, a3, a4, a5, a6)
                and x != c and x != d and c != d
                and color(a1, x) = color(a1, c) and color(a1, c) = color(a1, d)
            }
        }, y)
        exists_intro(function(d: Nat) {
            w6_tail_member(x, a2, a3, a4, a5, a6) and w6_tail_member(y, a2, a3, a4, a5, a6) and w6_tail_member(d, a2, a3, a4, a5, a6)
            and x != y and x != d and y != d
            and color(a1, x) = color(a1, y) and color(a1, y) = color(a1, d)
        }, z)
        exists(b: Nat, c: Nat, d: Nat) {
            w6_tail_member(b, a2, a3, a4, a5, a6) and w6_tail_member(c, a2, a3, a4, a5, a6) and w6_tail_member(d, a2, a3, a4, a5, a6)
            and b != c and b != d and c != d
            and color(a1, b) = color(a1, c) and color(a1, c) = color(a1, d)
        }
        three_edges_from_a1_share_color(color, a1, a2, a3, a4, a5, a6)
    }
}

/// The pigeonhole conclusion can be unpacked.
theorem three_edges_from_a1_share_color_witness(color: (Nat, Nat) -> Bool, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) {
    three_edges_from_a1_share_color(color, a1, a2, a3, a4, a5, a6) implies exists(x: Nat, y: Nat, z: Nat) {
        w6_tail_member(x, a2, a3, a4, a5, a6) and w6_tail_member(y, a2, a3, a4, a5, a6) and w6_tail_member(z, a2, a3, a4, a5, a6)
        and x != y and x != z and y != z
        and color(a1, x) = color(a1, y) and color(a1, y) = color(a1, z)
    }
} by {
    if three_edges_from_a1_share_color(color, a1, a2, a3, a4, a5, a6) {
        three_edges_from_a1_share_color(color, a1, a2, a3, a4, a5, a6) = exists(b: Nat, c: Nat, d: Nat) {
            w6_tail_member(b, a2, a3, a4, a5, a6) and w6_tail_member(c, a2, a3, a4, a5, a6) and w6_tail_member(d, a2, a3, a4, a5, a6)
            and b != c and b != d and c != d
            and color(a1, b) = color(a1, c) and color(a1, c) = color(a1, d)
        }
        exists(b: Nat, c: Nat, d: Nat) {
            w6_tail_member(b, a2, a3, a4, a5, a6) and w6_tail_member(c, a2, a3, a4, a5, a6) and w6_tail_member(d, a2, a3, a4, a5, a6)
            and b != c and b != d and c != d
            and color(a1, b) = color(a1, c) and color(a1, c) = color(a1, d)
        }
    }
}

