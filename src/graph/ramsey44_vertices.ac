from nat import Nat
from finite_set import FiniteSet
from data.nat.nat_range_set import range_set, range_set_contains
from graph.simple_graph import complete_graph, complete_graph_adj_iff_ne
from graph.simple_graph_degree import neighborhood, neighborhood_contains_eq
from graph.ramsey44_labels import eighteen_labels_lt_bound

numerals Nat

/// The eighteen vertices `{0, ..., 17}` on which the upper bound R(4, 4) <= 18 lives.
let eighteen_vertices: FiniteSet[Nat] = range_set(Nat.18)

/// The seventeen vertices `{0, ..., 16}` on which the lower bound R(4, 4) > 17 lives.
let seventeen_vertices: FiniteSet[Nat] = range_set(Nat.17)

/// A natural below eighteen is a vertex of the eighteen-element set.
theorem eighteen_vertices_contains(x: Nat) {
    x < Nat.18 implies eighteen_vertices.contains(x)
} by {
    if x < Nat.18 {
        range_set_contains(Nat.18, x)
        range_set(Nat.18).contains(x)
        eighteen_vertices.contains(x)
    }
}

/// A natural below seventeen is a vertex of the seventeen-element set.
theorem seventeen_vertices_contains(x: Nat) {
    x < Nat.17 implies seventeen_vertices.contains(x)
} by {
    if x < Nat.17 {
        range_set_contains(Nat.17, x)
        range_set(Nat.17).contains(x)
        seventeen_vertices.contains(x)
    }
}

/// A vertex of the eighteen-element set other than zero is a neighbour of zero in the
/// complete graph.
theorem eighteen_neighbor_of_zero(x: Nat) {
    eighteen_vertices.contains(x) and x != Nat.0 implies
        neighborhood(complete_graph[Nat], eighteen_vertices, Nat.0).contains(x)
} by {
    if eighteen_vertices.contains(x) and x != Nat.0 {
        neighborhood_contains_eq(complete_graph[Nat], eighteen_vertices, Nat.0, x)
        (neighborhood(complete_graph[Nat], eighteen_vertices, Nat.0).contains(x)
            = (eighteen_vertices.contains(x) and complete_graph[Nat].adj(Nat.0, x)))
        complete_graph_adj_iff_ne[Nat](Nat.0, x)
        complete_graph[Nat].adj(Nat.0, x) = (Nat.0 != x)
        eighteen_vertices.contains(x)
        complete_graph[Nat].adj(Nat.0, x)
        neighborhood(complete_graph[Nat], eighteen_vertices, Nat.0).contains(x)
    }
}

/// Every positive label is below eighteen.
theorem positive_labels_lt_18 {
    Nat.1 < Nat.18 and Nat.2 < Nat.18 and Nat.3 < Nat.18 and Nat.4 < Nat.18 and Nat.5 < Nat.18
    and Nat.6 < Nat.18 and Nat.7 < Nat.18 and Nat.8 < Nat.18 and Nat.9 < Nat.18 and Nat.10 < Nat.18
    and Nat.11 < Nat.18 and Nat.12 < Nat.18 and Nat.13 < Nat.18 and Nat.14 < Nat.18
    and Nat.15 < Nat.18 and Nat.16 < Nat.18 and Nat.17 < Nat.18
} by {
    eighteen_labels_lt_bound
    Nat.1 < Nat.18
    Nat.2 < Nat.18
    Nat.3 < Nat.18
    Nat.4 < Nat.18
    Nat.5 < Nat.18
    Nat.6 < Nat.18
    Nat.7 < Nat.18
    Nat.8 < Nat.18
    Nat.9 < Nat.18
    Nat.10 < Nat.18
    Nat.11 < Nat.18
    Nat.12 < Nat.18
    Nat.13 < Nat.18
    Nat.14 < Nat.18
    Nat.15 < Nat.18
    Nat.16 < Nat.18
    Nat.17 < Nat.18
}

/// Every positive label is a vertex of the eighteen-element set.
theorem positive_vertices_contains_18(x: Nat) {
    (x = Nat.1 or x = Nat.2 or x = Nat.3 or x = Nat.4 or x = Nat.5 or x = Nat.6 or x = Nat.7
        or x = Nat.8 or x = Nat.9 or x = Nat.10 or x = Nat.11 or x = Nat.12 or x = Nat.13
        or x = Nat.14 or x = Nat.15 or x = Nat.16 or x = Nat.17)
    implies eighteen_vertices.contains(x)
} by {
    if x = Nat.1 or x = Nat.2 or x = Nat.3 or x = Nat.4 or x = Nat.5 or x = Nat.6 or x = Nat.7
        or x = Nat.8 or x = Nat.9 or x = Nat.10 or x = Nat.11 or x = Nat.12 or x = Nat.13
        or x = Nat.14 or x = Nat.15 or x = Nat.16 or x = Nat.17 {
        if x = Nat.1 {
            Nat.1 < Nat.18
            eighteen_vertices_contains(x)
            eighteen_vertices.contains(x)
        } else {
            if x = Nat.2 {
                Nat.2 < Nat.18
                eighteen_vertices_contains(x)
                eighteen_vertices.contains(x)
            } else {
                if x = Nat.3 {
                    Nat.3 < Nat.18
                    eighteen_vertices_contains(x)
                    eighteen_vertices.contains(x)
                } else {
                    if x = Nat.4 {
                        Nat.4 < Nat.18
                        eighteen_vertices_contains(x)
                        eighteen_vertices.contains(x)
                    } else {
                        if x = Nat.5 {
                            Nat.5 < Nat.18
                            eighteen_vertices_contains(x)
                            eighteen_vertices.contains(x)
                        } else {
                            if x = Nat.6 {
                                Nat.6 < Nat.18
                                eighteen_vertices_contains(x)
                                eighteen_vertices.contains(x)
                            } else {
                                if x = Nat.7 {
                                    Nat.7 < Nat.18
                                    eighteen_vertices_contains(x)
                                    eighteen_vertices.contains(x)
                                } else {
                                    if x = Nat.8 {
                                        Nat.8 < Nat.18
                                        eighteen_vertices_contains(x)
                                        eighteen_vertices.contains(x)
                                    } else {
                                        if x = Nat.9 {
                                            Nat.9 < Nat.18
                                            eighteen_vertices_contains(x)
                                            eighteen_vertices.contains(x)
                                        } else {
                                            if x = Nat.10 {
                                                Nat.10 < Nat.18
                                                eighteen_vertices_contains(x)
                                                eighteen_vertices.contains(x)
                                            } else {
                                                if x = Nat.11 {
                                                    Nat.11 < Nat.18
                                                    eighteen_vertices_contains(x)
                                                    eighteen_vertices.contains(x)
                                                } else {
                                                    if x = Nat.12 {
                                                        Nat.12 < Nat.18
                                                        eighteen_vertices_contains(x)
                                                        eighteen_vertices.contains(x)
                                                    } else {
                                                        if x = Nat.13 {
                                                            Nat.13 < Nat.18
                                                            eighteen_vertices_contains(x)
                                                            eighteen_vertices.contains(x)
                                                        } else {
                                                            if x = Nat.14 {
                                                                Nat.14 < Nat.18
                                                                eighteen_vertices_contains(x)
                                                                eighteen_vertices.contains(x)
                                                            } else {
                                                                if x = Nat.15 {
                                                                    Nat.15 < Nat.18
                                                                    eighteen_vertices_contains(x)
                                                                    eighteen_vertices.contains(x)
                                                                } else {
                                                                    if x = Nat.16 {
                                                                        Nat.16 < Nat.18
                                                                        eighteen_vertices_contains(x)
                                                                        eighteen_vertices.contains(x)
                                                                    } else {
                                                                        Nat.17 < Nat.18
                                                                        eighteen_vertices_contains(x)
                                                                        eighteen_vertices.contains(x)
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
