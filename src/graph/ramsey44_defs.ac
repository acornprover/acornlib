/// True of four distinct vertices of the nine-set spanning a red K4.
define red_k4_in_w9(color: (Nat, Nat) -> Bool, w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
