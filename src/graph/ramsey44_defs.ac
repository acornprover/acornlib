            w6_member(a, a1, a2, a3, a4, a5, a6) and w6_member(b, a1, a2, a3, a4, a5, a6) and w6_member(c, a1, a2, a3, a4, a5, a6)
            and a != b and a != c and b != c
            and not color(a, b) and not color(a, c) and not color(b, c)
        }
        blue_k3_in_w6(color, a1, a2, a3, a4, a5, a6)
    }
}

