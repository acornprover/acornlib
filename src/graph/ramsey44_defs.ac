}

/// Row 5: the vertex w5 is distinct from every later vertex.
define good_nine_row5(w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    w5 != w6 and w5 != w7 and w5 != w8 and w5 != w9
}

/// Row 6: the vertex w6 is distinct from every later vertex.
define good_nine_row6(w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    w6 != w7 and w6 != w8 and w6 != w9
}

/// Row 7: the vertex w7 is distinct from every later vertex.
define good_nine_row7(w7: Nat, w8: Nat, w9: Nat) -> Bool {
    w7 != w8 and w7 != w9
}

/// Row 8: the vertex w8 is distinct from every later vertex.
define good_nine_row8(w8: Nat, w9: Nat) -> Bool {
    w8 != w9
}

/// The 9 vertices are pairwise distinct.
define good_nine(w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    good_nine_row1(w1, w2, w3, w4, w5, w6, w7, w8, w9) and good_nine_row2(w2, w3, w4, w5, w6, w7, w8, w9) and good_nine_row3(w3, w4, w5, w6, w7, w8, w9) and good_nine_row4(w4, w5, w6, w7, w8, w9) and good_nine_row5(w5, w6, w7, w8, w9) and good_nine_row6(w6, w7, w8, w9) and good_nine_row7(w7, w8, w9) and good_nine_row8(w8, w9)
}

/// Row 1: the vertex a1 is distinct from every later vertex.
define good_six_row1(a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) -> Bool {
