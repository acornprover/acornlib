theorem blue_k3_in_w6_intro(color: (Nat, Nat) -> Bool, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat, x: Nat, y: Nat, z: Nat) {
    w6_member(x, a1, a2, a3, a4, a5, a6) and w6_member(y, a1, a2, a3, a4, a5, a6) and w6_member(z, a1, a2, a3, a4, a5, a6)
    and x != y and x != z and y != z
    and not color(x, y) and not color(x, z) and not color(y, z)
    implies blue_k3_in_w6(color, a1, a2, a3, a4, a5, a6)
} by {
    if w6_member(x, a1, a2, a3, a4, a5, a6) and w6_member(y, a1, a2, a3, a4, a5, a6) and w6_member(z, a1, a2, a3, a4, a5, a6)
        and x != y and x != z and y != z
        and not color(x, y) and not color(x, z) and not color(y, z) {
        blue_k3_in_w6(color, a1, a2, a3, a4, a5, a6) = exists(a: Nat, b: Nat, c: Nat) {
            w6_member(a, a1, a2, a3, a4, a5, a6) and w6_member(b, a1, a2, a3, a4, a5, a6) and w6_member(c, a1, a2, a3, a4, a5, a6)
            and a != b and a != c and b != c
            and not color(a, b) and not color(a, c) and not color(b, c)
        }
        exists_intro(function(a: Nat) {
            exists(b: Nat, c: Nat) {
                w6_member(a, a1, a2, a3, a4, a5, a6) and w6_member(b, a1, a2, a3, a4, a5, a6) and w6_member(c, a1, a2, a3, a4, a5, a6)
                and a != b and a != c and b != c
                and not color(a, b) and not color(a, c) and not color(b, c)
            }
        }, x)
        exists_intro(function(b: Nat) {
            exists(c: Nat) {
                w6_member(x, a1, a2, a3, a4, a5, a6) and w6_member(b, a1, a2, a3, a4, a5, a6) and w6_member(c, a1, a2, a3, a4, a5, a6)
                and x != b and x != c and b != c
                and not color(x, b) and not color(x, c) and not color(b, c)
            }
        }, y)
        exists_intro(function(c: Nat) {
            w6_member(x, a1, a2, a3, a4, a5, a6) and w6_member(y, a1, a2, a3, a4, a5, a6) and w6_member(c, a1, a2, a3, a4, a5, a6)
            and x != y and x != c and y != c
