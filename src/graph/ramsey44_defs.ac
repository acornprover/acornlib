/// Three vertices of the w9-set spanning a triangle witness the predicate.
theorem red_k3_in_w9_intro(color: (Nat, Nat) -> Bool, w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat, x: Nat, y: Nat, z: Nat) {
    w9_member(x, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(y, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(z, w1, w2, w3, w4, w5, w6, w7, w8, w9)
    and x != y and x != z and y != z
    and color(x, y) and color(x, z) and color(y, z)
    implies red_k3_in_w9(color, w1, w2, w3, w4, w5, w6, w7, w8, w9)
} by {
    if w9_member(x, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(y, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(z, w1, w2, w3, w4, w5, w6, w7, w8, w9)
        and x != y and x != z and y != z
        and color(x, y) and color(x, z) and color(y, z) {
        red_k3_in_w9(color, w1, w2, w3, w4, w5, w6, w7, w8, w9) = exists(a: Nat, b: Nat, c: Nat) {
            w9_member(a, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(b, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(c, w1, w2, w3, w4, w5, w6, w7, w8, w9)
            and a != b and a != c and b != c
            and color(a, b) and color(a, c) and color(b, c)
        }
        exists_intro(function(a: Nat) {
            exists(b: Nat, c: Nat) {
                w9_member(a, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(b, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(c, w1, w2, w3, w4, w5, w6, w7, w8, w9)
                and a != b and a != c and b != c
                and color(a, b) and color(a, c) and color(b, c)
            }
        }, x)
        exists_intro(function(b: Nat) {
            exists(c: Nat) {
                w9_member(x, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(b, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(c, w1, w2, w3, w4, w5, w6, w7, w8, w9)
                and x != b and x != c and b != c
                and color(x, b) and color(x, c) and color(b, c)
            }
        }, y)
        exists_intro(function(c: Nat) {
            w9_member(x, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(y, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(c, w1, w2, w3, w4, w5, w6, w7, w8, w9)
            and x != y and x != c and y != c
            and color(x, y) and color(x, c) and color(y, c)
        }, z)
        exists(a: Nat, b: Nat, c: Nat) {
            w9_member(a, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(b, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(c, w1, w2, w3, w4, w5, w6, w7, w8, w9)
            and a != b and a != c and b != c
            and color(a, b) and color(a, c) and color(b, c)
        }
        red_k3_in_w9(color, w1, w2, w3, w4, w5, w6, w7, w8, w9)
    }
}

