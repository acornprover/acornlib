        and x != y and x != z and x != t and y != z and y != t and z != t
        and color(x, y) and color(x, z) and color(x, t) and color(y, z) and color(y, t) and color(z, t)
    }
}

/// True of four distinct vertices of the nine-set spanning a blue K4.
define blue_k4_in_w9(color: (Nat, Nat) -> Bool, w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
