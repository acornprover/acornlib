/// True of three distinct vertices of the w9-set spanning a red triangle.
define red_k3_in_w9(color: (Nat, Nat) -> Bool, w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    exists(x: Nat, y: Nat, z: Nat) {
        w9_member(x, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(y, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(z, w1, w2, w3, w4, w5, w6, w7, w8, w9)
        and x != y and x != z and y != z
        and color(x, y) and color(x, z) and color(y, z)
    }
}

/// True of three distinct vertices of the w9-set spanning a blue triangle.
define blue_k3_in_w9(color: (Nat, Nat) -> Bool, w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    exists(x: Nat, y: Nat, z: Nat) {
        w9_member(x, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(y, w1, w2, w3, w4, w5, w6, w7, w8, w9) and w9_member(z, w1, w2, w3, w4, w5, w6, w7, w8, w9)
        and x != y and x != z and y != z
        and not color(x, y) and not color(x, z) and not color(y, z)
    }
}

