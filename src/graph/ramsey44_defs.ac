from nat import Nat
from data.basic.logic import exists_intro

numerals Nat

/// True of a member of the 9 vertices `{w1, w2, w3, w4, w5, w6, w7, w8, w9}`.
define w9_member(x: Nat, w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    x = w1 or x = w2 or x = w3 or x = w4 or x = w5 or x = w6 or x = w7 or x = w8 or x = w9
}

/// True of a member of the 6 vertices `{a1, a2, a3, a4, a5, a6}`.
define w6_member(x: Nat, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) -> Bool {
    x = a1 or x = a2 or x = a3 or x = a4 or x = a5 or x = a6
}

/// Row 1: the vertex w1 is distinct from every later vertex.
define good_nine_row1(w1: Nat, w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    w1 != w2 and w1 != w3 and w1 != w4 and w1 != w5 and w1 != w6 and w1 != w7 and w1 != w8 and w1 != w9
}

/// Row 2: the vertex w2 is distinct from every later vertex.
define good_nine_row2(w2: Nat, w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
    w2 != w3 and w2 != w4 and w2 != w5 and w2 != w6 and w2 != w7 and w2 != w8 and w2 != w9
}

/// Row 3: the vertex w3 is distinct from every later vertex.
define good_nine_row3(w3: Nat, w4: Nat, w5: Nat, w6: Nat, w7: Nat, w8: Nat, w9: Nat) -> Bool {
