/// True of a member of the five vertices `{a2, ..., a6}`.
define w6_tail_member(x: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) -> Bool {
    x = a2 or x = a3 or x = a4 or x = a5 or x = a6
}

/// A tail member of the six-set is a member of the six-set.
theorem w6_tail_member_implies_member(x: Nat, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) {
    w6_tail_member(x, a2, a3, a4, a5, a6) implies w6_member(x, a1, a2, a3, a4, a5, a6)
} by {
    if w6_tail_member(x, a2, a3, a4, a5, a6) {
        if x = a2 {
            w6_member(x, a1, a2, a3, a4, a5, a6) = (x = a1 or x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
            w6_member(x, a1, a2, a3, a4, a5, a6)
        } else {
            if x = a3 {
                w6_member(x, a1, a2, a3, a4, a5, a6) = (x = a1 or x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                w6_member(x, a1, a2, a3, a4, a5, a6)
            } else {
                if x = a4 {
                    w6_member(x, a1, a2, a3, a4, a5, a6) = (x = a1 or x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                    w6_member(x, a1, a2, a3, a4, a5, a6)
                } else {
                    if x = a5 {
                        w6_member(x, a1, a2, a3, a4, a5, a6) = (x = a1 or x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                        w6_member(x, a1, a2, a3, a4, a5, a6)
                    } else {
                        w6_tail_member(x, a2, a3, a4, a5, a6) = (x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                        (x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                        if x = a2 {
                            x = a2
                            false
                        } else {
                            if x = a3 {
                                x = a3
                                false
                            } else {
                                if x = a4 {
                                    x = a4
                                    false
                                } else {
                                    if x = a5 {
                                        x = a5
                                        false
                                    } else {
                                        x = a6
                                    }
                                }
                            }
                        }
                        w6_member(x, a1, a2, a3, a4, a5, a6) = (x = a1 or x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                        w6_member(x, a1, a2, a3, a4, a5, a6)
                    }
                }
            }
        }
    }
}

/// The first vertex is distinct from every other vertex of a good six-set.
theorem good_six_row1_all(a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) {
    good_six(a1, a2, a3, a4, a5, a6) implies (a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6)
} by {
    if good_six(a1, a2, a3, a4, a5, a6) {
        good_six(a1, a2, a3, a4, a5, a6) = (good_six_row1(a1, a2, a3, a4, a5, a6) and good_six_row2(a2, a3, a4, a5, a6) and good_six_row3(a3, a4, a5, a6) and good_six_row4(a4, a5, a6) and good_six_row5(a5, a6))
        good_six_row1(a1, a2, a3, a4, a5, a6) and good_six_row2(a2, a3, a4, a5, a6) and good_six_row3(a3, a4, a5, a6) and good_six_row4(a4, a5, a6) and good_six_row5(a5, a6)
        good_six_row1(a1, a2, a3, a4, a5, a6)
        good_six_row1(a1, a2, a3, a4, a5, a6) = (a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6)
        a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6
        a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6
    }
}

/// A tail member distinct from the first vertex in every coordinate is not the first vertex.
theorem distinct_all_implies_tail_member_ne_a1(x: Nat, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) {
    a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6 and w6_tail_member(x, a2, a3, a4, a5, a6) implies x != a1
} by {
    if a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6 and w6_tail_member(x, a2, a3, a4, a5, a6) {
        if x = a2 {
            a1 != a2
            x != a1
        } else {
            if x = a3 {
                a1 != a3
                x != a1
            } else {
                if x = a4 {
                    a1 != a4
                    x != a1
                } else {
                    if x = a5 {
                        a1 != a5
                        x != a1
                    } else {
                        w6_tail_member(x, a2, a3, a4, a5, a6) = (x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                        (x = a2 or x = a3 or x = a4 or x = a5 or x = a6)
                        if x = a2 {
                            x = a2
                            false
                        } else {
                            if x = a3 {
                                x = a3
                                false
                            } else {
                                if x = a4 {
                                    x = a4
                                    false
                                } else {
                                    if x = a5 {
                                        x = a5
                                        false
                                    } else {
                                        x = a6
                                        a1 != a6
                                        x != a1
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

/// A tail member of the six-set is distinct from the first vertex.
theorem tail_member_ne_a1(x: Nat, a1: Nat, a2: Nat, a3: Nat, a4: Nat, a5: Nat, a6: Nat) {
    good_six(a1, a2, a3, a4, a5, a6) and w6_tail_member(x, a2, a3, a4, a5, a6) implies x != a1
} by {
    if good_six(a1, a2, a3, a4, a5, a6) and w6_tail_member(x, a2, a3, a4, a5, a6) {
        good_six_row1_all(a1, a2, a3, a4, a5, a6)
        good_six(a1, a2, a3, a4, a5, a6) implies (a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6)
        a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6
        a1 != a2 and a1 != a3 and a1 != a4 and a1 != a5 and a1 != a6 and w6_tail_member(x, a2, a3, a4, a5, a6)
        distinct_all_implies_tail_member_ne_a1(x, a1, a2, a3, a4, a5, a6)
        x != a1
    }
}