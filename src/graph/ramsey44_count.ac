/// Filtering by a predicate and its negation partitions the list.
///
/// Every element is kept by exactly one of the two filters, so the filtered lengths add
/// to the original length.
theorem filter_partition_length[T](list: List[T], p: T -> Bool) {
    list.filter(p).length + list.filter(function(x: T) { not p(x) }).length = list.length
} by {
    define f(l: List[T]) -> Bool {
        l.filter(p).length + l.filter(function(x: T) { not p(x) }).length = l.length
    }

    f(List.nil[T])

    forall(head: T, tail: List[T]) {
        if f(tail) {
            f(tail) = (tail.filter(p).length + tail.filter(function(x: T) { not p(x) }).length = tail.length)
            tail.filter(p).length + tail.filter(function(x: T) { not p(x) }).length = tail.length
            if p(head) {
                List.cons(head, tail).filter(p) = List.cons(head, tail.filter(p))
                List.cons(head, tail).filter(p).length = List.cons(head, tail.filter(p)).length
                List.cons(head, tail.filter(p)).length = tail.filter(p).length.suc
                List.cons(head, tail).filter(p).length = tail.filter(p).length.suc
                not (not p(head))
                List.cons(head, tail).filter(function(x: T) { not p(x) }) = tail.filter(function(x: T) { not p(x) })
                List.cons(head, tail).filter(function(x: T) { not p(x) }).length = tail.filter(function(x: T) { not p(x) }).length
                List.cons(head, tail).length = tail.length.suc
                tail.filter(p).length.suc + tail.filter(function(x: T) { not p(x) }).length = tail.length.suc
                List.cons(head, tail).filter(p).length + List.cons(head, tail).filter(function(x: T) { not p(x) }).length = List.cons(head, tail).length
                f(List.cons(head, tail))
            } else {
                not p(head)
                List.cons(head, tail).filter(p) = tail.filter(p)
                List.cons(head, tail).filter(p).length = tail.filter(p).length
                List.cons(head, tail).filter(function(x: T) { not p(x) }) = List.cons(head, tail.filter(function(x: T) { not p(x) }))
                List.cons(head, tail).filter(function(x: T) { not p(x) }).length = List.cons(head, tail.filter(function(x: T) { not p(x) })).length
                List.cons(head, tail.filter(function(x: T) { not p(x) })).length = tail.filter(function(x: T) { not p(x) }).length.suc
                List.cons(head, tail).filter(function(x: T) { not p(x) }).length = tail.filter(function(x: T) { not p(x) }).length.suc
                List.cons(head, tail).length = tail.length.suc
                tail.filter(p).length + tail.filter(function(x: T) { not p(x) }).length.suc = tail.length.suc
                List.cons(head, tail).filter(p).length + List.cons(head, tail).filter(function(x: T) { not p(x) }).length = List.cons(head, tail).length
                f(List.cons(head, tail))
            }
        }
    }

    f(list)
    list.filter(p).length + list.filter(function(x: T) { not p(x) }).length = list.length
}

/// A natural greater than zero is the successor of its predecessor.
theorem suc_pred_of_gt_zero(a: Nat) {
    a > Nat.0 implies (a - Nat.1) + Nat.1 = a
} by {
    if a > Nat.0 {
        Nat.1 <= a
        add_sub(a, Nat.1)
        a - Nat.1 + Nat.1 = a
    }
}

/// Equal predecessors of positive naturals are equal.
theorem sub_eq_sub_imp_eq(a: Nat, b: Nat) {
    a > Nat.0 and b > Nat.0 and a - Nat.1 = b - Nat.1 implies a = b
} by {
    if a > Nat.0 and b > Nat.0 and a - Nat.1 = b - Nat.1 {
        a - Nat.1 + Nat.1 = b - Nat.1 + Nat.1
        suc_pred_of_gt_zero(a)
        a - Nat.1 + Nat.1 = a
        suc_pred_of_gt_zero(b)
        b - Nat.1 + Nat.1 = b
        a = b
    }
}

/// A natural not greater than zero is zero.
theorem not_gt_zero_imp_zero(a: Nat) {
    not (a > Nat.0) implies a = Nat.0
} by {
    if not (a > Nat.0) {
        zero_or_suc(a)
        if a = Nat.0 {
            a = Nat.0
        } else {
            a != Nat.0
            exists(b: Nat) { a = b.suc }
            let (b: Nat) satisfy { a = b.suc }
            b.suc > Nat.0
            a > Nat.0
            false
        }
    }
}

/// Indexing a cons at zero names the head.
theorem get_idx_zero_cons[T](head: T, tail: List[T]) {
    List.cons(head, tail).get_idx(Nat.0) = Option.some(head)
} by {
    List.cons(head, tail).get_idx(Nat.0) = Option.some(head)
}

/// Indexing a cons at a successor looks into the tail.
theorem get_idx_suc_cons[T](head: T, tail: List[T], k: Nat) {
    List.cons(head, tail).get_idx(k + Nat.1) = tail.get_idx(k)
} by {
    k + Nat.1 > Nat.0
    List.cons(head, tail).get_idx(k + Nat.1) = tail.get_idx(k + Nat.1 - Nat.1)
    k + Nat.1 - Nat.1 = k
    List.cons(head, tail).get_idx(k + Nat.1) = tail.get_idx(k)
}

/// An index at or beyond the length names no element.
theorem get_idx_out_of_bounds_self[T](list: List[T], idx: Nat, x: T) {
    idx >= list.length implies not (list.get_idx(idx) = Option.some(x))
} by {
    if idx >= list.length {
        define p(l: List[T]) -> Bool {
            forall(i: Nat) {
                i >= l.length implies not (l.get_idx(i) = Option.some(x))
            }
        }

        p(List.nil[T]) = forall(i: Nat) {
            i >= List.nil[T].length implies not (List.nil[T].get_idx(i) = Option.some(x))
        }
        forall(i: Nat) {
            if i >= List.nil[T].length {
                List.nil[T].get_idx(i) = Option.none[T]
                if List.nil[T].get_idx(i) = Option.some(x) {
                    List.nil[T].get_idx(i) = Option.none[T]
                    match Option.none[T] {
                        Option.none {
                            false
                        }
                        Option.some(u) {
                            false
                        }
                    }
                }
                not (List.nil[T].get_idx(i) = Option.some(x))
            }
            i >= List.nil[T].length implies not (List.nil[T].get_idx(i) = Option.some(x))
        }
        p(List.nil[T])

        forall(head: T, tail: List[T]) {
            if p(tail) {
                forall(i: Nat) {
                    if i >= List.cons(head, tail).length {
                        List.cons(head, tail).length = tail.length.suc
                        i >= tail.length.suc
                        tail.length < tail.length.suc
                        lt_and_lte(tail.length, tail.length.suc, i)
                        tail.length < i
                        Nat.0 <= tail.length
                        lte_and_lt(Nat.0, tail.length, i)
                        Nat.0 < i
                        i > Nat.0
                        List.cons(head, tail).get_idx(i) = tail.get_idx(i - Nat.1)
                        suc_pred_of_gt_zero(i)
                        i = (i - Nat.1) + Nat.1
                        tail.length.suc = tail.length + Nat.1
                        i >= tail.length + Nat.1
                        (i - Nat.1) + Nat.1 >= tail.length + Nat.1
                        lte_cancel_suc(tail.length, i - Nat.1)
                        tail.length <= i - Nat.1
                        i - Nat.1 >= tail.length
                        not (tail.get_idx(i - Nat.1) = Option.some(x))
                        if List.cons(head, tail).get_idx(i) = Option.some(x) {
                            List.cons(head, tail).get_idx(i) = tail.get_idx(i - Nat.1)
                            tail.get_idx(i - Nat.1) = Option.some(x)
                            false
                        }
                        not (List.cons(head, tail).get_idx(i) = Option.some(x))
                    }
                    i >= List.cons(head, tail).length implies not (List.cons(head, tail).get_idx(i) = Option.some(x))
                }
                p(List.cons(head, tail))
            }
        }

        List.induction(function(l: List[T]) { p(l) })
        forall(l: List[T]) { p(l) }
        p(list)
        idx >= list.length implies not (list.get_idx(idx) = Option.some(x))
        not (list.get_idx(idx) = Option.some(x))
    }
}

/// Every index below the length names an element.
theorem get_idx_always_some[T](list: List[T], idx: Nat) {
    idx < list.length implies exists(x: T) {
        list.get_idx(idx) = Option.some(x)
    }
} by {
    define p(l: List[T]) -> Bool {
        forall(i: Nat) {
            i < l.length implies exists(x: T) {
                l.get_idx(i) = Option.some(x)
            }
        }
    }

    p(List.nil[T])

    forall(head: T, tail: List[T]) {
        if p(tail) {
            forall(i: Nat) {
                if i < List.cons(head, tail).length {
                    zero_or_suc(i)
                    if i = Nat.0 {
                        List.cons(head, tail).get_idx(Nat.0) = Option.some(head)
                        List.cons(head, tail).get_idx(i) = Option.some(head)
                        exists(x: T) {
                            List.cons(head, tail).get_idx(i) = Option.some(x)
                        }
                    } else {
                        i != Nat.0
                        exists(k: Nat) { i = k.suc }
                        let (k: Nat) satisfy { i = k.suc }
                        i = k + Nat.1
                        k.suc < List.cons(head, tail).length
                        List.cons(head, tail).length = tail.length.suc
                        k.suc < tail.length.suc
                        lt_cancel_suc(k, tail.length)
                        k < tail.length
                        exists(x: T) {
                            tail.get_idx(k) = Option.some(x)
                        }
                        let (u: T) satisfy { tail.get_idx(k) = Option.some(u) }
                        get_idx_suc_cons(head, tail, k)
                        List.cons(head, tail).get_idx(k + Nat.1) = tail.get_idx(k)
                        List.cons(head, tail).get_idx(i) = Option.some(u)
                        exists(x: T) {
                            List.cons(head, tail).get_idx(i) = Option.some(x)
                        }
                    }
                }
                i < List.cons(head, tail).length implies exists(x: T) {
                    List.cons(head, tail).get_idx(i) = Option.some(x)
                }
            }
            p(List.cons(head, tail)) = forall(i: Nat) {
                i < List.cons(head, tail).length implies exists(x: T) {
                    List.cons(head, tail).get_idx(i) = Option.some(x)
                }
            }
            p(List.cons(head, tail))
        }
    }

    List.induction(function(l: List[T]) { p(l) })
    forall(l: List[T]) { p(l) }
    idx < list.length implies exists(x: T) {
        list.get_idx(idx) = Option.some(x)
    }
}

/// An indexed element below the length is a member of the list.
theorem get_idx_implies_contains_lt[T](list: List[T], idx: Nat, x: T) {
    idx < list.length implies (list.get_idx(idx) = Option.some(x) implies list.contains(x))
} by {
    define p(l: List[T]) -> Bool {
        forall(i: Nat) {
            i < l.length implies (l.get_idx(i) = Option.some(x) implies l.contains(x))
        }
    }

    p(List.nil[T])

    forall(head: T, tail: List[T]) {
        if p(tail) {
            forall(i: Nat) {
                if i < List.cons(head, tail).length {
                    if List.cons(head, tail).get_idx(i) = Option.some(x) {
                        zero_or_suc(i)
                        if i = Nat.0 {
                            List.cons(head, tail).get_idx(Nat.0) = Option.some(head)
                            List.cons(head, tail).get_idx(i) = Option.some(head)
                            Option.some(head) = Option.some(x)
                            head = x
                            List.cons(head, tail).contains(x)
                        } else {
                            i != Nat.0
                            exists(k: Nat) { i = k.suc }
                            let (k: Nat) satisfy { i = k.suc }
                            i = k + Nat.1
                            k.suc < List.cons(head, tail).length
                            List.cons(head, tail).length = tail.length.suc
                            k.suc < tail.length.suc
                            lt_cancel_suc(k, tail.length)
                            k < tail.length
                            get_idx_suc_cons(head, tail, k)
                            List.cons(head, tail).get_idx(k + Nat.1) = tail.get_idx(k)
                            List.cons(head, tail).get_idx(i) = tail.get_idx(k)
                            tail.get_idx(k) = Option.some(x)
                            k < tail.length implies (tail.get_idx(k) = Option.some(x) implies tail.contains(x))
                            tail.contains(x)
                            List.cons(head, tail).contains(x)
                        }
                    }
                    List.cons(head, tail).get_idx(i) = Option.some(x) implies List.cons(head, tail).contains(x)
                }
                i < List.cons(head, tail).length implies (List.cons(head, tail).get_idx(i) = Option.some(x) implies List.cons(head, tail).contains(x))
            }
            p(List.cons(head, tail))
        }
    }

    List.induction(function(l: List[T]) { p(l) })
    forall(l: List[T]) { p(l) }
    p(list)
    idx < list.length implies (list.get_idx(idx) = Option.some(x) implies list.contains(x))
}
