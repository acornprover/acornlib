/// A smaller label is a different label.
theorem petersen_lt_imp_ne(a: Nat, b: Nat) {
    a < b implies a != b
} by {
    if a < b {
        if a = b {
            a < a
            lt_not_ref(a)
            not (a < a)
            false
        }
        a != b
    }
}

