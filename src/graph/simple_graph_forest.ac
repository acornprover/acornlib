        fs_card(fs_insert(fs_insert(FiniteSet.empty[Pair[V, V]], Pair.new(v, u)), Pair.new(u, v))) = Nat.2
        // (v, u) not in edges(s'):
        directed_edges_contains_eq(g, fs_remove(s, v), Pair.new(v, u))
