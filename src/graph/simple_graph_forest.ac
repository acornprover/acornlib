            false
        }
        not directed_edges(g, fs_remove(s, v)).contains(Pair.new(u, v))
        // (u, v) not in {(v, u)}:
        fs_insert_contains_eq(FiniteSet.empty[Pair[V, V]], Pair.new(v, u), Pair.new(u, v))
        fs_insert(FiniteSet.empty[Pair[V, V]], Pair.new(v, u)).contains(Pair.new(u, v)) =
