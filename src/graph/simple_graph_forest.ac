            fs_card(fs_insert(directed_edges(g, fs_remove(s, v)), Pair.new(v, u))) + Nat.1
        fs_card(fs_insert(fs_insert(directed_edges(g, fs_remove(s, v)), Pair.new(v, u)), Pair.new(u, v))) =
