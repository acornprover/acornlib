            directed_edges(g, s).contains(p) implies directed_edges(g, t).contains(p)
        }
        fs_subset_eq_intro(directed_edges(g, s), directed_edges(g, t))
        directed_edges(g, s).subset_eq(directed_edges(g, t))
    }
}

