/// Two indices naming the same element force the count of that element to be at least two.
theorem count_ge_two_of_get_idx_eq[T](list: List[T], i: Nat, j: Nat, x: T) {
    i < j implies (j < list.length implies (list.get_idx(i) = Option.some(x) implies (list.get_idx(j) = Option.some(x) implies list.count(x) >= Nat.2)))
} by {
    define p(l: List[T]) -> Bool {
        forall(a: Nat, b: Nat) {
            a < b implies (b < l.length implies (l.get_idx(a) = Option.some(x) implies (l.get_idx(b) = Option.some(x) implies l.count(x) >= Nat.2)))
        }
    }

    p(List.nil[T])

    forall(head: T, tail: List[T]) {
        if p(tail) {
            forall(a: Nat, b: Nat) {
                if a < b {
                    if b < List.cons(head, tail).length {
                        if List.cons(head, tail).get_idx(a) = Option.some(x) {
                            if List.cons(head, tail).get_idx(b) = Option.some(x) {
                                List.cons(head, tail).get_idx(a) = Option.some(x)
                                List.cons(head, tail).get_idx(b) = Option.some(x)
                                b < List.cons(head, tail).length
                                a < b
                                zero_or_suc(a)
                                if a = Nat.0 {
                                    List.cons(head, tail).get_idx(Nat.0) = Option.some(head)
                                    List.cons(head, tail).get_idx(a) = Option.some(head)
                                    Option.some(head) = Option.some(x)
                                    head = x
                                    zero_or_suc(b)
                                    if b = Nat.0 {
                                        b = Nat.0
                                        a = Nat.0
                                        a < b
                                        false
                                    } else {
                                        b != Nat.0
                                        exists(k: Nat) { b = k.suc }
                                        let (k: Nat) satisfy { b = k.suc }
                                        b = k + Nat.1
                                        k.suc < List.cons(head, tail).length
                                        List.cons(head, tail).length = tail.length.suc
                                        k.suc < tail.length.suc
                                        lt_cancel_suc(k, tail.length)
                                        k < tail.length
                                        get_idx_suc_cons(head, tail, k)
                                        List.cons(head, tail).get_idx(k + Nat.1) = tail.get_idx(k)
                                        List.cons(head, tail).get_idx(b) = tail.get_idx(k)
                                        tail.get_idx(k) = Option.some(x)
                                        k < tail.length
                                        k < tail.length implies (tail.get_idx(k) = Option.some(x) implies tail.contains(x))
                                        get_idx_implies_contains_lt(tail, k, x)
                                        tail.get_idx(k) = Option.some(x) implies tail.contains(x)
                                        tail.contains(x)
                                        list_contains_implies_count_geq_one(tail, x)
                                        tail.count(x) >= Nat.1
                                        Nat.1 <= tail.count(x)
                                        lte_add_left(Nat.1, Nat.1, tail.count(x))
                                        Nat.1 + Nat.1 <= Nat.1 + tail.count(x)
                                        Nat.1 + Nat.1 = Nat.2
                                        Nat.2 <= Nat.1 + tail.count(x)
                                        Nat.1 + tail.count(x) >= Nat.2
                                        count_cons_of_eq(head, tail, x)
                                        List.cons(head, tail).count(x) = 1 + tail.count(x)
                                        List.cons(head, tail).count(x) >= Nat.2
                                    }
                                } else {
                                    a != Nat.0
                                    exists(ka: Nat) { a = ka.suc }
                                    let (ka: Nat) satisfy { a = ka.suc }
                                    a = ka + Nat.1
                                    get_idx_suc_cons(head, tail, ka)
                                    List.cons(head, tail).get_idx(ka + Nat.1) = tail.get_idx(ka)
                                    List.cons(head, tail).get_idx(a) = tail.get_idx(ka)
                                    tail.get_idx(ka) = Option.some(x)
                                    zero_or_suc(b)
                                    if b = Nat.0 {
                                        b = Nat.0
                                        a < b
                                        false
                                    } else {
                                        b != Nat.0
                                        exists(kb: Nat) { b = kb.suc }
                                        let (kb: Nat) satisfy { b = kb.suc }
                                        b = kb + Nat.1
                                        get_idx_suc_cons(head, tail, kb)
                                        List.cons(head, tail).get_idx(kb + Nat.1) = tail.get_idx(kb)
                                        List.cons(head, tail).get_idx(b) = tail.get_idx(kb)
                                        tail.get_idx(kb) = Option.some(x)
                                        a < b
                                        a = ka + Nat.1
                                        b = kb + Nat.1
                                        ka + Nat.1 < kb + Nat.1
                                        lt_cancel_suc(ka, kb)
                                        ka < kb
                                        b < List.cons(head, tail).length
                                        List.cons(head, tail).length = tail.length.suc
                                        kb + Nat.1 < tail.length.suc
                                        kb < tail.length
                                        ka < kb
                                        ka < kb implies (kb < tail.length implies (tail.get_idx(ka) = Option.some(x) implies (tail.get_idx(kb) = Option.some(x) implies tail.count(x) >= Nat.2)))
                                        kb < tail.length implies (tail.get_idx(ka) = Option.some(x) implies (tail.get_idx(kb) = Option.some(x) implies tail.count(x) >= Nat.2))
                                        tail.get_idx(ka) = Option.some(x) implies (tail.get_idx(kb) = Option.some(x) implies tail.count(x) >= Nat.2)
                                        tail.get_idx(kb) = Option.some(x) implies tail.count(x) >= Nat.2
                                        tail.count(x) >= Nat.2
                                        if head = x {
                                            count_cons_of_eq(head, tail, x)
                                            List.cons(head, tail).count(x) = 1 + tail.count(x)
                                            tail.count(x) >= Nat.2
                                            Nat.2 <= tail.count(x)
                                            Nat.1 <= Nat.2
                                            lte_trans(Nat.1, Nat.2, tail.count(x))
                                            Nat.1 <= tail.count(x)
                                            lte_add_left(Nat.1, Nat.1, tail.count(x))
                                            Nat.1 + Nat.1 <= Nat.1 + tail.count(x)
                                            Nat.1 + Nat.1 = Nat.2
                                            Nat.2 <= Nat.1 + tail.count(x)
                                            Nat.1 + tail.count(x) >= Nat.2
                                            List.cons(head, tail).count(x) >= Nat.2
                                        } else {
                                            count_cons_other(head, tail, x)
                                            List.cons(head, tail).count(x) = tail.count(x)
                                            List.cons(head, tail).count(x) >= Nat.2
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                a < b implies (b < List.cons(head, tail).length implies (List.cons(head, tail).get_idx(a) = Option.some(x) implies (List.cons(head, tail).get_idx(b) = Option.some(x) implies List.cons(head, tail).count(x) >= Nat.2)))
            }
            p(List.cons(head, tail))
        }
    }

    p(list)
    i < j implies (j < list.length implies (list.get_idx(i) = Option.some(x) implies (list.get_idx(j) = Option.some(x) implies list.count(x) >= Nat.2)))
}

/// A unique list cannot name the same element from two different indices.
theorem get_idx_eq_implies_eq_idx_of_unique[T](list: List[T], i: Nat, j: Nat, x: T) {
    list.is_unique and list.get_idx(i) = Option.some(x) and list.get_idx(j) = Option.some(x)
    implies i = j
} by {
    if list.is_unique and list.get_idx(i) = Option.some(x) and list.get_idx(j) = Option.some(x) {
        unique_implies_no_duplicate(list, x)
        list.count(x) <= Nat.1
        trichotomy(i, j)
        if i < j {
            get_idx_out_of_bounds_self(list, j, x)
            j >= list.length implies not (list.get_idx(j) = Option.some(x))
            list.get_idx(j) = Option.some(x)
            not (j >= list.length)
            j < list.length
            count_ge_two_of_get_idx_eq(list, i, j, x)
            i < j implies (j < list.length implies (list.get_idx(i) = Option.some(x) implies (list.get_idx(j) = Option.some(x) implies list.count(x) >= Nat.2)))
            j < list.length implies (list.get_idx(i) = Option.some(x) implies (list.get_idx(j) = Option.some(x) implies list.count(x) >= Nat.2))
            list.get_idx(i) = Option.some(x) implies (list.get_idx(j) = Option.some(x) implies list.count(x) >= Nat.2)
            list.get_idx(j) = Option.some(x) implies list.count(x) >= Nat.2
            list.count(x) >= Nat.2
            Nat.2 <= list.count(x)
            list.count(x) <= Nat.1
            lte_trans(Nat.2, list.count(x), Nat.1)
            Nat.2 <= Nat.1
            false
        } else {
            if j < i {
                get_idx_out_of_bounds_self(list, i, x)
                i >= list.length implies not (list.get_idx(i) = Option.some(x))
                list.get_idx(i) = Option.some(x)
                not (i >= list.length)
                i < list.length
                count_ge_two_of_get_idx_eq(list, j, i, x)
                j < i implies (i < list.length implies (list.get_idx(j) = Option.some(x) implies (list.get_idx(i) = Option.some(x) implies list.count(x) >= Nat.2)))
                i < list.length implies (list.get_idx(j) = Option.some(x) implies (list.get_idx(i) = Option.some(x) implies list.count(x) >= Nat.2))
                list.get_idx(j) = Option.some(x) implies (list.get_idx(i) = Option.some(x) implies list.count(x) >= Nat.2)
                list.get_idx(i) = Option.some(x) implies list.count(x) >= Nat.2
                list.count(x) >= Nat.2
                Nat.2 <= list.count(x)
                list.count(x) <= Nat.1
                lte_trans(Nat.2, list.count(x), Nat.1)
                Nat.2 <= Nat.1
                false
            } else {
                i = j
            }
        }
    }
}

/// Distinct indices in a unique list name distinct elements.
theorem get_idx_distinct_of_unique[T](list: List[T], i: Nat, j: Nat, x: T, y: T) {
    list.is_unique and list.get_idx(i) = Option.some(x) and list.get_idx(j) = Option.some(y) and i != j implies x != y
} by {
    if list.is_unique and list.get_idx(i) = Option.some(x) and list.get_idx(j) = Option.some(y) and i != j {
        if x = y {
            list.get_idx(j) = Option.some(x)
            list.is_unique and list.get_idx(i) = Option.some(x) and list.get_idx(j) = Option.some(x)
            get_idx_eq_implies_eq_idx_of_unique(list, i, j, x)
            i = j
            false
        }
        x != y
    }
}

/// The numerals below nine are ordered.
theorem count_numeral_lt_ladder {
    Nat.0 < Nat.1 and Nat.1 < Nat.2 and Nat.2 < Nat.3 and Nat.3 < Nat.4 and Nat.4 < Nat.5 and Nat.5 < Nat.6 and Nat.6 < Nat.7 and Nat.7 < Nat.8 and Nat.8 < Nat.9
} by {
    Nat.0.suc = Nat.1
    Nat.0 < Nat.0.suc
    Nat.0 < Nat.1
    Nat.1.suc = Nat.2
    Nat.1 < Nat.1.suc
    Nat.1 < Nat.2
    Nat.2.suc = Nat.3
    Nat.2 < Nat.2.suc
    Nat.2 < Nat.3
    Nat.3.suc = Nat.4
    Nat.3 < Nat.3.suc
    Nat.3 < Nat.4
    Nat.4.suc = Nat.5
    Nat.4 < Nat.4.suc
    Nat.4 < Nat.5
    Nat.5.suc = Nat.6
    Nat.5 < Nat.5.suc
    Nat.5 < Nat.6
    Nat.6.suc = Nat.7
    Nat.6 < Nat.6.suc
    Nat.6 < Nat.7
    Nat.7.suc = Nat.8
    Nat.7 < Nat.7.suc
    Nat.7 < Nat.8
    Nat.8.suc = Nat.9
    Nat.8 < Nat.8.suc
    Nat.8 < Nat.9
}

/// The numeral 0 is below the numeral 1.
theorem count_numeral_lt_0_1 {
    Nat.0 < Nat.1
} by {
    count_numeral_lt_ladder
    (Nat.0 < Nat.1 and Nat.1 < Nat.2 and Nat.2 < Nat.3 and Nat.3 < Nat.4 and Nat.4 < Nat.5 and Nat.5 < Nat.6 and Nat.6 < Nat.7 and Nat.7 < Nat.8 and Nat.8 < Nat.9)
    Nat.0 < Nat.1
}

/// The numeral 0 is below the numeral 2.
theorem count_numeral_lt_0_2 {
    Nat.0 < Nat.2
