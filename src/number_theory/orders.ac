/// `6 ≢ 1 (mod 7)`.
theorem not_congr_six_mod_seven {
    not Nat.6.congr_mod(Nat.1, Nat.7)
} by {
    mod_six_mod_seven
    Nat.6.mod(Nat.7) = Nat.6
    mod_one_mod_seven
    Nat.1.mod(Nat.7) = Nat.1
    if Nat.6.congr_mod(Nat.1, Nat.7) {
