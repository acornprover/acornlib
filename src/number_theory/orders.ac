/// `x < 5` forces `x` into `{0, 1, 2, 3, 4}`.
theorem k_below_five_cases(k: Nat) {
    k < Nat.5 implies (k = Nat.0 or k = Nat.1 or k = Nat.2 or k = Nat.3 or k = Nat.4)
} by {
    if k < Nat.5 {
        lt_suc_right(k, Nat.4)
        k = Nat.4 or k < Nat.4
