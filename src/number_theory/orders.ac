    multiplicative_order_mod(Nat.3, Nat.5) = Nat.4
    four_plus_one
    Nat.4 + Nat.1 = Nat.5
    add_imp_sub(Nat.4, Nat.1, Nat.5)
    Nat.5 - Nat.1 = Nat.4
    multiplicative_order_mod(Nat.3, Nat.5) = Nat.5 - Nat.1
    Nat.5.is_prime and Nat.3.coprime(Nat.5) and
