    (Nat.5 - Nat.1).totient = Nat.2
} by {
    four_plus_one
    Nat.4 + Nat.1 = Nat.5
    add_imp_sub(Nat.4, Nat.1, Nat.5)
    Nat.5 - Nat.1 = Nat.4
    totient_four_mod_five
    Nat.4.totient = Nat.2
    (Nat.5 - Nat.1).totient = Nat.2
}

