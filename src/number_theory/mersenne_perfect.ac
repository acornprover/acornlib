                    }
                }
            } else {
            not (b <= Nat.5)
            lt_or_lte(Nat.5, b)
            Nat.5 < b or b <= Nat.5
            Nat.5 < b
            lt_imp_lte_suc(Nat.5, b)
            Nat.6 <= b
            if c <= Nat.5 {
                Nat.31 = b * c
                exists(x: Nat) { c * x = Nat.31 }
                c.divides(Nat.31)
                lt_suc(Nat.5)
                Nat.5 < Nat.6
                lte_and_lt(c, Nat.5, Nat.6)
                c < Nat.6
                lt_suc_right(c, Nat.5)
                if c = Nat.5 {
                    Nat.5.divides(Nat.31)
                    not_five_divides_31
                    false
                } else {
                    c < Nat.5
                    lt_suc_right(c, Nat.4)
