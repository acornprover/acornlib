    Nat.3 + Nat.3 = Nat.6
    Nat.2 + Nat.2 = Nat.4
    (Nat.3 + Nat.3).read(Nat.2 + Nat.2) = Nat.6.read(Nat.4)
    Nat.6.read(Nat.4) = Nat.64
    Nat.32 + Nat.32 = Nat.64
}

