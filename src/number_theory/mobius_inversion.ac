            nat_mobius(Nat.0) = Int.0
            nat_mobius(a) = Int.0
            nat_mobius_one
            nat_mobius(b) = Int.1
            nat_mobius(a) * nat_mobius(b) = Int.0 * Int.1
            mul_zero_left[Int](Int.1)
            Int.0 * Int.1 = Int.0
            nat_mobius(a * b) = nat_mobius(a) * nat_mobius(b)
        } else {
            if b = Nat.0 {
                coprime_zero_right_imp_one(a)
