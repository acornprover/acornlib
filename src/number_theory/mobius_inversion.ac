/// The Möbius function is multiplicative on coprime arguments.
theorem nat_mobius_multiplicative_apply(a: Nat, b: Nat) {
    a.coprime(b) implies nat_mobius(a * b) = nat_mobius(a) * nat_mobius(b)
} by {
    if a.coprime(b) {
        if a = Nat.0 {
            coprime_zero_left_imp_one(b)
