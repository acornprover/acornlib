    nat_add_3_2
    Nat.3 + Nat.2 = Nat.5
    range_sum(function(d: Nat) { floor_weight_term(Nat.3, d) }, Nat.3) = Nat.5
    range_sum(function(d: Nat) { floor_weight_term(Nat.3, d) }, Nat.4) = Nat.8
    floor_weighted_sigma_sum(Nat.3) = Nat.8
}

