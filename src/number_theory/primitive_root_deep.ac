    seven_is_prime
    Nat.7.is_prime
    Nat.1 <= Nat.6
    lt_six_seven
    Nat.6 < Nat.7
    coprime_below_prime(Nat.7, Nat.6)
    Nat.6.coprime(Nat.7)
