/// `5` is coprime to `7`.
theorem five_coprime_mod_seven {
    Nat.5.coprime(Nat.7)
} by {
    seven_is_prime
    Nat.7.is_prime
    Nat.1 <= Nat.5
    lt_five_seven
    Nat.5 < Nat.7
