}

/// A square of a real is at most the sum of four squares, with the square
/// in the fourth position.
theorem sq_le_sum4_d(a: Real, b: Real, c: Real, d: Real) {
    d * d <= a * a + b * b + c * c + d * d
} by {
    sq_le_sum4(d, a, b, c)
    d * d <= d * d + a * a + b * b + c * c
    d * d + a * a + b * b + c * c = a * a + d * d + b * b + c * c
