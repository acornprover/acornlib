/// in the third position.
theorem sq_le_sum4_c(a: Real, b: Real, c: Real, d: Real) {
    c * c <= a * a + b * b + c * c + d * d
} by {
    sq_le_sum4(c, a, b, d)
    c * c <= c * c + a * a + b * b + d * d
    c * c + a * a + b * b + d * d = a * a + b * b + c * c + d * d
