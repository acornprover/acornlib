            from_nat[Real](b) * from_nat[Real](b) +
            from_nat[Real](c) * from_nat[Real](c) +
            from_nat[Real](d) * from_nat[Real](d)
        real_add_pos_lt(Real.1, Real.1)
        Real.1 < Real.1 + Real.1
