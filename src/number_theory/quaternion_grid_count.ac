        Real.0 <= from_nat[Real](b) * from_nat[Real](b)
        le_add_nonneg(Real.1, from_nat[Real](b) * from_nat[Real](b))
        Real.1 <= Real.1 + from_nat[Real](b) * from_nat[Real](b)
