    a * a + b * b + (d * d + c * c) = a * a + b * b + (c * c + d * d)
    a * a + b * b + d * d + c * c = a * a + b * b + (d * d + c * c)
    a * a + b * b + (c * c + d * d) = a * a + b * b + c * c + d * d
    a * a + b * b + d * d + c * c = a * a + b * b + c * c + d * d
    le_eq_rewrite(d * d, d * d + a * a + b * b + c * c, a * a + b * b + c * c + d * d)
    d * d <= a * a + b * b + c * c + d * d
}

