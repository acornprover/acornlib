/// 2 < 5.
theorem lt_two_five {
    Nat.2 < Nat.5
} by {
    Nat.2 + Nat.3 = Nat.5
    exists(c: Nat) { Nat.2 + c = Nat.5 }
    Nat.2 <= Nat.5
    two_ne_five
    Nat.2 != Nat.5
    Nat.2 < Nat.5
}

/// 1 < 7.
theorem lt_one_seven {
    Nat.1 < Nat.7
} by {
    Nat.1 + Nat.6 = Nat.7
    exists(c: Nat) { Nat.1 + c = Nat.7 }
    Nat.1 <= Nat.7
    one_ne_seven
    Nat.1 != Nat.7
    Nat.1 < Nat.7
}

/// 3 < 7.
theorem lt_three_seven {
    Nat.3 < Nat.7
} by {
    Nat.3 + Nat.4 = Nat.7
    exists(c: Nat) { Nat.3 + c = Nat.7 }
    Nat.3 <= Nat.7
