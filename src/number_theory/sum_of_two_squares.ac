            ((a * a).mod(Nat.4) + (b * b).mod(Nat.4)).mod(Nat.4) = Nat.1.mod(Nat.4)
            small_mod(Nat.1, Nat.4)
            Nat.1.mod(Nat.4) = Nat.1
            ((a * a).mod(Nat.4) + (b * b).mod(Nat.4)).mod(Nat.4) = Nat.1
            (a * a + b * b).mod(Nat.4) = Nat.1
            (a * a + b * b).mod(Nat.4) = Nat.0 or
