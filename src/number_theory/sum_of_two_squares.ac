            p.mod(Nat.4) = Nat.1
        } else {
            (a * a + b * b).mod(Nat.4) = Nat.0
            p.mod(Nat.4) = Nat.0
            add_mod(p, Nat.4)
            let q: Nat satisfy { q * Nat.4 + p.mod(Nat.4) = p }
            q * Nat.4 + Nat.0 = p
