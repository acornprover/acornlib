        p.mod(Nat.4) = (a * a + b * b).mod(Nat.4)
        if (a * a + b * b).mod(Nat.4) != Nat.0 {
            if (a * a + b * b).mod(Nat.4) != Nat.2 {
                (a * a + b * b).mod(Nat.4) = Nat.1
