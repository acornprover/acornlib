    Int.from_nat(Nat.3) = Int.3
    Int.from_nat(Nat.7) = Int.7
    Int.4 + Int.3 = Int.7
    Int.2 * Int.2 + Int.3 * Int.1 = Int.7
    mul_one_right(Int.2)
    Int.2 * Int.1 = Int.2
