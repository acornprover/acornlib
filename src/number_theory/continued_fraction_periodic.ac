    Int.9 * (y * y) - (Int.6 * (y * y) + Int.6 * (y * y)) =
        Int.9 * (y * y) - Int.6 * (y * y) - Int.6 * (y * y)
    Int.6 * (y * y) + Int.6 * (y * y) = Int.3 * (Int.4 * (y * y))
