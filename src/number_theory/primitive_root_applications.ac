/// `φ(4) = 2`.
theorem totient_four_mod_five {
    Nat.4.totient = Nat.2
} by {
    two_is_prime
    Nat.2.is_prime
    totient_pp(Nat.2)
    (Nat.2 * Nat.2).totient = Nat.2 * Nat.2 - Nat.2
    Nat.2 * Nat.2 = Nat.4
    Nat.4.totient = Nat.4 - Nat.2
    Nat.4 - Nat.2 = Nat.2
    Nat.4.totient = Nat.2
}


