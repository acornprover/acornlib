/// `[4]` contains no order-`4` residue.
theorem singleton_order_four_len_4 {
    List.singleton(Nat.4).filter(order_four_pred_mod_five).length = Nat.0
} by {
    order_four_mod_five
    multiplicative_order_mod(Nat.4, Nat.5) = Nat.2
