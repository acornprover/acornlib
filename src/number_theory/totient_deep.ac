                n != j + j
                lte_neq_imp_lt(n, j + j)
                n < j + j
                count_upper_half_suc_yes(n, j)
                count_upper_half(n, j.suc) = count_upper_half(n, j) + Nat.1
                if j + j < n {
                    lt_trans(j + j, n, j + j)
                    j + j < j + j
                    false
