                    count_lower_half(n, j.suc) + count_upper_half(n, j.suc)
            }
            count_coprime_to(n, j.suc) =
                count_lower_half(n, j.suc) + count_upper_half(n, j.suc)
        } else {
            not j.coprime(n)
