    }
    subsequence(partial(re_seq(complex_exp_term(complex_i_mul_real(x)))), Nat.2.mul) = partial(cos_term(x))
    cos_term_abs_converges(x)
    absolutely_converges(cos_term(x))
    absolutely_converges_imp_converges(cos_term(x))
